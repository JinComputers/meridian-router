#!/bin/sh /etc/rc.common
# meridian-dns — procd-служба под OpenWrt.
#
# РЕЖИМ НАПОЛНЕНИЯ, БЕЗ ЗАВОРОТА. Сервер не садится на :53 и не трогает
# межсетевой экран вовсе. На :53 сидит dnsmasq; он резолвит по строкам
# nftset=, которые порождает сам meridian-dns, и кладёт адреса в набор
# meridian_dst4 таблицы inet meridian. Второго перехватчика DNS в доме быть не
# должно — это грабля MagiTrickle, и запрет прямой.
#
# ТАБЛИЦУ inet meridian ПОДНИМАЕТ meridian-nft СВОИМ procd, а НЕ файл в
# /etc/nftables.d. Файл там попадает внутрь inet fw4, и на холодной загрузке
# объявление чужой базовой цепочки кладёт весь набор правил целиком
# (замерено 10.09.2026: `Chain of type "filter" is not supported`).
#
# START=81 — раньше клиента (95) и панели (96). Сервер ни от кого из них не
# зависит, а они от него зависят. Номер НЕ гарантирует готовности: procd
# запускает по очереди, не дожидаясь, пока служба ответит. Панель обязана
# переживать «сервера ещё нет» сама, и она это умеет.
START=81
STOP=10
USE_PROCD=1

BIN=/usr/sbin/meridian-dns
CONF=/etc/qwdtt/meridian-dns.yaml
NASTROJKI=/etc/qwdtt/meridian-dns.conf
LOG=/var/log/meridian-dns.log
RUN=/var/run

# Значения по умолчанию. Их МОЖНО перекрыть в $NASTROJKI, но панель и скрипты
# сюда не пишут: явное значение в файле приколачивает роутер к сегодняшнему
# умолчанию навсегда, и расхождение выглядит штатной работой (правило 17).
LISTEN_DEF="auto:5453"
LOGMAX_DEF=2097152

tablica_est() {
    nft list table inet meridian >/dev/null 2>&1
}

start_service() {
    LISTEN="$LISTEN_DEF"
    LOGMAX="$LOGMAX_DEF"
    # Читаем настройки, ЕСЛИ файл есть. Точка — спец-встроенная команда, и её
    # неудача гасит неинтерактивную оболочку целиком (правило 31), поэтому
    # существование проверяется ДО, а не подавляется 2>/dev/null.
    if [ -r "$NASTROJKI" ]; then
        . "$NASTROJKI"
    fi

    if [ ! -x "$BIN" ]; then
        logger -t meridian-dns "ОТКАЗ: $BIN нет или он не исполняемый — не запускаю"
        return 1
    fi

    # НАБОР ЖИВЁТ В ЧУЖОЙ ТАБЛИЦЕ, И БЕЗ НЕЁ ПИСАТЬ НЕКУДА.
    #
    # Без этой проверки сервер стартовал бы, не смог создать набор, вышел с
    # ошибкой — и procd поднял бы его снова, и снова. Аварийная ветка без
    # паузы и предела это вечный цикл, который платит логом, памятью и
    # процессором (правило 22), а на роутере с 248 МБ лог в tmpfs съедает ОЗУ
    # за минуты (правило 21).
    #
    # Поэтому: одна попытка поднять владельца таблицы, одна перепроверка,
    # затем ОТКАЗ с внятной строкой. Отказ лучше цикла: его видно.
    if ! tablica_est; then
        logger -t meridian-dns "таблицы inet meridian нет — поднимаю meridian-nft"
        [ -x /etc/init.d/meridian-nft ] && /etc/init.d/meridian-nft start
        if ! tablica_est; then
            logger -t meridian-dns "ОТКАЗ: таблицы inet meridian нет и поднять её не вышло."
            logger -t meridian-dns "  Набор meridian_dst4 живёт в ней; писать некуда, и я НЕ запускаюсь."
            logger -t meridian-dns "  Проверьте: nft list table inet meridian ; /etc/init.d/meridian-nft enable"
            return 1
        fi
        logger -t meridian-dns "таблица inet meridian поднялась"
    fi

    mkdir -p "$RUN" "$(dirname "$LOG")" "$(dirname "$CONF")"

    procd_open_instance
    # -rezhim napolnenie ЗАДАЁТСЯ ЯВНО, хотя это и умолчание сборки openwrt.
    # Умолчание может смениться, а строка в журнале обязана называть источник
    # значения; явный флаг делает источник однозначным и переживает пересборку
    # с другой платформой.
    procd_set_param command "$BIN" \
        -rezhim napolnenie \
        -listen "$LISTEN" \
        -config "$CONF" \
        -listen-file "$RUN/meridian-dns.listen" \
        -pid "$RUN/meridian-dns.pid" \
        -log "$LOG" \
        -log-max "$LOGMAX" \
        run
    # Потолок лога держит САМА ПРОГРАММА (-log-max): обрезка снаружи не спасает
    # от строки в цикле, которая пишется со скоростью процессора (правило 21).
    procd_set_param respawn 3600 5 0
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    # Сервер в этом режиме ничего не ставил в экран — снимать нечего. Строка
    # нужна, чтобы «ничего не снял, потому что нечего» не выглядело как
    # «ничего не снял, потому что не смог» (правило 52).
    logger -t meridian-dns "остановка: заворота и пометки не ставили, снимать нечего"
}

reload_service() {
    stop
    start
}

service_triggers() {
    procd_add_reload_trigger "qwdtt"
}
