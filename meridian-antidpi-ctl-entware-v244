#!/bin/sh
# meridian-antidpi-ctl для Кинетика (Entware) — тот же договор с панелью, что
# на OpenWrt (shag12-antidpi/owrt/meridian-antidpi-ctl):
#
#   status [--machine]      состояние (key=value при --machine)
#   on | off                весь анти-DPI (off — только сейчас, автозапуск остаётся)
#   domains <группа>        домены группы (печатает движок, 2.4.2+)
#   group <имя> on|off      одна группа: youtube | discord | cloudflare | other | social
#
# Коды: 0 — сделано; 1 — отказ («ОТКАЗ: …» одной строкой в stderr); 2 — неверные аргументы.
#
# Отличия от OpenWrt: init — /opt/etc/init.d/S51meridian-antidpi (автозапуск =
# исполняемый файл, enable/disable нет); flock на HERO нет — замок каталогом.
# Паузы в белом нет и не нужно: правило очереди пропускает пакеты с меткой
# туннеля 0x1c9, а в белом весь зарубежный трафик идёт в туннель.

INIT=${MERIDIAN_ANTIDPI_INIT:-/opt/etc/init.d/S51meridian-antidpi}
BIN=${MERIDIAN_ANTIDPI_BIN:-/opt/bin/meridian-antidpi}
GROUPS=${MERIDIAN_ANTIDPI_GROUPS:-/opt/etc/meridian-antidpi/groups}
STATUS=${MERIDIAN_ANTIDPI_STATUS:-/var/run/meridian-antidpi.status}
LOCK=${MERIDIAN_ANTIDPI_LOCK:-/var/run/meridian-antidpi-ctl.lock}
ALL="youtube discord cloudflare other social"
AUTOPAUSE=${MERIDIAN_ANTIDPI_AUTOPAUSE:-$(dirname "$GROUPS")/all-groups-paused}

otkaz() { echo "ОТКАЗ: $*" >&2; exit 1; }

unlock() { rm -f "$LOCK/pid" 2>/dev/null; rmdir "$LOCK" 2>/dev/null; }

with_lock() {
	_i=0
	until mkdir "$LOCK" 2>/dev/null; do
		_p=$(cat "$LOCK/pid" 2>/dev/null)
		if [ -n "$_p" ] && ! kill -0 "$_p" 2>/dev/null; then
			unlock
			continue
		fi
		_i=$((_i + 1))
		[ "$_i" -ge 15 ] && otkaz "занято другой командой (замок $LOCK)"
		sleep 1
	done
	echo $$ > "$LOCK/pid"
	trap unlock EXIT
	trap 'exit 130' INT TERM HUP
}

group_val() { # нет строки/файла = 1
	_v=$(grep -E "^$1=" "$GROUPS" 2>/dev/null | tail -1 | cut -d= -f2)
	case "$_v" in 0|off) echo 0 ;; *) echo 1 ;; esac
}

running() { pidof meridian-antidpi >/dev/null 2>&1; }
all_groups_off() { for _g in $ALL; do [ "$(group_val "$_g")" = 0 ] || return 1; done; return 0; }

cmd_status() {
	if running; then _r=1; else _r=0; fi
	if [ -x "$INIT" ]; then _e=1; else _e=0; fi
	if [ "$1" = "--machine" ]; then
		echo "feature_youtube_ttk=1"
		echo "installed=$([ -x "$BIN" ] && echo 1 || echo 0)"
		echo "enabled=$_e"
		echo "running=$_r"
        [ -f "$AUTOPAUSE" ] && echo "paused_groups=1" || echo "paused_groups=0"
		for g in $ALL; do echo "group_$g=$(group_val "$g")"; done
        _y=$(grep -E '^youtube=[0-4]$' "${MERIDIAN_ANTIDPI_STRATEGY:-/opt/etc/meridian-antidpi/strategy}" 2>/dev/null | tail -1 | cut -d= -f2)
        echo "strategy_youtube=${_y:-3}"
		[ "$_r" = 1 ] && grep -E '^(paused_white|strategy_[a-z]+|packets|tls_handled|tls_group_off|quic_handled|quic_dropped|udp_handled)=' "$STATUS" 2>/dev/null | grep -v '^strategy_youtube='
		return 0
	fi
	echo "анти-DPI: $([ "$_r" = 1 ] && echo работает || echo остановлен), автозапуск $([ "$_e" = 1 ] && echo вкл || echo выкл)"
	for g in $ALL; do echo "  $g: $([ "$(group_val "$g")" = 1 ] && echo вкл || echo выкл)"; done
}

cmd_onoff() {
	[ -x "$INIT" ] || otkaz "анти-DPI не установлен (нет $INIT)"
	with_lock
	if [ "$1" = on ]; then
        if all_groups_off; then
            "$INIT" start >/dev/null 2>&1 || otkaz "не удалось применить паузу"
            echo "все группы выключены — анти-DPI на паузе"
            return 0
        fi
		"$INIT" start >/dev/null 2>&1
		_i=0
		while ! running; do
			_i=$((_i + 1)); [ "$_i" -ge 10 ] && otkaz "движок не поднялся за 10 с (/opt/var/log/meridian-antidpi.log)"
			sleep 1
		done
		echo "анти-DPI включён"
	else
		"$INIT" stop >/dev/null 2>&1
        rm -f "$AUTOPAUSE"
		echo "анти-DPI остановлен (автозапуск сохранён — вернётся после перезагрузки)"
	fi
}

cmd_group() {
 case " $ALL " in *" $1 "*) ;; *) echo "неизвестная группа «$1»; можно: $ALL" >&2; exit 2 ;; esac
 case "$2" in on) _v=1 ;; off) _v=0 ;; *) echo "ждали on или off" >&2; exit 2 ;; esac
 with_lock
 mkdir -p "$(dirname "$GROUPS")" || otkaz "нет каталога для $GROUPS"
 _tmp="$GROUPS.tmp.$$"; _backup="$GROUPS.before.$$"; _existed=0; _wasrunning=0; _hadpause=0
 [ -f "$AUTOPAUSE" ] && _hadpause=1
 running && _wasrunning=1
 if [ -f "$GROUPS" ]; then cp -p "$GROUPS" "$_backup" || otkaz "не сохранить группы"; _existed=1; fi
 {
  echo "# meridian-antidpi: включённость групп (1/0). Правит meridian-antidpi-ctl."
  for g in $ALL; do
   if [ "$g" = "$1" ]; then echo "$g=$_v"; else echo "$g=$(group_val "$g")"; fi
  done
 } > "$_tmp" || otkaz "не записать $GROUPS"
 mv -f "$_tmp" "$GROUPS" || otkaz "не заменить $GROUPS"
 _problem=""
 if all_groups_off; then
  if [ "$_wasrunning" = 1 ]; then
   (umask 077; : > "$AUTOPAUSE") || _problem="не сохранить состояние паузы"
  fi
  # Stale NFQUEUE rules can outlive a crashed or manually stopped process.
  # Remove and verify them even if no process is currently running. The
  # pause marker is preserved only for an automatic pause, never fabricated
  # for a previously manual stop.
  if [ -z "$_problem" ]; then
   "$INIT" stop >/dev/null 2>&1 || _problem="не остановить движок"
   running && _problem="движок не остановился"
   _rules=$(iptables -t mangle -S FORWARD 2>/dev/null) || _problem="не проверить правила очереди"
   echo "$_rules" | grep -q -- '--queue-num 500' && _problem="правила очереди не сняты"
  fi
 elif [ "$_hadpause" = 1 ] && [ "$_wasrunning" = 0 ]; then
  "$INIT" start >/dev/null 2>&1 || _problem="не запустить движок"
  _i=0; while ! running && [ "$_i" -lt 10 ]; do sleep 1; _i=$((_i + 1)); done
  running || _problem="движок не запустился"
  [ -n "$_problem" ] || rm -f "$AUTOPAUSE"
 elif [ "$_wasrunning" = 1 ]; then
  "$INIT" reload >/dev/null 2>&1 || _problem="движок не перечитал группы"
 fi
 if [ -n "$_problem" ]; then
  if [ "$_existed" = 1 ]; then mv -f "$_backup" "$GROUPS"; else rm -f "$GROUPS"; fi
  if [ "$_hadpause" = 1 ]; then (umask 077; : > "$AUTOPAUSE"); else rm -f "$AUTOPAUSE"; fi
  if [ "$_wasrunning" = 1 ]; then
   if running; then "$INIT" reload >/dev/null 2>&1 || :; else "$INIT" start >/dev/null 2>&1 || :; fi
  else
   if running; then "$INIT" stop >/dev/null 2>&1 || :; fi
  fi
  otkaz "$_problem; прежнее состояние групп восстановлено"
 fi
 rm -f "$_backup"
 echo "группа $1: $([ "$_v" = 1 ] && echo вкл || echo выкл)"
}

cmd_youtube_ttk() {
  [ "$1" = 1 ] || [ "$1" = 2 ] || { echo "неверная стратегия" >&2; exit 2; }
  with_lock
  _f=${MERIDIAN_ANTIDPI_STRATEGY:-/opt/etc/meridian-antidpi/strategy}
  _prev="${_f}.ttk-prev"; _tmp="${_f}.tmp.$$"; _backup="${_f}.rollback.$$"
  mkdir -p "$(dirname "$_f")" || otkaz "нет каталога"
  _current=$(grep -E '^youtube=[0-4]$' "$_f" 2>/dev/null | tail -1 | cut -d= -f2)
  [ -n "$_current" ] || _current=3
  if [ "$1" = 2 ]; then
    if [ "$_current" != 4 ]; then
      (umask 077; printf '%s\n' "$_current" > "${_prev}.tmp.$$" && mv -f "${_prev}.tmp.$$" "$_prev") || otkaz "не сохранена прежняя стратегия"
    fi
    _new=4
  else
    if [ "$_current" != 4 ]; then echo "Стратегия YouTube: 1"; return 0; fi
    _new=$(cat "$_prev" 2>/dev/null)
    case "$_new" in 0|1|2|3) ;; *) otkaz "нет сохранённой прежней стратегии" ;; esac
  fi
  _existed=0
  if [ -f "$_f" ]; then cp -p "$_f" "$_backup" || otkaz "нет копии для отката"; _existed=1; awk '!/^[[:space:]]*youtube[[:space:]]*=/' "$_f" > "$_tmp" || otkaz "не прочитать файл"; else : > "$_tmp"; fi
  printf 'youtube=%s\n' "$_new" >> "$_tmp" || otkaz "не записать стратегию"
  mv -f "$_tmp" "$_f" || otkaz "не заменить стратегию"
  if running && ! "$INIT" reload >/dev/null 2>&1; then
    if [ "$_existed" = 1 ]; then mv -f "$_backup" "$_f"; else rm -f "$_f"; fi
    "$INIT" reload >/dev/null 2>&1 || true
    otkaz "не удалось применить стратегию, прежняя настройка восстановлена"
  fi
  rm -f "$_backup"
  echo "Стратегия YouTube: $1"
}

case "$1" in
	youtube-ttk) [ $# -eq 2 ] || exit 2; cmd_youtube_ttk "$2" ;;
	status) cmd_status "$2" ;;
	on|off) [ $# -eq 1 ] || { echo "лишние аргументы" >&2; exit 2; }; cmd_onoff "$1" ;;
	group) [ $# -eq 3 ] || { echo "использование: $0 group <имя> on|off" >&2; exit 2; }; cmd_group "$2" "$3" ;;
	# 27.10.2026 (anti-DPI 2.4.2): домены группы печатает сам движок (список зашит в бинарь) — один источник для панели и meridian-dns.
	domains) [ $# -eq 2 ] || { echo "использование: $0 domains <$ALL>" >&2; exit 2; }
		case " $ALL " in *" $2 "*) ;; *) echo "неизвестная группа «$2»; можно: $ALL" >&2; exit 2 ;; esac
		[ -x "$BIN" ] || otkaz "движок не установлен ($BIN)"
		exec "$BIN" -domains "$2" ;;
	*) echo "использование: $0 status [--machine] | on | off | group <$ALL> on|off | domains <$ALL>" >&2; exit 2 ;;
esac
