#!/usr/sbin/nft -f
# meridian.nft — СВОЯ таблица inet meridian: набор и пометка.
#
# ПОЧЕМУ СВОЯ ТАБЛИЦА, А НЕ ФАЙЛ В /etc/nftables.d. Файлы оттуда включаются
# ВНУТРЬ таблицы inet fw4, и наша декларация цепочки встаёт РАНЬШЕ, чем fw4
# объявит её базовой. На reload это незаметно (таблица уже собрана), а на
# ХОЛОДНОЙ загрузке nft видит нашу обычную цепочку с тем же именем и роняет
# сборку целиком:
#     Error: Chain of type "filter" is not supported
#     type filter hook prerouting priority mangle
# Экран при этом не поднимается ВООБЩЕ — не «правило не сработало», а роутер
# без межсетевого экрана. Измерено 19.08.2026 (пункт 114) и повторено нами
# 10.09.2026 на живом роутере.
#
# В БАЗОВЫЕ ЦЕПОЧКИ fw4 НЕ ДОПИСЫВАТЬ НИКОГДА. Своя таблица этого не касается:
# на одном хуке проходятся ВСЕ базовые цепочки всех таблиц, наша и fw4-шная
# работают рядом и не спорят.
#
# ЧТО ЗДЕСЬ ЕСТЬ И ЧЕГО НЕТ:
#   есть  — набор и пометка: они МЕНЯЮТ пакет, это дело своей таблицы;
#   нет   — разрешения транзита: своей таблицей чужой policy drop не отменить
#           (замер 19.08: accept сработал, счётчик показал 2 пакета, а пакеты
#           всё равно умерли на policy drop у fw4). Транзит открывает зона fw4;
#   нет   — MSS: у зоны с mtu_fix=1 fw4 сам ставит клэмп в ОБЕ стороны и
#           считает от rt mtu. Своё правило рядом — второй хозяин одного
#           решения;
#   нет   — NAT: маскарад делает fw4 по зоне. ensure_masq с Кинетика сюда
#           переносить не надо и вредно.

# ИДЕМПОТЕНТНОСТЬ: ВТОРАЯ ЗАГРУЗКА НЕ ДОЛЖНА ДОБАВЛЯТЬ ВТОРУЮ КОПИЮ ПРАВИЛ.
#
# 12.09.2026 на живом роутере в mark_prerouting оказалось ВОСЕМЬ правил вместо
# четырёх — две одинаковые группы подряд, счётчики у обеих 266/266. Загадки
# здесь нет, это арифметика: `nft -f` ДОБАВЛЯЕТ, а запусков заведомо два —
# служба включена на загрузке и установщик зовёт `start` при установке.
# Вреда не было, но каждый пакет проходил лишнюю проверку, и след настоящей
# поломки утонул бы в этом шуме.
#
# ЧИСТИМ ЦЕПОЧКУ, А НЕ ТАБЛИЦУ, и вот что тут ЗАМЕРЕНО, а что нет.
# Замер 12.09.2026 в netns: `flush table inet meridian` снимает правила (4 -> 0)
# и НЕ трогает элементы набора (адрес остался на месте). То есть довод «flush
# table снесёт накопленные адреса», с которого начиналась эта правка, НЕВЕРЕН —
# он был догадкой, и проверка его не подтвердила.
# Оставляем `flush chain` по другой, честной причине: он трогает ровно то, что
# мы пересобираем, и не зависит от того, что появится в этой таблице завтра.
# Набор чистится только `flush set`/`delete set`, и ни того, ни другого здесь
# нет и быть не должно — на это стоит отдельная проверка в стенде.
#
# Пустое объявление ниже нужно, чтобы flush не упал на первой в жизни загрузке:
# очистить можно только то, что существует.
table inet meridian {
    chain mark_prerouting {
        type filter hook prerouting priority mangle; policy accept;
    }
}
flush chain inet meridian mark_prerouting

table inet meridian {
    set meridian_dst4 {
        type ipv4_addr
        flags interval
        auto-merge
        comment "адреса чёрного списка; наполняет dnsmasq через nftset="
    }

    chain mark_prerouting {
        type filter hook prerouting priority mangle; policy accept;

        # ОБРАТНЫЕ ПАКЕТЫ ВЫХОДЯТ ПЕРВЫМИ, ДО ВОССТАНОВЛЕНИЯ МЕТКИ.
        #
        # 13.09.2026, роутер владельца: обход не работал совсем. Ответ из
        # туннеля доходил до роутера (conntrack считал по 4-5 пакетов), но в
        # домашнюю сеть не уходил НИ ОДИН — счётчик iif meridian oif br-lan
        # стоял на нуле. Причина в порядке: восстановление метки стояло ВЫШЕ и
        # ставило 0x1c9 на обратный пакет тоже, а правило `fwmark 0x1c9 ->
        # таблица 129` отправляет всё помеченное в meridian. Ответ разворачивался
        # и уезжал обратно в туннель.
        #
        # Предохранитель pol_vpered при этом молчал (его счётчик тоже ноль): он
        # бьёт по помеченному, уходящему МИМО meridian, а здесь оно уходило
        # ИМЕННО в meridian. Два нуля рядом и назвали настоящую причину.
        #
        # Подтверждено трижды: вставили правило вживую — заработало, убрали —
        # сломалось, вставили снова — заработало.
        #
        # Трафик самого роутера этого не показывал: его ответы идут в INPUT, а
        # заворот в таблицу 129 случается на FORWARD. Проверка «с роутера
        # открывается» была проверкой не того пути (правило 33).
        ct direction reply counter return comment "meridian_reply"

        # Уже помеченный поток метим по conntrack, не разбирая заново.
        # ct mark здесь нужен по-настоящему: офлоада, который на Keenetic
        # держит поток своим nmark, на OpenWrt нет.
        ct mark and 0x1ff == 0x1c9 meta mark set ct mark counter comment "meridian_restore"

        # Основное: адрес в наборе -> метка -> сохранить в conntrack.
        # Форма маски та же, что --set-xmark 0x1c9/0x1ff на Кинетике
        # (проверено 19.08: nft это принимает).
        ip daddr @meridian_dst4 \
            meta mark set mark and 0xfffffe00 or 0x1c9 \
            counter comment "meridian_mark"
        ip daddr @meridian_dst4 ct mark set mark counter comment "meridian_save"
    }
}
