#!/bin/sh /etc/rc.common
# meridian-route-min — ДЕРЖАТЕЛЬ МАРШРУТА на OpenWrt: правило политики,
# таблица 129, два маршрута. Больше ничего: ни списков, ни удержания по
# таймеру, ни белого режима — это не порт движка, это его минимальное ядро.
#
# ЧЕМ ДЕРЖИМ И ПОЧЕМУ НЕ HOTPLUG. /etc/hotplug.d/iface/ срабатывает на
# интерфейсы UCI. Наш meridian создаёт клиент напрямую через TUN, интерфейсом
# OpenWrt он не является, события iface по нему не приходит ВОВСЕ. Держатель на
# hotplug молчал бы всегда, и выглядело бы это как «маршрут не нужен», а не как
# «мы его не ставим». Поэтому свой цикл с проверкой раз в 10 секунд: он не
# зависит от того, как появилось устройство, и переживает и загрузку, и
# пересоздание туннеля клиентом.

USE_PROCD=1
START=96
STOP=09

start_service() {
    procd_open_instance meridian-route-min
    procd_set_param command /usr/sbin/meridian-route-hold
    procd_set_param respawn 3600 5 0
    procd_set_param stdout 1
    procd_set_param stderr 1
    procd_close_instance
}

stop_service() {
    ip rule del pref 1000 2>/dev/null
    ip route flush table 129 2>/dev/null
    logger -t meridian-route-min "снято: правило 1000 и таблица 129"
}
