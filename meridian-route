TRANSITIONS="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.transitions"
TRANSITIONS_LASTMODE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.transitions.lastmode"
TRANSITIONS_MAX=200
qwdtt_path_mode() {
	[ -r "$QWDTT_PATH_STATE" ] || return 1
	sed -n 's/.*"mode"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' "$QWDTT_PATH_STATE" 2>/dev/null | head -1
}
qwdtt_path_since() {
	[ -r "$QWDTT_PATH_STATE" ] || return 1
	sed -n 's/.*"since"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' "$QWDTT_PATH_STATE" 2>/dev/null | head -1
}
transitions_ensure() {
	_tm=$(qwdtt_path_mode) || return 0
	[ -n "$_tm" ] || return 0
	_tprev=$(cat "$TRANSITIONS_LASTMODE" 2>/dev/null)
	[ "$_tm" = "$_tprev" ] && return 0
	mkdir_for "$TRANSITIONS"
	echo "$(date +%s) ${_tprev:-start} -> $_tm" >> "$TRANSITIONS" 2>/dev/null
	if [ -f "$TRANSITIONS" ]; then
		_tn=$(wc -l < "$TRANSITIONS" 2>/dev/null)
		[ "${_tn:-0}" -gt "$TRANSITIONS_MAX" ] 2>/dev/null && {
			tail -n "$TRANSITIONS_MAX" "$TRANSITIONS" > "$TRANSITIONS.tmp" 2>/dev/null \
				&& mv -f "$TRANSITIONS.tmp" "$TRANSITIONS" 2>/dev/null
		}
	fi
	printf '%s' "$_tm" > "$TRANSITIONS_LASTMODE" 2>/dev/null
	log "переход клиента: ${_tprev:-(впервые увиден)} -> $_tm"
}
transitions_continuous_since() {
	[ -f "$TRANSITIONS" ] || return 1
	tail -1 "$TRANSITIONS" 2>/dev/null | awk '{print $1}'
}
tun_field() {
	[ -f "$TUNSTATE" ] || return 1
	_tf_f=""; _tf_v=""
	while IFS= read -r _tf_l || [ -n "$_tf_l" ]; do
		case "$_tf_l" in "$1="*) _tf_v=${_tf_l#*=}; _tf_f=1; break ;; esac
	done < "$TUNSTATE"
	[ -n "$_tf_f" ] && printf '%s\n' "$_tf_v"
	return 0
}
tun_state_set() {
	mkdir_for "$TUNSTATE"
	{ echo "state=$1"; echo "since=$2"; echo "open_since=$3"
	  echo "held_total=${4:-0}"; echo "seen=${5:-0}"; } > "$TUNSTATE.tmp" 2>/dev/null || return 1
	mv -f "$TUNSTATE.tmp" "$TUNSTATE" 2>/dev/null
}
outage_record() {
	echo "$(date +%s) $1" >> "$OUTAGES" 2>/dev/null || return 0
	_n=$(grep -c . "$OUTAGES" 2>/dev/null)
	case "$_n" in ''|*[!0-9]*) return 0 ;; esac
	[ "$_n" -le "$OUTAGES_MAX" ] && return 0
	tail -n "$OUTAGES_MAX" "$OUTAGES" > "$OUTAGES.tmp" 2>/dev/null && mv -f "$OUTAGES.tmp" "$OUTAGES" 2>/dev/null
	return 0
}
outages_clean() {
	[ -f "$OUTAGES" ] || return 0
	awk 'NF==2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/' "$OUTAGES" 2>/dev/null
}
OUTAGESCLEANTMP="$RUNDIR/outages_clean.$$"
outages_clean_cached() {
	if [ -n "${_OC_MEMO_OK:-}" ]; then
		[ -n "$_OC_MEMO" ] && printf '%s\n' "$_OC_MEMO"
