				# собирал его заново на КАЖДОЙ строке снимка (~50 КБ).
				if (substr(line, 1, 1) != "[") next
				bp = index(line, "] ")
				if (bp == 0) next
				bare = substr(line, bp + 2)
				if (index(bare, "-A " ch " ") != 1) next
				if (bare !~ pat) next
				found = 1
				cnt = line
				sub(/^\[/, "", cnt); sub(/:.*/, "", cnt)
				sum += cnt + 0
			}
			END { if (!found) exit 1; print sum + 0 }
		'
		return $?
	fi
	_spi=$($_spt -S "$_spc" 2>/dev/null | grep -v '^-N ' | grep -n -- "$_spp" | cut -d: -f1)
	[ -n "$_spi" ] || return 1
	_sps=0
	for _spn in $_spi; do
		_spv=$($_spt -L "$_spc" -v -n -x 2>/dev/null | awk -v n="$_spn" '$1 ~ /^[0-9]+$/ { k++; if (k == n) { print $1; exit } }')
		case "$_spv" in ''|*[!0-9]*) continue ;; esac
		_sps=$((_sps + _spv))
	done
