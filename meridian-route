# роутере может быть просто "-w" без числа (iptables 1.4.21) — то есть без
# верхнего предела ожидания замка ядра сам по себе.
#
# white_home_ensure() больше не пересчитывает эталон живым вызовом — вместо
# этого КАЖДУЮ минуту (не только сразу после пересборки) проверяет ХВОСТ
# активной половины напрямую (white_home_tail_ok): последняя безусловная
# пометка в туннель на месте для каждой сети дома. Усечение обнаруживается
# сразу, а не только когда счёт правил случайно разойдётся ещё раз.
#
# Отказ сборки теперь виден человеку без разбора лога: status печатает
# white_chain_ok=yes|no и white_chain_ok_reason=, а живая (прежняя рабочая)
# половина при отказе остаётся НЕТРОНУТОЙ — проверено тестом, который рвёт
# сборку неактивной половины посередине (фолт-инъекция в подделке iptables,
# TestWhiteHomeApplyAtomicNePortitZhivujuPriObryve) и убеждается, что прыжок
# и содержимое живой половины не изменились ни на строку.
[ -n "$MERIDIAN_ROUTE_STATUS_PROFILE" ] && echo "status_profile: -2_script_top $(awk '{print $1}' /proc/uptime 2>/dev/null)" >&2

VERSION="1.90"

CONF="${MERIDIAN_ROUTE_CONF:-/opt/etc/qwdtt/qwdtt.conf}"
LIST="${MERIDIAN_ROUTE_LIST:-/opt/etc/qwdtt/meridian-route.list}"
STATE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}"
LOG="${MERIDIAN_ROUTE_LOG:-/opt/var/log/meridian-route.log}"
HOOKDIR="${MERIDIAN_ROUTE_HOOKDIR:-/opt/etc/ndm/netfilter.d}"
HOOK="$HOOKDIR/50-meridian-route.sh"
# Периодика (1.6) — своя, не через сторож клиента. Крючки NDM на смену состояния
# интерфейса измерены 21.08.2026 и вычеркнуты из планов: ни один из пяти
# (ifcreated.d/ifdestroyed.d/ifstatechanged.d/iflayerchanged.d/ifipchanged.d) не
# сработал ни на down/up интерфейса, ни на его полное пересоздание при
# перезапуске клиента — ndmd не видит TUN, который создаёт не прошивка, а
# Go-процесс напрямую через netlink. Единственный факт, что маршрут вообще
# возвращался в бою (не в этом тестовом расположении) — сторож САМОГО КЛИЕНТА
# раз в 5 минут, и только из ветки, куда попадают после успешного пинга через
# туннель (пинг проходит и при пустой таблице 129 — то есть это не гарантия,
# а везение по побочному пути). Не полагаемся на чужой код и чужое расписание.
CRONFILE="${MERIDIAN_ROUTE_CRONFILE:-/opt/etc/crontabs/root}"
CRONMARK="meridian-route ensure"
# STOPFLAG больше НЕ ЧИТАЕТСЯ НИГДЕ. Оставлен объявлением намеренно, с этим
# комментарием: он показывает, что метка остановки нам известна и что решение
# её не использовать — сознательное, а не забытое. Различить по ней «человек
# выключил» и «идёт перезапуск» невозможно: restart это stop плюс start.
STOPFLAG="${MERIDIAN_ROUTE_STOPFLAG:-/opt/var/run/qwdtt.stopped}"
# RESTARTMARK — «идёт перезапуск»: ставит restart() init-скрипта, снимает start().
#
# Изнутри движка «человек выключил» и «идёт перезапуск» неразличимы: restart это
# stop плюс start, и на вход on-tunnel-down они дают одно событие. Значит признак
# обязан приходить ОТ ТОГО, КТО ИНИЦИИРУЕТ, и ставиться в одной точке: все пять
# клиентских путей остановки (init stop, init restart, qwdtt-ctl stop, кнопка
# панели, перезапуск панели) сходятся в stop() init-скрипта.
RESTARTMARK="${MERIDIAN_ROUTE_RESTARTMARK:-/opt/var/run/qwdtt.restarting}"
# Срок жизни признака. Замерено: restart() это `stop; sleep 2; start` —
# фиксированные 2 с плюс преамбула start (ensure_cron, rotate_log,
# route_check_sum, файловые операции); клиент добивается kill -9 и своей уборки
# не ждёт. 120 — порядка десяти запасов к любому правдоподобному значению на
# mips и одновременно ЖЁСТКИЙ предел беды: авария между stop и start (питание,
# зависший start) оставит дом в удержании максимум на две минуты, а не навсегда.
# Точное число для mips — замером на роутере, он в блоке.
RESTART_TTL="${MERIDIAN_ROUTE_RESTART_TTL:-120}"
RUNDIR="${MERIDIAN_ROUTE_RUNDIR:-/tmp/qwdtt-run}"
# СЧЁТЧИКИ ХОДОВ — В ОЗУ, НЕ НА ФЛЕШ. Отвечают на вопрос «а оно вообще
# вызывается», парный к ключам присутствия hook= и cron_line=.
HOOKRUNS="$RUNDIR/hookruns"
ENSURERUNS="$RUNDIR/ensureruns"
ARMEDPID="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.armed"
# Метка «про пустой список уже сказано»: крючок зовётся часто, и без подавления
# одна и та же строка ушла бы в лог на каждое сетевое событие (правило 21).
EMPTYMARK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.emptylist"
# Метка «про мёртвый crond уже сказано» — тем же приёмом. Периодика не может
# сообщить о своей смерти сама (если crond не работает, её просто никто не
# зовёт) — сообщает nf-reapply, у которого рабочий канал вызова (крючок
# netfilter) подтверждён живым.
CRONDEADMARK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.cronddead"
# Момент, с которого маршрут не работает (интерфейса нет), — unix-время внутри
# файла, а не просто факт его существования (в отличие от EMPTYMARK/CRONDEADMARK,
# здесь важно КОГДА, не только ЧТО). Пишется РОВНО ОДИН РАЗ, при переходе в
# состояние (cmd_ensure ниже) — переписывать его на каждом проходе значило бы,
# что длительность блокировки всегда ноль, а панели нечего показать про то,
# сколько это уже длится.
BLOCKEDMARK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.blocked_since"

# FALLBACKMARK — след автоматического отката. ОТДЕЛЬНЫЙ файл, а не поле в
# состоянии: state_set переписывает состояние целиком, и отметка стёрлась бы
# первым же `on`. А она обязана пережить и перезапуск движка, и перезапуск
# панели, и следующее включение — снимает её только человек.
#
# Зачем вообще: переход при откате МОЛЧАЛИВЫЙ. Пользователь теряет один пакет и
# не замечает, что трафик пошёл открытым каналом. Отметка — единственное, из
# чего панель может об этом сказать; логи для этого не годятся, разбор
# растущего файла на роутере с 248 МБ мы уже один раз оплатили памятью.
FALLBACKMARK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.fallback"
# OFFMARK — «прямо сейчас идёт снятие». Внутри pid снимающего процесса.
#
# Заведена 04.09.2026 вместо удаления крючка при `off`. Прежде крючок УДАЛЯЛСЯ,
# и после автоотката движок терял способность самовосстанавливаться — ровно
# после события, которое эту способность и требует. Удаление стояло не зря: без
# него крючок вернул бы правила прямо во время снятия. Но лечить это удалением
# файла — то же, что лечить пожар сносом дома: метка решает ту же задачу и
# ничего не ломает.
OFFMARK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.removing"
# АППАРАТНАЯ РАЗГРУЗКА KEENETIC. Две ручки ядра, обе по умолчанию в 1.
#
# 04.09.2026, роутер владельца, измерено: транзитные соединения дома замирали с
# обратным потоком ровно на packets=7 bytes=4036 (одно и то же число в двух
# разных соединениях), у всех стояли [FASTNAT] и [RTCACHE]. Собственные запросы
# роутера через тот же туннель проходили всегда — трафик роутера разгрузке не
# отдаётся. После обнуления обеих ручек: три curl подряд 1,38 / 0,24 / 0,24 с
# вместо 0,25 с и двух таймаутов по 15 с.
#
# Пути переопределяются переменными — стенду нужно подставить свои файлы, а
# вписанный намертво путь означал бы «проверено на живом роутере или никак».
# УПРАВЛЕНИЕ РАЗГРУЗКОЙ ВЫКЛЮЧЕНО ПО УМОЛЧАНИЮ. Это АВАРИЙНЫЙ ключ.
#
# Основной механизм — CONNMARK --save-mark в цепочках пометки (см. rules_apply):
# метка едет в записи conntrack, которую разгрузка и держит, поэтому выключать
# разгрузку не нужно. Так работает MagiTrickle, и так работало у нас до
# 04.09.2026, когда CONNMARK сняли — это и создало отказ.
#
# Почему выключено по умолчанию, хотя выключение разгрузки помогает: ручки
# ГЛОБАЛЬНЫЕ, они меняют настройку всего роутера клиента. Трогать её ради того,
# что решается своим правилом, — плохой размен.
#
# Включается явно: MERIDIAN_ROUTE_OFFLOAD=off в окружении или строкой
# OFFLOAD="off" в qwdtt.conf. Любое другое значение — не трогаем.
OFFLOAD_MANAGE="${MERIDIAN_ROUTE_OFFLOAD:-}"
FASTNAT_PATH="${MERIDIAN_ROUTE_FASTNAT:-/proc/sys/net/netfilter/nf_conntrack_fastnat}"
FASTROUTE_PATH="${MERIDIAN_ROUTE_FASTROUTE:-/proc/sys/net/netfilter/nf_conntrack_fastroute}"
# Прежние значения — рядом с состоянием движка. Возвращаем ЗАПОМНЕННОЕ, а не
# единицы: у клиента могло быть выключено и до нас.
OFFLOADSAVE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.offload"
# Метка «про неудавшуюся проверку уже сказано» — подавление повторов той же
# строки в логе (правило 21).
UNSUREMARK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.unsure"
# Путь к самому себе: он попадает в крючок NDM и в запуск сторожа, поэтому должен
# быть ФАКТИЧЕСКИМ, а не заученным. Берём $0, если он абсолютный и исполняемый;
# иначе — боевое умолчание. Прежняя жёсткая строка означала, что движок, запущенный
# из /tmp, вписывал в крючок несуществующий /opt/bin/meridian-route, и крючок молча
# выходил по проверке -x: «0 восстановлений» на исправном крючке.
# Относительный путь разбираем отдельно: прогон зовёт движок именно так —
# `./meridian-route`. В 1.1 такая ветка уходила в боевое умолчание, и это било
# дважды: в крючок попадал несуществующий путь (блок 6 показал бы «0
# восстановлений» на исправном крючке), а сторож предохранителя, который
# запускается как «$SELF _armed», НЕ СТАРТОВАЛ ВООБЩЕ. То есть движок печатал
# «подтверди за N секунд, иначе всё снимется само» — и это была неправда.
case "$0" in
	/*)   C="$0" ;;
	./*)  C="$(pwd)/${0#./}" ;;   # без ./ в середине: путь идёт в крючок и в лог
	*/*)  C="$(pwd)/$0" ;;
	*)    C="" ;;      # найден через PATH — доверять нельзя, берём боевое умолчание
esac
if [ -n "$C" ] && [ -x "$C" ]; then SELF_DEFAULT="$C"; else SELF_DEFAULT="/opt/bin/meridian-route"; fi
SELF="${MERIDIAN_ROUTE_SELF:-$SELF_DEFAULT}"

# SELFNAME — по чему узнаём СВОЙ процесс в /proc/PID/cmdline. Не полный путь:
# нас зовут и как /opt/bin/meridian-route, и из крючка, и из периодики, и путь
# в командной строке бывает разным. Имя файла — то общее, что есть всегда.
SELFNAME="${MERIDIAN_ROUTE_SELFNAME:-$(basename "$SELF")}"

# Числа — умолчания В КОДЕ. В qwdtt.conf они не пишутся никогда: явное значение
# в конфиге приколачивает роутер к сегодняшнему умолчанию навсегда, и при смене
# умолчания такой роутер молча останется на прежнем поведении (правило 17).
MARK="0x1c9"
MASK="0x1ff"
TABLE="129"
PREF_TUN="1000"
PREF_HOLD="1001"
SET="meridian_dst4"
SETNEW="meridian_dst4_new"
CH_MARK="MERIDIAN_MARK"
CH_MSS="MERIDIAN_MSS"
# КЛЭМП ДЛЯ ТРАФИКА, РОЖДЁННОГО НА РОУТЕРЕ. Отдельная цепочка, а не второй
# прыжок на общую: общая суммирует счётчики со всех входов и потому не может
# ответить, работает ли клэмп именно здесь.
CH_MSS_LOCAL="${MERIDIAN_ROUTE_MSSLOCALCHAIN:-MERIDIAN_MSS_LOCAL}"
CH_FWD="MERIDIAN_FWD"
CONFIRM_DEFAULT="120"
IFACE_WAIT="120"       # сколько ждём появления интерфейса в on-tunnel-up, секунд
LOG_MAX="131072"       # потолок лога: 128 КБ + ровно один прошлый (правило 21)

# --------------------------------------------------------------------------
# Лог: потолок и ровно один прошлый файл. Без потолка лог — это утечка памяти,
# просто отложенная: на Keenetic /tmp и /opt делят одни и те же 254 МБ.
# --------------------------------------------------------------------------
log() {
	mkdir -p "$(dirname "$LOG")" 2>/dev/null
	if [ -f "$LOG" ]; then
		SZ=$(wc -c < "$LOG" 2>/dev/null || echo 0)
		[ "$SZ" -gt "$LOG_MAX" ] 2>/dev/null && mv -f "$LOG" "$LOG.1" 2>/dev/null
	fi
	echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG" 2>/dev/null
}

say() { echo "$*"; }
fail() { say "$*"; log "ОТКАЗ: $*"; exit 1; }

have() { command -v "$1" >/dev/null 2>&1; }

# run_bounded <секунды> <команда...> — СВОЙ ПРЕДЕЛ ПО ВРЕМЕНИ НА ЛЮБОЙ
# ВНЕШНИЙ ВЫЗОВ (владелец, 21.09.2026, живой роутер: ensure в белом режиме
# завис и не вернулся за 30 с, оборвано вручную; meridian-dns status не
# отвечал). НА ЭТОМ РОУТЕРЕ КОМАНДЫ timeout НЕТ (BusyBox без апплета) —
# подтверждено владельцем, полагаться нельзя. Без нативного timeout — фон +
# опрос + kill, ТА ЖЕ СХЕМА, что владелец применил в живой диагностике: не
# успело — kill -9, код 124 (тот же, что дал бы настоящий timeout, чтобы
# вызывающему коду было всё равно, какой из двух путей сработал).
#
# ОПРОС ЦЕЛЫМИ СЕКУНДАМИ: минимальный BusyBox sleep дробных не берёт, а
# здесь важен сам предел, не его точность до миллисекунды.
#
# Инвариант владельца, записан дословно: периодическая задача без замка и
# без предела по времени — это не периодика, а накопитель процессов.
run_bounded() {
	_rb_sec="$1"; shift
	if have timeout; then
		timeout "$_rb_sec" "$@"
		return $?
	fi
	mkdir -p "$RUNDIR" 2>/dev/null
	_rb_out="$RUNDIR/run_bounded.$$"
	"$@" > "$_rb_out" 2>&1 &
	_rb_pid=$!
	_rb_i=0
	while kill -0 "$_rb_pid" 2>/dev/null; do
		_rb_i=$((_rb_i + 1))
		if [ "$_rb_i" -ge "$_rb_sec" ]; then
			kill -9 "$_rb_pid" 2>/dev/null
			wait "$_rb_pid" 2>/dev/null
			cat "$_rb_out" 2>/dev/null
			rm -f "$_rb_out" 2>/dev/null
			return 124
		fi
		sleep 1
	done
	wait "$_rb_pid" 2>/dev/null
	_rb_rc=$?
	cat "$_rb_out" 2>/dev/null
	rm -f "$_rb_out" 2>/dev/null
	return $_rb_rc
}

# --------------------------------------------------------------------------
# ЗАМОК НА ОДИН ensure (владелец, 21.09.2026, живой роутер: крон зовёт
# ensure раз в минуту, а зависший вызов не отдаёт место следующему —
# процессы копятся быстрее, чем крон успевает их плодить). ИНВАРИАНТ,
# ЗАПИСАН ДОСЛОВНО: периодическая задача без замка и без предела по
# времени — это не периодика, а накопитель процессов.
#
# ПРЕДПОЧИТАЕМ flock, ЕСЛИ ЕСТЬ (ПРОВЕРЯЕТСЯ, не предполагается — тот же
# приём, что у IPTW и timeout выше): атомарен по построению, гонки между
# проверкой pid и его записью нет вовсе. БЕЗ flock — pid-файл с проверкой
# живости; окно гонки короче минуты между двумя ensure, а не исключено
# структурно, но лучше, чем ничего.
ENSURELOCK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.ensurelock"
ENSURE_HAVE_FLOCK=""
ensure_lock_acquire() {
	mkdir -p "$(dirname "$ENSURELOCK")" 2>/dev/null
	if have flock; then
		ENSURE_HAVE_FLOCK=1
		# БЕЗ `2>/dev/null` НА ЭТОЙ СТРОКЕ — И ЭТО НЕ НЕБРЕЖНОСТЬ. `exec N>файл`
		# БЕЗ КОМАНДЫ — особая форма POSIX: перенаправления в НЕЙ ПРИМЕНЯЮТСЯ
		# К ТЕКУЩЕЙ ОБОЛОЧКЕ НАВСЕГДА, а не только к этой строке. `2>/dev/null`
		# здесь означало бы не «подавить ошибку открытия fd 9», а «закрыть
		# STDERR ДВИЖКА ДО КОНЦА ЭТОГО ЗАПУСКА» — что и произошло: диагностика
		# gw_read_addrs (>&2) молчала НЕ ПОТОМУ, ЧТО ЕЁ НЕ БЫЛО, а потому что
		# stderr был перенаправлен в /dev/null задолго до неё. Найдено на
		# тесте, который якобы сломался без всякой связи с этой правкой —
		# связь была, просто на два экрана ниже по коду.
		exec 9>"$ENSURELOCK.flock" || return 1
		flock -n 9 2>/dev/null || return 1
		return 0
	fi
	if [ -f "$ENSURELOCK" ]; then
		_el_pid=$(cat "$ENSURELOCK" 2>/dev/null)
		case "$_el_pid" in
			''|*[!0-9]*) : ;;
			*) kill -0 "$_el_pid" 2>/dev/null && return 1 ;;
		esac
	fi
	echo $$ > "$ENSURELOCK" 2>/dev/null
	return 0
}
# ensure_lock_release — с flock замок снимается закрытием fd 9 (выход
# процесса делает это сам); файл-замок можно не убирать, его СУЩЕСТВОВАНИЕ
# не значит «занято» — занятость только в самом замке ядра. Без flock —
# свой pid-файл убираем сами.
ensure_lock_release() {
	[ -n "$ENSURE_HAVE_FLOCK" ] && return 0
	rm -f "$ENSURELOCK" 2>/dev/null
}

# conf_value KEY — достать значение из qwdtt.conf БЕЗ его подключения.
# Подключать боевой конфиг через «.» нельзя: «.» — спец-встроенная команда, и её
# неудача гасит неинтерактивную оболочку целиком, причём молча (правило 31).
conf_value() {
	[ -f "$CONF" ] || return 1
	sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*[\"']\{0,1\}\([^\"'#]*\).*/\1/p" "$CONF" \
		| tail -1 | sed 's/[[:space:]]*$//'
}

tun_name() {
	T=$(conf_value RAW_TUN 2>/dev/null)
	[ -n "$T" ] || T="meridian"
	echo "$T"
}

# wan_iface — интерфейс маршрута по умолчанию, КРОМЕ туннеля. ОДНО МЕСТО
# (правило 51, владелец 21.09.2026): до 1.71 этот же awk был вписан только
# внутри home_nets_klass(), а датчику selfdns_wan/selfdns_tun (шаг 11,
# MERIDIAN_SELFDNS_IFACE) нужен тот же факт — вынесено сюда, второй копии
# не заводим.
wan_iface() {
	ip -4 route show default 2>/dev/null | awk -v t="$(tun_name)" '{ for (i=1;i<=NF;i++) if ($i=="dev" && $(i+1)!=t) { print $(i+1); exit } }'
}

# Адрес транспорта: из RAW_PEER, иначе из PEER. Нужен, чтобы не дать человеку
# внести в список адрес, через который держится сам туннель.
peer_host() {
	P=$(conf_value RAW_PEER 2>/dev/null)
	[ -n "$P" ] || P=$(conf_value PEER 2>/dev/null)
	echo "$P" | cut -d: -f1
}

