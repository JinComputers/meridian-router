STATUS_HAVE_FLOCK=""
statuslock_acquire() {
	if have flock; then
		STATUS_HAVE_FLOCK=1
		exec 8>"$STATUSLOCK.flock" || return 1
		flock -n 8 2>/dev/null || return 1
		return 0
	fi
	if [ -f "$STATUSLOCK" ]; then
		_sl_pid=$(cat "$STATUSLOCK" 2>/dev/null)
		case "$_sl_pid" in
			''|*[!0-9]*) : ;;
			*) kill -0 "$_sl_pid" 2>/dev/null && return 1 ;;
		esac
	fi
	echo $$ > "$STATUSLOCK" 2>/dev/null
	return 0
}
statuslock_wait_or_takeover() {
	if have flock; then
		STATUS_HAVE_FLOCK=1
		exec 8>"$STATUSLOCK.flock" || return 1
		flock -w "$STATUS_WAIT_MAX" 8 2>/dev/null && return 0
		return 1
	fi
	_sw=0
	while [ "$_sw" -lt "$STATUS_WAIT_MAX" ]; do
		if [ -f "$STATUSLOCK" ]; then
			_sl_pid=$(cat "$STATUSLOCK" 2>/dev/null)
			case "$_sl_pid" in
				''|*[!0-9]*) echo $$ > "$STATUSLOCK" 2>/dev/null; return 0 ;;
				*) kill -0 "$_sl_pid" 2>/dev/null || { echo $$ > "$STATUSLOCK" 2>/dev/null; return 0; } ;;
			esac
		else
			echo $$ > "$STATUSLOCK" 2>/dev/null
			return 0
		fi
		sleep 1
		_sw=$((_sw + 1))
	done
	return 1
}
statuslock_release() {
	[ -n "$STATUS_HAVE_FLOCK" ] && return 0
	rm -f "$STATUSLOCK" 2>/dev/null
}
cmd_status() {
	if [ "${1:-}" != "--cache" ]; then
		_sc_out=$(cmd_status_compute)
