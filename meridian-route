	ver_ge "$_drs_v" "$DNSPOOLMINVER"
}
dns_server_pid() {
	[ -f "$DNSPIDFILE" ] || return 1
	_dsp=$(cat "$DNSPIDFILE" 2>/dev/null)
	case "$_dsp" in ''|*[!0-9]*) return 1 ;; esac
	[ -d "/proc/$_dsp" ] || return 1
	_dsc=$(tr '\0' ' ' < "/proc/$_dsp/cmdline" 2>/dev/null)
	[ -n "$_dsc" ] || return 1
	if [ "$(printf '%s' "$_dsc" | awk '{print $NF}')" != "run" ]; then
		log "selfdns_pool_reset: pid $_dsp из $DNSPIDFILE — cmdline не оканчивается на «run» ($(dns_cmdline_redacted "$_dsc")), не трогаю"
