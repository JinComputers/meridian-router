valid_cidr() {
	printf '%s\n' "$1" | awk -F'[./]' '
		{
			if (NF != 4 && NF != 5) exit 1
			for (i = 1; i <= 4; i++) {
				if ($i !~ /^[0-9]+$/) exit 1
				if ($i + 0 > 255) exit 1
				if (length($i) > 1 && substr($i,1,1) == "0") exit 1
			}
			if (NF == 5) {
				if ($5 !~ /^[0-9]+$/) exit 1
				if ($5 + 0 < 8 || $5 + 0 > 32) exit 1
			}
			exit 0
		}'
}
cidr_contains() {
	printf '%s %s\n' "$1" "$2" | awk '
		function toi(s,  p) { split(s, p, "."); return ((p[1]*256+p[2])*256+p[3])*256+p[4] }
		{
			n = $1; a = $2
			slash = index(n, "/")
			if (slash > 0) { pfx = substr(n, slash+1) + 0; net = substr(n, 1, slash-1) }
			else { pfx = 32; net = n }
			if (pfx == 0) { m = 0 } else { m = 4294967295 - (2 ^ (32 - pfx) - 1) }
			ni = toi(net); ai = toi(a)
			# and() есть не во всех awk, поэтому маскируем вычитанием остатка
			if (int(ni / (2 ^ (32 - pfx))) == int(ai / (2 ^ (32 - pfx)))) exit 0
			exit 1
		}'
}
forbidden_reason() {
	E="$1"
	A=${E%%/*}
	O1=$(echo "$A" | cut -d. -f1)
	O2=$(echo "$A" | cut -d. -f2)
	case "$O1" in
		0)   echo "0.0.0.0/8 — «этот сеть», такого назначения не бывает"; return ;;
		10)  echo "частная сеть 10/8 — это локалка, в туннель её нельзя"; return ;;
		127) echo "127/8 — сам роутер"; return ;;
	esac
	[ "$O1" = "192" ] && [ "$O2" = "168" ] && { echo "частная сеть 192.168/16 — это локалка"; return; }
	[ "$O1" = "169" ] && [ "$O2" = "254" ] && { echo "169.254/16 — служебные адреса канала"; return; }
	if [ "$O1" = "172" ] && [ "$O2" -ge 16 ] 2>/dev/null && [ "$O2" -le 31 ] 2>/dev/null; then
		echo "частная сеть 172.16/12 — это локалка"; return
	fi
	if [ "$O1" -ge 224 ] 2>/dev/null; then
		echo "224.0.0.0/4 и выше — многоадресные и зарезервированные"; return
	fi
	PH=$(peer_host)
	if [ -n "$PH" ] && cidr_contains "$E" "$PH"; then
		echo "покрывает адрес шлюза $PH — туннель зарубит сам себя (рекурсия)"; return
	fi
	echo ""
}
list_scan() {
	_ls_ph=$(peer_host)
	awk -v PH="$_ls_ph" '
		function toi(s,  p) { split(s, p, "."); return ((p[1]*256+p[2])*256+p[3])*256+p[4] }
		function contains(e, a,  sl, pf, nt) {
			sl = index(e, "/")
			if (sl > 0) { pf = substr(e, sl+1) + 0; nt = substr(e, 1, sl-1) } else { pf = 32; nt = e }
			return int(toi(nt) / (2 ^ (32 - pf))) == int(toi(a) / (2 ^ (32 - pf)))
		}
		function valid(l,  f, n, i) {
			n = split(l, f, /[.\/]/)
			if (n != 4 && n != 5) return 0
			for (i = 1; i <= 4; i++) {
				if (f[i] !~ /^[0-9]+$/) return 0
				if (f[i] + 0 > 255) return 0
				if (length(f[i]) > 1 && substr(f[i],1,1) == "0") return 0
			}
			if (n == 5) {
				if (f[5] !~ /^[0-9]+$/) return 0
				if (f[5] + 0 < 8 || f[5] + 0 > 32) return 0
			}
			return 1
		}
		function forb(e,  a, o, o1, o2) {
			a = e; sub(/\/.*/, "", a)
			split(a, o, "."); o1 = o[1]; o2 = o[2]
			if (o1 == "0")   return "0.0.0.0/8 — «этот сеть», такого назначения не бывает"
			if (o1 == "10")  return "частная сеть 10/8 — это локалка, в туннель её нельзя"
			if (o1 == "127") return "127/8 — сам роутер"
			if (o1 == "192" && o2 == "168") return "частная сеть 192.168/16 — это локалка"
			if (o1 == "169" && o2 == "254") return "169.254/16 — служебные адреса канала"
			if (o1 == "172" && o2 + 0 >= 16 && o2 + 0 <= 31) return "частная сеть 172.16/12 — это локалка"
			if (o1 + 0 >= 224) return "224.0.0.0/4 и выше — многоадресные и зарезервированные"
			if (PH != "" && contains(e, PH)) return "покрывает адрес шлюза " PH " — туннель зарубит сам себя (рекурсия)"
			return ""
		}
		BEGIN { n = 0 }
		{
			l = $0
			sub(/#.*/, "", l)
			sub(/^[[:space:]]+/, "", l); sub(/[[:space:]]+$/, "", l)
			if (l == "") next
			if (!valid(l)) { gsub(/\t/, " ", l); print "B\tv\t" l "\t"; next }
			r = forb(l)
			if (r != "") { print "B\tf\t" l "\t" r; next }
			n++
		}
		END { print "N\t" n }' "$@" 2>/dev/null
}
list_check() {
	N=0; BAD=0
	if [ ! -f "$LIST" ]; then
		say "файла списка нет ($LIST) — считаю, что адресов ноль; решать будут доменные группы"
	fi
	_lc_out=$(list_scan "${LIST:-/dev/null}")
	N=0; BAD=0
	_lc_tab=$(printf '\t')
	while IFS="$_lc_tab" read -r _lc_t _lc_k _lc_l _lc_r; do
		case "$_lc_t" in
			N) N="$_lc_k" ;;
			B)
				if [ "$_lc_k" = "v" ]; then
					say "строка не адрес и не подсеть: «$_lc_l»"
				else
					say "нельзя «$_lc_l»: $_lc_r"
				fi
				BAD=$((BAD+1)) ;;
		esac
	done <<LCEOF
$_lc_out
LCEOF
	if [ "$BAD" -gt 0 ]; then
		say "в списке $BAD негодных строк — не применяю НИЧЕГО"
		return 1
	fi
	if [ "$N" -eq 0 ]; then
		_grupp=$(dns_set_count)
		_zapisej=$(dns_entry_count)
		if [ "$_grupp" -eq 0 ] 2>/dev/null; then
			say "включать нечего: адресов в списке 0, доменных групп с пометкой 0"
			say "  Добавить адрес: $0 list add <адрес|подсеть>"
			say "  Либо включить доменную группу в панели — её наборы наполняет сервер DNS."
			return 1
		fi
		if [ "$_zapisej" -eq 0 ] 2>/dev/null; then
			say "адресов 0; доменных групп с пометкой $_grupp, но записей в их наборах пока 0 —"
			say "  включаюсь: наборы наполнит сервер DNS при первом же запросе, а без движка"
			say "  наполнение ничего не даст (ни ip rule, ни таблицы)."
		else
			say "список адресов пуст, но есть доменные группы ($_grupp, записей $_zapisej) — включаюсь ради них"
		fi
	fi
	echo "$N" > /dev/null
	return 0
}
