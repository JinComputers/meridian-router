KEEPSET="${MERIDIAN_ROUTE_KEEPSET:-meridian_keep4}"

# --------------------------------------------------------------------------
# БЕЛЫЙ РЕЖИМ, ОГРАНИЧЕННЫЙ ОДНИМ АДРЕСОМ ИСТОЧНИКА (white-test)
#
# Зачем отдельным слоем, а не правками в MERIDIAN_MARK. Той цепочкой владеет
# ensure: раз в минуту он сверяет её со своим списком и снимает всё лишнее как
# «лишнюю копию». Наши правила прожили бы там до первой периодики — это первое,
# что сломалось бы. Поэтому своя цепочка со своим прыжком; ensure про неё не
# знает и не трогает, потому что ходит только по трём своим.
#
# АВТОВОССТАНОВЛЕНИЯ У СЛОЯ НЕТ НАМЕРЕННО. Ни крючок NDM, ни периодика его не
# возвращают. Прошивка пересобрала правила — слой исчез, и это правильное
# поведение: неподтверждённый опытный слой не имеет права возвращаться сам.
# Тот же принцип, что у confirmed=no.
#
# ЦЕНА ОШИБКИ ОГРАНИЧЕНА ОДНИМ УСТРОЙСТВОМ: правила начинаются с -s <адрес>,
# и весь остальной дом остаётся в чёрном режиме.
WHITECHAIN="${MERIDIAN_ROUTE_WHITECHAIN:-MERIDIAN_WHITE}"
# Временная цепочка для построения ЭТАЛОНА тем же путём, что и боевая.
WHITECHAIN_CHK="${WHITECHAIN}_CHK"
DIRECTSET="${MERIDIAN_ROUTE_DIRECTSET:-meridian_direct4}"
# ИМЯ НАБОРА ДОМЕНОВ — НЕ ЗАШИТО (договор с котом 2). Кэш последнего
