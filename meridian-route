LAST_LOAD_MS=""
_uptime_cs() {
	_UTCS=""; _ut=""; { read -r _ut _ < /proc/uptime; } 2>/dev/null
	case "$_ut" in *.[0-9][0-9]) : ;; *) return ;; esac
	_ut_f=${_ut#*.}; _ut_f=${_ut_f#0}
	_UTCS=$(( ${_ut%.*} * 100 + _ut_f ))
}
set_load() {
	_uptime_cs; T0=$_UTCS
	ipset destroy "$SETNEW" 2>/dev/null
	{
		echo "create $SETNEW hash:net family inet"
		list_clean | sort -u | sed "s|^|add $SETNEW |"
		echo "create $SET hash:net family inet"
		echo "swap $SETNEW $SET"
		echo "destroy $SETNEW"
	} | ipset -exist restore 2>/dev/null || {
		ipset destroy "$SETNEW" 2>/dev/null
		return 1
	}
	_uptime_cs; T1=$_UTCS
	LAST_LOAD_MS=""
	[ -n "$T0" ] && [ -n "$T1" ] && LAST_LOAD_MS=$(( (T1 - T0) * 10 ))
	return 0
}
