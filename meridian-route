ru_snimki_proverit() {
	[ -f "$RU_RANGES_FILE" ] || { echo "нет файла $RU_RANGES_FILE"; return 1; }
	[ -f "$RU_DOMAINS_FILE" ] || { echo "нет файла $RU_DOMAINS_FILE"; return 1; }
	have sha256sum || { echo "нет sha256sum — сверить снимки нечем"; return 1; }
	ru_sha_ok "$RU_RANGES_FILE" "$RU_RANGES_SHA" || { echo "сумма $RU_RANGES_FILE не совпала с зашитой в движок — чужой файл не гружу"; return 1; }
	ru_sha_ok "$RU_DOMAINS_FILE" "$RU_DOMAINS_SHA" || { echo "сумма $RU_DOMAINS_FILE не совпала с зашитой в движок — чужой файл не гружу"; return 1; }
	return 0
}
set_count() {
	ipset list "$1" 2>/dev/null | awk '/^Members:/ { m = 1; next } m { n++ } END { print n + 0 }'
}
ru_ranges_load() {
	_rrl_want=$(grep -v '^#' "$RU_RANGES_FILE" 2>/dev/null | grep -c .)
	ipset destroy "$RUSETNEW" 2>/dev/null
	{
		echo "create $RUSETNEW hash:net family inet maxelem 65536"
		sed -n '/^#/d; /./s|^|add '"$RUSETNEW"' |p' "$RU_RANGES_FILE"
		echo "create $RUSET hash:net family inet maxelem 65536 -exist"
		echo "swap $RUSETNEW $RUSET"
		echo "destroy $RUSETNEW"
	} | ipset restore 2>/dev/null || {
		ipset destroy "$RUSETNEW" 2>/dev/null
		echo "ipset не принял снимок $RU_RANGES_FILE"
		return 1
	}
	_rrl_have=$(set_count "$RUSET")
	[ "$_rrl_have" = "$_rrl_want" ] || { echo "в наборе $RUSET записей $_rrl_have, в снимке $_rrl_want"; return 1; }
	echo "$_rrl_have" > "$RULOADED" 2>/dev/null
	return 0
}
ru_dns_on() {
	[ -x "$DNSBIN" ] || { echo "нет $DNSBIN — домены не включены"; return 1; }
	run_bounded 15 "$DNSBIN" ru-direct on "$RU_DOMAINS_FILE" >/dev/null 2>&1 || {
		echo "meridian-dns не подтвердил ru-direct on (нужен meridian-dns 0.38 и выше) — домены не включены"
		return 1
	}
	: > "$RUDNSMARK" 2>/dev/null
	return 0
}
ru_ubrat_nabory() {
	if [ -f "$RUDNSMARK" ]; then
		[ -x "$DNSBIN" ] && run_bounded 15 "$DNSBIN" ru-direct off >/dev/null 2>&1
		rm -f "$RUDNSMARK" 2>/dev/null
	fi
	off_nado_set "$RUDNSSET" && set_exists "$RUDNSSET" && ipset destroy "$RUDNSSET" 2>/dev/null
	off_nado_set "$RUSET"    && ipset destroy "$RUSET" 2>/dev/null
	off_nado_set "$RUSETNEW" && ipset destroy "$RUSETNEW" 2>/dev/null
	[ -e "$RULOADED" ] && rm -f "$RULOADED" 2>/dev/null
	return 0
}
ru_prigotovit() {
	_rp=$(ru_snimki_proverit) || { ru_reason_set "снимок не загружен: $_rp"; ru_ubrat_nabory; return 1; }
	_rpd="$RUNDIR/rudns_on.$$"
	rm -f "$_rpd" 2>/dev/null
	( if _o=$(ru_dns_on); then echo "0 $_o"; else echo "1 $_o"; fi > "$_rpd" 2>/dev/null ) &
	_rpd_pid=$!
	_rp=$(ru_ranges_load) || {
		wait "$_rpd_pid" 2>/dev/null
		rm -f "$_rpd" 2>/dev/null
		ru_reason_set "снимок не загружен: $_rp"; ru_ubrat_nabory; return 1
	}
	wait "$_rpd_pid" 2>/dev/null
	_rpd_l=""
	{ read -r _rpd_l < "$_rpd"; } 2>/dev/null
	rm -f "$_rpd" 2>/dev/null
	case "$_rpd_l" in
		"0 "*|0) ru_reason_set "" ;;
		"1 "*) ru_reason_set "${_rpd_l#1 }" ;;
		*) ru_reason_set "не узнал исход ru-direct on" ;;
	esac
	return 0
}
white_home_ru_v_cepochke() {
	_hrc=$(white_home_active_chain) || return 1
	ipt -S "$_hrc" 2>/dev/null | grep -qF -- "--match-set $RUSET dst -j RETURN"
}
ru_vne_cepochek() {
	_rvc=$(white_home_inactive_chain)
	[ -n "$_rvc" ] && chain_exists "$_rvc" && ipt -F "$_rvc" 2>/dev/null
	return 0
}
cmd_ru_direct() {
	case "${1:-}" in
		on)     ru_cmd_on ;;
		off)    ru_cmd_off ;;
		status) ru_status_lines ;;
		*)      echo "usage: $0 ru-direct on | off | status" >&2; return 2 ;;
	esac
}
ru_cmd_on() {
	_ron=$(ru_snimki_proverit) || { echo "ОТКАЗ: $_ron" >&2; return 1; }
	ru_flag_set on
	if ! white_home_on; then
		log "ru-direct включён (режим $(state_get mode): действует только в белом)"
		say "RU-адреса напрямую включены. Действуют в белом режиме; сейчас режим $(state_get mode) — ничего не меняется."
		return 0
	fi
	if ! ru_prigotovit; then
		_ron=$(ru_reason_get)
		ru_flag_set off
		ru_reason_set ""
		echo "ОТКАЗ: $_ron" >&2
		return 1
	fi
	if ! white_home_apply; then
		ru_flag_set off
		white_home_apply >/dev/null 2>&1
		ru_vne_cepochek
		ru_ubrat_nabory
		ru_reason_set ""
		echo "ОТКАЗ: белая цепочка не пересобралась с RU-исключениями — слой снят, режим прежний" >&2
		return 1
	fi
	log "ru-direct включён в белом режиме: адресов $(cat "$RULOADED" 2>/dev/null)"
	_ron=$(ru_reason_get)
	say "RU-адреса напрямую включены: российские адреса и домены идут мимо туннеля.${_ron:+ ВНИМАНИЕ: $_ron}"
	return 0
}
ru_cmd_off() {
	ru_flag_set off
	ru_reason_set ""
	if white_home_on; then
		white_home_apply || { echo "ОТКАЗ: белая цепочка не пересобралась без RU-исключений" >&2; return 1; }
		ru_vne_cepochek
	fi
	ru_ubrat_nabory
	log "ru-direct выключен"
	say "RU-адреса напрямую выключены."
	return 0
}
ru_status_lines() {
	_rsm=$(state_get mode)
	_ra=no
	if ru_flag_on; then
		echo "ru_direct=on"
		if [ "$_rsm" = "white" ]; then
			_rr=$(ru_reason_get)
			if set_exists "$RUSET" && white_home_ru_v_cepochke; then
				_ra=yes
				_rp="действует в белом режиме${_rr:+; $_rr}"
			else
				_rp="${_rr:-снимок не загружен: набора $RUSET нет или его правила нет в белой цепочке}"
			fi
		elif [ "$_rsm" = "black" ]; then
			_rp="чёрный режим: и так мимо туннеля"
		else
			_rp="режим выключен: слой не действует"
		fi
	else
		echo "ru_direct=off"
		_rp="выключено"
	fi
	echo "ru_direct_active=$_ra"
	echo "ru_direct_pochemu=$_rp"
	_rrc=0
	if set_exists "$RUSET" && [ -f "$RULOADED" ]; then
		{ read -r _rrc < "$RULOADED"; } 2>/dev/null
		case "$_rrc" in ''|*[!0-9]*) _rrc=$(set_count "$RUSET") ;; esac
	fi
	echo "ru_ranges_count=$_rrc"
	echo "ru_ranges_sha=$RU_RANGES_SHA"
	_rdc=""
	[ -f "$RUDNSMARK" ] && _rdc=$(dns_status_cache_field ru_direct_domains_running 2>/dev/null)
	case "$_rdc" in
		''|*[!0-9]*) if [ -f "$RUDNSMARK" ]; then _rdc=$(grep -v '^#' "$RU_DOMAINS_FILE" 2>/dev/null | grep -c .); else _rdc=0; fi ;;
	esac
	echo "ru_domains_count=$_rdc"
	if set_exists "$RUDNSSET"; then echo "ru_dns_set_count=$(set_count "$RUDNSSET")"; else echo "ru_dns_set_count=0"; fi
}
white_home_on() { [ "$(state_get mode)" = "white" ]; }
white_home_rules() {
	_whr_chain="${1:?white_home_rules: нужна цепочка-получатель}"
	_whr_ru=""
	if ru_flag_on; then
		for _whr_s in "$RUSET" "$RUDNSSET"; do
			set_exists "$_whr_s" && _whr_ru="$_whr_ru $_whr_s"
		done
	fi
	_whr_kd=$(keep_dns 2>/dev/null)
	_whr_dd=""
	for _hdds in $(dns_direct_sets); do
		set_exists "$_hdds" && _whr_dd="$_whr_dd $_hdds"
	done
	for _hn in $(home_nets); do
		for _hr in $_whr_kd; do
			echo "-A $_whr_chain -s $_hn -d $_hr -j MARK --set-xmark $MARK/$MASK"
			echo "-A $_whr_chain -s $_hn -d $_hr -j RETURN"
		done
		echo "-A $_whr_chain -s $_hn -m conntrack --ctdir REPLY -j MARK --set-xmark 0x0/$MASK"
		echo "-A $_whr_chain -s $_hn -m conntrack --ctdir REPLY -j RETURN"
		echo "-A $_whr_chain -s $_hn -m set --match-set $KEEPSET dst -j MARK --set-xmark 0x0/$MASK"
		echo "-A $_whr_chain -s $_hn -m set --match-set $KEEPSET dst -j RETURN"
		echo "-A $_whr_chain -s $_hn -m set --match-set $DIRECTSET dst -j MARK --set-xmark 0x0/$MASK"
		echo "-A $_whr_chain -s $_hn -m set --match-set $DIRECTSET dst -j RETURN"
		for _hdds in $_whr_dd; do
			echo "-A $_whr_chain -s $_hn -m set --match-set $_hdds dst -j MARK --set-xmark 0x0/$MASK"
			echo "-A $_whr_chain -s $_hn -m set --match-set $_hdds dst -j RETURN"
		done
		for _whr_s in $_whr_ru; do
			echo "-A $_whr_chain -s $_hn -m set --match-set $_whr_s dst -j MARK --set-xmark 0x0/$MASK"
			echo "-A $_whr_chain -s $_hn -m set --match-set $_whr_s dst -j RETURN"
		done
		echo "-A $_whr_chain -s $_hn -j MARK --set-xmark $MARK/$MASK"
		echo "-A $_whr_chain -s $_hn -j CONNMARK --save-mark --nfmask $MASK --ctmask $MASK"
	done
}
white_home_build_chain() {
	_whbc_chain="$1"
	ipt -N "$_whbc_chain" 2>/dev/null
	ipt -F "$_whbc_chain" 2>/dev/null
	if have iptables-restore; then
		mkdir -p "$RUNDIR" 2>/dev/null
		_whbc_tmp="$RUNDIR/whbc.$$"
		{
			echo "*mangle"
			echo ":$_whbc_chain - [0:0]"
			white_home_rules "$_whbc_chain"
			echo "COMMIT"
		} > "$_whbc_tmp" 2>/dev/null
		run_bounded 5 iptables-restore --noflush "$_whbc_tmp" >/dev/null 2>&1
		_whbc_rc=$?
		rm -f "$_whbc_tmp" 2>/dev/null
		[ "$_whbc_rc" = 0 ] && return 0
		ipt -F "$_whbc_chain" 2>/dev/null
	fi
	white_home_rules "$_whbc_chain" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
}
white_home_apply() {
	_wha_target=$(white_home_inactive_chain)
	white_home_build_chain "$_wha_target"
	white_home_build_chain "$WHITEHOMECHAIN_CHK"
	_wh_want=$(ipt -S "$WHITEHOMECHAIN_CHK" 2>/dev/null | grep -v "^-N " | sed "s/^-A $WHITEHOMECHAIN_CHK /-A ЦЕПОЧКА /")
	_wh_have=$(ipt -S "$_wha_target" 2>/dev/null | grep -v "^-N " | sed "s/^-A $_wha_target /-A ЦЕПОЧКА /")
	ipt -F "$WHITEHOMECHAIN_CHK" 2>/dev/null
	ipt -X "$WHITEHOMECHAIN_CHK" 2>/dev/null
	if [ -z "$_wh_want" ] || [ "$_wh_want" != "$_wh_have" ]; then
		say "ОТКАЗ: сборка $_wha_target разошлась с образцом — ЖИВАЯ цепочка не тронута."
		say "ждали:"; printf '%s\n' "$_wh_want" | sed 's/^/    /'
		say "получилось:"; printf '%s\n' "$_wh_have" | sed 's/^/    /'
		state_set_white_chain_ok no "сборка $_wha_target разошлась с образцом"
		return 1
	fi
	_wha_active=$(white_home_active_chain)
	if [ -z "$_wha_active" ]; then
		ipt -A PREROUTING -j "$_wha_target" 2>/dev/null
		ipt -C PREROUTING -j "$_wha_target" 2>/dev/null || {
			say "ОТКАЗ: прыжок на $_wha_target не встал."
			state_set_white_chain_ok no "первый прыжок не встал"
			return 1
		}
	else
		_wha_pos=$(ipt -S PREROUTING 2>/dev/null | grep -v '^-P ' | grep -n -- "-j $_wha_active\$" | head -1 | cut -d: -f1)
		if [ -z "$_wha_pos" ]; then
			say "ОТКАЗ: не нашёл позицию текущего прыжка ($_wha_active) в PREROUTING — переключать не на что опереться."
			state_set_white_chain_ok no "позиция текущего прыжка не найдена"
			return 1
		fi
		run_bounded 5 iptables $IPTW -t mangle -R PREROUTING "$_wha_pos" -j "$_wha_target"
		_wha_rc=$?
		if [ "$_wha_rc" != 0 ]; then
			say "ОТКАЗ: атомарное переключение прыжка не удалось (код $_wha_rc за пределом 5с) — прежняя цепочка $_wha_active остаётся живой и рабочей."
			state_set_white_chain_ok no "переключение прыжка не уложилось в предел"
			return 1
		fi
		ipt -C PREROUTING -j "$_wha_target" 2>/dev/null || {
			say "ОТКАЗ: после переключения прыжок указывает не на $_wha_target."
			state_set_white_chain_ok no "прыжок после -R не на новую половину"
			return 1
		}
	fi
	state_set_white_chain_ok yes
	return 0
}
white_home_all_names() {
	echo "$WHITEHOMECHAIN"
	echo "$WHITEHOMECHAIN_A"
	echo "$WHITEHOMECHAIN_B"
}
white_home_teardown() {
	_wht_bad=0
	for _wht_c in $(white_home_all_names); do
		[ -f "$WHITEHOMEEVERUSED" ] || off_nado "$_wht_c" || continue
		_wht_try=0
		while [ "$_wht_try" -lt 10 ] && ipt -C PREROUTING -j "$_wht_c" 2>/dev/null; do
			ipt -D PREROUTING -j "$_wht_c" 2>/dev/null
			_wht_try=$((_wht_try + 1))
		done
		if ipt -C PREROUTING -j "$_wht_c" 2>/dev/null; then
			say "ОТКАЗ: прыжок PREROUTING -> $_wht_c не снимается после $_wht_try попыток -D."
			log "white_home_teardown: прыжок на $_wht_c живой после $_wht_try попыток -D"
			_wht_bad=1
			continue
		fi
		ipt -F "$_wht_c" 2>/dev/null
		ipt -X "$_wht_c" 2>/dev/null
		if chain_exists "$_wht_c"; then
			say "ОТКАЗ: цепочка $_wht_c осталась после -F/-X."
			log "white_home_teardown: цепочка $_wht_c не снялась после -F/-X"
			_wht_bad=1
		fi
	done
	if [ -f "$WHITEHOMEEVERUSED" ] || off_nado "$WHITEHOMECHAIN_CHK"; then
		ipt -F "$WHITEHOMECHAIN_CHK" 2>/dev/null
		ipt -X "$WHITEHOMECHAIN_CHK" 2>/dev/null
	fi
	rm -f "$WHITECHAINOK_STATE" 2>/dev/null
	[ "$_wht_bad" = 0 ] && rm -f "$WHITEHOMEEVERUSED" 2>/dev/null
	return "$_wht_bad"
}
mss_local_teardown() {
	off_nado "$CH_MSS_LOCAL" || return 0
	while ipt -C OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null; do
		ipt -D OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null || break
	done
	ipt -F "$CH_MSS_LOCAL" 2>/dev/null
	ipt -X "$CH_MSS_LOCAL" 2>/dev/null
}
white_home_snaruzhi() {
	_src=$(echo "${SSH_CONNECTION:-}" | awk '{print $1}')
	[ -n "$_src" ] || return 1
	for _n in $(home_nets); do
		cidr_contains "$_n" "$_src" && return 1
	done
	echo "$_src"
	return 0
}
white_home_vorota() {
	if nft_meridian_active; then
		say "ОТКАЗ: на этом роутере разметка живёт в nftables (таблица inet meridian, путь OpenWrt) — этот движок её не понимает и не трогает."
		return 1
	fi
	if white_home_on; then
		say "ОТКАЗ: белый режим уже включён."
		return 1
	fi
	if white_on; then
		say "ОТКАЗ: включён опытный слой white-test для $(white_state_get addr). Сначала снимите его."
		return 1
	fi
	if [ "$(state_get mode)" != "black" ] || [ "$(state_get confirmed)" != "yes" ]; then
		say "ОТКАЗ: чёрный режим не включён или не подтверждён — метить некуда."
		return 1
	fi
	if ! iface_exists; then
		say "ОТКАЗ: туннеля $(tun_name) сейчас нет. Весь дом ушёл бы в удержание."
		return 1
	fi
	if ! route_mine_present; then
		say "ОТКАЗ: в таблице $TABLE нет нашего маршрута. Сначала: $0 ensure"
		return 1
	fi
	have ipset || { say "ОТКАЗ: нет ipset"; return 1; }
	if [ -n "$(ip -6 route show default 2>/dev/null)" ]; then
		say "ОТКАЗ: у роутера есть маршрут по умолчанию для IPv6. Белый режим сделан на IPv4: дом ушёл бы мимо туннеля по IPv6, а проверки показывали бы зелёное."
		return 1
	fi
	_sn=$(white_home_snaruzhi) && {
		say "ОТКАЗ: вы подключены к роутеру снаружи ($_sn). Переключение оборвёт вам доступ раньше, чем вы успеете подтвердить. Включайте из домашней сети."
		return 1
	}
	if [ -z "$(home_nets)" ]; then
		say "ОТКАЗ: сетей дома не прочитано НИ ОДНОЙ. Это не «сетей нет», это «мы их не увидели» — метить вслепую нельзя."
		return 1
	fi
	say "строю $KEEPSET заново (доверять прежнему содержимому нельзя)"
	keep_build_checked || { say "ОТКАЗ: $KEEPSET не собран или не прошёл проверку — см. выше. Без него дом потеряет и роутер, и сам туннель."; return 1; }
	set_exists "$DIRECTSET" || ipset create "$DIRECTSET" hash:net 2>/dev/null
	set_exists "$DIRECTSET" || { say "ОТКАЗ: не создать набор $DIRECTSET"; return 1; }
	white_direct_load || { say "ОТКАЗ: не наполнить $DIRECTSET из $WHITELIST"; return 1; }
	say "исключений белого режима: $(white_direct_entries) (список: $WHITELIST)"
	return 0
}
white_home_off_now() {
	white_home_teardown
	ru_ubrat_nabory
	if ! dns_upstream_split; then
		say "ВНИМАНИЕ: meridian-dns НЕ подтвердил переключение апстрима на split — он мог остаться на clean-only."
		log "БЕЛЫЙ РЕЖИМ ДОМА снят: meridian-dns НЕ подтвердил split — апстрим мог остаться на clean-only"
	fi
	ipset destroy "$DIRECTSET" 2>/dev/null
	rm -f "$AUTOSWITCHACTIVE" 2>/dev/null
	_prev=""
	[ -f "$WHITEPREV" ] && _prev=$(cat "$WHITEPREV" 2>/dev/null | tr -d '\n')
	case "$_prev" in
		black) state_set black yes "белый режим снят, возвращён чёрный"
		       say "Белый режим снят. ВОЗВРАЩЁН ЧЁРНЫЙ РЕЖИМ (mode=black, подтверждён)."
		       log "белый режим снят, возвращён black" ;;
		off)   state_set off no "белый режим снят, прежний режим был выключен"
		       say "Белый режим снят. Прежний режим был ВЫКЛЮЧЕН — возвращено off."
		       log "белый режим снят, возвращён off" ;;
		*)     # ПРЕЖНИЙ РЕЖИМ НЕ ПРОЧИТАЛСЯ. Не угадываем: снимаем пометку
		       state_set off no "белый режим снят, прежний режим НЕ ПРОЧИТАН"
		       say "ВНИМАНИЕ: прежний режим не прочитан (файл $WHITEPREV пуст или недоступен)."
		       say "Белый режим снят, пометка снята СОВСЕМ, режим переведён в off."
		       say "Чёрный режим, если он нужен, включите явно: $0 on"
		       log "белый режим снят, прежний режим НЕ ПРОЧИТАН — переведено в off" ;;
	esac
	rm -f "$WHITEPREV" "$WHITEHOMESINCE" "$WHITEHOMEDEAD" "$WHITEHOMEARMED" 2>/dev/null
}
white_home_armed_stop() {
	[ -f "$WHITEHOMEARMED" ] || return 0
	P=$(cat "$WHITEHOMEARMED" 2>/dev/null)
	rm -f "$WHITEHOMEARMED" 2>/dev/null
	case "$P" in ''|*[!0-9]*) return 0 ;; esac
	[ "$P" = "$$" ] && return 0
	[ -r "/proc/$P/cmdline" ] || return 0
	grep -aq 'meridian-route' "/proc/$P/cmdline" 2>/dev/null || return 0
	grep -aq '_white_home_armed' "/proc/$P/cmdline" 2>/dev/null || return 0
	kill "$P" 2>/dev/null
	return 0
}
cmd_white_home_armed() {
	trap '' HUP
	DEADLINE="$1"
	[ -n "$DEADLINE" ] || exit 1
	echo "$$" > "$WHITEHOMEARMED" 2>/dev/null
	while [ "$(date +%s)" -lt "$DEADLINE" ] 2>/dev/null; do
		[ "$(state_get confirmed)" = "yes" ] && { rm -f "$WHITEHOMEARMED"; exit 0; }
		white_home_on || { rm -f "$WHITEHOMEARMED"; exit 0; }
		sleep 5
	done
	[ "$(state_get confirmed)" = "yes" ] && { rm -f "$WHITEHOMEARMED"; exit 0; }
	log "БЕЛЫЙ РЕЖИМ: подтверждения не было — снимаю"
	white_home_off_now >/dev/null 2>&1
	fallback_mark unconfirmed_white white_removed_home_direct \
		"белый режим дома не подтвердили в срок — снят, весь дом снова ходит прежним путём"
	log "откат белого режима выполнен"
	rm -f "$WHITEHOMEARMED" 2>/dev/null
	exit 0
}
white_home_tail_ok() {
	_wht_active=$(white_home_active_chain) || return 1
	_wht_have=$(ipt -S "$_wht_active" 2>/dev/null)
	[ -n "$_wht_have" ] || return 1
	for _wht_n in $(home_nets); do
		printf '%s\n' "$_wht_have" | grep -qF -- "-A $_wht_active -s $_wht_n -j MARK --set-xmark $MARK/$MASK" || return 1
		printf '%s\n' "$_wht_have" | grep -qF -- "-A $_wht_active -s $_wht_n -j CONNMARK --save-mark --nfmask $MASK --ctmask $MASK" || return 1
	done
	return 0
}
white_home_ensure() {
	if ! white_home_on; then
		if [ -f "$RULOADED" ] || [ -f "$RUDNSMARK" ]; then
			log "ensure: наборы RU-напрямую остались вне белого режима — снимаю"
			ru_ubrat_nabory
		fi
		[ -f "$WHITEHOMEEVERUSED" ] || return 0
		have iptables || return 0
		_whr=""
		for _whc in $(white_home_all_names); do
			ipt -C PREROUTING -j "$_whc" 2>/dev/null && _whr="$_whr прыжок:$_whc"
			chain_exists "$_whc" && _whr="$_whr цепочка:$_whc"
		done
		if [ -n "$_whr" ]; then
			say "ensure: белый режим дома ВЫКЛЮЧЕН, а в live остались следы:$_whr — снимаю"
			log "ensure: остаток белого дома при mode!=white:$_whr — снимаю принудительно"
			white_home_teardown || log "ensure: снять остаток белого дома не удалось до конца"
		fi
		return 0
	fi
	have iptables || return 0
	have ipset || return 0
	_hn=0
	_wha=$(white_home_active_chain) || _hn=1
	[ "$_hn" = 0 ] && { white_home_tail_ok || _hn=1; }
	_wlf=$(white_list_clean | sort -u | grep -c .)
	_wls=$(white_direct_entries)
	if [ "$_wlf" != "$_wls" ]; then
		say "ensure: в $DIRECTSET записей $_wls, в списке $_wlf — наполняю заново"
		white_direct_load || log "ensure: не удалось наполнить $DIRECTSET"
	fi
	_hru=0
	if ru_flag_on; then
		if ! set_exists "$RUSET"; then
			say "ensure: RU-напрямую включены, а набора $RUSET нет — гружу заново"
			log "ensure: восстанавливаю набор $RUSET"
			ru_prigotovit || log "ensure: RU-напрямую не восстановлены: $(ru_reason_get)"
			_hn=1
		elif [ ! -f "$RUDNSMARK" ]; then
			_hrd=$(ru_dns_on) && _hn=1 || log "ensure: $_hrd"
		fi
		if [ "$_hn" = 0 ] && set_exists "$RUSET" && ! white_home_ru_v_cepochke; then
			say "ensure: RU-напрямую включены, а правила нет в белой цепочке — пересобираю"
			_hn=1
		fi
	elif [ -f "$RULOADED" ] || [ -f "$RUDNSMARK" ] || set_exists "$RUSET"; then
		_hru=1
		_hn=1
	fi
	[ "$_hn" = 0 ] && { state_set_white_chain_ok yes; return 0; }
	if [ "$_hru" = 1 ]; then
		log "ensure: RU-напрямую выключены, а наборы остались — снимаю"
		white_home_apply || log "ensure: белая цепочка без RU не пересобралась"
		ru_vne_cepochek
		ru_ubrat_nabory
		return 0
	fi
	say "ensure: белый режим включён, а цепочка дома отсутствует или хвост неполон — пересобираю в неактивную половину"
	log "ensure: восстанавливаю белую цепочку дома (была активна: ${_wha:-нет})"
	white_home_apply || log "ensure: восстановить белую цепочку дома НЕ удалось"
	return 0
}
dns_direct_add() {
	[ -x "$DNSBIN" ] || return 1
	run_bounded 10 "$DNSBIN" -config "$DNSCONFIG_DIRECT" domains add "$1" --group direct --create
}
dns_direct_del() {
	[ -x "$DNSBIN" ] || return 1
	run_bounded 10 "$DNSBIN" -config "$DNSCONFIG_DIRECT" domains del "$1"
}
dns_direct_clear() {
	[ -x "$DNSBIN" ] || return 1
	run_bounded 10 "$DNSBIN" -config "$DNSCONFIG_DIRECT" domains del --group direct --all
}
dns_direct_show_machine() {
	[ -x "$DNSBIN" ] || return 1
	run_bounded 10 "$DNSBIN" -config "$DNSCONFIG_DIRECT" domains show --machine
}
dns_direct_show_lines() {
	dns_direct_show_machine 2>/dev/null | grep '^entry='
}
dns_direct_show_count() {
	_dc=$(dns_direct_show_machine 2>/dev/null | sed -n 's/^entries=//p')
	case "$_dc" in ''|*[!0-9]*) echo "" ;; *) echo "$_dc" ;; esac
}
white_list_clean() {
	sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' "$WHITELIST" 2>/dev/null | grep -v '^$'
}
white_direct_load() {
	ipset destroy "$DIRECTSETNEW" 2>/dev/null
	ipset create "$DIRECTSETNEW" hash:net family inet 2>/dev/null || return 1
	white_list_clean | sort -u | sed "s|^|add $DIRECTSETNEW |" | ipset restore 2>/dev/null || {
		ipset destroy "$DIRECTSETNEW" 2>/dev/null
		return 1
	}
	set_exists "$DIRECTSET" || ipset create "$DIRECTSET" hash:net family inet 2>/dev/null || return 1
	ipset swap "$DIRECTSETNEW" "$DIRECTSET" 2>/dev/null || return 1
	ipset destroy "$DIRECTSETNEW" 2>/dev/null
	return 0
}
white_direct_entries() {
	set_exists "$DIRECTSET" || { echo 0; return 0; }
	ipset list "$DIRECTSET" 2>/dev/null | sed -n '/^Members:/,$p' | grep -vc '^Members:'
}
cmd_white_list() {
	case "${1:-show}" in
		show)
			if [ -e "$WHITELIST" ] && [ ! -r "$WHITELIST" ]; then
				say "не прочитать $WHITELIST (права?)"
				return 2
			fi
			_wln=0
			white_list_clean | while IFS= read -r _wle; do
				case "$_wle" in
					*/*) echo "entry=$_wle kind=net" ;;
					*)   echo "entry=$_wle kind=addr" ;;
				esac
			done
			_wln=$(white_list_clean | grep -c .)
			_wdn=0
			if dns_direct_merge_ready; then
				_wdrc=0; _wdraw=$(dns_direct_show_machine 2>/dev/null) || _wdrc=$?
				case "$_wdrc" in
					0)
						printf '%s
' "$_wdraw" | grep '^entry='
						_wdn=$(printf '%s
' "$_wdraw" | sed -n 's/^entries=//p')
						case "$_wdn" in ''|*[!0-9]*) _wdn=0 ;; esac
						echo "dns_direct_read=yes"
						;;
					2)
						say "ВНИМАНИЕ: meridian-dns не прочитал список доменов (код 2) — показаны только адреса и подсети."
						echo "dns_direct_read=no"
						;;
					*)
						say "ВНИМАНИЕ: meridian-dns вернул код $_wdrc на domains show --machine — домены не показаны."
						echo "dns_direct_read=no"
						;;
				esac
			fi
			echo "entries=$((_wln + _wdn))"
			return 0
			;;
		add)
			shift
			[ -n "${1:-}" ] || { say "что добавить? нужен адрес или подсеть"; return 1; }
			case "$1" in
				*[a-zA-Z]*)
					if ! dns_direct_merge_ready; then
						say "ОТКАЗ: «$1» похоже на домен, а домены движок не ведёт."
						say "  Домен нельзя положить в набор: его надо резолвить и следить за TTL,"
						say "  и это уже делает meridian-dns на живом ответе. Второй разбор здесь"
						say "  разошёлся бы с ним на первой же правке."
						say "  Домены белого режима: через meridian-dns (набор mn_*, см. кота 2)."
						return 1
					fi
					dns_direct_add "$1" || { say "ОТКАЗ: meridian-dns не принял «$1» (команда кота 2, см. договор)"; return 1; }
					say "добавлено (домен, через meridian-dns): $1"
					log "в белый список добавлен домен $1 (через meridian-dns)"
					return 0
					;;
			esac
			valid_cidr "$1" || { say "ОТКАЗ: «$1» не адрес, не подсеть и не домен"; return 1; }
			mkdir_for "$WHITELIST"
			if white_list_clean | grep -qx "$1"; then
				echo "already=yes"
				say "уже есть: $1"
				return 0
			fi
			echo "$1" >> "$WHITELIST" 2>/dev/null || { say "не записать в $WHITELIST"; return 2; }
			say "добавлено: $1"
			log "в белый список добавлено $1"
			white_home_on && { white_direct_load && say "набор $DIRECTSET обновлён: $(white_direct_entries) записей"; }
			return 0
			;;
		del)
			shift
			[ -n "${1:-}" ] || { say "что убрать?"; return 1; }
			if ! white_list_clean | grep -qx "$1"; then
				if dns_direct_merge_ready; then
					dns_direct_del "$1"; _wddrc=$?
					case "$_wddrc" in
						0)
							say "убрано (домен, через meridian-dns): $1"
							log "из белого списка убран домен $1 (через meridian-dns)"
							return 0
							;;
						5) : ;;   # не было нигде — падаем к absent=yes ниже
						6)
							say "ОТКАЗ: «$1» есть у meridian-dns, но в ДРУГОЙ группе (не direct) — не мой список, не трогаю."
							return 1
							;;
						*)
							say "ОТКАЗ: meridian-dns вернул код $_wddrc на domains del «$1» — не понимаю ответ, ничего не менял."
							return 1
							;;
					esac
				fi
				echo "absent=yes"
				say "в списке и не было: $1"
				return 0
			fi
			_wlt="$WHITELIST.tmp.$$"
			grep -vx "$1" "$WHITELIST" > "$_wlt" 2>/dev/null
			[ -f "$_wlt" ] || { say "не переписать $WHITELIST"; return 2; }
			mv -f "$_wlt" "$WHITELIST" 2>/dev/null || { rm -f "$_wlt"; say "не переписать $WHITELIST"; return 2; }
			say "убрано: $1"
			log "из белого списка убрано $1"
			white_home_on && { white_direct_load && say "набор $DIRECTSET обновлён: $(white_direct_entries) записей"; }
			return 0
			;;
		clear)
			shift
			[ "${1:-}" = "--yes" ] || {
				say "ОТКАЗ: clear стирает ВЕСЬ список исключений белого режима."
				say "  Если это и нужно: $0 white list clear --yes"
				return 1
			}
			: > "$WHITELIST" 2>/dev/null || { say "не очистить $WHITELIST"; return 2; }
			say "список очищен"
			log "белый список очищен человеком"
			white_home_on && { white_direct_load && say "набор $DIRECTSET обновлён: $(white_direct_entries) записей"; }
			return 0
			;;
		*)
			say "usage: $0 white list show | add <адрес|подсеть> | del <адрес|подсеть> | clear --yes"
			return 1
			;;
	esac
}
autoswitch_n() {
	_v="${MERIDIAN_ROUTE_AUTOSWITCH_N:-$(conf_value AUTOSWITCH_N 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 600 ;; *) echo "$_v" ;; esac
}
autoswitch_m() {
	_v="${MERIDIAN_ROUTE_AUTOSWITCH_M:-$(conf_value AUTOSWITCH_M 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 1800 ;; *) echo "$_v" ;; esac
}
autoswitch_cap() {
	_v="${MERIDIAN_ROUTE_AUTOSWITCH_CAP:-$(conf_value AUTOSWITCH_CAP 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 12 ;; *) echo "$_v" ;; esac
}
autoswitch_enabled() { [ -f "$AUTOSWITCHSTATE" ] && [ "$(cat "$AUTOSWITCHSTATE" 2>/dev/null)" = "on" ]; }
autoswitch_set() {
	mkdir_for "$AUTOSWITCHSTATE"
	printf '%s' "$1" > "$AUTOSWITCHSTATE" 2>/dev/null
}
autoswitch_daycount_get() {
	_today=$(date +%Y%m%d)
	_stamp=$(cat "$AUTOSWITCHCOUNTDAY" 2>/dev/null)
	[ "$_stamp" = "$_today" ] || { echo 0; return 0; }
	hod_schyot "$AUTOSWITCHCOUNT"
}
autoswitch_daycount_bump() {
	_today=$(date +%Y%m%d)
	_stamp=$(cat "$AUTOSWITCHCOUNTDAY" 2>/dev/null)
	if [ "$_stamp" != "$_today" ]; then
		echo "$_today" > "$AUTOSWITCHCOUNTDAY" 2>/dev/null
		echo 1 > "$AUTOSWITCHCOUNT" 2>/dev/null
		return 0
	fi
	_n=$(hod_schyot "$AUTOSWITCHCOUNT")
	echo $(( _n + 1 )) > "$AUTOSWITCHCOUNT" 2>/dev/null
	return 0
}
_autoswitch_disarm_if_human() {
	[ -n "${_AUTOSWITCH_CALLING:-}" ] && return 0
	autoswitch_enabled || return 0
	autoswitch_set off
	log "АВТОМАТ 10б-2: выключен — сработало ручное переключение белого режима"
	say "Автомат 10б-2 выключен: переключение было ручным. Включить снова: $0 auto on"
}
cmd_auto() {
	case "${1:-}" in
		on)
			autoswitch_set on
			log "АВТОМАТ 10б-2: включён (N=$(autoswitch_n)с, M=$(autoswitch_m)с, потолок $(autoswitch_cap)/сутки)"
			say "Автомат включён. N=$(autoswitch_n)с резервного -> белый; M=$(autoswitch_m)с быстрого -> чёрный."
			;;
		off)
			autoswitch_set off
			log "АВТОМАТ 10б-2: выключен человеком"
			say "Автомат выключен. Текущий режим не меняется."
			;;
		show)
			echo "autoswitch=$(autoswitch_enabled && echo on || echo off)"
			echo "autoswitch_n=$(autoswitch_n)"
			echo "autoswitch_m=$(autoswitch_m)"
			echo "autoswitch_daily_cap=$(autoswitch_cap)"
			echo "autoswitch_active=$([ -f "$AUTOSWITCHACTIVE" ] && echo yes || echo no)"
			echo "autoswitch_daily_count=$(autoswitch_daycount_get)"
			echo "qwdtt_path_mode=$(qwdtt_path_mode 2>/dev/null)"
			echo "qwdtt_path_continuous_since=$(transitions_continuous_since 2>/dev/null)"
			;;
		check)
			rm -f "$ZARUBEZHCHECK" 2>/dev/null
			if zarubezh_dostupno; then
				case "$ZARUBEZH_DETAIL" in
					"проверить нечем"*)
						say "ПРОВЕРИТЬ НЕЧЕМ: $ZARUBEZH_DETAIL"
						say "  Белый режим автомат при этом НЕ включит — отказ безопасный,"
						say "  но и признака белого списка у нас сейчас нет."
						;;
					*)
						say "зарубежное доступно напрямую: $ZARUBEZH_DETAIL — это НЕ белый список"
						;;
				esac
			else
				say "ничего не ответило напрямую (зарубежные адреса и наш вход $(peer_host 2>/dev/null)) — похоже на белый список"
			fi
			;;
		*)
			say "usage: $0 auto on | off | show | check"
			return 2
			;;
	esac
}
ZARUBEZHCHECK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.zarubezh"
ZARUBEZH_DETAIL=""
zarubezh_min_interval() {
	_v="${MERIDIAN_ROUTE_ZARUBEZH_MIN:-$(conf_value ZARUBEZH_MIN_INTERVAL 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 60 ;; *) echo "$_v" ;; esac
}
zarubezh_probe_odin() {
	_zp_ip="$1"; _zp_port="$2"
	if have curl; then
		curl -s -o /dev/null --connect-timeout 3 --max-time 5 "https://$_zp_ip:$_zp_port/" >/dev/null 2>&1
		_zp_rc=$?
		case "$_zp_rc" in
			7|28) return 1 ;;
			*)    return 0 ;;
		esac
	fi
	if have wget; then
		run_bounded 5 wget -q -O /dev/null "https://$_zp_ip:$_zp_port/" >/dev/null 2>&1
		_zp_rc=$?
		[ "$_zp_rc" = "124" ] && return 1
		[ "$_zp_rc" = "0" ] && return 0
		return 1
	fi
	return 2
}
zarubezh_dostupno() {
	ZARUBEZH_DETAIL=""
	_zd_now=$(date +%s)
	if [ -f "$ZARUBEZHCHECK" ]; then
		_zd_at=$(sed -n '1p' "$ZARUBEZHCHECK" 2>/dev/null)
		case "$_zd_at" in
			''|*[!0-9]*) ;;
			*)
				if [ $(( _zd_now - _zd_at )) -lt "$(zarubezh_min_interval)" ]; then
					_zd_verdict=$(sed -n '2p' "$ZARUBEZHCHECK" 2>/dev/null)
					ZARUBEZH_DETAIL=$(sed -n '3p' "$ZARUBEZHCHECK" 2>/dev/null)
					[ "$_zd_verdict" = "da" ]
					return $?
				fi
				;;
		esac
	fi
	_zd_otvet=""
	_zd_nechem=""
	for _zd_t in 1.1.1.1:443 8.8.8.8:443 9.9.9.9:443; do
		_zd_ip="${_zd_t%%:*}"; _zd_port="${_zd_t##*:}"
		zarubezh_probe_odin "$_zd_ip" "$_zd_port"
		case "$?" in
			0) _zd_otvet="$_zd_t (зарубежный)"; break ;;
			2) _zd_nechem=1; break ;;
		esac
	done
	if [ -n "$_zd_nechem" ]; then
		ZARUBEZH_DETAIL="проверить нечем: на роутере нет ни curl, ни wget"
		mkdir_for "$ZARUBEZHCHECK"
		printf '%s\n%s\n%s\n' "$_zd_now" "da" "$ZARUBEZH_DETAIL" > "$ZARUBEZHCHECK" 2>/dev/null
		return 0
	fi
	if [ -z "$_zd_otvet" ]; then
		_zd_peer=$(peer_host)
		_zd_pp=$(conf_value RAW_PEER 2>/dev/null); [ -n "$_zd_pp" ] || _zd_pp=$(conf_value PEER 2>/dev/null)
		_zd_peerport="${_zd_pp##*:}"
		case "$_zd_peerport" in ''|*[!0-9]*) _zd_peerport="" ;; esac
		if [ -n "$_zd_peer" ] && [ -n "$_zd_peerport" ]; then
			_zd_peerip="$_zd_peer"
			case "$_zd_peer" in *[!0-9.]*) _zd_peerip=$(keep_peer 2>/dev/null) ;; esac
			if [ -n "$_zd_peerip" ]; then
				zarubezh_probe_odin "$_zd_peerip" "$_zd_peerport"
				[ "$?" = "0" ] && _zd_otvet="$_zd_peer:$_zd_peerport (наш вход)"
			fi
		fi
	fi
	mkdir_for "$ZARUBEZHCHECK"
	if [ -n "$_zd_otvet" ]; then
		printf '%s\n%s\n%s\n' "$_zd_now" "da" "$_zd_otvet" > "$ZARUBEZHCHECK" 2>/dev/null
		ZARUBEZH_DETAIL="$_zd_otvet"
		return 0
	fi
	printf '%s\n%s\n%s\n' "$_zd_now" "net" "" > "$ZARUBEZHCHECK" 2>/dev/null
	return 1
}
autoswitch_trigger_on() {
	_asdur="$1"
	_ascnt=$(autoswitch_daycount_get)
	if [ "$_ascnt" -ge "$(autoswitch_cap)" ] 2>/dev/null; then
		log "АВТОМАТ 10б-2: порог включения достигнут (${_asdur}с на резервном), НО суточный потолок переключений исчерпан ($_ascnt/$(autoswitch_cap)) — не включаю"
		return 1
	fi
	if zarubezh_dostupno; then
		log "АВТОМАТ 10б-2: на резервном пути ${_asdur}с, но зарубежное доступно напрямую (${ZARUBEZH_DETAIL}) — не белый список, режим не меняю"
		return 1
	fi
	log "АВТОМАТ 10б-2: ${_asdur}с непрерывно на резервном пути (порог $(autoswitch_n)с), зарубежное напрямую недоступно — включаю белый режим"
	autoswitch_daycount_bump
	_AUTOSWITCH_CALLING=1
	white_cmd_home_on --confirm 0 >/dev/null 2>&1
	_asrc=$?
	if [ "$_asrc" = "0" ] && white_home_on; then
		white_cmd_home_confirm >/dev/null 2>&1
		: > "$AUTOSWITCHACTIVE" 2>/dev/null
		log "АВТОМАТ 10б-2: белый режим включён и подтверждён автоматически"
	else
		log "АВТОМАТ 10б-2: попытка включить белый режим НЕ УДАЛАСЬ (код $_asrc) — смотрите причину выше в журнале"
	fi
	unset _AUTOSWITCH_CALLING 2>/dev/null || _AUTOSWITCH_CALLING=""
	return 0
}
autoswitch_trigger_off() {
	_asdur="$1"
	_ascnt=$(autoswitch_daycount_get)
	if [ "$_ascnt" -ge "$(autoswitch_cap)" ] 2>/dev/null; then
		log "АВТОМАТ 10б-2: порог возврата достигнут (${_asdur}с на быстром), НО суточный потолок переключений исчерпан ($_ascnt/$(autoswitch_cap)) — не выключаю"
		return 1
	fi
	log "АВТОМАТ 10б-2: ${_asdur}с непрерывно на быстром пути (порог $(autoswitch_m)с) — возвращаю чёрный режим"
	autoswitch_daycount_bump
	_AUTOSWITCH_CALLING=1
	white_cmd_home_off >/dev/null 2>&1
	unset _AUTOSWITCH_CALLING 2>/dev/null || _AUTOSWITCH_CALLING=""
	rm -f "$AUTOSWITCHACTIVE" 2>/dev/null
	log "АВТОМАТ 10б-2: чёрный режим восстановлен"
	return 0
}
autoswitch_ensure() {
	autoswitch_enabled || return 0
	_aspm=$(qwdtt_path_mode) || return 0
	[ -n "$_aspm" ] || return 0
	_assince=$(transitions_continuous_since) || return 0
	case "$_assince" in ''|*[!0-9]*) return 0 ;; esac
	_asdur=$(( $(date +%s) - _assince ))
	[ "$_asdur" -ge 0 ] || return 0
	case "$_aspm" in
		backup)
			if ! white_home_on && [ "$_asdur" -ge "$(autoswitch_n)" ]; then
				autoswitch_trigger_on "$_asdur"
			fi
			;;
		fast)
			if white_home_on && [ -f "$AUTOSWITCHACTIVE" ] && [ "$_asdur" -ge "$(autoswitch_m)" ]; then
				autoswitch_trigger_off "$_asdur"
			fi
			;;
	esac
	return 0
}
cmd_white() {
	case "${1:-}" in
		on)      shift; white_cmd_home_on "$@" ;;
		off)     white_cmd_home_off ;;
		confirm) white_cmd_home_confirm ;;
		show)    white_cmd_home_show ;;
		list)    shift; cmd_white_list "$@" ;;
		*)       say "usage: $0 white on [--confirm N] | off | confirm | show" ; return 2 ;;
	esac
}
white_cmd_home_on() {
	_autoswitch_disarm_if_human
	_whsec="$WHITE_HOME_CONFIRM_DEFAULT"
	while [ $# -gt 0 ]; do
		case "$1" in
			--confirm) _whsec="$2"; shift 2 ;;
			--confirm=*) _whsec="${1#--confirm=}"; shift ;;
			*) say "непонятный аргумент: $1"; return 2 ;;
		esac
	done
	case "$_whsec" in ''|*[!0-9]*) say "--confirm ждёт число секунд, получено «$_whsec»"; return 2 ;; esac
	if [ -z "${_ENSURE_LOCKED:-}" ]; then
		ensure_lock_acquire_wait || {
			say "ОТКАЗ: не дождался замка ensure за ${ENSURE_WAIT_MAX}с — похоже, параллельно уже идёт проверка/переключение. Повторите через несколько секунд."
			return 1
		}
		_ENSURE_LOCKED=1
	fi
	memo_vkl
	white_home_vorota || return 1
	if ru_flag_on; then
		ru_prigotovit || say "ВНИМАНИЕ: RU-адреса напрямую не действуют: $(ru_reason_get)"
	fi
	state_get mode > "$WHITEPREV" 2>/dev/null
	if ! white_home_apply; then
		say "Снимаю, ничего не оставляю."
		white_home_teardown
		ru_ubrat_nabory
		rm -f "$WHITEPREV" 2>/dev/null
		return 1
	fi
	if ! dns_upstream_clean_only; then
		say "ОТКАЗ: meridian-dns не переключил апстрим на clean-only. Снимаю, ничего не оставляю."
		white_home_teardown
		ru_ubrat_nabory
		rm -f "$WHITEPREV" 2>/dev/null
		return 1
	fi
	if [ -n "${_AUTOSWITCH_CALLING:-}" ]; then
		state_set white no "белый режим дома включён автоматически (автомат 10б-2)"
	else
		state_set white no "белый режим дома включён человеком"
	fi
	: > "$WHITEHOMEEVERUSED" 2>/dev/null
	date +%s > "$WHITEHOMESINCE" 2>/dev/null
	_whdead=$(( $(date +%s) + _whsec ))
	if [ "$_whsec" -gt 0 ] 2>/dev/null; then echo "$_whdead" > "$WHITEHOMEDEAD" 2>/dev/null; else : > "$WHITEHOMEDEAD" 2>/dev/null; fi
	if [ -n "${_AUTOSWITCH_CALLING:-}" ]; then
		log "БЕЛЫЙ РЕЖИМ ДОМА включён автоматически (автомат 10б-2): сети $(home_nets | tr '\n' ' ')подтвердить за $_whsec с"
	else
		log "БЕЛЫЙ РЕЖИМ ДОМА включён: сети $(home_nets | tr '\n' ' ')подтвердить за $_whsec с"
	fi
	say "ВКЛЮЧЕНО НА ВЕСЬ ДОМ. Сети: $(home_nets | tr '\n' ' ')"
	say "Весь трафик этих сетей, кроме исключений, идёт в туннель."
	say "УДЕРЖАНИЕ ТЕПЕРЬ closed: пропадёт туннель — дом останется БЕЗ ИНТЕРНЕТА,"
	say "  пока вы сами не скажете: $0 hold open"
	white_home_armed_stop
	if [ "$_whsec" -gt 0 ] 2>/dev/null; then
		say "ПОДТВЕРДИТЬ за $_whsec с (из ДОМАШНЕЙ сети): $0 white confirm"
		say "Не подтвердите — режим снимется сам и всё вернётся как было."
		if have setsid; then
			setsid "$SELF" _white_home_armed "$_whdead" </dev/null >/dev/null 2>&1 &
		else
			( ( "$SELF" _white_home_armed "$_whdead" </dev/null >/dev/null 2>&1 & ) & )
		fi
	else
		say "Подтверждение не требуется (--confirm 0): режим сам не снимется."
	fi
	return 0
}
white_cmd_home_confirm() {
	white_home_on || { say "подтверждать нечего: белый режим не включён"; return 1; }
	state_set white yes "белый режим дома подтверждён человеком"
	if [ -n "${_AUTOSWITCH_CALLING:-}" ]; then
		log "белый режим дома подтверждён автоматически (автомат 10б-2) — откат отменён"
	else
		log "белый режим дома подтверждён человеком — откат отменён"
	fi
	say "Принято. Откат отменён, белый режим остаётся до $0 white off."
}
white_cmd_home_off() {
	_autoswitch_disarm_if_human
	if [ -z "${_ENSURE_LOCKED:-}" ]; then
		ensure_lock_acquire_wait || {
			say "ОТКАЗ: не дождался замка ensure за ${ENSURE_WAIT_MAX}с — похоже, параллельно уже идёт проверка/переключение. Повторите через несколько секунд."
			return 1
		}
		_ENSURE_LOCKED=1
	fi
	white_home_on || {
		say "белый режим не включён — проверяю, не осталось ли следов"
		white_home_teardown
		_sled=$(ipt -S 2>/dev/null | grep -c "$WHITEHOMECHAIN")
		[ "$_sled" = "0" ] && say "следов нет" || say "ВНИМАНИЕ: следы остались ($_sled строк)"
		return 0
	}
	white_home_off_now
	_sled=$(ipt -S 2>/dev/null | grep -c "$WHITEHOMECHAIN")
	if [ "$_sled" != "0" ]; then
		say "СНЯТО НЕ ВСЁ: в mangle осталось строк с $WHITEHOMECHAIN: $_sled"
		return 1
	fi
	say "Следов не осталось."
	return 0
}
white_cmd_home_show() {
	if white_home_on; then
		echo "white=on"
		if [ -f "$AUTOSWITCHACTIVE" ]; then
			echo "white_by=auto"
		else
			echo "white_by=human"
		fi
		echo "white_confirmed=$(state_get confirmed)"
		echo "white_since=$(cat "$WHITEHOMESINCE" 2>/dev/null)"
		echo "white_prev_mode=$(cat "$WHITEPREV" 2>/dev/null)"
