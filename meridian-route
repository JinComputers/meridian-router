DIRECTDNSSETS_STATE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.directdnssets"
WHITESTATE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.whitetest"
WHITEARMED="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.whitearmed"
WHITE_CONFIRM_DEFAULT="${MERIDIAN_ROUTE_WHITE_CONFIRM:-300}"

# --------------------------------------------------------------------------
# БЕЛЫЙ РЕЖИМ НА ВЕСЬ ДОМ (шаг 10б-1) — ОТДЕЛЬНЫЙ ГЛАГОЛ, НЕ АРГУМЕНТ К white-test
#
# Почему отдельный глагол, а не приём сети в `white-test on` (решение
# владельца 20.09.2026, довод по коду): у слоя white-test НАМЕРЕННО нет
# автовосстановления — прошивка пересобрала правила, слой исчез, и это
# правильно для неподтверждённого опыта. Дому нужно РОВНО ОБРАТНОЕ: режим
# обязан пережить перезагрузку и пересборку правил, иначе дом молча
# вываливается в открытый канал. Два противоположных требования к
# автовосстановлению в одном глаголе — это два режима под одним именем.
#
# Режимы взаимно исключаются: включение одного при включённом другом — отказ.
WHITEHOMECHAIN="${MERIDIAN_ROUTE_WHITEHOMECHAIN:-MERIDIAN_WHITE_HOME}"
WHITEHOMECHAIN_CHK="${WHITEHOMECHAIN}_CHK"
# ДВЕ ЖИВЫЕ ПОЛОВИНЫ, A И B (1.70, владелец, 21.09.2026, инвариант 41).
# Раньше живая цепочка ($WHITEHOMECHAIN) флашилась и строилась заново НА
# МЕСТЕ, пока прыжок на неё уже стоял — окно, в которое цепочка неполна,
# было видно живьём (20.09.2026: два «не удалось» подряд, 1с разницы,
# правил дома стало 6 из ожидаемых ~20, дом ушёл мимо туннеля молча).
# Теперь строим и сверяем в НЕАКТИВНУЮ половину, живую НЕ ТРОГАЕМ, пока
# сборка не подтверждена, переключаем ОДНИМ действием (-R по позиции — -E
# проверено НЕ переставляет прыжок, см. white_home_apply). $WHITEHOMECHAIN
# как физическая цепочка больше не существует — это только основа имени;
# РЕАЛЬНУЮ, живую цепочку называет white_home_active_chain().
WHITEHOMECHAIN_A="${WHITEHOMECHAIN}_A"
WHITEHOMECHAIN_B="${WHITEHOMECHAIN}_B"
WHITECHAINOK_STATE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.whitechainok"
WHITEHOMEARMED="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.whitehomearmed"
# ПРЕЖНИЙ РЕЖИМ ХРАНИТСЯ ОТДЕЛЬНЫМ ФАЙЛОМ, а не полем в state. Формат state
# читают и старые движки; добавлять туда поле — менять договор ради нашей
# перестановки. Файл рядом стоит ноль и старым движком просто не замечается.
WHITEPREV="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.whiteprev"
WHITEHOMESINCE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.whitehomesince"
# ДЕДЛАЙН ОТДЕЛЬНЫМ ФАЙЛОМ, а не полем рядом с «since». Панель читает
# white_confirm_in числом ИЛИ словом, и источник у слова и у числа обязан быть
# один: пусто — режим выключен, `confirmed` — подтверждён, `never` — включали
# с --confirm 0, число — сколько секунд осталось.
WHITEHOMEDEAD="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.whitehomedead"
# WHITEHOMEEVERUSED — «белый дом хоть раз включали на этом роутере» (1.74,
# владелец, 21.09.2026, пункт 2 хвоста живого дефекта на HERO). Ставится в
# white_cmd_home_on() на успешном включении, снимается ТОЛЬКО когда
# white_home_teardown() подтвердил ПОЛНУЮ чистоту (вернул 0) — если снятие
# осталось недоделанным, маркер остаётся нарочно. Читает его ensure: на
# парке из одиннадцати роутеров, где белый дом не включали НИКОГДА, файла
# нет, и самолечение остатка обязано быть доказанным нулём вызовов iptables
# (тот же инвариант, что у white_position_ensure, — читающий вызов тоже
# берёт замок xtables, и шестьдесят таких в час на слабом роутере — цена,
# которую платить не с чего). На роутере, где белый дом хоть раз стоял,
# маркер есть, и проверка идёт — та самая, что и нашла бы остаток на HERO.
WHITEHOMEEVERUSED="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.whitehomeeverused"
# --------------------------------------------------------------------------
# АВТОПЕРЕХОД 10б-2 (1.83, владелец, 22.09.2026: «status оставляем на 3-4с,
# идём в автоматику»). N минут непрерывно на резервном пути — включить белый
# дом; M минут непрерывно на быстром — вернуть чёрный. Условия владельца:
# N=10 мин, M=30 мин, оба настройкой; auto=off по умолчанию; ЛЮБОЕ ручное
# переключение белого выключает автомат; громкий журнал; читает уже
# существующий журнал переходов (transitions_ensure, 1.63), новых опросов
# клиента не заводит.
#
# AUTOSWITCHACTIVE — «белый дом сейчас включён АВТОМАТОМ, не человеком».
# Только по этому маркеру автомат разрешает себе САМ выключить белый — чужого
# (человеческого) включения он не трогает никогда (инвариант «приоритет
# человека», тот же класс, что WHITEHOMEEVERUSED — маркер, не вычисление,
# потому что «кто включил» саму систему знать неоткуда, кроме как записать
# в момент включения).
AUTOSWITCHACTIVE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.autoswitchactive"
# AUTOSWITCHSTATE — включён ли сам автомат (on/отсутствие файла = off).
# ОТДЕЛЬНЫЙ ФАЙЛ, НЕ state_set()/state_get() (пойман на себе же при первой
# сборке 1.83): state_set() жёстко пишет ТРИ поля mode/confirmed/changed
# ЦЕЛИКОМ ПОВЕРХ $STATE — вызов state_set autoswitch on затёр бы mode=
# самого движка значением «autoswitch». Приём тот же, что у WHITEHOMEEVERUSED
# и AUTOSWITCHACTIVE выше: простой файл-маркер рядом.
AUTOSWITCHSTATE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.autoswitchstate"
# Суточный счётчик переключений автомата — потолок против бесконечного
# дребезга при нестабильном канале. Два файла: число и дата, на которую оно
# считано (та же пара, что TRANSITIONS/TRANSITIONS_LASTMODE) — смена даты
# обнуляет счёт, а не бесконечно копит.
AUTOSWITCHCOUNT="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.autoswitchcount"
AUTOSWITCHCOUNTDAY="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.autoswitchcountday"
# _AUTOSWITCH_CALLING — ВНУТРЕННИЙ ФЛАГ ВЫЗОВА, не файл: автомат сам вызывает
# white_cmd_home_on()/white_cmd_home_off() (та же полная сборка, что у
# человека — apply, dns_upstream_clean_only, сторож), и ставит этот флаг
# ПЕРЕД вызовом, чтобы те не приняли собственный вызов автомата за ручное
# переключение и не выключили сами себя. Пусто в любом другом пути вызова —
# ручной верно распознаётся ручным.
# СПИСОК ИСКЛЮЧЕНИЙ БЕЛОГО РЕЖИМА — ОТДЕЛЬНЫЙ ФАЙЛ, а не тот же, что у чёрного.
# Решение владельца: одна и та же запись значит разное в чёрном и белом режиме,
# и список между режимами НЕ переносится.
#
# ИСТОЧНИК ПРАВДЫ — ФАЙЛ, набор ipset производен от него. Набор живёт в памяти
# ядра и исчезает при перезагрузке; список, набранный человеком, исчезать не
# имеет права.
WHITELIST="${MERIDIAN_ROUTE_WHITELIST:-/opt/etc/qwdtt/meridian-white.list}"
# --------------------------------------------------------------------------
# СЛИЯНИЕ С ХРАНИЛИЩЕМ ДОМЕНОВ (кот 2) — ГОТОВЫ ОБЁРТКИ, ЖДЁТ ФОРМАТ
#
# Команды ниже — согласованный синтаксис (ДОГОВОР С КОТОМ 2, SOSTOYANIE.md),
# писать по нему можно уже сегодня. ЧЕГО НЕТ: формата `domains show
# --machine` построчно — его Кот 2 ещё не назвал. dns_direct_parse_machine_line
# ниже нарочно отказывает, а не угадывает: ложный разбор молча показал бы не
# те домены человеку, который решает по этому списку, что уходит напрямую.
DNSCONFIG_DIRECT="${MERIDIAN_ROUTE_DNS_DIRECT_CONFIG:-/opt/etc/qwdtt/meridian-dns-napryamuyu.yaml}"
# ВОРОТА СЛИЯНИЯ — ОТКРЫТЫ (21.09.2026). Владелец: «три вещи кота 2 ->
# слияние ОДНОЙ правкой -> кандидат -> выкат через чёрный режим». Кот 2
# выложил кандидат 0.29: domains del --group direct --all (опустошает
# группу, не сносит), sets flush (через ipset swap на парке / nft flush set
# на OpenWrt), domains show --machine и direct_sets= готовы раньше. Проверено
# с моей стороны: все семь файлов кандидата отдаются по HTTP кодом 200,
# версия 0.29 подтверждена строкой в бинарнике.
#
# ЭТА СТРОКА — И ЕСТЬ ОБЕЩАННАЯ «ОДНА ПРАВКА». Формат show/коды del сверены
# фактом (1.60), а не догадкой — обёртки писать заново не пришлось.
dns_direct_merge_ready() { return 0; }
DIRECTSETNEW="${DIRECTSET}_new"
WHITE_HOME_CONFIRM_DEFAULT="${MERIDIAN_ROUTE_WHITE_HOME_CONFIRM:-300}"
KEEPSETNEW="${KEEPSET}_new"
KEEPFP="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.keepfp"
KEEPFAILMARK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.keepfail"

# --------------------------------------------------------------------------
# DoT ЧЕРЕЗ ТУННЕЛЬ (реализация вечернего решения 05.09.2026, выкачено 15.09.2026)
#
# ДЫРА, КОТОРУЮ ЗАКРЫВАЕМ. `meridian-dns` спрашивает чистые резолверы по DoT
# (TCP:853), и при недоступности TLS падает на ТОТ ЖЕ адрес открытым текстом,
# 53 (`cleanpool.go:askOne`, признано и залогировано самим сервером: «ПАДАЮ НА
# ОТКРЫТЫЙ ТЕКСТ... Ответ можно подделать по дороге»). Замер на боевом
# роутере 15.09.2026 — падение реально происходит (лог 11.09, 13.09), причина
# — `dial tcp ...: i/o timeout`, тихий дроп 853 у провайдера, а не сертификат
# или код. Подменённый ответ на этом пути кладёт в набор обхода чужой адрес.
#
# ПОЧЕМУ БЕЗ SO_MARK И БЕЗ ПЕТЛИ НА РЕЛЕЕ. Петля из комментария выше
# («OUTPUT не помечаем... UDP до TURN-релея VK») возникает при пометке ПО
# ИСКЛЮЧЕНИЮ («метим всё, кроме keep») — под неё попал бы любой трафик
# роутера, включая транспорт клиента. Здесь пометка ПО ВКЛЮЧЕНИЮ: TCP,
# --dport 853, ровно два адреса из clean_addrs. DoT — TCP (`dot.go:95`,
# `net.DialTimeout("tcp", ...)`); транспорт клиента к релею и к VPS — другие
# порты и адреса. Пересечения нет структурно, проверено по коду 15.09.2026.
#
# СВОЯ ЦЕПОЧКА, А НЕ ПРАВИЛА ВНУТРЬ ЧУЖОЙ — тот же довод, что у WHITECHAIN:
# `ensure` раз в минуту сверяет `MERIDIAN_MARK` со своим списком и снёс бы
# наши правила как лишние копии. Своя цепочка `ensure` не трогает вовсе.
#
# АДРЕСА — СПРОШЕНЫ, А НЕ ВПИСАНЫ. Тот же источник и та же функция, что и у
# `keep_dns()` (clean_addrs из статуса сервера): одно значение в двух местах
# расходится молча (правило 51).
#
# `keep_dns()` СЕГОДНЯ НЕ ТРОГАЕМ. Резолверы остаются в `keep` — в чёрном
# режиме `keep` не подключён к пометке ни одним правилом (References: 0),
# и это правило на него не влияет никак. Убрать их из `keep` — задача шага
# «широкая цепочка OUTPUT» (пункт «д» плана), и там критичен порядок: правило
# 853 обязано стоять ВЫШЕ RETURN по `keep`, иначе снова замкнётся в него же.
DOTCHAIN="${MERIDIAN_ROUTE_DOTCHAIN:-MERIDIAN_DOT}"
DOTCHAIN_CHK="${DOTCHAIN}_CHK"
DOTSTATE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.dot"
DOTARMED="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.dotarmed"
DOT_CONFIRM_DEFAULT="${MERIDIAN_ROUTE_DOT_CONFIRM:-300}"

# --------------------------------------------------------------------------
# СВОЙ DNS РОУТЕРА — В ТУННЕЛЬ (шаг 11, глагол `out`)
#
# ЧТО ЗАКРЫВАЕМ. Белый режим ведёт в туннель весь дом, но трафик САМОГО
# роутера рождается в OUTPUT и в цепочку дома не попадает вовсе. Замер
# 20.09.2026: conntrack src=<адрес WAN> dst=1.1.1.1 dport=853 mark=0 — сервер
# meridian-dns спрашивает чистый пул мимо туннеля. Дом при этом уже весь
# внутри: со стороны провайдера видно ровно одно — этот дом ходит к чужому
# резолверу.
#
# ИМЯ ЦЕПОЧКИ — ПО ПОЛИТИКЕ, А НЕ ПО ТАБЛИЦЕ. MERIDIAN_SELFDNS читается как
# «свой DNS роутера», и это ровно то, что цепочка делает. Не MERIDIAN_OUTPUT:
# таблица и крюк — это место, а не смысл, и имя по месту завтра соврёт при
# первом же переносе. Не MERIDIAN_SELF: слой держит одну политику, и имя,
# обещающее весь трафик роутера, обещало бы то, чего в нём нет.
#
# ИМЯ НЕ ИЗ ПРОСТРАНСТВА meridian-dns. MERIDIAN_DNS и MERIDIAN_DNS_MARK —
# цепочки ЧУЖОГО компонента (сервер ставит их сам), и третья с тем же началом
# однажды была бы снята его же уборкой.
SELFDNSCHAIN="${MERIDIAN_ROUTE_SELFDNSCHAIN:-MERIDIAN_SELFDNS}"
SELFDNSCHAIN_CHK="${SELFDNSCHAIN}_CHK"

# MERIDIAN_SELFDNS_IFACE — ПАРА СЧЁТЧИКОВ ПО ТОЧКЕ ВЫХОДА (шаг 11, владелец,
# 21.09.2026, инвариант 14). MERIDIAN_SELFDNS живёт в mangle OUTPUT, где
# интерфейс ЕЩЁ НЕ ВЫБРАН — критерий «REPLY dst = туннель» там не работает
# для TCP-соединений самого роутера: адрес источника фиксируется в connect()
# ДО пометки (доказано tcpdump -p 15.09.2026, dot_mss_blackhole.md, и
# повторно живьём 21.09.2026: meridian=6 пакетов, ppp0=0, при этом conntrack
# REPLY у части соединений указывал на WAN-адрес — критерий по REPLY соврал
# бы «утечка», хотя пакет физически шёл в туннель). В mangle POSTROUTING
# точка выхода УЖЕ решена — счёт по -o не врёт ни для UDP, ни для TCP.
# Имя — по смыслу, не по крюку (тот же довод, что у SELFDNSCHAIN выше).
SELFDNSIFCHAIN="${MERIDIAN_ROUTE_SELFDNSIFCHAIN:-MERIDIAN_SELFDNS_IFACE}"
SELFDNSIFCHAIN_CHK="${SELFDNSIFCHAIN}_CHK"

# MERIDIAN_SELFDNS_WANIN — счётчик ВХОДЯЩИХ ответов резолвера на WAN (шаг 11,
# владелец, 22.09.2026, авария с DNS meridian-server). SELFDNSIFCHAIN считает,
# КУДА УХОДИТ запрос; этот считает, ОТКУДА ПРИХОДИТ ответ — если он приходит
# на WAN вместо туннеля, это утечка, которую selfdns_wan/selfdns_tun зелёным
# не покажут (они про исходящее). mangle PREROUTING — интерфейс уже решён
# (`-i`), тот же довод, что у POSTROUTING/`-o` для исходящего счётчика.
SELFDNSWANINCHAIN="${MERIDIAN_ROUTE_SELFDNSWANINCHAIN:-MERIDIAN_SELFDNS_WANIN}"
SELFDNSWANINCHAIN_CHK="${SELFDNSWANINCHAIN}_CHK"

OUTSTATE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.out"
OUTARMED="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.outarmed"
OUT_CONFIRM_DEFAULT="${MERIDIAN_ROUTE_OUT_CONFIRM:-300}"
UPSTREAM_EXC="${MERIDIAN_ROUTE_UPSTREAM_EXCEPTIONS:-/opt/etc/qwdtt/meridian-dns-upstream-exceptions}"
# СОСТОЯНИЕ — ЧТО МЫ ТУДА ПОСЛЕДНИЙ РАЗ ЗАПИСАЛИ. Без него нечем узнать,
# КАКУЮ строку убрать при смене VPS: файл человекочитаемый, и наша строка не
# отличается от человеческой по формату.
UPSTREAM_EXC_STATE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.upstreamvps"
UPSTREAM_EXC_MARK="meridian-route-avto-po-peer"

OUTNOADDRMARK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.outnoaddr"

# keep_fixed — постоянная часть. Порядок и состав — из решения 01.09.2026.
#
# 10.66.0.0/16 и 10.77.77.0/24 перечислены отдельно, хотя и входят в 10.0.0.0/8:
# они названы по смыслу (сети клиентов WG и RAW), и если однажды RFC1918 из
# набора уйдёт, эти две обязаны остаться.
keep_fixed() {
	echo "10.66.0.0/16"      # сеть WireGuard-клиентов
	echo "10.77.77.0/24"     # сеть RAW-клиентов
	echo "10.0.0.0/8"        # RFC1918
	echo "172.16.0.0/12"     # RFC1918
	echo "192.168.0.0/16"    # RFC1918
	echo "100.64.0.0/10"     # CGNAT: у владельца WAN 100.65.18.80 внутри него
	echo "127.0.0.0/8"       # петлевой
	echo "169.254.0.0/16"    # link-local
	echo "224.0.0.0/4"       # многоадресная
	echo "240.0.0.0/4"       # зарезервированное
}

# keep_local_nets — сети роутера ПО ФАКТУ с интерфейсов, а не по списку имён.
# Список имён («br0, br1») устарел бы на первом же роутере с другой прошивкой, и
# устарел бы молча: человек потерял бы доступ к своему роутеру.
# nets_from_ipo — СЕТИ ИЗ ВЫВОДА `ip -o -f inet addr show`, приведённые к
# адресу сети. Вынесено из keep_local_nets 20.09.2026, когда понадобился
# второй потребитель (home_nets): маскирование в двух местах — это два места,
# где оно разъедется, и мы за одну неделю видели это трижды.
nets_from_ipo() {
	awk '
		{
			for (i = 1; i <= NF; i++) if ($i == "inet") { cidr = $(i+1); break }
			if (cidr == "") next
			split(cidr, p, "/")
			split(p[1], o, ".")
			# АДРЕС БЕЗ ПРЕФИКСА — ЭТО /32, А НЕ МУСОР.
			#
			# Замер на боевом роутере владельца (Keenetic HERO, 09.09.2026):
			#   34: ppp0    inet 100.65.18.80 peer 10.1.254.36/32 scope global ppp0
			# У локального адреса префикса НЕТ вовсе, «/32» стоит у peer-адреса.
			# Прежняя редакция давала bits=0 и уходила по `next` — то есть WAN
			# роутера ТИХО не попадал в keep. Не мусор и не деление на ноль:
			# именно молчаливый пропуск, и он неотличим от «такой строки не было».
			#
			# Форму `peer` не разбираем намеренно: чужой адрес на том конце
			# канала — не наша локальная сеть, и класть его в keep нельзя.
			if (p[2] == "") bits = 32
			else bits = p[2] + 0
			if (bits < 8 || bits > 32) { cidr = ""; next }
			ip = o[1]*16777216 + o[2]*65536 + o[3]*256 + o[4]
			# Маска через деление: сдвиги есть не во всех awk на роутерах.
			d = 1
			for (k = 0; k < 32 - bits; k++) d = d * 2
			net = int(ip / d) * d
			a = int(net / 16777216) % 256
			b = int(net / 65536) % 256
			c = int(net / 256) % 256
			e = net % 256
			printf "%d.%d.%d.%d/%d\n", a, b, c, e, bits
			cidr = ""
		}'
}

keep_local_nets() {
	ip -o -f inet addr show 2>/dev/null | nets_from_ipo
}

# home_nets — сети ДОМА: всё с интерфейсов, КРОМЕ петлевого, КРОМЕ интерфейса
# с маршрутом по умолчанию (это канал провайдера) и КРОМЕ самого туннеля.
#
# Почему не «весь RFC1918» и не «без -s вовсе»:
#   * без -s мы пометили бы и входящий трафик из WAN. У прямого направления
#     соединения, заведённого СНАРУЖИ (проброс порта), пакеты приходят с WAN,
#     и метка увела бы их в туннель — асимметричная маршрутизация и мёртвый
#     проброс. Ответы такого соединения спасает правило --ctdir REPLY, а
#     прямое направление — только -s;
#   * «весь RFC1918» негоден: у владельца WAN 100.65.18.80 внутри CGNAT, и
#     такое правило накрыло бы его собственный канал.
# home_nets_klass — ВСЕ сети с интерфейсов И ПРИГОВОР ПО КАЖДОЙ, строкой
# «сеть интерфейс приговор». Приговоры: home, loopback, wan, tunnel,
# not-bridge, not-private.
#
# ПРИЗНАК ДОМА — МОСТ, НЕ ДИАПАЗОН АДРЕСА (1.69, владелец, 21.09.2026, разбор
# вместе с Котом 2 живьём на HERO). Раньше «дом» значило «приватный диапазон
# минус WAN/туннель/петля» — это ловило nwg0 (встроенный WireGuard Keenetic,
# 10.146.0.0/24, внутри 10.0.0.0/8 по диапазону): заворот DNS на 5453 у Кота 2
# стоит только на br0, а белая цепочка молча метила ещё и nwg0 — домены
# direct-списка там никогда не резолвятся meridian-dns, попадание в белый
# набор для этого сегмента ничего не значит. Признак «интерфейс — МОСТ»
# (каталог /sys/class/net/ИМЯ/bridge существует) устойчивее вдвойне:
# WireGuard/PPPoE/служебные интерфейсы мостами не бывают НИКОГДА, а признак
# переживёт смену платформы без правки — Keenetic называет мосты br0, br1...,
# OpenWrt называет свой LAN-мост br-lan, оба находятся одним и тем же тестом.
#
# Почему не «весь RFC1918» и не «без -s вовсе» (не изменилось этой правкой):
#   * без -s мы пометили бы и входящий трафик из WAN. У прямого направления
#     соединения, заведённого СНАРУЖИ (проброс порта), пакеты приходят с WAN,
#     и метка увела бы их в туннель — асимметричная маршрутизация и мёртвый
#     проброс. Ответы такого соединения спасает правило --ctdir REPLY, а
#     прямое направление — только -s;
#   * «весь RFC1918» негоден: у владельца WAN 100.65.18.80 внутри CGNAT, и
#     такое правило накрыло бы его собственный канал.
#
# Отдельная функция, а не фильтр внутри home_nets, ровно по одной причине:
# отсев обязан быть ВИДИМЫМ. 1.49 сделала фильтр строже и тем завела дефект
# ЗЕРКАЛЬНЫЙ прежнему — раньше лишняя сеть попадала в цепочку молча, теперь
# настоящая может не попасть молча, и нули в счётчиках будут выглядеть как
# «никто не ходит». Поэтому status печатает и то, что взято (home_nets=), и
# то, что отсеяно (home_nets_iskl=), поинтерфейсно, с причиной.
#
# not-bridge — приватный адрес на интерфейсе, который НЕ мост: WireGuard
# (nwg*), туннели, любой будущий не-LAN интерфейс — отсеивается по
# построению. not-private — МОСТ с публичным адресом: дом на публичной
# подсети от провайдера существует и не редкость, единственный приговор,
# который может оказаться ошибкой.
#
# НИ ОДНОГО МОСТА НЕ НАЙДЕНО — ОТДЕЛЬНОГО ГЕЙТА ЗДЕСЬ НЕТ. home_nets() в этом
# случае вернёт пусто, а ворота white_home_apply уже отказывают словами на
# пустом home_nets («сетей дома не прочитано НИ ОДНОЙ... метить вслепую
# нельзя») — заводить вторую копию того же отказа здесь значило бы правило 51.
home_nets_klass() {
	_wan=$(wan_iface)
	_tn=$(tun_name)
	ip -o -f inet addr show 2>/dev/null | while IFS= read -r _hkl; do
		_hkif=$(printf '%s\n' "$_hkl" | awk '{print $2}')
		# Маскирование — тем же общим помощником, второй копии не заводим.
		_hknt=$(printf '%s\n' "$_hkl" | nets_from_ipo)
		[ -n "$_hknt" ] || continue
		if [ "$_hkif" = "lo" ]; then echo "$_hknt $_hkif loopback"; continue; fi
		if [ -n "$_wan" ] && [ "$_hkif" = "$_wan" ]; then echo "$_hknt $_hkif wan"; continue; fi
		if [ "$_hkif" = "$_tn" ]; then echo "$_hknt $_hkif tunnel"; continue; fi
		if [ ! -d "/sys/class/net/$_hkif/bridge" ]; then
			echo "$_hknt $_hkif not-bridge"; continue
		fi
		case "$_hknt" in
			10.*|192.168.*) echo "$_hknt $_hkif home" ;;
			172.1[6-9].*|172.2[0-9].*|172.3[01].*) echo "$_hknt $_hkif home" ;;
			100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) echo "$_hknt $_hkif home" ;;
			*) echo "$_hknt $_hkif not-private" ;;
		esac
	done
}

home_nets()   { home_nets_klass | awk '$3 == "home" { print $1 }'; }
# home_ifaces — ТЕ ЖЕ мосты, ИМЕНАМИ, не сетями. Нужен отдельно: у Кота 2
# заворот DNS на 5453 берёт список ИНТЕРФЕЙСОВ (IFACES), а не диапазонов —
# отдаём наружу глаголом `home-ifaces` (правило владельца 21.09.2026,
# инвариант 36: один источник факта на два компонента, а не свой список у
# каждого, который расходится молча при следующей смене прошивки).
home_ifaces() { home_nets_klass | awk '$3 == "home" { print $2 }' | sort -u; }

# QWDTTLOG — журнал КЛИЕНТА (не движка). Источник для keep_peer_from_log
# ниже: строка "[РЕЗОЛВ] host -> ip (...)" — адрес, к которому клиент РЕАЛЬНО
# подключился, не наш собственный DNS-запрос.
QWDTTLOG="${MERIDIAN_ROUTE_QWDTTLOG:-/opt/var/log/qwdtt.log}"
# KEEPPEERIP — последний известный адрес за именем PEER, для строки в
# журнал ровно при смене (не на каждом ensure).
KEEPPEERIP="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.keeppeerip"

# keep_peer_from_log — адрес, к которому КЛИЕНТ реально подключился (1.89,
# владелец 23.09.2026: «источник адреса — тот, к которому клиент реально
# подключился ... а не собственный nslookup через DNS провайдера (его можно
# подменить)»). Клиент уже прошёл свою цепочку (DoH по адресам -> системный
# DNS с отбросом частных -> кэш рабочего) и реально пошёл именно на этот
# адрес — записав это строкой "[РЕЗОЛВ] host -> ip (...)" в свой журнал.
# Собственный резолв движка тем же провайдером, что режет адрес шлюза,
# можно подменить так же легко, как и системный DNS роутера.
keep_peer_from_log() {
	_kpl_host="$1"
	[ -r "$QWDTTLOG" ] || return 1
	_kpl_ip=$(grep -F "$_kpl_host" "$QWDTTLOG" 2>/dev/null | grep '\[РЕЗОЛВ\]' | tail -1 \
		| sed -n 's/.*-> \([0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\.[0-9][0-9]*\) .*/\1/p')
	[ -n "$_kpl_ip" ] || return 1
	echo "$_kpl_ip"
}

# keep_peer — адрес VPS ИЗ КОНФИГА. Набранный руками разошёлся бы с конфигом при
# первой смене VPS, и расхождение проявилось бы как «туннель не поднимается»,
# без единой строки об ошибке.
#
# Имя, а не адрес, — отдельный случай: разрешать его надо ЗДЕСЬ и сейчас, пока
# DNS ещё ходит обычным путём. Не разрешилось — отказ, а не пустая строка.
#
# ИМЯ ЗА PEER (1.89): источник адреса — журнал клиента (keep_peer_from_log),
# nslookup — только БУТСТРАП, пока клиент ещё ни разу не резолвил (журнала
# нет или нужной строки в нём ещё нет). Частные/служебные адреса отбрасывает
# forbidden_reason — тот же страж, что у остального состава набора. Смена
# адреса относительно прошлого известного — отдельная строка в журнал, а не
# молчаливая подмена: следующий keep_refresh_if_stale увидит другой
# отпечаток и пересоберёт набор в этом же цикле ensure.
keep_peer() {
	_p=$(peer_host)
	[ -n "$_p" ] || return 1
	case "$_p" in
		*[!0-9.]*)
			_r=$(keep_peer_from_log "$_p")
			if [ -z "$_r" ]; then
				# БУТСТРАП: клиент ещё ни разу не резолвил себя в журнал —
				# без адреса вход всё равно не собрать, nslookup здесь
				# единственный источник до первого подключения клиента.
				_r=$(nslookup "$_p" 2>/dev/null | awk '/^Address/ && $NF ~ /^[0-9.]+$/ { print $NF }' | grep -v '^127\.' | head -1)
				[ -n "$_r" ] || return 1
			fi
			_kp_frb=$(forbidden_reason "$_r/32")
			if [ -n "$_kp_frb" ]; then
				say "ОТКАЗ: адрес $_r за именем $_p — $_kp_frb"
				return 1
			fi
			_kp_old=""
			[ -f "$KEEPPEERIP" ] && _kp_old=$(cat "$KEEPPEERIP" 2>/dev/null)
			if [ -n "$_kp_old" ] && [ "$_kp_old" != "$_r" ]; then
				log "keep: адрес за именем $_p сменился $_kp_old -> $_r, исключения пересобраны"
			fi
			if [ "$_kp_old" != "$_r" ]; then
				mkdir -p "$(dirname "$KEEPPEERIP")" 2>/dev/null
				printf '%s' "$_r" > "$KEEPPEERIP" 2>/dev/null
			fi
			echo "$_r"
			;;
		*) echo "$_p" ;;
	esac
}

# keep_dns — адреса ЧИСТЫХ РЕЗОЛВЕРОВ, спрошенные У СЕРВЕРА DNS.
#
# ЭТУ ФУНКЦИЮ НЕ ГАСИМ И НЕ УСЛОВЛИВАЕМ (1.72, владелец, 21.09.2026, пункт 1
# хвоста шага 11 — читай дальше комментарий этой правки, она СМЕНЯЕТ прежний,
# который описывал отменённое 05.09.2026 решение и сам предупреждал, что его
# надо убрать при следующем касании). `keep_dns()` — ИСТОЧНИК для явных
# построчных правил `out_rules()`/`white_home_rules()`: они читают её
# НАПРЯМУЮ и метят 53/853 к этим адресам в туннель БЕЗУСЛОВНО, независимо от
# членства в $KEEPSET (владелец, 20.09.2026: «запасной путь на 53 остаётся
# прямым» отменено, к резолверам метится всё, «туннель ляжет — ляжет и DNS»
# — выбранный размен вслух). Убирать резолверов ИЗ ЭТОЙ функции значило бы
# сломать те самые построчные правила — не делать так.
#
# Отдельный вопрос — входят ли эти же адреса ЕЩЁ И в сам набор $KEEPSET
# (общее «не трогать» исключение белого дома/white-test). Решает его
# keep_dns_for_set() ниже, а не эта функция.
DNSBIN="${MERIDIAN_ROUTE_DNSBIN:-/opt/bin/meridian-dns}"

# --------------------------------------------------------------------------
# meridian-dns status — ОДИН ЖИВОЙ ВЫЗОВ НА ЗАПУСК ДВИЖКА, НЕ БОЛЬШЕ
# (владелец, 21.09.2026, живой роутер: status зовёт панель каждые несколько
# секунд, а meridian-dns status под нагрузкой не отвечал 5с и дольше — до
# правки status делал это живым вызовом КАЖДЫЙ раз). ОДИН процесс движка
# может звать и keep_dns(), и dns_direct_sets() — кэш склеивает их в один
# живой вызов.
#
# ФАЙЛОМ, А НЕ ПЕРЕМЕННЫМИ. Первая редакция кэшировала в переменные и НЕ
# РАБОТАЛА: $(keep_dns) — это command substitution, POSIX форкает под неё
# subshell, и присвоение внутри него теряется, когда он завершается —
# следующий $(dns_direct_sets) снова видел пустой кэш. Проверено тестом,
# поймано ДО отправки: 4 живых вызова за один ensure вместо одного. $$ в
# отличие от переменных ОБЩИЙ для всех subshell'ов одного запуска (POSIX:
# $$ не меняется внутри `$(...)`) — файл по имени с ним виден отовсюду.
#
# УБОРКА — ОБЯЗАТЕЛЬНА, НЕ «ЕСЛИ УСПЕЕМ»: PID'ы переиспользуются, и не
# убранный файл однажды читался бы СЛЕДУЮЩИМ процессом с тем же $$ как
# свежий кэш ЧУЖОГО, куда более старого запуска. Убирает общий EXIT trap
# (см. конец файла, _on_exit_cleanup) — один на весь скрипт, не для каждой
# команды отдельно.
#
# ПРЕДЕЛ — run_bounded, а не голое ожидание: инвариант владельца записан
# дословно — «периодическая задача без замка и без предела по времени —
# это не периодика, а накопитель процессов».
DNSLIVETMP="$RUNDIR/dns_status_live.$$"
dns_status_live() {
	if [ ! -f "$DNSLIVETMP" ]; then
		mkdir -p "$RUNDIR" 2>/dev/null
		if [ -x "$DNSBIN" ]; then
			run_bounded 5 "$DNSBIN" status 2>/dev/null > "$DNSLIVETMP.tmp"
			mv -f "$DNSLIVETMP.tmp" "$DNSLIVETMP" 2>/dev/null
		else
			: > "$DNSLIVETMP"
		fi
	fi
	[ -s "$DNSLIVETMP" ] || return 1
	cat "$DNSLIVETMP"
}

# DNSSTATCACHE — ПЕРСИСТЕНТНЫЙ КЭШ ДЛЯ `status` (владелец, 21.09.2026):
# «status зовёт панель каждые несколько секунд — он обязан быть самым
# дешёвым глаголом движка, а стал самым дорогим». `status` НИКОГДА не ходит
# в сеть живьём — читает то, что сюда положил ПОСЛЕДНИЙ ensure. Пишет
# ТОЛЬКО dns_status_cache_refresh(), зовёт её ТОЛЬКО cmd_ensure.
DNSSTATCACHE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.dnscache"
dns_status_cache_refresh() {
	_dscr=$(dns_status_live 2>/dev/null) || return 1
	mkdir -p "$(dirname "$DNSSTATCACHE")" 2>/dev/null
	{ echo "at=$(date +%s)"; printf '%s\n' "$_dscr"; } > "$DNSSTATCACHE.tmp.$$" 2>/dev/null || return 1
	mv -f "$DNSSTATCACHE.tmp.$$" "$DNSSTATCACHE" 2>/dev/null
}
# dns_status_cache_field <имя> — поле из кэша, БЕЗ единого живого вызова.
dns_status_cache_field() {
	[ -f "$DNSSTATCACHE" ] || return 1
	sed -n "s/^$1=//p" "$DNSSTATCACHE" 2>/dev/null | head -1
}
# dns_status_cache_age — секунд с последнего успешного обновления. Пусто =
# кэша ещё не было НИ РАЗУ; это НЕ «сейчас», это «неизвестно», и status
# обязан показать разницу, а не подставить 0.
dns_status_cache_age() {
	_dsca=$(dns_status_cache_field at) || return 1
	case "$_dsca" in ''|*[!0-9]*) return 1 ;; esac
	echo $(( $(date +%s) - _dsca ))
}

keep_dns() {
	_out=$(dns_status_live 2>/dev/null | sed -n 's/^clean_addrs=//p' | head -1)
	[ -n "$_out" ] || return 1
	printf '%s\n' "$_out" | tr ',' '\n' | grep -v '^$'
}

# keep_other_ifaces — АДРЕСА, УВЕДЁННЫЕ ЧЕЛОВЕКОМ В ЧУЖОЙ КАНАЛ.
#
# Замер на боевом роутере владельца (Keenetic HERO, 09.09.2026):
#   37: nwg0    inet 10.146.0.40/24
#   114.114.114.114 dev nwg0  proto static  scope link  metric 1000
#   223.5.5.5       dev nwg0  proto static  scope link  metric 1000
#
# Это ПУБЛИЧНЫЕ адреса, нарочно уведённые в другой туннель. В белом режиме они
# получат метку, уйдут в нашу таблицу и поедут в meridian: правило политики
# перекрывает статический маршрут. Мы молча украли бы чужой канал, и в журнале
# это выглядело бы штатной работой — то есть найти это было бы нечем.
#
# БЕРЁМ ЗАМЕРОМ С ТАБЛИЦЫ, А НЕ СПИСКОМ. Список чужих интерфейсов устареет при
# первом же новом туннеле, и устареет молча. Признак объективен: у адреса есть
# явный маршрут через интерфейс, ОТЛИЧНЫЙ от интерфейса маршрута по умолчанию.
#
# Что исключаем и почему:
#   * маршрут по умолчанию и всё, что идёт его интерфейсом, — это и есть
#     обычный путь, ему в keep не место (иначе keep накроет весь интернет);
#   * НАШ туннель: его маршруты ведут в meridian, и класть их в keep значило бы
#     исключить из туннеля то, ради чего он поднят;
#   * наши же таблицы: смотрим только главную (`ip route show` без table).
keep_other_ifaces() {
	_def=$(ip -4 route show default 2>/dev/null | sed -n 's/.*[[:space:]]dev[[:space:]]\([^ ]*\).*/\1/p' | head -1)
	# ПУСТОЙ ЭТАЛОН НАЗЫВАЕТСЯ ВСЛУХ (правило 39): без маршрута по умолчанию
	# «отличный от него интерфейс» не определён, и молчать здесь нельзя —
	# иначе в keep уедет вся таблица.
	if [ -z "$_def" ]; then
		say "ВНИМАНИЕ: маршрута по умолчанию нет — чужие каналы определить не с чем, в keep они не попадут"
		return 0
	fi
	_tun=$(tun_name)
	ip -4 route show 2>/dev/null | awk -v def="$_def" -v tun="$_tun" '
		$1 == "default" { next }
		{
			dev = ""
			for (i = 1; i <= NF; i++) if ($i == "dev") { dev = $(i+1); break }
			if (dev == "") next
			if (dev == def) next
			if (dev == tun) next
			# Первое поле — назначение. Голый адрес считаем /32: маршрут на
			# один адрес — самый частый случай увода в чужой канал.
			d = $1
			if (index(d, "/") == 0) d = d "/32"
			print d
		}'
}

# keep_dns_for_set — резолверы В $KEEPSET, КРОМЕ момента, когда явные
# построчные правила (out_rules()/white_home_rules(), см. keep_dns() выше)
# уже метят их порты 53/853 в туннель безусловно. Держать резолверов ЕЩЁ и в
# $KEEPSET тогда означало бы прятать от туннеля ЛЮБОЙ ДРУГОЙ порт к тому же
# адресу заодно (DoH:443 и что угодно ещё на 1.1.1.1/9.9.9.9) — остаточная
# утечка мимо шага 11, которую $KEEPSET до сих пор тихо прикрывал.
#
# УСЛОВИЕ — out=on И ПОДТВЕРЖДЁН, не только on: неподтверждённый слой может
# откатиться сам (armed-таймер), и до этого момента резолверы обязаны
# оставаться защищёнными в $KEEPSET, как раньше. out=off — поведение КАК
# БЫЛО ДО ЭТОЙ ПРАВКИ (1.72, владелец, 21.09.2026, пункт 1 хвоста шага 11).
keep_dns_for_set() {
	if out_on && [ "$(out_state_get confirmed)" = "yes" ]; then
		return 0
	fi
	keep_dns
}

# keep_lines — весь состав. Пустая строка не попадает никуда.
keep_lines() {
	keep_peer
	keep_local_nets
	keep_other_ifaces
	keep_dns_for_set
	keep_fixed
}

# keep_populate ЦЕЛЬ — наполнить набор ЦЕЛЬ (создаётся заново), БЕЗ подмены.
#
# Вынесено из keep_build 15.09.2026 (шаг 3 обновлённого порядка, свежесть
# keep): свежести нужно строить кандидата В СТОРОНЕ и проверять его ДО того,
# как он станет боевым, а не после — иначе неудачная пересборка успевает
# заменить рабочий набор раньше, чем выяснится, что она неудачная.
keep_populate() {
	_target="$1"
	_peer=$(keep_peer) || {
		say "ОТКАЗ: адрес VPS не получен из конфига ($CONF, ключ RAW_PEER или PEER)."
		say "  Без него пакеты самого туннеля попадут в туннель — это петля, и связь"
		say "  не поднимется вовсе. Набор НЕ собран."
		return 1
	}
	_nets=$(keep_local_nets)
	[ -n "$_nets" ] || {
		say "ОТКАЗ: не удалось прочитать сети роутера с интерфейсов (ip -o -f inet addr show)."
		say "  Без них человек теряет доступ к самому роутеру. Набор НЕ собран."
		return 1
	}
	# Резолверы — предупреждением, а не отказом: белого режима ещё нет, и в
	# чёрном их отсутствие в наборе ничего не ломает. КОГДА появится инверсия
	# пометки, это обязано СТАТЬ отказом: без них DNS уедет в туннель и умрёт
	# вместе с ним.
	if ! keep_dns >/dev/null 2>&1; then
		say "ВНИМАНИЕ: адреса чистых резолверов не получены от $DNSBIN (ключ clean_addrs)."
		say "  Для чёрного режима это не мешает. Для БЕЛОГО — обязательное условие:"
		say "  без них DNS уйдёт в туннель и умрёт вместе с ним."
	fi
	ipset destroy "$_target" 2>/dev/null
	ipset create "$_target" hash:net family inet 2>/dev/null || {
		say "ОТКАЗ: не создать $_target"
		return 1
	}
	keep_lines | sort -u | grep -v '^$' | sed "s|^|add $_target |" | ipset restore 2>/dev/null || {
		ipset destroy "$_target" 2>/dev/null
		say "ОТКАЗ: ipset не принял состав набора"
		return 1
	}
	return 0
}

# keep_fingerprint — отпечаток ВХОДНЫХ ДАННЫХ keep, не самого набора.
#
# `cksum` НЕ ИСПОЛЬЗУЕМ: его нет в BusyBox этого роутера (проверено на живом
# Entware 15.09.2026 — `cksum: not found`; есть только `md5sum`/`sha256sum`).
# Правило 25 («проверять в среде роутера, а не гадать по названию утилиты»)
# в действии: слепое следование `keep_lines | sort -u | cksum` дало бы функцию,
# которая на этом роутере не запускается вовсе, а не «работает иначе». Берём
# `md5sum` — он есть и делает то же самое: детерминированный отпечаток строк.
keep_fingerprint() {
	keep_lines | sort -u | md5sum 2>/dev/null | awk '{print $1}'
}

# keep_build — собрать набор. Атомарно: наполняем новый и подменяем, чтобы не
# было мгновения, когда keep пуст (в белом режиме это мгновение = отрезанный
# роутер).
keep_build() {
	keep_populate "$KEEPSETNEW" || return 1
	set_exists "$KEEPSET" || ipset create "$KEEPSET" hash:net family inet 2>/dev/null
	ipset swap "$KEEPSETNEW" "$KEEPSET" 2>/dev/null || {
		ipset destroy "$KEEPSETNEW" 2>/dev/null
		say "ОТКАЗ: подмена набора не удалась"
		return 1
	}
	ipset destroy "$KEEPSETNEW" 2>/dev/null
	return 0
}

# keep_gate — ГОТОВ ЛИ НАБОР НАСТОЛЬКО, ЧТОБЫ СТАВИТЬ ПОМЕТКУ.
#
# Шаг 1 белого режима, 09.09.2026. Ворота отдельны от keep_check намеренно:
# check спрашивает ядро про ВЕСЬ состав и годится для отчёта, а ворота решают
# один вопрос — можно ли ставить правило пометки. Условие ворот минимально и
# названо владельцем: адрес VPS И хотя бы одна локальная сеть роутера.
#
# Почему именно эти два, а не весь состав. Без адреса VPS пакеты самого туннеля
# уйдут в туннель — петля, связь не поднимется вовсе. Без сети роутера человек
# теряет SSH и панель, и вернуть их нечем. Всё остальное (RFC1918, CGNAT,
# многоадресные) — про удобство и чужой трафик; их отсутствие портит маршрут,
# но не отрезает нас от роутера.
#
# ЭТО ПРОВЕРКА, А НЕ КОММЕНТАРИЙ: печатает, чего не хватает, и возвращает
# ненулевой код. Спрашиваем ЯДРО (`ipset test`), а не свой же список: сверка
# списка с самим собой зелена и при пустом наборе (правило 36).
keep_gate() {
	_net=""
	if ! set_exists "$KEEPSET"; then
		say "ВОРОТА KEEP ЗАКРЫТЫ: набора $KEEPSET нет вовсе."
		say "  Пометку ставить нельзя: метилось бы ВСЁ, включая наш туннель и роутер."
		say "  Собрать: $0 keep build"
		return 1
	fi
	_peer=$(keep_peer)
	if [ -z "$_peer" ]; then
		say "ВОРОТА KEEP ЗАКРЫТЫ: адрес VPS не получен из $CONF (ключ RAW_PEER или PEER)."
		say "  Без него проверять нечего, а без него же будет петля."
		return 1
	fi
	_bad=""
	if ! ipset test "$KEEPSET" "$_peer" >/dev/null 2>&1; then
		_bad="адрес VPS $_peer"
	fi
	# ХОТЯ БЫ ОДНА сеть роутера. Считаем ЧИСЛО найденных, а не факт вызова:
	# пустой перечень интерфейсов дал бы ноль проверок и выглядел бы как успех
	# (правило 39).
	_est=0
	_vsego=0
	for _n in $(keep_local_nets); do
		_vsego=$((_vsego + 1))
		if ipset test "$KEEPSET" "${_n%%/*}" >/dev/null 2>&1; then
			_est=$((_est + 1))
			_net="$_n"
		fi
	done
	if [ "$_vsego" = 0 ]; then
		say "ВОРОТА KEEP ЗАКРЫТЫ: сетей роутера не прочитано НИ ОДНОЙ (ip -o -f inet addr show)."
		say "  Это не «сетей нет», это «мы их не увидели» — ставить пометку вслепую нельзя."
		return 1
	fi
	if [ "$_est" = 0 ]; then
		if [ -n "$_bad" ]; then
			_bad="$_bad и ни одной из $_vsego сетей роутера"
		else
			_bad="ни одной из $_vsego сетей роутера"
		fi
	fi
	if [ -n "$_bad" ]; then
		say "ВОРОТА KEEP ЗАКРЫТЫ: в наборе $KEEPSET нет $_bad."
		say "  Пометку НЕ ставлю. Без адреса VPS — петля (трафик туннеля уйдёт в туннель);"
		say "  без сети роутера человек теряет SSH и панель, и вернуть их нечем."
		say "  Пересобрать набор: $0 keep build"
		return 1
	fi
	say "ворота keep открыты: адрес VPS $_peer в наборе, сетей роутера в наборе $_est из $_vsego (например $_net)"
	return 0
}

# keep_check — ПРОВЕРКА ПРЕДМЕТА, а не своего утверждения.
#
# Спрашиваем ЯДРО (`ipset test`) про каждый обязательный адрес, а не сверяем
# свой же список сам с собой. Печатает, чего не хватает; код 0 только когда всё
# на месте.
keep_check() {
	# Необязательный аргумент — целевой набор. По умолчанию $KEEPSET (прежнее
	# поведение, все существующие вызовы без аргумента не меняются). Добавлено
	# 15.09.2026, чтобы свежесть (keep_refresh_if_stale) могла проверить
	# КАНДИДАТА до подмены, а не боевой набор после — иначе неудачная проверка
	# уже застала бы боевой набор заменённым.
	_set="${1:-$KEEPSET}"
	_bad=""
	set_exists "$_set" || { say "набора $_set нет вовсе"; return 1; }
	_peer=$(keep_peer) || { say "адрес VPS не получен из конфига — проверять не с чем"; return 1; }
	ipset test "$_set" "$_peer" >/dev/null 2>&1 || _bad="$_bad
адрес VPS $_peer — ПЕТЛЯ: пакеты туннеля пойдут в туннель"
	for _n in $(keep_local_nets); do
		ipset test "$_set" "${_n%%/*}" >/dev/null 2>&1 || _bad="$_bad
сеть роутера $_n — человек потеряет доступ к роутеру"
	done
	for _n in $(keep_fixed); do
		ipset test "$_set" "${_n%%/*}" >/dev/null 2>&1 || _bad="$_bad
$_n"
	done
	if [ -n "$_bad" ]; then
		say "В НАБОРЕ $_set НЕ ХВАТАЕТ:"
		printf '%s\n' "$_bad" | grep -v '^$' | sed 's/^/    /'
		return 1
	fi
	# ЧИСТЫЕ РЕЗОЛВЕРЫ: В БЕЛОМ РЕЖИМЕ — ОТКАЗ, В ЧЁРНОМ — ПО-ПРЕЖНЕМУ НЕТ.
	#
	# В keep_build это предупреждение, и там же написано почему: «КОГДА
	# появится инверсия пометки, это обязано СТАТЬ отказом: без них DNS уедет
	# в туннель и умрёт вместе с ним». Инверсия появилась.
	#
	# Но отказывать ВСЕГДА нельзя: у чёрного режима отсутствие meridian-dns
	# ничего не ломает, а одиннадцать роутеров парка живут именно чёрным.
	# Превратить их keep_check в отказ означало бы починить будущее ценой
	# работающего настоящего. Поэтому строгость включается только тогда, когда
	# в игре белый: режим уже белый ИЛИ его прямо сейчас включают (флаг ставят
	# ворота white_home_vorota).
	if white_home_on || [ "${KEEP_DNS_STROGO:-0}" = "1" ]; then
		if ! keep_dns >/dev/null 2>&1; then
			say "ОТКАЗ: адреса чистых резолверов не получены от meridian-dns (clean_addrs) — в белом режиме DNS уехал бы в туннель и умер бы вместе с ним."
			return 1
		fi
	fi
	return 0
}

# keep_refresh_if_stale — ПЕРЕСОБРАТЬ keep, ЕСЛИ ВХОДНЫЕ ДАННЫЕ ИЗМЕНИЛИСЬ.
#
# Шаг 3 обновлённого порядка работ (15.09.2026), ДО самого белого режима и
# отдельным выкатом. Причина первой очереди: сегодня keep собирается только в
# white_cmd_on() и `keep build`, между включениями протухает МОЛЧА — сменился
# адрес VPS, поднялась новая локальная сеть, человек увёл адреса в свой туннель
# (nwg0 у владельца). В чёрном режиме это не видно (пометка выборочная); в
# белом протухший keep при уже стоящей пометке отрезает роутер целиком — ни
# SSH, ни панели, вернуть нечем. Единственный отказ белого режима без
# удалённого выхода, и единственный, который стоит чинить раньше всего
# остального.
#
# ПОРЯДОК ОБЯЗАТЕЛЕН: строим КАНДИДАТА в $KEEPSETNEW, проверяем ЕГО (не
# боевой набор), и только прошедшего проверку подменяем. Неудача на любом шаге
# оставляет $KEEPSET нетронутым — это и есть требование 4 порядка работ, и
# оно выполнено устройством функции, а не отдельной проверкой поверх.
#
# Отпечаток считается ВСЕГДА (дёшево: чтение конфига и интерфейсов), а
# пересборка (дорого: ipset create/restore/swap) — ТОЛЬКО при его изменении.
# Первый запуск после установки этой версии всегда пересобирает один раз:
# файла отпечатка ещё нет, и это правильно — заодно проверяет текущий состав.
#
# ЛОГ БЕЗ ПОТОЛКА — ЭТО УТЕЧКА (правило 21): если данных для сборки нет
# (например, PEER ещё не задан на свежей установке), отпечаток входа стабилен,
# а сборка стабильно проваливается — без метки-подавления строка ушла бы в
# журнал каждую минуту навсегда. $KEEPFAILMARK подавляет повтор ровно как
# $UNSUREMARK у ensure: одна строка на НАЧАЛО отказа, тишина до починки.
keep_refresh_if_stale() {
	_fp_new=$(keep_fingerprint)
	_fp_old=""
	[ -f "$KEEPFP" ] && _fp_old=$(cat "$KEEPFP" 2>/dev/null)
	if [ "$_fp_new" = "$_fp_old" ] && set_exists "$KEEPSET"; then
		return 0
	fi
	if ! keep_populate "$KEEPSETNEW"; then
		if [ ! -f "$KEEPFAILMARK" ]; then
			date +%s > "$KEEPFAILMARK" 2>/dev/null
			log "keep: пересборка не удалась (сбор входных данных) — рабочий набор $KEEPSET не тронут"
		fi
		say "ОТКАЗ: пересборка keep не удалась при сборе данных — прежний набор $KEEPSET остаётся"
		return 1
	fi
	if ! keep_check "$KEEPSETNEW"; then
		ipset destroy "$KEEPSETNEW" 2>/dev/null
		if [ ! -f "$KEEPFAILMARK" ]; then
			date +%s > "$KEEPFAILMARK" 2>/dev/null
			log "keep: новый состав не прошёл проверку — рабочий набор $KEEPSET НЕ заменён"
		fi
		say "ОТКАЗ: новый состав keep не прошёл проверку — прежний набор $KEEPSET остаётся в силе"
		return 1
	fi
	set_exists "$KEEPSET" || ipset create "$KEEPSET" hash:net family inet 2>/dev/null
	if ! ipset swap "$KEEPSETNEW" "$KEEPSET" 2>/dev/null; then
		ipset destroy "$KEEPSETNEW" 2>/dev/null
		if [ ! -f "$KEEPFAILMARK" ]; then
			date +%s > "$KEEPFAILMARK" 2>/dev/null
			log "keep: подмена набора не удалась — рабочий набор $KEEPSET остаётся прежним"
		fi
		say "ОТКАЗ: подмена keep не удалась — прежний набор остаётся"
		return 1
	fi
	ipset destroy "$KEEPSETNEW" 2>/dev/null
	echo "$_fp_new" > "$KEEPFP" 2>/dev/null
	[ -f "$KEEPFAILMARK" ] && rm -f "$KEEPFAILMARK" 2>/dev/null
	log "keep: набор пересобран по изменившемуся отпечатку (записей: $(ipset list "$KEEPSET" 2>/dev/null | sed -n '/^Members:/,$p' | grep -vc '^Members:'))"
	say "keep пересобран: отпечаток изменился, набор $KEEPSET обновлён и проверен"
	return 0
}

# white_addr_ok — адрес источника годен: ровно IPv4 без маски и ИЗ ЧАСТНОЙ СЕТИ.
#
# Частная сеть — не придирчивость: слой предназначен одному устройству в доме, а
# публичный адрес в -s означал бы, что человек ошибся полем и мы завернём чужой
# транзит. Отказ дешевле разбирательства.
white_addr_ok() {
	case "$1" in
		*/*) return 1 ;;
		*[!0-9.]*) return 1 ;;
	esac
	echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$' || return 1
	case "$1" in
		10.*|192.168.*) return 0 ;;
		172.1[6-9].*|172.2[0-9].*|172.3[01].*) return 0 ;;
		100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) return 0 ;;
	esac
	return 1
}

white_state_get() { [ -f "$WHITESTATE" ] && sed -n "s/^$1=//p" "$WHITESTATE" 2>/dev/null | head -1; }

white_on() { [ -f "$WHITESTATE" ]; }

# white_rules — состав цепочки ОДНИМ СПИСКОМ, чтобы и ставить, и сверять по
# одному источнику. Порядок значим: сначала выходы, потом безусловная пометка.
white_rules() {
	_a="$1"
	# ИНВЕРСИЯ (шаг 10): каждое исключение СНИМАЕТ метку и только потом
	# выходит — RETURN сам по себе не отменяет то, что уже поставила чужая
	# помечающая цепочка ВЫШЕ нас (см. white_position_ensure про то, что
	# может стоять НИЖЕ). Маска обязательна: 0x0/$MASK снимает только наше
	# поле, не задевая 0x40000000 (nfqws, шаг 9) и биты прошивки.
	echo "-A $WHITECHAIN -s $_a -m conntrack --ctdir REPLY -j MARK --set-xmark 0x0/$MASK"
	echo "-A $WHITECHAIN -s $_a -m conntrack --ctdir REPLY -j RETURN"
	echo "-A $WHITECHAIN -s $_a -m set --match-set $KEEPSET dst -j MARK --set-xmark 0x0/$MASK"
	echo "-A $WHITECHAIN -s $_a -m set --match-set $KEEPSET dst -j RETURN"
	echo "-A $WHITECHAIN -s $_a -m set --match-set $DIRECTSET dst -j MARK --set-xmark 0x0/$MASK"
	echo "-A $WHITECHAIN -s $_a -m set --match-set $DIRECTSET dst -j RETURN"
	echo "-A $WHITECHAIN -s $_a -j MARK --set-xmark $MARK/$MASK"
	echo "-A $WHITECHAIN -s $_a -j CONNMARK --save-mark --nfmask $MASK --ctmask $MASK"
}

# white_home_active_chain — КОТОРАЯ ИЗ ПОЛОВИН (A/B) РЕАЛЬНО СТОИТ В
# PREROUTING ПРЯМО СЕЙЧАС (1.70). Спрашиваем предмет, не помним: после
# переключения активной становится то, на что показывает прыжок, а не то,
# что мы в прошлый раз построили. Пусто — прыжка нет вовсе (белый дом ни
# разу не включали, либо снят).
white_home_active_chain() {
	ipt -C PREROUTING -j "$WHITEHOMECHAIN_A" 2>/dev/null && { echo "$WHITEHOMECHAIN_A"; return 0; }
	ipt -C PREROUTING -j "$WHITEHOMECHAIN_B" 2>/dev/null && { echo "$WHITEHOMECHAIN_B"; return 0; }
	return 1
}

# white_home_inactive_chain — ДРУГАЯ половина, та, что сейчас НЕ прыгнута и
# в которую безопасно строить: живого трафика через неё не идёт, флашить и
# наполнять можно не оглядываясь. Прыжка нет вовсе (первое включение) —
# половина A, по соглашению.
white_home_inactive_chain() {
	_whi=$(white_home_active_chain)
	if [ "$_whi" = "$WHITEHOMECHAIN_A" ]; then
		echo "$WHITEHOMECHAIN_B"
	else
		echo "$WHITEHOMECHAIN_A"
	fi
}

# state_set_white_chain_ok <yes|no> [причина] — ОДИН ФАЙЛ, ОДНА ПРАВДА,
# читает cmd_status ключами white_chain_ok=/white_chain_ok_reason=.
# «no» без причины не бывает: вызывающий обязан назвать её словами.
state_set_white_chain_ok() {
	mkdir -p "$(dirname "$WHITECHAINOK_STATE")" 2>/dev/null
	{ echo "ok=$1"; echo "reason=${2:-}"; echo "at=$(date +%s)"; } > "$WHITECHAINOK_STATE.tmp.$$" 2>/dev/null \
		&& mv -f "$WHITECHAINOK_STATE.tmp.$$" "$WHITECHAINOK_STATE" 2>/dev/null
}

# white_aktivnaya_cepochka — КАКАЯ ИЗ НАШИХ БЕЛЫХ ЦЕПОЧЕК РЕАЛЬНО СТОИТ В
# PREROUTING, ЛЮБОГО ИЗ ДВУХ РЕЖИМОВ. Спрашиваем предмет, а не помним имя:
# цепочек стало три (слой на одно устройство, половина A и половина B режима
# дома), они не все взаимно исключаются просто по имени, и зашитое имя
# означало бы, что ключ статуса врёт в части случаев.
white_aktivnaya_cepochka() {
	_wac_h=$(white_home_active_chain) && { echo "$_wac_h"; return 0; }
	ipt -C PREROUTING -j "$WHITECHAIN" 2>/dev/null && { echo "$WHITECHAIN"; return 0; }
	return 1
}

# schyot_pravil — СУММА СЧЁТЧИКОВ ВСЕХ ПРАВИЛ ЦЕПОЧКИ, ПОДХОДЯЩИХ ПОД ПРИЗНАК.
#
# Общий помощник для всех производных ключей: позиции правил берём из `-S`
# (там видно, ЧТО правило делает), счётчики — из `-L -v -n -x` по тому же
# номеру. Строки правил в выводе отбираем по содержимому (первое поле —
# число), а не по номеру строки: у разных сборок iptables разное число
# заголовочных строк — на этом уже пришлось чинить cmd_gw_teardown.
#
# Зачем помощник, а не три похожих awk: «первая строка с таким текстом» —
# признак, который тихо портится от добавления второго правила. Один раз он
# уже соврал (white_marked показал 0 при 39723 в цепочке), и врал бы
# правдоподобно, если бы первой оказалась живая строка.
#
# Аргументы: цепочка, признак для grep по -S, обёртка таблицы (ipt или iptf).
# hod_schyot — «сколько раз это вызывалось с перезагрузки». Отдельно от
# ключей присутствия: «крючок на месте» и «крючок отработал» — разные факты,
# и пять дней с неработающим клэмпом показали, чем кончается их смешение.
hod_schyot() { _hsf="$1"; _hsv=$(cat "$_hsf" 2>/dev/null); case "$_hsv" in ''|*[!0-9]*) echo 0 ;; *) echo "$_hsv" ;; esac; }
hod_plyus() {
	mkdir -p "$RUNDIR" 2>/dev/null
	_hpv=$(hod_schyot "$1")
	echo $(( _hpv + 1 )) > "$1" 2>/dev/null
	return 0
}

# schyot_pravil (snapshot-ветка) — ОДИН awk НА ВЕСЬ ЗАПРОС (1.79, владелец,
# 22.09.2026: «сначала ускорение», после того как A/B на HERO 1.76 vs 1.77
# показал их статистически неотличимыми — файловая нарезка 1.77 не была ни
# вредна, ни полезна, узкое место оказалось в другом: число форков на один
# status. Было — на КАЖДОЕ совпадающее правило свой отдельный `sed` (дважды)
# внутри shell-цикла: для чейна с K совпадениями это 1(grep поиска строк) +
# 2K(извлечение счётчика) форков, не считая mkdir/rm временного файла. Стало —
# один awk, который сам находит совпадения И суммирует счётчики за один
# проход по уже прочитанному в память снимку, без файлов и без цикла с
# подпроцессами внутри. Живая ветка (не через снимок) не тронута.
schyot_pravil() {
	_spc="$1"; _spp="$2"; _spt="${3:-ipt}"
	# 1.90: снимок теперь есть у всех трёх таблиц, поэтому и счётчики берём
	# из него для всех трёх, а не только для mangle. Пустой кусок таблицы =
	# снимка по ней нет: уходим в живую ветку, а не отвечаем «не найдено».
	# ВЫБОР КУСКА СНИМКА — БЕЗ ПОДСТАНОВКИ КОМАНДЫ. `$(функция)` здесь была
	# бы forkом на КАЖДЫЙ вызов счётчика, то есть вернула бы ровно то, что мы
	# этой правкой убираем. Простой case, ни одного процесса.
	case "$_spt" in
		ipt)  _spsn="$_IPTSNAP_S" ;;
		iptn) _spsn="$_IPTSNAP_N" ;;
		iptf) _spsn="$_IPTSNAP_F" ;;
		*)    _spsn="" ;;
	esac
	if [ -n "$_IPTSNAP_ON" ] && [ -n "$_spsn" ]; then
		printf '%s\n' "$_spsn" | awk -v ch="$_spc" -v pat="$_spp" '
			{
				line = $0
				if (line !~ ("^\\[[0-9]+:[0-9]+\\] -A " ch " ")) next
				bare = line
				sub(/^\[[0-9]*:[0-9]*\] /, "", bare)
				if (bare !~ pat) next
				found = 1
				cnt = line
				sub(/^\[/, "", cnt); sub(/:.*/, "", cnt)
				sum += cnt + 0
			}
			END { if (!found) exit 1; print sum + 0 }
		'
		return $?
	fi
	_spi=$($_spt -S "$_spc" 2>/dev/null | grep -v '^-N ' | grep -n -- "$_spp" | cut -d: -f1)
	[ -n "$_spi" ] || return 1
	_sps=0
	for _spn in $_spi; do
		_spv=$($_spt -L "$_spc" -v -n -x 2>/dev/null | awk -v n="$_spn" '$1 ~ /^[0-9]+$/ { k++; if (k == n) { print $1; exit } }')
		case "$_spv" in ''|*[!0-9]*) continue ;; esac
		_sps=$((_sps + _spv))
	done
	echo "$_sps"
	return 0
}

# schyot_pravil_mnogo — ТО ЖЕ, ЧТО schyot_pravil, НО ОДНИМ СНИМКОМ НА
# НЕСКОЛЬКО ПРИЗНАКОВ СРАЗУ (1.68, владелец, 21.09.2026, инвариант 22).
#
# Раздельные вызовы schyot_pravil на одну и ту же цепочку делают КАЖДЫЙ свою
# пару -S/-L — а трафик в цепочке течёт между вызовами (в $SELFDNSCHAIN это
# ВЕСЬ исходящий с роутера, не только DNS). Два вызова подряд на разные
# признаки той же цепочки видят РАЗНЫЕ моменты живого счётчика, и числа
# расходятся не от ошибки арифметики, а от времени между чтениями — это и
# поймал владелец между разделами 3 и 5 живого прогона. Здесь -S и -L
# читаются РОВНО ОДИН РАЗ на всю группу признаков, дальше только парсинг.
#
# Печатает по одной строке на признак, В ТОМ ЖЕ ПОРЯДКЕ, что даны аргументы;
# пустая строка — признак не найден (как return 1 у одиночного варианта, но
# сигнал строкой: одна пустая строка не должна портить разбор соседних).
schyot_pravil_mnogo() {
	_spmc="$1"; _spmt="$2"; shift 2
	# ВЫБОР КУСКА СНИМКА — БЕЗ ПОДСТАНОВКИ КОМАНДЫ. `$(функция)` здесь была
	# бы forkом на КАЖДЫЙ вызов счётчика, то есть вернула бы ровно то, что мы
	# этой правкой убираем. Простой case, ни одного процесса.
	case "$_spmt" in
		ipt)  _spmsn="$_IPTSNAP_S" ;;
		iptn) _spmsn="$_IPTSNAP_N" ;;
		iptf) _spmsn="$_IPTSNAP_F" ;;
		*)    _spmsn="" ;;
	esac
	if [ -n "$_IPTSNAP_ON" ] && [ -n "$_spmsn" ]; then
		# ОДИН awk НА ВСЮ ГРУППУ ПРИЗНАКОВ СРАЗУ (1.79) — та же причина, что у
		# schyot_pravil выше: раньше N признаков давали N живых grep-поисков
		# ПЛЮС по 2 форка на каждое совпадение внутри каждого. Патterny
		# передаются awk'у через -v одной строкой, по одному на \n (сами
		# паттерны однострочные литералы/собраны из имён цепочек — переноса
		# строки внутри них не бывает); awk копит суммы по всем сразу за один
		# проход по чейну и печатает построчно, в порядке аргументов, как и
		# раньше.
		_spm_patstr=""
		for _spm_p in "$@"; do
			_spm_patstr="$_spm_patstr$_spm_p
"
		done
		printf '%s\n' "$_spmsn" | awk -v ch="$_spmc" -v patstr="$_spm_patstr" '
			BEGIN {
				n = split(patstr, rawpat, "\n")
				np = 0
				for (i = 1; i <= n; i++) {
					if (rawpat[i] == "") continue
					np++
					pat[np] = rawpat[i]
				}
			}
			{
				line = $0
				if (line !~ ("^\\[[0-9]+:[0-9]+\\] -A " ch " ")) next
				bare = line
				sub(/^\[[0-9]*:[0-9]*\] /, "", bare)
				cnt = line
				sub(/^\[/, "", cnt); sub(/:.*/, "", cnt)
				cnt = cnt + 0
				for (i = 1; i <= np; i++) {
					if (bare ~ pat[i]) { found[i] = 1; sum[i] += cnt }
				}
			}
			END {
				for (i = 1; i <= np; i++) {
					if (found[i]) print sum[i] + 0; else print ""
				}
			}
		'
		return 0
	fi
	_spm_s=$($_spmt -S "$_spmc" 2>/dev/null | grep -v '^-N ')
	_spm_l=$($_spmt -L "$_spmc" -v -n -x 2>/dev/null)
	for _spm_p in "$@"; do
		_spmi=$(printf '%s\n' "$_spm_s" | grep -n -- "$_spm_p" | cut -d: -f1)
		if [ -z "$_spmi" ]; then
			echo ""
			continue
		fi
		_spms=0
		for _spmn in $_spmi; do
			_spmv=$(printf '%s\n' "$_spm_l" | awk -v n="$_spmn" '$1 ~ /^[0-9]+$/ { k++; if (k == n) { print $1; exit } }')
			case "$_spmv" in ''|*[!0-9]*) continue ;; esac
			_spms=$((_spms + _spmv))
		done
		echo "$_spms"
	done
	return 0
}

# white_marked — сколько пакетов НАША ПОМЕТКА реально поставила. Ноль до
# прогона и рост во время — единственный однозначный признак, что инверсия
# работает, и на этот ключ будет смотреть автопереход (10б-2).
#
# ДВЕ ОШИБКИ ПРЕЖНЕЙ РЕДАКЦИИ, обе найдены на живой приёмке 20.09.2026, когда
# status показал white_marked=0, а счётчики цепочки — 2623 пакета:
#
#   1. «первая строка MARK» перестала означать «пометка». После шага 10 в
#      цепочке ЧЕТЫРЕ строки MARK, и три из них СНИМАЮТ метку (0x0/маска); а
#      в цепочке дома первой идёт вообще пометка трафика к резолверам, у
#      которой ноль пакетов, пока никто не ходит к 1.1.1.1 напрямую. Брали
#      первую попавшуюся — получали чужой счётчик. Тот же класс, на котором
#      уже горел TestKeepGateOtkryvaetsjaINetPetli;
#   2. имя цепочки было зашито.
#
# Стало: складываем счётчики ВСЕХ правил, которые ставят именно нашу метку.
# Позиции берём из `-S` (там видно `--set-xmark $MARK/$MASK` и не видно
# снятий), а счётчики — из `-L -v -n -x` по тому же номеру правила.
# СТРОКИ ПРАВИЛ ОТБИРАЕМ ПО СОДЕРЖИМОМУ, А НЕ ПО НОМЕРУ СТРОКИ ВЫВОДА: у
# разных сборок iptables разное число заголовочных строк — ровно то, на чём
# уже пришлось чинить cmd_gw_teardown. Признак строки правила — первое поле
# число (счётчик пакетов).
white_marked() {
	_wmc="${1:-}"
	[ -n "$_wmc" ] || _wmc=$(white_aktivnaya_cepochka) || return 1
	schyot_pravil "$_wmc" "--set-xmark $MARK/$MASK" ipt
}

# nft_meridian_active — есть ли на этом роутере РАБОЧАЯ nftables-таблица
# inet meridian (путь OpenWrt: /etc/qwdtt/meridian.nft, разметка в своём
# синтаксисе, отдельная от этого файла реализация — Кот 2). Проверяем ФАКТ,
# а не имя прошивки: два независимых движка разметки на одном и том же
# трафике хуже одного неверного, и решение не должно зависеть от того,
# правильно ли мы угадали, что за прошивка перед нами.
#
# Инверсия (шаг 10) — этой таблицы не касается и не обязана понимать её
# синтаксис. Включать white-test поверх рабочего nft-пути значит поставить
# ДВЕ системы пометки на один пакет — какая победит, этим релизом не
# определено, и выяснять это на живом абоненте нельзя.
# --------------------------------------------------------------------------
# БЕЛЫЙ РЕЖИМ НА ВЕСЬ ДОМ: состав цепочки, ворота, применение, снятие
# --------------------------------------------------------------------------

# dns_direct_sets — ИМЕНА НАБОРОВ ДОМЕНОВ (meridian-dns), НЕ АДРЕСОВ.
#
# ДЫРА, ЗАКРЫВАЕМАЯ ЭТОЙ ФУНКЦИЕЙ (владелец, 21.09.2026): слияние 1.59-1.61
# подключило домены к `white list show|add|del`, но НИ ОДНО правило в
# MERIDIAN_WHITE_HOME на набор доменов не ссылалось — исход (б) из двух
# названных владельцем: домены ложились в набор, который никто не читает,
# и список «напрямую» по доменам НЕ ДЕЙСТВОВАЛ ВООБЩЕ, молча. Худший из двух
# возможных исходов, потому что выглядел рабочим.
#
# ИМЯ НЕ ЗАШИВАЕТСЯ (договор с котом 2): читаем `direct_sets=` из
# `meridian-dns status`, тем же приёмом, что `keep_dns()` читает clean_addrs.
#
# НЕПРОЧИТАННЫЙ — НЕ ПУСТОЙ. При молчании meridian-dns сохраняем ПОСЛЕДНЕЕ
# известное имя (файл состояния) и не снимаем пару строк из-за одной неудачной
# попытки спросить статус — иначе секундная заминка meridian-dns на каждом
# `ensure` выключала бы исключение доменов и включала обратно, а трафик к уже
# добавленным доменам на эту секунду уезжал бы в тайм-аут.
#
# СТРОКИ СНИМАЮТСЯ ТОЛЬКО КОГДА НАБОРА ДЕЙСТВИТЕЛЬНО НЕТ В IPSET — это
# проверяет вызывающий (`white_home_rules`) через `set_exists`, не эта
# функция: у неё другая работа, смешивать их означало бы не различать
# «не спросили» и «спросили и набора нет».
dns_direct_sets() {
	# ЖИВОЙ ВЫЗОВ — ЧЕРЕЗ ОБЩИЙ КЭШ ПРОЦЕССА (dns_status_live), НЕ СВОЙ:
	# один запуск движка, спросивший и keep_dns(), и dns_direct_sets(),
	# раньше слал два живых `meridian-dns status» подряд.
	_dds=$(dns_status_live 2>/dev/null | sed -n 's/^direct_sets=//p' | head -1)
	if [ -n "$_dds" ]; then
		printf '%s' "$_dds" > "$DIRECTDNSSETS_STATE" 2>/dev/null
	else
		_dds=$(cat "$DIRECTDNSSETS_STATE" 2>/dev/null)
	fi
	printf '%s\n' "$_dds" | tr ',' '\n' | grep -v '^$'
}

# dns_upstream_show/clean_only/split — переключатель апстрима meridian-dns
# (кот 2, 0.29+). БЕЗ -config: тот же экземпляр, что отвечает на `status`
# (СЕРВЕР, не сторож — см. запись про два процесса в SOSTOYANIE.md), апстрим
# — свойство всего сервера, а не отдельной группы доменов.
#
# АСИММЕТРИЯ ЗАКРЫТА ВЛАДЕЛЬЦЕМ (тот же приём, что sets flush): не удался
# clean-only на `white on` — режим НЕ включать, слой ни на что не влиял бы,
# пока апстрим не переключён; не удался split на `white off` — снять ВСЁ
# РАВНО, но громко, потому что молчание об отказе здесь хуже, чем откат
# режима, который трафик уже вернул прежним путём.
dns_upstream_clean_only() { [ -x "$DNSBIN" ] || return 1; run_bounded 10 "$DNSBIN" upstream clean-only; }
dns_upstream_split()      { [ -x "$DNSBIN" ] || return 1; run_bounded 10 "$DNSBIN" upstream split; }

white_home_on() { [ "$(state_get mode)" = "white" ]; }

# white_home_rules — состав цепочки ОДНИМ СПИСКОМ, тем же приёмом, что у
# white_rules: и ставим, и сверяем по одному источнику.
#
# ПОРЯДОК ЗНАЧИМ, и самое важное в нём — ДВЕ СТРОКИ ПРО РЕЗОЛВЕРЫ ПЕРЕД
# выходом по keep (решение владельца 20.09.2026).
#
# Зачем они. `meridian_keep4` — hash:net, портов не знает, и адреса чистых
# резолверов лежат в нём ЦЕЛИКОМ (решение 05.09: роутер ходит к ним напрямую,
# DoT внутри TLS, имён провайдер не видит). Но набор один, а потребителя два:
# роутер И дом. При радиусе одного ноутбука это была мелочь, при радиусе дома
# — утечка: устройство с прописанным вручную 1.1.1.1 пошло бы к нему НАПРЯМУЮ
# и ОТКРЫТЫМ текстом, то есть ровно то, ради чего белый режим и затевается.
#
# Поэтому: трафик ДОМА к адресам резолверов помечается и выходит ДО того, как
# до него доберётся выход по keep. Роутер при этом ходит к ним по-прежнему
# напрямую — его пакеты рождаются в OUTPUT и в эту цепочку не заходят вовсе.
# Аргумент 1 — цепочка-получатель (1.70): раньше имя было зашито, а с двумя
# живыми половинами (A/B) генератор обязан уметь построить строки для ЛЮБОЙ
# из них, включая временную WHITEHOMECHAIN_CHK для сверки-эталона.
white_home_rules() {
	_whr_chain="${1:?white_home_rules: нужна цепочка-получатель}"
	for _hn in $(home_nets); do
		for _hr in $(keep_dns 2>/dev/null); do
			echo "-A $_whr_chain -s $_hn -d $_hr -j MARK --set-xmark $MARK/$MASK"
			echo "-A $_whr_chain -s $_hn -d $_hr -j RETURN"
		done
		# Дальше — тот же состав, что у слоя на одно устройство: снятие метки
		# перед КАЖДЫМ исключением (шаг 10), потом безусловная пометка.
		echo "-A $_whr_chain -s $_hn -m conntrack --ctdir REPLY -j MARK --set-xmark 0x0/$MASK"
		echo "-A $_whr_chain -s $_hn -m conntrack --ctdir REPLY -j RETURN"
		echo "-A $_whr_chain -s $_hn -m set --match-set $KEEPSET dst -j MARK --set-xmark 0x0/$MASK"
		echo "-A $_whr_chain -s $_hn -m set --match-set $KEEPSET dst -j RETURN"
		echo "-A $_whr_chain -s $_hn -m set --match-set $DIRECTSET dst -j MARK --set-xmark 0x0/$MASK"
		echo "-A $_whr_chain -s $_hn -m set --match-set $DIRECTSET dst -j RETURN"
		# ВТОРОЙ ПРЯМОЙ НАБОР — ДОМЕНЫ (кот 2). Пара на КАЖДЫЙ набор, что
		# отдаёт dns_direct_sets(), и ТОЛЬКО если набор реально есть в ipset —
		# несуществующий набор в -m set --match-set уронил бы правило целиком
		# (ошибка ядра xt_set, не безвредная строка, тот же класс, что у
		# GWSET в gw_rules_apply).
		for _hdds in $(dns_direct_sets); do
			set_exists "$_hdds" || continue
			echo "-A $_whr_chain -s $_hn -m set --match-set $_hdds dst -j MARK --set-xmark 0x0/$MASK"
			echo "-A $_whr_chain -s $_hn -m set --match-set $_hdds dst -j RETURN"
		done
		echo "-A $_whr_chain -s $_hn -j MARK --set-xmark $MARK/$MASK"
		echo "-A $_whr_chain -s $_hn -j CONNMARK --save-mark --nfmask $MASK --ctmask $MASK"
	done
}

# white_home_apply — ПОСТАВИТЬ ЦЕПОЧКУ АТОМАРНО (1.70, владелец, 21.09.2026,
# инвариант 41 — после живого случая 20.09.2026, см. запись у WHITEHOMECHAIN_A
# выше). ЖИВУЮ (активную) половину НЕ ТРОГАЕМ вообще, пока новая не построена
# и не сверена ЦЕЛИКОМ в НЕАКТИВНОЙ. Переключение — ОДНО действие (-R по
# позиции прыжка), и только оно ограничено по времени: проверено на стенде —
# `iptables -E` (переименование) НЕ переставляет существующий прыжок на новое
# имя, прыжок продолжает указывать на СТАРОЕ содержимое под новым именем;
# рабочий способ — замена самого правила прыжка, `-R PREROUTING <позиция> -j
# <новая половина>`, одной командой ядра.
white_home_apply() {
	_wha_target=$(white_home_inactive_chain)
	ipt -N "$_wha_target" 2>/dev/null
	ipt -F "$_wha_target" 2>/dev/null
	white_home_rules "$_wha_target" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	# Эталон строится ТЕМ ЖЕ ПУТЁМ во временной ТРЕТЬЕЙ цепочке (не в живой
	# половине!): iptables нормализует то, что читает (-s 192.168.1.0/24
	# против /24, порядок модулей), и сравнивать рукописную строку с его
	# выводом нельзя — обожглись 05.09.
	ipt -N "$WHITEHOMECHAIN_CHK" 2>/dev/null
	ipt -F "$WHITEHOMECHAIN_CHK" 2>/dev/null
	white_home_rules "$WHITEHOMECHAIN_CHK" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	_wh_want=$(ipt -S "$WHITEHOMECHAIN_CHK" 2>/dev/null | grep -v "^-N " | sed "s/^-A $WHITEHOMECHAIN_CHK /-A ЦЕПОЧКА /")
	_wh_have=$(ipt -S "$_wha_target" 2>/dev/null | grep -v "^-N " | sed "s/^-A $_wha_target /-A ЦЕПОЧКА /")
	ipt -F "$WHITEHOMECHAIN_CHK" 2>/dev/null
	ipt -X "$WHITEHOMECHAIN_CHK" 2>/dev/null
	# ПУСТОЕ ОЖИДАНИЕ — НЕ СОВПАДЕНИЕ (правило 39).
	if [ -z "$_wh_want" ] || [ "$_wh_want" != "$_wh_have" ]; then
		say "ОТКАЗ: сборка $_wha_target разошлась с образцом — ЖИВАЯ цепочка не тронута."
		say "ждали:"; printf '%s\n' "$_wh_want" | sed 's/^/    /'
		say "получилось:"; printf '%s\n' "$_wh_have" | sed 's/^/    /'
		state_set_white_chain_ok no "сборка $_wha_target разошлась с образцом"
		return 1
	fi
	_wha_active=$(white_home_active_chain)
	if [ -z "$_wha_active" ]; then
		# ПЕРВОЕ ВКЛЮЧЕНИЕ — прыжка ещё нет, ставить его ОБЫЧНЫМ добавлением
		# безопасно: до него собранная половина ни на что не влияла.
		ipt -A PREROUTING -j "$_wha_target" 2>/dev/null
		ipt -C PREROUTING -j "$_wha_target" 2>/dev/null || {
			say "ОТКАЗ: прыжок на $_wha_target не встал."
			state_set_white_chain_ok no "первый прыжок не встал"
			return 1
		}
	else
		# ПЕРЕКЛЮЧЕНИЕ — ЕДИНСТВЕННОЕ МЕСТО С ПРЕДЕЛОМ ПО ВРЕМЕНИ (инвариант
		# 41). IPTW на этом роутере может быть просто "-w" без числа (iptables
		# 1.4.21, см. запись у IPTW) — то есть без верхнего предела ожидания
		# замка ядра САМ ПО СЕБЕ. run_bounded — наш собственный предел поверх.
		_wha_pos=$(ipt -S PREROUTING 2>/dev/null | grep -v '^-P ' | grep -n -- "-j $_wha_active\$" | head -1 | cut -d: -f1)
		if [ -z "$_wha_pos" ]; then
			say "ОТКАЗ: не нашёл позицию текущего прыжка ($_wha_active) в PREROUTING — переключать не на что опереться."
			state_set_white_chain_ok no "позиция текущего прыжка не найдена"
			return 1
		fi
		# ЧЕРЕЗ ГОЛЫЙ iptables, НЕ ЧЕРЕЗ ipt(): run_bounded с timeout зовёт
		# внешнюю программу с этим именем аргументом — «ipt» ИМЕНИ ТАКОГО НЕТ
		# на диске, это шелл-функция, и на роутере с настоящим timeout
		# (не этот, но не гадаем про остальной парк) вызов молча не найдёт
		# команду.
		run_bounded 5 iptables $IPTW -t mangle -R PREROUTING "$_wha_pos" -j "$_wha_target"
		_wha_rc=$?
		if [ "$_wha_rc" != 0 ]; then
			say "ОТКАЗ: атомарное переключение прыжка не удалось (код $_wha_rc за пределом 5с) — прежняя цепочка $_wha_active остаётся живой и рабочей."
			state_set_white_chain_ok no "переключение прыжка не уложилось в предел"
			return 1
		fi
		ipt -C PREROUTING -j "$_wha_target" 2>/dev/null || {
			say "ОТКАЗ: после переключения прыжок указывает не на $_wha_target."
			state_set_white_chain_ok no "прыжок после -R не на новую половину"
			return 1
		}
	fi
	state_set_white_chain_ok yes
	return 0
}

# white_home_teardown — снять БЕЗ разговоров, ОБЕ половины (1.70). Отдельно
# от cmd_white_off, потому что зовётся и из отката, и из общего off.
# white_home_all_names — ОДИН СПИСОК ИМЁН ЦЕПОЧЕК ДОМАШНЕГО БЕЛОГО РЕЖИМА, В
# ОДНОМ МЕСТЕ (1.74, владелец, 21.09.2026, инвариант 36 — живой дефект на
# HERO: после off в mangle остался MERIDIAN_WHITE_HOME_A, весь дом продолжал
# идти туннелем при mode=black). Три имени: базовое (без суффикса — вдруг
# где-то остался след ДО 1.70, когда A/B ещё не было) и обе половины 1.70.
# Кто угодно, кому нужен ПОЛНЫЙ список (teardown, самолечение ensure,
# проверка в status), зовёт ЭТУ функцию — вторая копия списка однажды
# забудет одно из трёх имён, как и случилось здесь.
white_home_all_names() {
	echo "$WHITEHOMECHAIN"
	echo "$WHITEHOMECHAIN_A"
	echo "$WHITEHOMECHAIN_B"
}

# white_home_teardown — снять ВСЕ известные имена, и ГРОМКО, если что-то не
# снялось. ДО этой правки цикл ловил ОДИН отказ -D через `|| break` и молчал:
# под нагрузкой (живой замер на HERO — load average 2.4-3.2) -D мог
# отказать один раз из-за гонки за xtables-замок, цикл выходил, а
# последующие -F/-X на цепочку с ЖИВЫМ прыжком тоже отказывали — обе ошибки
# уходили в /dev/null, наружу не долетало ничего. Теперь -D повторяется до
# 10 раз, а после цикла — ЯВНАЯ проверка -C и chain_exists: если прыжок или
# цепочка всё ещё живы, teardown говорит об этом вслух (say+log) и
# возвращает 1, вместо тихого «готово» на недоделанной работе.
white_home_teardown() {
	_wht_bad=0
	for _wht_c in $(white_home_all_names); do
		_wht_try=0
		while [ "$_wht_try" -lt 10 ] && ipt -C PREROUTING -j "$_wht_c" 2>/dev/null; do
			ipt -D PREROUTING -j "$_wht_c" 2>/dev/null
			_wht_try=$((_wht_try + 1))
		done
		if ipt -C PREROUTING -j "$_wht_c" 2>/dev/null; then
			say "ОТКАЗ: прыжок PREROUTING -> $_wht_c не снимается после $_wht_try попыток -D."
			log "white_home_teardown: прыжок на $_wht_c живой после $_wht_try попыток -D"
			_wht_bad=1
			continue
		fi
		ipt -F "$_wht_c" 2>/dev/null
		ipt -X "$_wht_c" 2>/dev/null
		if chain_exists "$_wht_c"; then
			say "ОТКАЗ: цепочка $_wht_c осталась после -F/-X."
			log "white_home_teardown: цепочка $_wht_c не снялась после -F/-X"
			_wht_bad=1
		fi
	done
	ipt -F "$WHITEHOMECHAIN_CHK" 2>/dev/null
	ipt -X "$WHITEHOMECHAIN_CHK" 2>/dev/null
	rm -f "$WHITECHAINOK_STATE" 2>/dev/null
	# МАРКЕР «КОГДА-ТО ВКЛЮЧАЛИ» СНИМАЕТСЯ ТОЛЬКО ПРИ ПОЛНОЙ ЧИСТОТЕ. Если
	# снятие осталось недоделанным ($_wht_bad=1), маркер нарочно остаётся —
	# именно он включает самолечение в ensure на следующем тике.
	[ "$_wht_bad" = 0 ] && rm -f "$WHITEHOMEEVERUSED" 2>/dev/null
	return "$_wht_bad"
}

# mss_local_teardown — снять локальный клэмп. Отдельно, потому что его ставит
# не белый режим, а общая проводка, и снимается он вместе с ней.
mss_local_teardown() {
	while ipt -C OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null; do
		ipt -D OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null || break
	done
	ipt -F "$CH_MSS_LOCAL" 2>/dev/null
	ipt -X "$CH_MSS_LOCAL" 2>/dev/null
}

# white_home_snaruzhi — «человек подключён СНАРУЖИ?». Отдельными воротами,
# которых у слоя на одно устройство не было и не требовалось: там ошибка
# стоила интернета на ноутбуке, здесь — доступа к роутеру у того, кто прямо
# сейчас его переключает, ДО того как успеет подтвердить.
white_home_snaruzhi() {
	_src=$(echo "${SSH_CONNECTION:-}" | awk '{print $1}')
	[ -n "$_src" ] || return 1
	for _n in $(home_nets); do
		cidr_contains "$_n" "$_src" && return 1
	done
	echo "$_src"
	return 0
}

# white_home_vorota — ВСЕ ворота одним местом, каждая со своим отказом.
white_home_vorota() {
	if nft_meridian_active; then
		say "ОТКАЗ: на этом роутере разметка живёт в nftables (таблица inet meridian, путь OpenWrt) — этот движок её не понимает и не трогает."
		return 1
	fi
	if white_home_on; then
		say "ОТКАЗ: белый режим уже включён."
		return 1
	fi
	if white_on; then
		say "ОТКАЗ: включён опытный слой white-test для $(white_state_get addr). Сначала снимите его."
		return 1
	fi
	if [ "$(state_get mode)" != "black" ] || [ "$(state_get confirmed)" != "yes" ]; then
		say "ОТКАЗ: чёрный режим не включён или не подтверждён — метить некуда."
		return 1
	fi
	if ! iface_exists; then
		say "ОТКАЗ: туннеля $(tun_name) сейчас нет. Весь дом ушёл бы в удержание."
		return 1
	fi
	if ! route_mine_present; then
		say "ОТКАЗ: в таблице $TABLE нет нашего маршрута. Сначала: $0 ensure"
		return 1
	fi
	have ipset || { say "ОТКАЗ: нет ipset"; return 1; }
	# IPv6 — ВОРОТА, И ФЛАГА ОБХОДА НЕТ (решение владельца 20.09.2026).
	# Весь слой на IPv4. Есть маршрут наружу по IPv6 — дом уходит мимо
	# туннеля, а наши проверки по IPv4 показывают зелёное: худший исход из
	# возможных, потому что выглядит он исправным.
	if [ -n "$(ip -6 route show default 2>/dev/null)" ]; then
		say "ОТКАЗ: у роутера есть маршрут по умолчанию для IPv6. Белый режим сделан на IPv4: дом ушёл бы мимо туннеля по IPv6, а проверки показывали бы зелёное."
		return 1
	fi
	_sn=$(white_home_snaruzhi) && {
		say "ОТКАЗ: вы подключены к роутеру снаружи ($_sn). Переключение оборвёт вам доступ раньше, чем вы успеете подтвердить. Включайте из домашней сети."
		return 1
	}
	if [ -z "$(home_nets)" ]; then
		say "ОТКАЗ: сетей дома не прочитано НИ ОДНОЙ. Это не «сетей нет», это «мы их не увидели» — метить вслепую нельзя."
		return 1
	fi
	# KEEP СТРОИТСЯ ЗАНОВО, А НЕ ПРОВЕРЯЕТСЯ: содержимому набора, собранного
	# когда-то, доверять нельзя, а цена ошибки здесь — отрезанный роутер.
	say "строю $KEEPSET заново (доверять прежнему содержимому нельзя)"
	keep_build || { say "ОТКАЗ: $KEEPSET не собрался — без него дом потеряет и роутер, и сам туннель."; return 1; }
	KEEP_DNS_STROGO=1 keep_check || { say "ОТКАЗ: $KEEPSET собран, но проверку не прошёл — см. выше"; return 1; }
	set_exists "$DIRECTSET" || ipset create "$DIRECTSET" hash:net 2>/dev/null
	set_exists "$DIRECTSET" || { say "ОТКАЗ: не создать набор $DIRECTSET"; return 1; }
	# НАБОР НАПОЛНЯЕТСЯ ИЗ ФАЙЛА ПРИ КАЖДОМ ВКЛЮЧЕНИИ: набор живёт в памяти
	# ядра и перезагрузку не переживает, а список человека обязан пережить.
	white_direct_load || { say "ОТКАЗ: не наполнить $DIRECTSET из $WHITELIST"; return 1; }
	say "исключений белого режима: $(white_direct_entries) (список: $WHITELIST)"
	return 0
}

# white_home_off_now — СНЯТИЕ БЕЗ РАЗГОВОРОВ, общий код ручного off и отката.
# Возвращает прежний режим и ГОВОРИТ СЛОВАМИ, какой именно (решение владельца:
# молчаливое превращение «выключил белый» в «включил чёрный» недопустимо,
# названное — нормально).
white_home_off_now() {
	white_home_teardown
	# АПСТРИМ meridian-dns — SPLIT, БЕЗУСЛОВНО. Асимметрия с on (владелец):
	# снимаем ВСЁ РАВНО — трафик уже вернулся прежним путём без апстрима, и
	# держать слой из-за одной неудавшейся команды значило бы качели хуже
	# самого отказа. Но отказ ГРОМКИЙ: тот же приём, что sets flush в off.
	if ! dns_upstream_split; then
		say "ВНИМАНИЕ: meridian-dns НЕ подтвердил переключение апстрима на split — он мог остаться на clean-only."
		log "БЕЛЫЙ РЕЖИМ ДОМА снят: meridian-dns НЕ подтвердил split — апстрим мог остаться на clean-only"
	fi
	# НАБОР ЧЕЛОВЕКА УНИЧТОЖАЕТСЯ, а не остаётся наполненным (решение
	# владельца по шагу 10): одна и та же запись значит разное в чёрном и
	# белом режиме, и следующее включение не должно наследовать прежний
	# список. Порядок обязателен: правила, ссылающиеся на набор, сняты выше,
	# иначе ipset откажет «набор занят».
	ipset destroy "$DIRECTSET" 2>/dev/null
	# AUTOSWITCHACTIVE — снимается здесь же (1.83): белый уходит и через
	# прямой off, и через сторож неподтверждённого таймера, и через саму
	# автомат-команду — маркер «включил автомат» не должен пережить ни один
	# из этих путей, иначе следующее ЧЕЛОВЕЧЕСКОЕ включение унаследует чужой
	# маркер, и автомат решит, что вправе выключить чужое.
	rm -f "$AUTOSWITCHACTIVE" 2>/dev/null
	_prev=""
	[ -f "$WHITEPREV" ] && _prev=$(cat "$WHITEPREV" 2>/dev/null | tr -d '\n')
	case "$_prev" in
		black) state_set black yes "белый режим снят, возвращён чёрный"
		       say "Белый режим снят. ВОЗВРАЩЁН ЧЁРНЫЙ РЕЖИМ (mode=black, подтверждён)."
		       log "белый режим снят, возвращён black" ;;
		off)   state_set off no "белый режим снят, прежний режим был выключен"
		       say "Белый режим снят. Прежний режим был ВЫКЛЮЧЕН — возвращено off."
		       log "белый режим снят, возвращён off" ;;
		*)     # ПРЕЖНИЙ РЕЖИМ НЕ ПРОЧИТАЛСЯ. Не угадываем: снимаем пометку
		       # совсем и говорим громко (решение владельца).
		       state_set off no "белый режим снят, прежний режим НЕ ПРОЧИТАН"
		       say "ВНИМАНИЕ: прежний режим не прочитан (файл $WHITEPREV пуст или недоступен)."
		       say "Белый режим снят, пометка снята СОВСЕМ, режим переведён в off."
		       say "Чёрный режим, если он нужен, включите явно: $0 on"
		       log "белый режим снят, прежний режим НЕ ПРОЧИТАН — переведено в off" ;;
	esac
	rm -f "$WHITEPREV" "$WHITEHOMESINCE" "$WHITEHOMEDEAD" "$WHITEHOMEARMED" 2>/dev/null
	# СЛОЙ out ЗДЕСЬ НЕ ТРОГАЕМ (1.76, владелец, 21.09.2026, живой дефект на
	# HERO, инвариант 43: снятие одного слоя не снимает другой). До этой
	# правки здесь стояло `rm -f "$OUTSTATE" "$OUTARMED" "$OUTNOADDRMARK"` —
	# «white off» молча гасил уже включённый и подтверждённый out (и вместе
	# с ним возвращал резолверы в $KEEPSET, поскольку keep_dns_for_set()
	# смотрит именно на out_on()+confirmed). out — независимый слой: у него
	# своя команда `out off`, свой таймер неподтверждения (OUTARMED, см.
	# ниже), и только они имеют право его снимать.
}

# white_home_armed_stop — снять ПРЕЖНЕГО сторожа белого дома тем же приёмом,
# что armed_stop() у чёрного режима (1.72, владелец, 21.09.2026, пункт 0
# хвоста шага 11). До этой правки такого не было вовсе: повторный `white on`
# в одной сессии не трогал сторожа от предыдущего включения — осиротевший
# процесс жил своим старым дедлайном и мог снять НОВУЮ, уже подтверждённую
# сессию, ничего не зная о ней. Кого убивать — по /proc/<pid>/cmdline и
# своему PID, не по имени (правило 25). Признак — «_white_home_armed», а не
# общий «_armed» из armed_stop(): тот совпал бы и с этим процессом тоже
# (подстрока), но не наоборот, и делить одну функцию на двух не выигрыш —
# каждый сторож снимает только своего.
white_home_armed_stop() {
	[ -f "$WHITEHOMEARMED" ] || return 0
	P=$(cat "$WHITEHOMEARMED" 2>/dev/null)
	rm -f "$WHITEHOMEARMED" 2>/dev/null
	case "$P" in ''|*[!0-9]*) return 0 ;; esac
	[ "$P" = "$$" ] && return 0
	[ -r "/proc/$P/cmdline" ] || return 0
	grep -aq 'meridian-route' "/proc/$P/cmdline" 2>/dev/null || return 0
	grep -aq '_white_home_armed' "/proc/$P/cmdline" 2>/dev/null || return 0
	kill "$P" 2>/dev/null
	return 0
}

# cmd_white_home_armed — предохранитель. Тот же приём, что у чёрного режима и
# у слоя white-test: отцепленный процесс, дедлайн в аргументе, подтверждение
# отменяет. След об автооткате ставится СУЩЕСТВУЮЩИМ механизмом
# (fallback_mark), второго рядом не заводим — его и снимать пришлось бы
# вторым глаголом.
cmd_white_home_armed() {
	trap '' HUP
	DEADLINE="$1"
	[ -n "$DEADLINE" ] || exit 1
	echo "$$" > "$WHITEHOMEARMED" 2>/dev/null
	while [ "$(date +%s)" -lt "$DEADLINE" ] 2>/dev/null; do
		[ "$(state_get confirmed)" = "yes" ] && { rm -f "$WHITEHOMEARMED"; exit 0; }
		white_home_on || { rm -f "$WHITEHOMEARMED"; exit 0; }
		sleep 5
	done
	[ "$(state_get confirmed)" = "yes" ] && { rm -f "$WHITEHOMEARMED"; exit 0; }
	log "БЕЛЫЙ РЕЖИМ: подтверждения не было — снимаю"
	white_home_off_now >/dev/null 2>&1
	fallback_mark unconfirmed_white white_removed_home_direct \
		"белый режим дома не подтвердили в срок — снят, весь дом снова ходит прежним путём"
	log "откат белого режима выполнен"
	rm -f "$WHITEHOMEARMED" 2>/dev/null
	exit 0
}

# white_home_tail_ok — ХВОСТ ЖИВОЙ ЦЕПОЧКИ ЦЕЛ: последняя (безусловная)
# пометка в туннель есть для КАЖДОЙ сети дома (1.70, владелец, 21.09.2026).
# Дёшево (один -S активной половины, дальше только grep) — зовётся КАЖДУЮ
# минуту, не только сразу после пересборки: живой случай 20.09.2026 показал,
# что усечение обнаруживается по несовпадению СЧЁТА правил только тогда,
# когда счёт СЛУЧАЙНО разойдётся ещё раз — иначе усечённая, но САМОЙ СЕБЕ
# равная цепочка живёт до следующей перезагрузки. Хвост — то самое место,
# без которого весь трафик мимо явных исключений идёт НЕ в туннель; его
# отсутствие проверяется НАПРЯМУЮ, а не через число строк.
white_home_tail_ok() {
	_wht_active=$(white_home_active_chain) || return 1
	_wht_have=$(ipt -S "$_wht_active" 2>/dev/null)
	[ -n "$_wht_have" ] || return 1
	for _wht_n in $(home_nets); do
		printf '%s\n' "$_wht_have" | grep -qF -- "-A $_wht_active -s $_wht_n -j MARK --set-xmark $MARK/$MASK" || return 1
		printf '%s\n' "$_wht_have" | grep -qF -- "-A $_wht_active -s $_wht_n -j CONNMARK --save-mark --nfmask $MASK --ctmask $MASK" || return 1
	done
	return 0
}

# white_home_ensure — АВТОВОССТАНОВЛЕНИЕ РЕЖИМА ДОМА. Ради него глагол и
# сделан отдельным: слой white-test возвращаться НЕ должен, а режим дома —
# обязан, иначе прошивка пересобрала правила и дом молча ушёл открытым
# каналом, ничего никому не сказав.
#
# Дёшево в обычном случае: ворота читают ФАЙЛ состояния, и на роутерах парка
# (режим там не белый) отсюда не уходит ни одного вызова iptables.
#
# ПРЕЖНЯЯ СВЕРКА ЧИСЛОМ ПРАВИЛ УБРАНА (1.70): она сама пересчитывала «сколько
# должно быть» ЖИВЫМ независимым вызовом white_home_rules() внутри ensure —
# третья копия одного факта за один заход (правило 51), и именно она стояла
# рядом с гонкой 20.09.2026. Хвост проверяется НАПРЯМУЮ (white_home_tail_ok),
# без пересчёта эталона здесь.
white_home_ensure() {
	if ! white_home_on; then
		# САМОЛЕЧЕНИЕ ОСТАТКА (1.74, владелец, 21.09.2026, живой дефект на
		# HERO, пункт 2): teardown мог тихо не долететь (гонка за замок
		# под нагрузкой, или подмена движка между on и off — обе картины
		# теперь неважны, потому что проверка идёт по ЖИВЫМ правилам, не
		# по памяти о том, кто и как их ставил).
		#
		# ГЕЙТ ПО WHITEHOMEEVERUSED — ОБЯЗАТЕЛЕН (поймано регрессией той же
		# правки): без него самолечение звало бы iptables -C на все три
		# имени КАЖДУЮ минуту НА ВСЕХ одиннадцати роутерах парка, где белый
		# дом не включали никогда — ровно тот инвариант, который
		# white_position_ensure уже защищает своим собственным тестом
		# («ensure без белого слоя — доказанный ноль вызовов наружу»).
		# Маркера нет — выходим, не тронув iptables вовсе.
		[ -f "$WHITEHOMEEVERUSED" ] || return 0
		have iptables || return 0
		_whr=""
		for _whc in $(white_home_all_names); do
			ipt -C PREROUTING -j "$_whc" 2>/dev/null && _whr="$_whr прыжок:$_whc"
			chain_exists "$_whc" && _whr="$_whr цепочка:$_whc"
		done
		if [ -n "$_whr" ]; then
			say "ensure: белый режим дома ВЫКЛЮЧЕН, а в live остались следы:$_whr — снимаю"
			log "ensure: остаток белого дома при mode!=white:$_whr — снимаю принудительно"
			white_home_teardown || log "ensure: снять остаток белого дома не удалось до конца"
		fi
		return 0
	fi
	have iptables || return 0
	have ipset || return 0
	_hn=0
	_wha=$(white_home_active_chain) || _hn=1
	[ "$_hn" = 0 ] && { white_home_tail_ok || _hn=1; }
	# НАБОР ИСКЛЮЧЕНИЙ — ТОЖЕ ПРЕДМЕТ ВОССТАНОВЛЕНИЯ. После перезагрузки он
	# исчезает вместе с памятью ядра, а список человека лежит в файле.
	_wlf=$(white_list_clean | sort -u | grep -c .)
	_wls=$(white_direct_entries)
	if [ "$_wlf" != "$_wls" ]; then
		say "ensure: в $DIRECTSET записей $_wls, в списке $_wlf — наполняю заново"
		white_direct_load || log "ensure: не удалось наполнить $DIRECTSET"
	fi
	[ "$_hn" = 0 ] && { state_set_white_chain_ok yes; return 0; }
	say "ensure: белый режим включён, а цепочка дома отсутствует или хвост неполон — пересобираю в неактивную половину"
	log "ensure: восстанавливаю белую цепочку дома (была активна: ${_wha:-нет})"
	white_home_apply || log "ensure: восстановить белую цепочку дома НЕ удалось"
	return 0
}

# white_list_clean — строки списка без мусора. Тот же приём, что list_clean у
# чёрного списка: комментарии и пробелы срезаются, пустые строки выбрасываются.
# dns_direct_add/del/clear/show_machine — обёртки СОГЛАСОВАННОГО синтаксиса.
# Формат ПОКА НЕ ПОДКЛЮЧЁН к cmd_white_list: см. dns_direct_parse_machine_line.
dns_direct_add() {
	[ -x "$DNSBIN" ] || return 1
	run_bounded 10 "$DNSBIN" -config "$DNSCONFIG_DIRECT" domains add "$1" --group direct --create
}
dns_direct_del() {
	[ -x "$DNSBIN" ] || return 1
	run_bounded 10 "$DNSBIN" -config "$DNSCONFIG_DIRECT" domains del "$1"
}
dns_direct_clear() {
	[ -x "$DNSBIN" ] || return 1
	run_bounded 10 "$DNSBIN" -config "$DNSCONFIG_DIRECT" domains del --group direct --all
}
dns_direct_show_machine() {
	[ -x "$DNSBIN" ] || return 1
	run_bounded 10 "$DNSBIN" -config "$DNSCONFIG_DIRECT" domains show --machine
}

# ФОРМАТ ПОДТВЕРЖДЁН КОТОМ 2, ПОСТРОЧНО ИЗ КОДА (rulecmd.go), 21.09.2026:
#
#   entry=<текст правила> kind=domain|wildcard|regex|net
#   entries=<число>
#
# Разделитель — пробел, entries=N ПОСЛЕДНЕЙ строкой (не первой), kind — РОВНО
# четыре значения: domain (склеены domain И namespace — del их не различает,
# ищет по тексту r.Rule), wildcard, regex, net (их net = наш net). Формат
# СОВПАДАЕТ с нашим собственным show («entry=X kind=Y») — разбирать построчно
# незачем, строки entry= передаются как есть.
#
# ПУСТО И НЕПРОЧИТАНО — РАЗНЫЕ ИСХОДЫ. Пустой список: entries=0, код 0.
# Файл не прочитан: код 2, entries НЕ печатается вовсе. Смешивать их —
# ровно тот дефект, что уже ловили на direct_sets в meridian-dns status
# («непрочитанный — это не пустой»).
dns_direct_show_lines() {
	dns_direct_show_machine 2>/dev/null | grep '^entry='
}
dns_direct_show_count() {
	_dc=$(dns_direct_show_machine 2>/dev/null | sed -n 's/^entries=//p')
	case "$_dc" in ''|*[!0-9]*) echo "" ;; *) echo "$_dc" ;; esac
}

white_list_clean() {
	sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' "$WHITELIST" 2>/dev/null | grep -v '^$'
}

# white_direct_load — НАПОЛНИТЬ meridian_direct4 ИЗ ФАЙЛА, одной операцией и
# атомарно: заливаем во временный набор и меняем местами. Полупустой набор
# исключений означал бы, что часть прямых адресов на секунду ушла в туннель.
white_direct_load() {
	ipset destroy "$DIRECTSETNEW" 2>/dev/null
	ipset create "$DIRECTSETNEW" hash:net family inet 2>/dev/null || return 1
	white_list_clean | sort -u | sed "s|^|add $DIRECTSETNEW |" | ipset restore 2>/dev/null || {
		ipset destroy "$DIRECTSETNEW" 2>/dev/null
		return 1
	}
	set_exists "$DIRECTSET" || ipset create "$DIRECTSET" hash:net family inet 2>/dev/null || return 1
	ipset swap "$DIRECTSETNEW" "$DIRECTSET" 2>/dev/null || return 1
	ipset destroy "$DIRECTSETNEW" 2>/dev/null
	return 0
}

white_direct_entries() {
	set_exists "$DIRECTSET" || { echo 0; return 0; }
	ipset list "$DIRECTSET" 2>/dev/null | sed -n '/^Members:/,$p' | grep -vc '^Members:'
}

# cmd_white_list — глаголы списка исключений белого режима.
#
# ДОМЕНЫ СЮДА НЕ КЛАДУТСЯ, И ЭТО РЕШЕНИЕ, А НЕ НЕДОДЕЛКА (согласовано с котом 2
# 20.09.2026). Домен нельзя положить в ipset: его надо резолвить, следить за
# TTL, доливать новые адреса и убирать протухшие. Всё это уже написано в
# meridian-dns и работает на живом ответе; второй резолвер в движке — вторая
# копия той же логики, а копии в этом дереве расходились трижды. Домен,
# поданный сюда, получает ОТКАЗ СЛОВАМИ с указанием, куда идти, — молчаливый
# приём домена был бы хуже отказа: человек решил бы, что домен добавлен.
#
# КОДЫ: 0 сделано, 1 отказ с причиной, 2 не узнали. Те же три, что везде.
cmd_white_list() {
	case "${1:-show}" in
		show)
			if [ -e "$WHITELIST" ] && [ ! -r "$WHITELIST" ]; then
				say "не прочитать $WHITELIST (права?)"
				return 2
			fi
			_wln=0
			# ПОРЯДОК — КАК ХРАНИТСЯ, не сортируем: у панели список не должен
			# прыгать между обновлениями на ровном месте.
			white_list_clean | while IFS= read -r _wle; do
				case "$_wle" in
					*/*) echo "entry=$_wle kind=net" ;;
					*)   echo "entry=$_wle kind=addr" ;;
				esac
			done
			_wln=$(white_list_clean | grep -c .)
			# ВТОРОЕ ХРАНИЛИЩЕ — ОДНИМ СПИСКОМ С ПЕРВЫМ (договор с котом 2).
			# Новые kind (wildcard, regex, net) печатаются КАК ЕСТЬ: формат
			# совпадает с нашим («entry=X kind=Y»), разбирать незачем.
			_wdn=0
			if dns_direct_merge_ready; then
				_wdrc=0; _wdraw=$(dns_direct_show_machine 2>/dev/null) || _wdrc=$?
				case "$_wdrc" in
					0)
						printf '%s
' "$_wdraw" | grep '^entry='
						_wdn=$(printf '%s
' "$_wdraw" | sed -n 's/^entries=//p')
						case "$_wdn" in ''|*[!0-9]*) _wdn=0 ;; esac
						echo "dns_direct_read=yes"
						;;
					2)
						# НЕПРОЧИТАННЫЙ — НЕ ПУСТОЙ. Молчим о доменах словами,
						# а не нулём: ноль здесь означал бы «доменов нет», а
						# на деле «мы их не увидели» (тот же класс, что
						# direct_sets в meridian-dns status).
						say "ВНИМАНИЕ: meridian-dns не прочитал список доменов (код 2) — показаны только адреса и подсети."
						echo "dns_direct_read=no"
						;;
					*)
						say "ВНИМАНИЕ: meridian-dns вернул код $_wdrc на domains show --machine — домены не показаны."
						echo "dns_direct_read=no"
						;;
				esac
			fi
			echo "entries=$((_wln + _wdn))"
			return 0
			;;
		add)
			shift
			[ -n "${1:-}" ] || { say "что добавить? нужен адрес или подсеть"; return 1; }
			case "$1" in
				*[a-zA-Z]*)
					# КЛАССИФИКАЦИЯ ПО СИНТАКСИСУ (владелец, 21.09.2026): буквы
					# в записи — домен. dns_direct_merge_ready — аварийный
					# выключатель на случай отката слияния, в бою открыт.
					if ! dns_direct_merge_ready; then
						say "ОТКАЗ: «$1» похоже на домен, а домены движок не ведёт."
						say "  Домен нельзя положить в набор: его надо резолвить и следить за TTL,"
						say "  и это уже делает meridian-dns на живом ответе. Второй разбор здесь"
						say "  разошёлся бы с ним на первой же правке."
						say "  Домены белого режима: через meridian-dns (набор mn_*, см. кота 2)."
						return 1
					fi
					dns_direct_add "$1" || { say "ОТКАЗ: meridian-dns не принял «$1» (команда кота 2, см. договор)"; return 1; }
					say "добавлено (домен, через meridian-dns): $1"
					log "в белый список добавлен домен $1 (через meridian-dns)"
					return 0
					;;
			esac
			valid_cidr "$1" || { say "ОТКАЗ: «$1» не адрес, не подсеть и не домен"; return 1; }
			# forbidden_reason ЗДЕСЬ НЕ ЗОВЁТСЯ, и это не забывчивость. Те
			# ворота стерегут ЧЁРНЫЙ список, где запись означает «завернуть в
			# туннель»: завернуть туда свою же сеть — отрезать роутер. В белом
			# режиме смысл записи ОБРАТНЫЙ — «идёт напрямую», и запретить
			# частную сеть значило бы запретить безобидное. Поймано тестом на
			# 10.0.0.0/8: добавление отвергалось воротами чужого списка.
			mkdir -p "$(dirname "$WHITELIST")" 2>/dev/null
			# ПОВТОРНОЕ ДОБАВЛЕНИЕ — НЕ ОШИБКА (довод кота 2): панель повторяет
			# запрос при таймауте, и отказ на успешной операции показал бы
			# человеку ошибку там, где всё хорошо.
			if white_list_clean | grep -qx "$1"; then
				echo "already=yes"
				say "уже есть: $1"
				return 0
			fi
			echo "$1" >> "$WHITELIST" 2>/dev/null || { say "не записать в $WHITELIST"; return 2; }
			say "добавлено: $1"
			log "в белый список добавлено $1"
			white_home_on && { white_direct_load && say "набор $DIRECTSET обновлён: $(white_direct_entries) записей"; }
			return 0
			;;
		del)
			shift
			[ -n "${1:-}" ] || { say "что убрать?"; return 1; }
			# ОБЪЕДИНЁННОЕ УДАЛЕНИЕ: absent=yes ТОЛЬКО когда не нашли НИ В
			# ОДНОМ из двух хранилищ (владелец, 21.09.2026) — не когда не
			# нашли в первом проверенном.
			#
			# КОДЫ ПОДТВЕРЖДЕНЫ КОТОМ 2, 21.09.2026: 0 — было и убрано,
			# 5 (rcNotFound) — не было нигде, 6 (rcOtherGroup) — есть, но в
			# ДРУГОЙ группе. Шестой код — ДРУГОЙ ФАКТ, чем «нет вообще», и
			# назвать его иначе как absent=yes значило бы отсеять правду
			# молча (правило владельца: отсеявшая правку правка обязана
			# назвать, кого отсеяла).
			if ! white_list_clean | grep -qx "$1"; then
				if dns_direct_merge_ready; then
					dns_direct_del "$1"; _wddrc=$?
					case "$_wddrc" in
						0)
							say "убрано (домен, через meridian-dns): $1"
							log "из белого списка убран домен $1 (через meridian-dns)"
							return 0
							;;
						5) : ;;   # не было нигде — падаем к absent=yes ниже
						6)
							say "ОТКАЗ: «$1» есть у meridian-dns, но в ДРУГОЙ группе (не direct) — не мой список, не трогаю."
							return 1
							;;
						*)
							say "ОТКАЗ: meridian-dns вернул код $_wddrc на domains del «$1» — не понимаю ответ, ничего не менял."
							return 1
							;;
					esac
				fi
				echo "absent=yes"
				say "в списке и не было: $1"
				return 0
			fi
			_wlt="$WHITELIST.tmp.$$"
			# КОД ВОЗВРАТА grep ЗДЕСЬ НЕ ПРИЗНАК УСПЕХА: когда убирается
			# последняя строка, grep не выбирает ничего и возвращает 1, а файл
			# при этом переписан правильно. Проверяем существование результата,
			# а не код. Поймано тестом на списке из одной записи.
			grep -vx "$1" "$WHITELIST" > "$_wlt" 2>/dev/null
			[ -f "$_wlt" ] || { say "не переписать $WHITELIST"; return 2; }
			mv -f "$_wlt" "$WHITELIST" 2>/dev/null || { rm -f "$_wlt"; say "не переписать $WHITELIST"; return 2; }
			say "убрано: $1"
			log "из белого списка убрано $1"
			white_home_on && { white_direct_load && say "набор $DIRECTSET обновлён: $(white_direct_entries) записей"; }
			return 0
			;;
		clear)
			shift
			# CLEAR СТИРАЕТ ВСЁ, ЧТО ЧЕЛОВЕК НАБРАЛ. Явное --yes обязательно:
			# панель эту команду не зовёт вовсе, она остаётся в руках человека.
			[ "${1:-}" = "--yes" ] || {
				say "ОТКАЗ: clear стирает ВЕСЬ список исключений белого режима."
				say "  Если это и нужно: $0 white list clear --yes"
				return 1
			}
			: > "$WHITELIST" 2>/dev/null || { say "не очистить $WHITELIST"; return 2; }
			say "список очищен"
			log "белый список очищен человеком"
			white_home_on && { white_direct_load && say "набор $DIRECTSET обновлён: $(white_direct_entries) записей"; }
			return 0
			;;
		*)
			say "usage: $0 white list show | add <адрес|подсеть> | del <адрес|подсеть> | clear --yes"
			return 1
			;;
	esac
}

# --------------------------------------------------------------------------
# АВТОПЕРЕХОД 10б-2 — настройки и команда auto.
# --------------------------------------------------------------------------

# autoswitch_n/autoswitch_m — минимум непрерывности на резервном/быстром пути
# (секунд), прежде чем автомат сработает. Настройкой (владелец, 22.09.2026),
# тот же порядок переопределения, что у hold_open_after: переменная
# окружения сильнее конфига, конфиг сильнее умолчания. N=600 (10 мин),
# M=1800 (30 мин) — числа владельца, не замер (для замера данных ещё мало —
# разведка 10б-2 дала только 32 минуты журнала клиента).
autoswitch_n() {
	_v="${MERIDIAN_ROUTE_AUTOSWITCH_N:-$(conf_value AUTOSWITCH_N 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 600 ;; *) echo "$_v" ;; esac
}
autoswitch_m() {
	_v="${MERIDIAN_ROUTE_AUTOSWITCH_M:-$(conf_value AUTOSWITCH_M 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 1800 ;; *) echo "$_v" ;; esac
}
# autoswitch_cap — суточный потолок ПЕРЕКЛЮЧЕНИЙ (в обе стороны вместе, не
# отдельно на включение/выключение). Предварительное число: при N=600/M=1800
# теоретический потолок дребезга — раз в 2400с (40 мин), то есть до 36
# переключений в сутки при непрерывном дребезге канала; 12 — это меньше
# трети теоретического максимума, ловит патологию, не мешает нормальным
# редким переходам.
autoswitch_cap() {
	_v="${MERIDIAN_ROUTE_AUTOSWITCH_CAP:-$(conf_value AUTOSWITCH_CAP 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 12 ;; *) echo "$_v" ;; esac
}
# autoswitch_enabled — включён ли автомат ПРЯМО СЕЙЧАС (файл AUTOSWITCHSTATE,
# не $STATE — см. её комментарий выше). Это переключаемое РАБОЧЕЕ состояние
# движка, не внешний конфиг: включает человек командой, выключает и сам
# движок при ручном белом (см. _autoswitch_disarm_if_human ниже).
autoswitch_enabled() { [ -f "$AUTOSWITCHSTATE" ] && [ "$(cat "$AUTOSWITCHSTATE" 2>/dev/null)" = "on" ]; }
autoswitch_set() {
	mkdir -p "$(dirname "$AUTOSWITCHSTATE")" 2>/dev/null
	printf '%s' "$1" > "$AUTOSWITCHSTATE" 2>/dev/null
}

# autoswitch_daycount_get/bump — суточный счётчик с обнулением по дате.
# Та же пара приёмов, что TRANSITIONS_LASTMODE (файл с последней меткой) и
# hod_schyot (число, деградирует в 0 на любой мусор), сведённые вместе:
# дата не совпала с сегодняшней — счёт сегодняшнего дня равен нулю, что бы
# ни лежало в файле числа.
autoswitch_daycount_get() {
	_today=$(date +%Y%m%d)
	_stamp=$(cat "$AUTOSWITCHCOUNTDAY" 2>/dev/null)
	[ "$_stamp" = "$_today" ] || { echo 0; return 0; }
	hod_schyot "$AUTOSWITCHCOUNT"
}
autoswitch_daycount_bump() {
	_today=$(date +%Y%m%d)
	_stamp=$(cat "$AUTOSWITCHCOUNTDAY" 2>/dev/null)
	if [ "$_stamp" != "$_today" ]; then
		echo "$_today" > "$AUTOSWITCHCOUNTDAY" 2>/dev/null
		echo 1 > "$AUTOSWITCHCOUNT" 2>/dev/null
		return 0
	fi
	_n=$(hod_schyot "$AUTOSWITCHCOUNT")
	echo $(( _n + 1 )) > "$AUTOSWITCHCOUNT" 2>/dev/null
	return 0
}

# _autoswitch_disarm_if_human — вызывается ПЕРВЫМ действием из
# white_cmd_home_on()/white_cmd_home_off() (человеческие команды). Если
# автомат сейчас включён И вызов НЕ от самого автомата (флаг
# _AUTOSWITCH_CALLING пуст) — гасит автомат и говорит об этом вслух.
# «Ручное переключение отключает автомат» — решение владельца 22.09.2026,
# без него: до конца дня (инвариант «приоритет человека», тот же смысл, что
# WHITEHOMEEVERUSED и WHITEHOMEDEAD рядом).
_autoswitch_disarm_if_human() {
	[ -n "${_AUTOSWITCH_CALLING:-}" ] && return 0
	autoswitch_enabled || return 0
	autoswitch_set off
	log "АВТОМАТ 10б-2: выключен — сработало ручное переключение белого режима"
	say "Автомат 10б-2 выключен: переключение было ручным. Включить снова: $0 auto on"
}

cmd_auto() {
	case "${1:-}" in
		on)
			autoswitch_set on
			log "АВТОМАТ 10б-2: включён (N=$(autoswitch_n)с, M=$(autoswitch_m)с, потолок $(autoswitch_cap)/сутки)"
			say "Автомат включён. N=$(autoswitch_n)с резервного -> белый; M=$(autoswitch_m)с быстрого -> чёрный."
			;;
		off)
			autoswitch_set off
			log "АВТОМАТ 10б-2: выключен человеком"
			say "Автомат выключен. Текущий режим не меняется."
			;;
		show)
			echo "autoswitch=$(autoswitch_enabled && echo on || echo off)"
			echo "autoswitch_n=$(autoswitch_n)"
			echo "autoswitch_m=$(autoswitch_m)"
			echo "autoswitch_daily_cap=$(autoswitch_cap)"
			echo "autoswitch_active=$([ -f "$AUTOSWITCHACTIVE" ] && echo yes || echo no)"
			echo "autoswitch_daily_count=$(autoswitch_daycount_get)"
			echo "qwdtt_path_mode=$(qwdtt_path_mode 2>/dev/null)"
			echo "qwdtt_path_continuous_since=$(transitions_continuous_since 2>/dev/null)"
			;;
		check)
			# РУЧНАЯ ПРОВЕРКА П.2, БЕЗ ПЕРЕКЛЮЧЕНИЯ РЕЖИМА (1.89, владелец
			# 23.09.2026: «в проверку блока включи прогон вручную»). Не
			# читает кэш ZARUBEZHCHECK — человек спросил именно сейчас,
			# отвечаем свежим замером, а не тем, что легло от автомата
			# минуту назад.
			rm -f "$ZARUBEZHCHECK" 2>/dev/null
			# ТРИ ИСХОДА, А НЕ ДВА. zarubezh_dostupno возвращает 0 и когда
			# кто-то ответил, и когда проверять НЕЧЕМ — это намеренно (отказ
			# падает в безопасную сторону), но человеку эти два случая надо
			# показать РАЗНЫМИ словами: «работает и ответило» против «не на
			# чем проверить». Слить их значило бы отчитаться об успехе там,
			# где ничего не проверено.
			if zarubezh_dostupno; then
				case "$ZARUBEZH_DETAIL" in
					"проверить нечем"*)
						say "ПРОВЕРИТЬ НЕЧЕМ: $ZARUBEZH_DETAIL"
						say "  Белый режим автомат при этом НЕ включит — отказ безопасный,"
						say "  но и признака белого списка у нас сейчас нет."
						;;
					*)
						say "зарубежное доступно напрямую: $ZARUBEZH_DETAIL — это НЕ белый список"
						;;
				esac
			else
				say "ничего не ответило напрямую (зарубежные адреса и наш вход $(peer_host 2>/dev/null)) — похоже на белый список"
			fi
			;;
		*)
			say "usage: $0 auto on | off | show | check"
			return 2
			;;
	esac
}

# ЗАРУБЕЖНОЕ ДОСТУПНО НАПРЯМУЮ? (1.89, владелец 23.09.2026 — разбор
# ошибочного включения в 01:32). «Долго на резервном пути» САМО ПО СЕБЕ не
# значит белый список у провайдера: 22-23.09 клиент сидел на ретрансляторе
# VK потому, что резали адрес нашего сервера, а провайдер работал обычно.
# Проверяем ЧУЖИЕ крупные зарубежные адреса (не наши серверы, без DNS — по
# IP) И наш текущий вход (PEER) — хоть что-то ответило напрямую, минуя
# туннель, значит провайдер в обычном режиме (или режется только наш
# конкретный адрес, как с Парижем), а не белый список.
#
# МИМО ТУННЕЛЯ — БЕЗ ВСЯКОЙ МЕТКИ, И ЭТО ПРОВЕРЕНО НА ЖИВОМ РОУТЕРЕ
# (HERO, 23.09.2026): пометка в туннель ставится только в PREROUTING, то
# есть для ТРАНЗИТА из LAN, а собственный трафик роутера туда не попадает.
# `ip route get 1.1.1.1` на HERO отвечает `dev ppp0` — наружу, не в туннель.
# Первая редакция передавала исходный адрес WAN через `nc -s`; это было и
# лишним, и невозможным (см. ниже).
#
# ЛЁГКАЯ: таймаут 3с на адрес, короткое замыкание на первом ответе, и
# результат КЭШИРУЕТСЯ (ZARUBEZHCHECK) не чаще раза в
# zarubezh_min_interval() — ensure зовёт autoswitch_ensure каждый цикл, а
# порог N уже пройден, значит без кэша проба крутилась бы на каждом тике,
# пока провайдер и правда не станет белым списком (часы, не секунды).
ZARUBEZHCHECK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.zarubezh"
ZARUBEZH_DETAIL=""

zarubezh_min_interval() {
	_v="${MERIDIAN_ROUTE_ZARUBEZH_MIN:-$(conf_value ZARUBEZH_MIN_INTERVAL 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 60 ;; *) echo "$_v" ;; esac
}

# ПОЧЕМУ НЕ nc (HERO, 23.09.2026, владелец поймал на приёмке). BusyBox на
# Keenetic собран по минимуму: `nc --help` печатает ровно
# «Usage: nc [IPADDR PORT]» — НИ ОДНОГО ключа, ни -w, ни -s. Поэтому
# `nc -w 3 ...` печатал справку и выходил с кодом 1, и КАЖДАЯ проба
# «не отвечала». А «никто не ответил» значит «белый список» — то есть
# неработающий инструмент толкал автомат ровно туда, от чего эта проверка и
# заводилась. Отказ обязан падать в безопасную сторону, а не в опасную.
#
# curl на роутере есть (/opt/bin/curl, проверено там же) и умеет свой предел
# по времени. Коды: 7 — не соединился, 28 — истекло время; ЛЮБОЙ другой код
# означает, что соединение состоялось (в том числе 35/51/60 — TLS не сошёлся,
# но TCP дошёл, а нам нужен именно факт достижимости).
zarubezh_probe_odin() {
	_zp_ip="$1"; _zp_port="$2"
	if have curl; then
		curl -s -o /dev/null --connect-timeout 3 --max-time 5 "https://$_zp_ip:$_zp_port/" >/dev/null 2>&1
		_zp_rc=$?
		case "$_zp_rc" in
			7|28) return 1 ;;
			*)    return 0 ;;
		esac
	fi
	if have wget; then
		# У busybox wget предела на соединение нет, поэтому предел ставим сами
		# (run_bounded — тот же приём, что у остальных внешних вызовов: своей
		# команды timeout на роутере нет).
		run_bounded 5 wget -q -O /dev/null "https://$_zp_ip:$_zp_port/" >/dev/null 2>&1
		_zp_rc=$?
		[ "$_zp_rc" = "124" ] && return 1
		# wget возвращает ненулевое и на TLS-несовпадении, и на отказе связи;
		# различить их нечем, поэтому ненулевое считаем «не ответило».
		[ "$_zp_rc" = "0" ] && return 0
		return 1
	fi
	# ПРОВЕРИТЬ НЕЧЕМ — отдельный ответ, не «не ответило» (см. zarubezh_dostupno).
	return 2
}

# zarubezh_dostupno — 0 (успех) значит «БЕЛЫЙ НЕ включать», 1 — «похоже на
# белый список, включать можно». ZARUBEZH_DETAIL — чем именно объясняется
# ответ, для журнала.
#
# ОТКАЗ ПАДАЕТ В БЕЗОПАСНУЮ СТОРОНУ (HERO, 23.09.2026). Ноль возвращается не
# только когда кто-то ОТВЕТИЛ, но и когда проверить НЕЧЕМ (нет ни curl, ни
# wget): «не смогли проверить» — это не «белый список». Первая редакция
# сваливала оба случая в «никто не ответил», и неработающий nc заставлял
# автомат включать белый режим ровно в той ситуации, ради которой проверка и
# заводилась. Незнание не должно выглядеть как знание.
zarubezh_dostupno() {
	ZARUBEZH_DETAIL=""
	_zd_now=$(date +%s)
	if [ -f "$ZARUBEZHCHECK" ]; then
		_zd_at=$(sed -n '1p' "$ZARUBEZHCHECK" 2>/dev/null)
		case "$_zd_at" in
			''|*[!0-9]*) ;;
			*)
				if [ $(( _zd_now - _zd_at )) -lt "$(zarubezh_min_interval)" ]; then
					_zd_verdict=$(sed -n '2p' "$ZARUBEZHCHECK" 2>/dev/null)
					ZARUBEZH_DETAIL=$(sed -n '3p' "$ZARUBEZHCHECK" 2>/dev/null)
					[ "$_zd_verdict" = "da" ]
					return $?
				fi
				;;
		esac
	fi

	_zd_otvet=""
	_zd_nechem=""
	for _zd_t in 1.1.1.1:443 8.8.8.8:443 9.9.9.9:443; do
		_zd_ip="${_zd_t%%:*}"; _zd_port="${_zd_t##*:}"
		zarubezh_probe_odin "$_zd_ip" "$_zd_port"
		case "$?" in
			0) _zd_otvet="$_zd_t (зарубежный)"; break ;;
			2) _zd_nechem=1; break ;;
		esac
	done
	# ПРОВЕРИТЬ НЕЧЕМ — выходим сразу и НЕ включаем белый.
	if [ -n "$_zd_nechem" ]; then
		ZARUBEZH_DETAIL="проверить нечем: на роутере нет ни curl, ни wget"
		mkdir -p "$(dirname "$ZARUBEZHCHECK")" 2>/dev/null
		printf '%s\n%s\n%s\n' "$_zd_now" "da" "$ZARUBEZH_DETAIL" > "$ZARUBEZHCHECK" 2>/dev/null
		return 0
	fi
	if [ -z "$_zd_otvet" ]; then
		_zd_peer=$(peer_host)
		_zd_pp=$(conf_value RAW_PEER 2>/dev/null); [ -n "$_zd_pp" ] || _zd_pp=$(conf_value PEER 2>/dev/null)
		_zd_peerport="${_zd_pp##*:}"
		case "$_zd_peerport" in ''|*[!0-9]*) _zd_peerport="" ;; esac
		if [ -n "$_zd_peer" ] && [ -n "$_zd_peerport" ]; then
			_zd_peerip="$_zd_peer"
			case "$_zd_peer" in *[!0-9.]*) _zd_peerip=$(keep_peer 2>/dev/null) ;; esac
			if [ -n "$_zd_peerip" ]; then
				zarubezh_probe_odin "$_zd_peerip" "$_zd_peerport"
				[ "$?" = "0" ] && _zd_otvet="$_zd_peer:$_zd_peerport (наш вход)"
			fi
		fi
	fi

	mkdir -p "$(dirname "$ZARUBEZHCHECK")" 2>/dev/null
	if [ -n "$_zd_otvet" ]; then
		printf '%s\n%s\n%s\n' "$_zd_now" "da" "$_zd_otvet" > "$ZARUBEZHCHECK" 2>/dev/null
		ZARUBEZH_DETAIL="$_zd_otvet"
		return 0
	fi
	printf '%s\n%s\n%s\n' "$_zd_now" "net" "" > "$ZARUBEZHCHECK" 2>/dev/null
	return 1
}

# autoswitch_trigger_on/off — само срабатывание. Вызываются ТОЛЬКО из
# autoswitch_ensure(). Обе: проверяют потолок, считают его, громко пишут в
# журнал ПЕРЕД действием (решение сработало — читатель обязан узнать, даже
# если само действие ниже почему-то откажет), зовут человеческую команду под
# флагом _AUTOSWITCH_CALLING.
autoswitch_trigger_on() {
	_asdur="$1"
	_ascnt=$(autoswitch_daycount_get)
	if [ "$_ascnt" -ge "$(autoswitch_cap)" ] 2>/dev/null; then
		log "АВТОМАТ 10б-2: порог включения достигнут (${_asdur}с на резервном), НО суточный потолок переключений исчерпан ($_ascnt/$(autoswitch_cap)) — не включаю"
		return 1
	fi
	# ЗАРУБЕЖНОЕ ДОСТУПНО? (1.89, владелец 23.09.2026 — разбор ошибочного
	# включения в 01:32). «Долго на резервном пути» САМО ПО СЕБЕ не значит
	# белый список у провайдера: 22-23.09 клиент сидел на ретрансляторе VK
	# потому, что резали адрес нашего сервера, а провайдер работал обычно.
	# Автомат тогда принял это за белый список и включил белый режим зря.
	# Поэтому перед включением спрашиваем ЧУЖИЕ зарубежные адреса, не наши:
	# отвечают — провайдер в обычном режиме, белый НЕ включаем.
	if zarubezh_dostupno; then
		log "АВТОМАТ 10б-2: на резервном пути ${_asdur}с, но зарубежное доступно напрямую (${ZARUBEZH_DETAIL}) — не белый список, режим не меняю"
		return 1
	fi
	log "АВТОМАТ 10б-2: ${_asdur}с непрерывно на резервном пути (порог $(autoswitch_n)с), зарубежное напрямую недоступно — включаю белый режим"
	autoswitch_daycount_bump
	_AUTOSWITCH_CALLING=1
	white_cmd_home_on --confirm 0 >/dev/null 2>&1
	_asrc=$?
	if [ "$_asrc" = "0" ] && white_home_on; then
		# ПОДТВЕРЖДАЕМ СРАЗУ ЖЕ (1.83, найдено регрессией на этом же тесте):
		# --confirm 0 ставит confirmed=no НАВСЕГДА и не поднимает сторожа —
		# сделано для человека («сам не снимется, подтверждать не нужно»).
		# Но may_restore() (ворота ВСЕГО остального ensure, включая
		# transitions_ensure/autoswitch_ensure следом) пускает ТОЛЬКО
		# confirmed=yes ИЛИ живого сторожа. confirmed=no без сторожа —
		# самозапирающееся состояние: автомат включил белый и после этого
		# ensure нигде дальше этой же функции не заходит, включая ту же
		# автоматику, которая должна его потом выключить. У автомата нет
		# человека, ждущего подтверждения, — подтверждать неоткуда, кроме
		# как самому, сразу.
		white_cmd_home_confirm >/dev/null 2>&1
		: > "$AUTOSWITCHACTIVE" 2>/dev/null
		log "АВТОМАТ 10б-2: белый режим включён и подтверждён автоматически"
	else
		log "АВТОМАТ 10б-2: попытка включить белый режим НЕ УДАЛАСЬ (код $_asrc) — смотрите причину выше в журнале"
	fi
	unset _AUTOSWITCH_CALLING 2>/dev/null || _AUTOSWITCH_CALLING=""
	return 0
}
autoswitch_trigger_off() {
	_asdur="$1"
	_ascnt=$(autoswitch_daycount_get)
	if [ "$_ascnt" -ge "$(autoswitch_cap)" ] 2>/dev/null; then
		log "АВТОМАТ 10б-2: порог возврата достигнут (${_asdur}с на быстром), НО суточный потолок переключений исчерпан ($_ascnt/$(autoswitch_cap)) — не выключаю"
		return 1
	fi
	log "АВТОМАТ 10б-2: ${_asdur}с непрерывно на быстром пути (порог $(autoswitch_m)с) — возвращаю чёрный режим"
	autoswitch_daycount_bump
	_AUTOSWITCH_CALLING=1
	white_cmd_home_off >/dev/null 2>&1
	unset _AUTOSWITCH_CALLING 2>/dev/null || _AUTOSWITCH_CALLING=""
	rm -f "$AUTOSWITCHACTIVE" 2>/dev/null
	log "АВТОМАТ 10б-2: чёрный режим восстановлен"
	return 0
}

# autoswitch_ensure — вызывается КАЖДЫЙ цикл ensure, СРАЗУ после
# transitions_ensure (комментарий на месте вызова расставлен заранее, 1.63:
# «Замер N/M и будущий суточный потолок автомата читают этот журнал
# независимо от того, включён ли уже сам автопереход»). Молчит, если автомат
# выключен, журнала клиента нет, или путь только что определился (пустой
# continuous_since).
autoswitch_ensure() {
	autoswitch_enabled || return 0
	_aspm=$(qwdtt_path_mode) || return 0
	[ -n "$_aspm" ] || return 0
	_assince=$(transitions_continuous_since) || return 0
	case "$_assince" in ''|*[!0-9]*) return 0 ;; esac
	_asdur=$(( $(date +%s) - _assince ))
	[ "$_asdur" -ge 0 ] || return 0
	case "$_aspm" in
		backup)
			if ! white_home_on && [ "$_asdur" -ge "$(autoswitch_n)" ]; then
				autoswitch_trigger_on "$_asdur"
			fi
			;;
		fast)
			if white_home_on && [ -f "$AUTOSWITCHACTIVE" ] && [ "$_asdur" -ge "$(autoswitch_m)" ]; then
				autoswitch_trigger_off "$_asdur"
			fi
			;;
	esac
	return 0
}

cmd_white() {
	case "${1:-}" in
		on)      shift; white_cmd_home_on "$@" ;;
		off)     white_cmd_home_off ;;
		confirm) white_cmd_home_confirm ;;
		show)    white_cmd_home_show ;;
		list)    shift; cmd_white_list "$@" ;;
		*)       say "usage: $0 white on [--confirm N] | off | confirm | show" ; return 2 ;;
	esac
}

white_cmd_home_on() {
	_autoswitch_disarm_if_human
	_whsec="$WHITE_HOME_CONFIRM_DEFAULT"
	while [ $# -gt 0 ]; do
		case "$1" in
			--confirm) _whsec="$2"; shift 2 ;;
			--confirm=*) _whsec="${1#--confirm=}"; shift ;;
			*) say "непонятный аргумент: $1"; return 2 ;;
		esac
	done
	case "$_whsec" in ''|*[!0-9]*) say "--confirm ждёт число секунд, получено «$_whsec»"; return 2 ;; esac

	white_home_vorota || return 1

	# ПРЕЖНИЙ РЕЖИМ ЗАПОМИНАЕТСЯ ДО ПОДМЕНЫ. Откат обязан вернуть не «как
	# принято», а то, что было на самом деле.
	state_get mode > "$WHITEPREV" 2>/dev/null
	if ! white_home_apply; then
		say "Снимаю, ничего не оставляю."
		white_home_teardown
		rm -f "$WHITEPREV" 2>/dev/null
		return 1
	fi
	# АПСТРИМ meridian-dns — CLEAN-ONLY. Не удался — слой снимаем: цепочка
	# без переключенного апстрима исключает наборы, но провайдерские домены
	# из-под meridian-dns шли бы прежним путём (ndnproxy, 80.252.130.253/.254)
	# — ровно та утечка, ради которой шаг 11 вообще затевался.
	if ! dns_upstream_clean_only; then
		say "ОТКАЗ: meridian-dns не переключил апстрим на clean-only. Снимаю, ничего не оставляю."
		white_home_teardown
		rm -f "$WHITEPREV" 2>/dev/null
		return 1
	fi
	# КТО ВКЛЮЧИЛ (1.89, владелец 23.09.2026, тот же разбор, что confirm
	# ниже): автомат 10б-2 зовёт эту же функцию под _AUTOSWITCH_CALLING —
	# запись не должна звать это «человеком», когда это не так.
	if [ -n "${_AUTOSWITCH_CALLING:-}" ]; then
		state_set white no "белый режим дома включён автоматически (автомат 10б-2)"
	else
		state_set white no "белый режим дома включён человеком"
	fi
	: > "$WHITEHOMEEVERUSED" 2>/dev/null
	date +%s > "$WHITEHOMESINCE" 2>/dev/null
	_whdead=$(( $(date +%s) + _whsec ))
	if [ "$_whsec" -gt 0 ] 2>/dev/null; then echo "$_whdead" > "$WHITEHOMEDEAD" 2>/dev/null; else : > "$WHITEHOMEDEAD" 2>/dev/null; fi
	if [ -n "${_AUTOSWITCH_CALLING:-}" ]; then
		log "БЕЛЫЙ РЕЖИМ ДОМА включён автоматически (автомат 10б-2): сети $(home_nets | tr '\n' ' ')подтвердить за $_whsec с"
	else
		log "БЕЛЫЙ РЕЖИМ ДОМА включён: сети $(home_nets | tr '\n' ' ')подтвердить за $_whsec с"
	fi
	say "ВКЛЮЧЕНО НА ВЕСЬ ДОМ. Сети: $(home_nets | tr '\n' ' ')"
	say "Весь трафик этих сетей, кроме исключений, идёт в туннель."
	say "УДЕРЖАНИЕ ТЕПЕРЬ closed: пропадёт туннель — дом останется БЕЗ ИНТЕРНЕТА,"
	say "  пока вы сами не скажете: $0 hold open"
	# СТАРЫЙ СТОРОЖ — ДОЛОЙ ПЕРЕД НОВЫМ (1.72, пункт 0 хвоста шага 11).
	white_home_armed_stop
	if [ "$_whsec" -gt 0 ] 2>/dev/null; then
		say "ПОДТВЕРДИТЬ за $_whsec с (из ДОМАШНЕЙ сети): $0 white confirm"
		say "Не подтвердите — режим снимется сам и всё вернётся как было."
		if have setsid; then
			setsid "$SELF" _white_home_armed "$_whdead" </dev/null >/dev/null 2>&1 &
		else
			( ( "$SELF" _white_home_armed "$_whdead" </dev/null >/dev/null 2>&1 & ) & )
		fi
	else
		say "Подтверждение не требуется (--confirm 0): режим сам не снимется."
	fi
	return 0
}

white_cmd_home_confirm() {
	white_home_on || { say "подтверждать нечего: белый режим не включён"; return 1; }
	state_set white yes "белый режим дома подтверждён человеком"
	# КТО ПОДТВЕРДИЛ (1.89, владелец 23.09.2026). Автомат 10б-2 зовёт эту же
	# функцию, и раньше его подтверждение попадало в журнал словами «подтверждён
	# человеком» — 23.09 автомат включил белый ошибочно, а запись выглядела
	# решением владельца. Признак уже есть: _AUTOSWITCH_CALLING ставит сам
	# автомат на время вызова.
	if [ -n "${_AUTOSWITCH_CALLING:-}" ]; then
		log "белый режим дома подтверждён автоматически (автомат 10б-2) — откат отменён"
	else
		log "белый режим дома подтверждён человеком — откат отменён"
	fi
	say "Принято. Откат отменён, белый режим остаётся до $0 white off."
}

white_cmd_home_off() {
	_autoswitch_disarm_if_human
	white_home_on || {
		# Снимать всё равно пробуем: цепочка могла пережить чужую правку
		# состояния, и «режим не включён» не означает «следов нет».
		say "белый режим не включён — проверяю, не осталось ли следов"
		white_home_teardown
		_sled=$(ipt -S 2>/dev/null | grep -c "$WHITEHOMECHAIN")
		[ "$_sled" = "0" ] && say "следов нет" || say "ВНИМАНИЕ: следы остались ($_sled строк)"
		return 0
	}
	white_home_off_now
	_sled=$(ipt -S 2>/dev/null | grep -c "$WHITEHOMECHAIN")
	if [ "$_sled" != "0" ]; then
		say "СНЯТО НЕ ВСЁ: в mangle осталось строк с $WHITEHOMECHAIN: $_sled"
		return 1
	fi
	say "Следов не осталось."
	return 0
}

white_cmd_home_show() {
	if white_home_on; then
		echo "white=on"
		# КТО ВКЛЮЧИЛ БЕЛЫЙ (1.89, владелец 23.09.2026). Раньше здесь стояло
		# жёсткое human — и включение автоматом 10б-2 подписывалось как
		# «подтверждён человеком». 23.09 это и произошло: автомат включил
		# белый в 01:32 ошибочно, а в журнале и в панели выглядело решением
		# владельца. Признак берём из уже существующего маркера автомата,
		# новых сущностей не заводим: файл ставится ровно там, где автомат
		# включает белый, и снимается вместе с уходом белого.
		if [ -f "$AUTOSWITCHACTIVE" ]; then
			echo "white_by=auto"
		else
			echo "white_by=human"
		fi
		echo "white_confirmed=$(state_get confirmed)"
		echo "white_since=$(cat "$WHITEHOMESINCE" 2>/dev/null)"
		echo "white_prev_mode=$(cat "$WHITEPREV" 2>/dev/null)"
		echo "white_home_nets=$(home_nets | tr '\n' ' ')"
	else
		echo "white=off"
	fi
}

nft_meridian_active() {
	have nft || return 1
	nft list table inet meridian >/dev/null 2>&1
}

cmd_white_test() {
	case "${1:-}" in
		on)      shift; white_cmd_on "$@" ;;
		off)     white_cmd_off ;;
		confirm) white_cmd_confirm ;;
		show)    white_cmd_show ;;
		*)       say "usage: $0 white-test on <адрес> [--confirm N] | off | confirm | show" ; return 2 ;;
	esac
}

white_cmd_on() {
	# ПРОВЕРКА ПРЕДМЕТА, А НЕ ИМЕНИ ПРОШИВКИ — первой строкой, дешевле всего
	# остального. Если разметка на этом роутере живёт в nftables (таблица
	# inet meridian, путь OpenWrt), эта правка её не понимает: две системы
	# пометки на одном трафике хуже одной верной.
	if nft_meridian_active; then
		say "ОТКАЗ: на этом роутере разметка живёт в nftables (таблица inet meridian, путь OpenWrt) — эта правка (шаг 10) её не понимает и не трогает. white-test здесь не включается."
		return 1
	fi
	# ИМЕНА ЛОКАЛЬНЫХ — С ПОДЧЁРКИВАНИЯ, И ЭТО НЕ СТИЛЬ. Первая редакция брала
	# CONF под число секунд, а CONF — это ГЛОБАЛЬНЫЙ путь к qwdtt.conf. Движок
	# после этого читал конфиг из файла с именем «0», keep не собирался, и отказ
	# выглядел как «в конфиге нет PEER». Поймано стендом на первом же прогоне.
	_wa="${1:-}"
	shift 2>/dev/null || true
	_wsec="$WHITE_CONFIRM_DEFAULT"
	while [ $# -gt 0 ]; do
		case "$1" in
			--confirm) _wsec="$2"; shift 2 ;;
			--confirm=*) _wsec="${1#--confirm=}"; shift ;;
			*) say "непонятный аргумент: $1"; return 2 ;;
		esac
	done
	case "$_wsec" in ''|*[!0-9]*) say "--confirm ждёт число секунд, получено «$_wsec»"; return 2 ;; esac
	if ! white_addr_ok "$_wa"; then
		say "ОТКАЗ: «$_wa» не годится. Нужен один адрес IPv4 из домашней сети, без маски."
		say "Посмотреть, кто есть в сети: ip neigh ; cat /tmp/dhcp.leases"
		return 2
	fi
	if white_on; then
		say "ОТКАЗ: слой уже включён для $(white_state_get addr). Сначала: $0 white-test off"
		return 2
	fi
	# ОСНОВАНИЕ ПОД СЛОЕМ. Инверсия метит ВЕСЬ трафик устройства, и без
	# правила политики, таблицы и живого туннеля это означает не «через
	# туннель», а «в никуда». Проверяем предмет, а не намерение.
	if ! may_restore; then
		say "ОТКАЗ: чёрный режим не включён или не подтверждён — метить некуда."
		return 1
	fi
	if ! iface_exists; then
		say "ОТКАЗ: туннеля $(tun_name) сейчас нет. Весь трафик устройства ушёл бы в удержание."
		return 1
	fi
	if ! route_mine_present; then
		say "ОТКАЗ: в таблице $TABLE нет нашего маршрута. Сначала: $0 ensure"
		return 1
	fi
	have ipset || { say "ОТКАЗ: нет ipset"; return 1; }
	# KEEP СТРОИТСЯ ЗАНОВО, А НЕ ПРОВЕРЯЕТСЯ. Содержимому набора, собранного
	# когда-то руками, доверять нельзя: следа той команды нет ни в одном файле.
	# Здесь цена ошибки — потеря доступа к роутеру с того самого устройства.
	say "строю $KEEPSET заново (доверять прежнему содержимому нельзя)"
	if ! keep_build; then
		say "ОТКАЗ: $KEEPSET не собрался — без него устройство потеряет и роутер, и сам туннель"
		return 1
	fi
	if ! keep_check; then
		say "ОТКАЗ: $KEEPSET собран, но проверку не прошёл — см. выше"
		return 1
	fi
	# ВОРОТ ЗДЕСЬ НЕТ, И ЭТО ОСОЗНАННО.
	#
	# Первая редакция звала keep_gate сразу после keep_check. Мутация «снять
	# ворота из постановки слоя» прошла ЗЕЛЁНОЙ, и она права: условие ворот
	# (адрес VPS И хотя бы одна сеть роутера) — ПОДМНОЖЕСТВО условия keep_check
	# (адрес VPS И ВСЕ сети роутера И постоянная часть). Ворота не могут
	# отказать там, где check прошёл, значит второй предохранитель здесь не
	# проверяется ничем и создаёт видимость двойной защиты (правило 49).
	#
	# keep_gate живёт отдельным глаголом (`keep gate`) и предназначен пути
	# ИНВЕРСИИ пометки — шагу 5, которого ещё нет. Там keep_check не стоит и
	# стоять не будет: перед инверсией нужен минимальный ответ «можно ли
	# метить», а не полный отчёт о составе.
	# Набор прямых исключений: пустой набор не совпадает ни с чем, правило
	# безвредно, но место под него должно быть заранее.
	set_exists "$DIRECTSET" || ipset create "$DIRECTSET" hash:net 2>/dev/null
	if ! set_exists "$DIRECTSET"; then
		say "ОТКАЗ: не создать набор $DIRECTSET"
		return 1
	fi
	ipt -N "$WHITECHAIN" 2>/dev/null
	ipt -F "$WHITECHAIN" 2>/dev/null
	white_rules "$_wa" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	# СВЕРКА СОДЕРЖИМЫМ, а не кодами возврата: правило 37 и вся сегодняшняя
	# наука. Ставили пять строк — в цепочке обязано быть пять тех же.
	#
	# НО СРАВНИВАТЬ РУКОПИСНУЮ СТРОКУ С ВЫВОДОМ iptables НЕЛЬЗЯ. Он нормализует
	# то, что читает: 05.09.2026 слой отказался встать на роутере владельца,
	# потому что мы ставили «-s 192.168.1.116», а читали «-s 192.168.1.116/32».
	# Класс шире одного случая: iptables переписывает и порядок модулей, и форму
	# масок, и регистр целей. Подгонять ожидание под /32 значило бы ждать
	# следующей лексемы.
	#
	# Поэтому ожидание СТРОИТСЯ ТЕМ ЖЕ ПУТЁМ: те же правила добавляются во
	# временную цепочку, и сравниваются ДВА ВЫХОДА iptables между собой. Что бы
	# он ни переписал, он перепишет это одинаково в обеих. Дороже второго
	# варианта (сверка по лексемам) на одну цепочку и пять вызовов, но строже:
	# ловит и лишнее правило, и переставленный порядок, а не только присутствие
	# ключевых слов.
	ipt -N "$WHITECHAIN_CHK" 2>/dev/null
	ipt -F "$WHITECHAIN_CHK" 2>/dev/null
	white_rules "$_wa" | sed "s/^-A $WHITECHAIN /-A $WHITECHAIN_CHK /" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	_want=$(ipt -S "$WHITECHAIN_CHK" 2>/dev/null | grep -v "^-N " | sed "s/^-A $WHITECHAIN_CHK /-A ЦЕПОЧКА /")
	_have=$(ipt -S "$WHITECHAIN" 2>/dev/null | grep -v "^-N " | sed "s/^-A $WHITECHAIN /-A ЦЕПОЧКА /")
	ipt -F "$WHITECHAIN_CHK" 2>/dev/null
	ipt -X "$WHITECHAIN_CHK" 2>/dev/null
	# ПУСТОЕ ОЖИДАНИЕ — НЕ СОВПАДЕНИЕ. Если временная цепочка не создалась,
	# оба выхода были бы пусты и сверка прошла бы, ничего не проверив
	# (правило 39).
	if [ -z "$_want" ]; then
		say "ОТКАЗ: не удалось построить эталон во временной цепочке — сверять не с чем. Снимаю."
		white_teardown
		return 1
	fi
	if [ "$_want" != "$_have" ]; then
		say "ОТКАЗ: цепочка $WHITECHAIN легла не так, как задумано. Снимаю."
		say "ждали:"; printf '%s\n' "$_want" | sed 's/^/    /'
		say "получилось:"; printf '%s\n' "$_have" | sed 's/^/    /'
		white_teardown
		return 1
	fi
	# ПРЫЖОК — ПОСЛЕДНИМ ДЕЙСТВИЕМ И В КОНЕЦ ЦЕПОЧКИ.
	#
	# Последним действием: пока прыжка нет, цепочка ни на что не влияет, и
	# любой отказ выше стоит ноль.
	#
	# В КОНЕЦ, А НЕ ПЕРВЫМ. Первая редакция ставила -I PREROUTING 1, и это было
	# прямой ошибкой: выше нас стоит правило прошивки
	#   -A PREROUTING -m mark --mark 0x0 -j _NDM_DNSRT_PREROUTING_MANGLE
	# Оно заходит в свою цепочку только для пакетов с НУЛЕВОЙ меткой. Пометив
	# пакет раньше, мы отключили бы DNS-маршрутизацию Keenetic для испытуемого
	# устройства — тихо и не сразу заметно. Рабочие цепочки сегодня стоят ПОСЛЕ
	# всех _NDM_* и после nfqws_pre, туда же встаём и мы.
	ipt_check PREROUTING -j "$WHITECHAIN"; case $? in
		1) ipt -A PREROUTING -j "$WHITECHAIN" 2>/dev/null ;;
	esac
	if ! ipt -C PREROUTING -j "$WHITECHAIN" 2>/dev/null; then
		say "ОТКАЗ: прыжок на $WHITECHAIN не встал. Снимаю цепочку."
		white_teardown
		return 1
	fi
	_dead=$(( $(date +%s) + _wsec ))
	{ echo "addr=$_wa"; echo "since=$(date +%s)"; echo "deadline=$_dead"; } > "$WHITESTATE" 2>/dev/null
	statuscache_drop
	log "white-test включён для $_wa: весь его трафик, кроме $KEEPSET и $DIRECTSET, идёт в туннель; подтвердить за $_wsec с"
	say "ВКЛЮЧЕНО для $_wa. Весь трафик этого устройства, кроме исключений, идёт в туннель."
	say "Остальной дом не затронут: правила начинаются с -s $_wa."
	if [ "$_wsec" -gt 0 ] 2>/dev/null; then
		say "ПОДТВЕРДИТЬ за $_wsec с: $0 white-test confirm"
		say "Не подтвердите — слой снимется сам, и всё вернётся как было."
		if have setsid; then
			setsid "$SELF" _white_armed "$_dead" </dev/null >/dev/null 2>&1 &
		else
			( ( "$SELF" _white_armed "$_dead" </dev/null >/dev/null 2>&1 & ) & )
		fi
	else
		say "Подтверждение не требуется (--confirm 0): слой сам не снимется."
	fi
	return 0
}

# white_teardown — снять всё БЕЗ разговоров. Отдельно от white_cmd_off, потому
# что зовётся и из середины включения, когда говорить ещё не о чем.
white_teardown() {
	ipt -F "$WHITECHAIN_CHK" 2>/dev/null
	ipt -X "$WHITECHAIN_CHK" 2>/dev/null
	while ipt -C PREROUTING -j "$WHITECHAIN" 2>/dev/null; do
		ipt -D PREROUTING -j "$WHITECHAIN" 2>/dev/null || break
	done
	ipt -F "$WHITECHAIN" 2>/dev/null
	ipt -X "$WHITECHAIN" 2>/dev/null
	rm -f "$WHITESTATE" 2>/dev/null
	return 0
}

white_cmd_off() {
	if ! white_on; then
		# Снимаем всё равно: слой мог остаться от прерванного включения.
		white_teardown
	else
		_a=$(white_state_get addr)
		white_teardown
		log "white-test снят для $_a"
	fi
	# СПИСОК ПРЕЖНЕГО РЕЖИМА НЕ ПЕРЕНОСИТСЯ (владелец, шаг 10): одна и та же
	# запись в чёрном значит «через туннель», в белом — «напрямую», перенос
	# молча перевернул бы смысл. Уничтожаем набор, а не оставляем пустым:
	# правила уже сняты white_teardown() ВЫШЕ (иначе ipset destroy отказал бы
	# — набор занят), порядок обязателен именно такой.
	ipset destroy "$DIRECTSET" 2>/dev/null
	# СЛЕДОВ БЫТЬ НЕ ДОЛЖНО, и это проверяется, а не предполагается.
	_sled=""
	ipt -C PREROUTING -j "$WHITECHAIN" 2>/dev/null && _sled="$_sled прыжок в PREROUTING;"
	ipt -S "$WHITECHAIN" >/dev/null 2>&1 && _sled="$_sled цепочка $WHITECHAIN;"
	ipt -S "$WHITECHAIN_CHK" >/dev/null 2>&1 && _sled="$_sled временная цепочка $WHITECHAIN_CHK;"
	[ -f "$WHITESTATE" ] && _sled="$_sled файл состояния;"
	set_exists "$DIRECTSET" && _sled="$_sled набор $DIRECTSET;"
	if [ -n "$_sled" ]; then
		say "ОТКАЗ: после снятия осталось —$_sled"
		return 1
	fi
	say "СНЯТО, следов не осталось. Набор $DIRECTSET уничтожен — следующее включение соберёт его заново."
	return 0
}

white_cmd_confirm() {
	if ! white_on; then
		say "подтверждать нечего: слой не включён"
		return 1
	fi
	# ЗНАЧЕНИЯ ЧИТАЮТСЯ ДО ОТКРЫТИЯ ФАЙЛА НА ЗАПИСЬ, А НЕ ВНУТРИ ТОГО ЖЕ
	# КОМАНДНОГО БЛОКА. `{ ... } > "$WHITESTATE"` обрезает файл в момент
	# настройки перенаправления для ВСЕГО блока — раньше, чем выполнится
	# первая команда внутри. Тот же баг ловили 15.09.2026 в dot_cmd_confirm
	# (addrs=/since= пустые после confirm) — здесь конструкция была
	# идентичная и того же класса (см. комментарий у DOTSTATE), чинится тем
	# же приёмом.
	_wa=$(white_state_get addr)
	_ws=$(white_state_get since)
	{ echo "addr=$_wa"; echo "since=$_ws"; echo "confirmed=yes"; } > "$WHITESTATE" 2>/dev/null
	statuscache_drop
	rm -f "$WHITEARMED" 2>/dev/null
	log "white-test подтверждён для $_wa — сам не снимется"
	say "Подтверждено. Слой останется до $0 white-test off."
	return 0
}

white_cmd_show() {
	if ! white_on; then
		say "white-test: выключен"
		return 0
	fi
	say "white-test: включён для $(white_state_get addr)"
	say "подтверждён: $(white_state_get confirmed | grep -c yes)"
	say "цепочка $WHITECHAIN:"
	iptables $IPTW -t mangle -L "$WHITECHAIN" -v -n -x 2>/dev/null | sed 's/^/    /'
	return 0
}

# _white_armed — сторож слоя. Тот же приём, что у предохранителя чёрного
# режима, и по той же причине: человек сидит ЗА ТЕМ САМЫМ устройством и может
# потерять доступ. Своего сторожа не пишу — этот проверен сегодня в бою.
cmd_white_armed() {
	trap '' HUP
	DEADLINE="$1"
	[ -n "$DEADLINE" ] || return 1
	echo "$$" > "$WHITEARMED" 2>/dev/null
	while [ "$(date +%s)" -lt "$DEADLINE" ] 2>/dev/null; do
		white_on || { rm -f "$WHITEARMED"; return 0; }
		[ "$(white_state_get confirmed)" = "yes" ] && { rm -f "$WHITEARMED"; return 0; }
		sleep 5
	done
	white_on || { rm -f "$WHITEARMED"; return 0; }
	[ "$(white_state_get confirmed)" = "yes" ] && { rm -f "$WHITEARMED"; return 0; }
	log "white-test: ПОДТВЕРЖДЕНИЯ НЕ БЫЛО — снимаю слой"
	white_cmd_off >/dev/null 2>&1
	log "white-test: слой снят по таймеру"
	rm -f "$WHITEARMED" 2>/dev/null
	return 0
}

# --------------------------------------------------------------------------
# DoT ЧЕРЕЗ ТУННЕЛЬ — команды. Обоснование и границы — в комментарии над
# DOTCHAIN выше; здесь только устройство.

dot_on() { [ -f "$DOTSTATE" ]; }
dot_state_get() { [ -f "$DOTSTATE" ] && sed -n "s/^$1=//p" "$DOTSTATE" 2>/dev/null | head -1; }

# dot_rules АДРЕСА — построчный список адресов (как отдаёт keep_dns) на
# правила цепочки. Порт 53 НЕ УПОМИНАЕТСЯ нигде в этой функции ни разу — это
# и есть гарантия, что запасной путь остаётся непомеченным: мы его просто не
# трогаем, а не «трогаем и разрешаем».
dot_rules() {
	while IFS= read -r _a; do
		[ -n "$_a" ] || continue
		echo "-A $DOTCHAIN -p tcp -d $_a --dport 853 -j MARK --set-xmark $MARK/$MASK"
		echo "-A $DOTCHAIN -p tcp -d $_a --dport 853 -j CONNMARK --save-mark --nfmask $MASK --ctmask $MASK"
	done
}

dot_teardown() {
	ipt -F "$DOTCHAIN_CHK" 2>/dev/null
	ipt -X "$DOTCHAIN_CHK" 2>/dev/null
	while ipt -C OUTPUT -j "$DOTCHAIN" 2>/dev/null; do
		ipt -D OUTPUT -j "$DOTCHAIN" 2>/dev/null || break
	done
	# СНИМАЕМ ТОЛЬКО СВОЙ ПРЫЖОК, А НЕ ЦЕПОЧКУ MERIDIAN_MSS ЦЕЛИКОМ: она
	# чужая (ставит чёрный режим для FORWARD) и продолжает служить транзиту
	# независимо от нас. Наш след здесь — ровно эта строка `-A OUTPUT -j
	# MERIDIAN_MSS`, добавленная в dot_cmd_on; тело и прыжок из FORWARD не
	# трогаем.
	# КЛЭМП СНИМАЕМ, ТОЛЬКО ЕСЛИ ОН НАШ. После поглощения слоя шагом 11 тот же
	# прыжок ставит `out on`, и `dot off`, позванный ради уборки старого следа,
	# снял бы ЧУЖОЙ работающий клэмп — молча, и обнаружилось бы это зависаниями
	# на крупных ответах, а не отказом. Владелец у правила один.
	if ! out_on; then
		while ipt -C OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null; do
			ipt -D OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null || break
		done
	fi
	while ipt -C OUTPUT -j MERIDIAN_MSS 2>/dev/null; do
		ipt -D OUTPUT -j MERIDIAN_MSS 2>/dev/null || break
	done
	ipt -F "$DOTCHAIN" 2>/dev/null
	ipt -X "$DOTCHAIN" 2>/dev/null
	rm -f "$DOTSTATE" 2>/dev/null
	return 0
}

dot_cmd_on() {
	_dsec="$DOT_CONFIRM_DEFAULT"
	while [ $# -gt 0 ]; do
		case "$1" in
			--confirm) _dsec="$2"; shift 2 ;;
			--confirm=*) _dsec="${1#--confirm=}"; shift ;;
			*) say "непонятный аргумент: $1"; return 2 ;;
		esac
	done
	case "$_dsec" in ''|*[!0-9]*) say "--confirm ждёт число секунд, получено «$_dsec»"; return 2 ;; esac
	if dot_on; then
		say "ОТКАЗ: уже включено. Сначала: $0 dot off"
		return 2
	fi
	# ОСНОВАНИЕ ТО ЖЕ, ЧТО У WHITE-TEST, И ПО ТОЙ ЖЕ ПРИЧИНЕ: маршрут в
	# таблице $TABLE появляется ТОЛЬКО когда чёрный режим включён и
	# подтверждён (route_up зовётся из on-tunnel-up под тем же may_restore).
	# Без этого условия помеченный пакет пойдёт «в никуда», а не в туннель.
	if ! may_restore; then
		say "ОТКАЗ: чёрный режим не включён или не подтверждён — метить некуда."
		return 1
	fi
	# АДРЕСА — ТОТ ЖЕ ИСТОЧНИК, ЧТО У keep_dns(): одно значение в одном месте.
	_addrs=$(keep_dns)
	if [ -z "$_addrs" ]; then
		say "ОТКАЗ: адреса чистых резолверов не получены от $DNSBIN (clean_addrs) — метить нечего."
		return 1
	fi
	ipt -N "$DOTCHAIN" 2>/dev/null
	ipt -F "$DOTCHAIN" 2>/dev/null
	printf '%s\n' "$_addrs" | dot_rules | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	# СВЕРКА СОДЕРЖИМЫМ ЧЕРЕЗ ТЕНЕВУЮ ЦЕПОЧКУ — тот же приём, что у WHITECHAIN
	# (правило 37, история 05.09.2026 про нормализацию масок в iptables).
	ipt -N "$DOTCHAIN_CHK" 2>/dev/null
	ipt -F "$DOTCHAIN_CHK" 2>/dev/null
	printf '%s\n' "$_addrs" | dot_rules | sed "s/^-A $DOTCHAIN /-A $DOTCHAIN_CHK /" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	_want=$(ipt -S "$DOTCHAIN_CHK" 2>/dev/null | grep -v "^-N " | sed "s/^-A $DOTCHAIN_CHK /-A ЦЕПОЧКА /")
	_have=$(ipt -S "$DOTCHAIN" 2>/dev/null | grep -v "^-N " | sed "s/^-A $DOTCHAIN /-A ЦЕПОЧКА /")
	ipt -F "$DOTCHAIN_CHK" 2>/dev/null
	ipt -X "$DOTCHAIN_CHK" 2>/dev/null
	if [ -z "$_want" ]; then
		say "ОТКАЗ: не удалось построить эталон во временной цепочке — сверять не с чем. Снимаю."
		dot_teardown
		return 1
	fi
	if [ "$_want" != "$_have" ]; then
		say "ОТКАЗ: цепочка $DOTCHAIN легла не так, как задумано. Снимаю."
		say "ждали:"; printf '%s\n' "$_want" | sed 's/^/    /'
		say "получилось:"; printf '%s\n' "$_have" | sed 's/^/    /'
		dot_teardown
		return 1
	fi
	# ПРЫЖОК — ПОСЛЕДНИМ ДЕЙСТВИЕМ И В КОНЕЦ, тем же приёмом, что у WHITECHAIN:
	# пока прыжка нет, цепочка ни на что не влияет, и любой отказ выше стоит ноль.
	ipt_check OUTPUT -j "$DOTCHAIN"; case $? in
		1) ipt -A OUTPUT -j "$DOTCHAIN" 2>/dev/null ;;
	esac
	if ! ipt -C OUTPUT -j "$DOTCHAIN" 2>/dev/null; then
		say "ОТКАЗ: прыжок в OUTPUT не встал. Снимаю цепочку."
		dot_teardown
		return 1
	fi
	# КЛЭМП MSS — ПУНКТ «Г» ПЛАНА БЕЛОГО РЕЖИМА, ВСПЛЫВШИЙ РАНЬШЕ СРОКА
	# (приёмка 15.09.2026). Умирает не наш исходящий ClientHello (он мал), а
	# ОТВЕТ сервера: мы объявляем в SYN MSS по интерфейсу (обычно 1424), сервер
	# честно шлёт сегменты этим размером +40, путь туннеля держит меньше —
	# первый крупный ответ (цепочка сертификатов TLS) проваливается целиком.
	# Клэмп правит НАШ ОБЪЯВЛЕННЫЙ MSS в SYN, чтобы СЕРВЕР прислал меньшими
	# кусками — лечит не то, что уходит, а то, что нам присылают в ответ.
	#
	# Цепочка MERIDIAN_MSS УЖЕ ЕСТЬ (ставит чёрный режим, фильтрует по МЕТКЕ
	# 0x1c9/0x1ff, а не по набору адресов — значит подходит нам без изменений
	# тела). Она сегодня подключена только к FORWARD (транзитный трафик от LAN)
	# — наш DoT рождается ЛОКАЛЬНО на роутере и идёт через OUTPUT, FORWARD не
	# видит его вовсе. ПРОВЕРЯЕМ НАЛИЧИЕ ПЕРЕД ДОБАВЛЕНИЕМ: если прыжок уже
	# стоит (для чего-то ещё, или мы сами что-то не подчистили) — не дублируем.
	# ПРЫЖОК ИДЁТ НА ЛОКАЛЬНУЮ ЦЕПОЧКУ, А НЕ НА ОБЩУЮ (шаг 11, часть первая).
	#
	# Прежде здесь стоял прыжок на MERIDIAN_MSS, в теле которой
	# `-o <туннель>`. В mangle OUTPUT интерфейс ещё не выбран — правило не
	# совпадало НИ РАЗУ с выката 1.33/1.34, то есть клэмп для DoT не работал
	# пять дней, а chain_mss=yes/jump_mss=yes всё это время говорили «да».
	# MERIDIAN_MSS_LOCAL клэмпает ТОЛЬКО ПО МЕТКЕ и потому совпадает.
	#
	# СТАРЫЙ ПРЫЖОК СНИМАЕТСЯ ЗДЕСЬ ЖЕ. Он мёртв по построению, оставлять его
	# — значит держать в OUTPUT строку, которая ничего не делает и при этом
	# лишает mss_packets способности отвечать числом: одна цепочка на два
	# входа не разделяет счётчики.
	while ipt -C OUTPUT -j MERIDIAN_MSS 2>/dev/null; do
		ipt -D OUTPUT -j MERIDIAN_MSS 2>/dev/null || break
	done
	ipt_check OUTPUT -j "$CH_MSS_LOCAL"; case $? in
		1) ipt -A OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null ;;
	esac
	_dead=$(( $(date +%s) + _dsec ))
	{ echo "addrs=$(printf '%s' "$_addrs" | tr '\n' ',')"; echo "since=$(date +%s)"; echo "deadline=$_dead"; } > "$DOTSTATE" 2>/dev/null
	log "DoT-через-туннель включён для: $(printf '%s' "$_addrs" | tr '\n' ' '); подтвердить за $_dsec с"
	say "ВКЛЮЧЕНО. TCP:853 к $(printf '%s' "$_addrs" | tr '\n' ' ') идёт в туннель; порт 53 не тронут."
	if [ "$_dsec" -gt 0 ] 2>/dev/null; then
		say "ПОДТВЕРДИТЬ за $_dsec с: $0 dot confirm — иначе снимется само."
		if have setsid; then
			setsid "$SELF" _dot_armed "$_dead" </dev/null >/dev/null 2>&1 &
		else
			( ( "$SELF" _dot_armed "$_dead" </dev/null >/dev/null 2>&1 & ) & )
		fi
	else
		say "Подтверждение не требуется (--confirm 0): правило само не снимется."
	fi
	return 0
}

dot_cmd_off() {
	if ! dot_on; then
		dot_teardown
	else
		dot_teardown
		log "DoT-через-туннель снят"
	fi
	_sled=""
	ipt -C OUTPUT -j "$DOTCHAIN" 2>/dev/null && _sled="$_sled прыжок в OUTPUT;"
	ipt -S "$DOTCHAIN" >/dev/null 2>&1 && _sled="$_sled цепочка $DOTCHAIN;"
	ipt -S "$DOTCHAIN_CHK" >/dev/null 2>&1 && _sled="$_sled временная цепочка $DOTCHAIN_CHK;"
	ipt -C OUTPUT -j MERIDIAN_MSS 2>/dev/null && _sled="$_sled прыжок в MERIDIAN_MSS;"
	# Тот же довод: прыжок на клэмп — след ТОЛЬКО когда слой out выключен.
	out_on || { ipt -C OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null && _sled="$_sled прыжок в $CH_MSS_LOCAL;"; }
	[ -f "$DOTSTATE" ] && _sled="$_sled файл состояния;"
	if [ -n "$_sled" ]; then
		say "ОТКАЗ: после снятия осталось —$_sled"
		return 1
	fi
	say "СНЯТО, следов не осталось. Запасной путь на 53 работал всё это время без изменений."
	return 0
}

dot_cmd_confirm() {
	if ! dot_on; then
		say "подтверждать нечего: не включено"
		return 1
	fi
	# ЗНАЧЕНИЯ ЧИТАЮТСЯ ДО ОТКРЫТИЯ ФАЙЛА НА ЗАПИСЬ, А НЕ ВНУТРИ ТОГО ЖЕ
	# КОМАНДНОГО БЛОКА. `{ ... } > "$DOTSTATE"` обрезает файл в момент
	# настройки перенаправления для ВСЕГО блока — раньше, чем выполнится
	# первая команда внутри. Прежняя редакция звала `dot_state_get` внутри
	# блока и читала уже пустой файл: приёмка 15.09.2026 поймала это по
	# факту (`addrs=` и `since=` пустые после confirm). Тот же приём
	# (значение в переменную ДО перезаписи) стоит проверить и у
	# `white_cmd_confirm` — там конструкция идентичная, баг не мой, но того
	# же класса; не трогаю без отдельного решения.
	_addrs=$(dot_state_get addrs)
	_since=$(dot_state_get since)
	{ echo "addrs=$_addrs"; echo "since=$_since"; echo "confirmed=yes"; } > "$DOTSTATE" 2>/dev/null
	rm -f "$DOTARMED" 2>/dev/null
	log "DoT-через-туннель подтверждён — сам не снимется"
	say "Подтверждено. Останется до $0 dot off."
	return 0
}

dot_cmd_show() {
	if ! dot_on; then
		say "dot: выключено"
		return 0
	fi
	say "dot: включено для $(dot_state_get addrs)"
	say "подтверждён: $(dot_state_get confirmed | grep -c yes)"
	say "цепочка $DOTCHAIN:"
	iptables $IPTW -t mangle -L "$DOTCHAIN" -v -n -x 2>/dev/null | sed 's/^/    /'
	return 0
}

# ПОГЛОЩЕНИЕ СЛОЯ dot ШАГОМ 11 (решение владельца 20.09.2026).
#
# `dot on` делал часть того, что теперь делает `out on`: вёл 853 к чистым
# резолверам в туннель. Два слоя, спорящих за один прыжок клэмпа в OUTPUT и за
# пометку одних и тех же пакетов, — это не выбор, а способ получить состояние,
# которое никто не умеет описать. Поэтому вход закрыт ЯВНО и с причиной.
#
# СНЯТИЕ ОСТАВЛЕНО ЖИВЫМ. На роутере, где слой успели включить, `dot off`
# обязан работать: закрыть дверь так, что след станет нечем убрать, — это не
# поглощение, а ловушка.
cmd_dot() {
	case "${1:-}" in
		on)      say "ОТКАЗ: слой dot ПОГЛОЩЁН шагом 11."
		         say "Его работу (853 к чистым резолверам в туннель) и больше того"
		         say "делает: $0 out on   — там же и 53, и клэмп MSS для своего трафика."
		         say "Снять уже включённый слой dot по-прежнему можно: $0 dot off"
		         return 1 ;;
		_on_vnutri) shift; dot_cmd_on "$@" ;;
		off)     dot_cmd_off ;;
		confirm) dot_cmd_confirm ;;
		show)    dot_cmd_show ;;
		*)       say "usage: $0 dot off | confirm | show   (on поглощён шагом 11: $0 out on)" ; return 2 ;;
	esac
}

# --------------------------------------------------------------------------
# СВОЙ DNS РОУТЕРА В ТУННЕЛЬ (шаг 11) — устройство. Зачем — у констант выше.

out_on() { [ -f "$OUTSTATE" ]; }
out_state_get() { [ -f "$OUTSTATE" ] && sed -n "s/^$1=//p" "$OUTSTATE" 2>/dev/null | head -1; }

# statuscache_drop — ВЫБРОСИТЬ КЭШ status (1.90, вопрос кота 2, 23.09.2026).
#
# ДЫРА, КОТОРУЮ ЭТО ЗАКРЫВАЕТ. `status --cache` отдаёт ответ не старше
# STATUSCACHE_TTL (5с) и до 1.90 НИЧТО не сбрасывало кэш при смене режима.
# То есть сразу после переключения панель до пяти секунд показывала бы
# ПРЕЖНИЙ режим — и без пометки status_stale, то есть уверенно и неотличимо
# от правды. Это ровно инвариант 22 («показание не должно врать
# правдоподобно»), и заметил это не я: кот 2 отказался переводить панель на
# --cache, пока не получит на этот счёт прямого ответа. Ответ был «нет» —
# отсюда эта функция.
#
# Зовётся из ВСЕХ трёх мест, где состояние записывается на диск: state_set
# (режим и подтверждение), out_state_set (слой out) и запись $WHITESTATE
# (белая проба). Дешевле некуда: одна проверка и один unlink, никаких
# процессов.
statuscache_drop() { [ -f "$STATUSCACHE" ] && rm -f "$STATUSCACHE" 2>/dev/null; return 0; }

out_state_set() {
	mkdir -p "$(dirname "$OUTSTATE")" 2>/dev/null
	_ots="$OUTSTATE.tmp.$$"
	{
		echo "since=$1"
		echo "confirmed=$2"
		echo "deadline=$3"
		echo "resolvers=$4"
	} > "$_ots" 2>/dev/null || return 1
	mv -f "$_ots" "$OUTSTATE" 2>/dev/null
	statuscache_drop
}

# out_rules — состав цепочки ОДНИМ СПИСКОМ (тот же приём, что у white_rules и
# white_home_rules): и ставим, и сверяем по одному источнику.
#
# ПОРЯДОК СТРОК СОГЛАСОВАН С ВЛАДЕЛЬЦЕМ И ЗНАЧИМ ЦЕЛИКОМ:
#
# 1. RETURN ПО SO_MARK. Транспорт самого клиента не метим НИКОГДА: помеченный,
#    он уехал бы в таблицу $TABLE, то есть в туннель, который сам же и держит —
#    петля, и роутер остался бы без связи вовсе. Бит 0x40000000 — тот же, что у
#    стопгэпа nfqws (шаг 9), и это НЕ совпадение: клиент ставит его на свои
#    сокеты. Сегодня в OUTPUT эту метку ещё никто не ставит, и строка ничего не
#    ловит — она стоит ЗАРАНЕЕ, потому что день, когда клиент её поставит,
#    иначе обернулся бы мёртвым роутером, а не ошибкой в журнале.
#
# 2. 53 И 853 К ЧИСТЫМ РЕЗОЛВЕРАМ — пометка и RETURN. ОБА порта, а не один:
#    решение 05.09 («запасной путь на 53 остаётся прямым») владельцем 20.09.2026
#    ОТМЕНЕНО — в белом режиме к провайдеру не уходит ничего, а «туннель ляжет —
#    ляжет и DNS» названо выбранным разменом вслух. Адреса СПРОШЕНЫ у
#    meridian-dns (clean_addrs), не вписаны: одно значение в двух местах
#    расходится молча.
#
# 3. ВЫХОД ПО KEEP. Честно про его роль: пометки он не меняет — всё, что не
#    совпало выше, и так уходит непомеченным. Он отделяет «ушло прямо законно»
#    (роутер, VPS, соседний туннель) от «утекло», и только ради этого стоит.
#
# 4. СЧЁТЧИК УТЕЧКИ — ТРИ ПРАВИЛА БЕЗ ЦЕЛИ, БЕЗ -m comment (владелец,
#    21.09.2026, инвариант 32, второй заход на этот пункт за один день).
#    Первый заход (правка чуть раньше тем же числом) убрал хвостовые правила
#    вовсе и считал утечку вычитанием (packets-marked-keep) — владелец эту
#    мысль отклонил живьём: блоку приёмки нужно ЧИСЛО, которое читается
#    ОДНИМ живым правилом, а не арифметикой над тремя отдельными живыми
#    чтениями, каждое своим моментом времени. Правило БЕЗ ЦЕЛИ (без `-j`) —
#    валидный iptables: попало — счётчик вырос, и провалилось к следующему
#    правилу как ни в чём не бывало; ничего не блокирует и ничего не решает
#    само, только считает. Прежние три правила использовали `-m comment` для
#    отличения от правил-резолверов — здесь эта нужда снята: у counter-правил
#    НЕТ `-d`, а у правил резолверов ОН ЕСТЬ ВСЕГДА, `-S` печатает `-d`
#    первым, значит текст строки уже отличим без комментария. Три правила —
#    ОДИН И ТОТ ЖЕ набор портов, что метят строки резолверов (udp/53,
#    tcp/53, tcp/853), но без адреса: сюда попадает то, что НЕ достигло ни
#    одной MARK-строки (не наш чистый резолвер) и НЕ ушло по keep (пункт 3) —
#    то есть буквально мимо туннеля к постороннему DNS.
out_rules() {
	echo "-A $SELFDNSCHAIN -m mark --mark $GWMARK/$GWMASK -j RETURN"
	printf '%s\n' "$1" | while IFS= read -r _a; do
		[ -n "$_a" ] || continue
		echo "-A $SELFDNSCHAIN -p udp -d $_a --dport 53 -j MARK --set-xmark $MARK/$MASK"
		echo "-A $SELFDNSCHAIN -p udp -d $_a --dport 53 -j RETURN"
		echo "-A $SELFDNSCHAIN -p tcp -d $_a --dport 53 -j MARK --set-xmark $MARK/$MASK"
		echo "-A $SELFDNSCHAIN -p tcp -d $_a --dport 53 -j RETURN"
		echo "-A $SELFDNSCHAIN -p tcp -d $_a --dport 853 -j MARK --set-xmark $MARK/$MASK"
		echo "-A $SELFDNSCHAIN -p tcp -d $_a --dport 853 -j RETURN"
	done
	echo "-A $SELFDNSCHAIN -m set --match-set $KEEPSET dst -j RETURN"
	echo "-A $SELFDNSCHAIN -p udp --dport 53"
	echo "-A $SELFDNSCHAIN -p tcp --dport 53"
	echo "-A $SELFDNSCHAIN -p tcp --dport 853"
}

# out_rules_iface — ТА ЖЕ ФОРМА, ЧТО out_rules, НО БЕЗ ЦЕЛИ И ПАРАМИ ПО -o
# (1.71): на каждый резолвер x {udp:53,tcp:53,tcp:853} — одна строка с
# -o <WAN>, одна с -o <туннель>. $1 — список резолверов (как у out_rules),
# $2 — WAN-интерфейс, $3 — интерфейс туннеля. Пустые $2/$3 — дело
# вызывающего (selfdns_iface_apply), здесь только печать.
out_rules_iface() {
	_ori_wan="$2"; _ori_tun="$3"
	printf '%s\n' "$1" | while IFS= read -r _a; do
		[ -n "$_a" ] || continue
		echo "-A $SELFDNSIFCHAIN -o $_ori_wan -p udp -d $_a --dport 53"
		echo "-A $SELFDNSIFCHAIN -o $_ori_tun -p udp -d $_a --dport 53"
		echo "-A $SELFDNSIFCHAIN -o $_ori_wan -p tcp -d $_a --dport 53"
		echo "-A $SELFDNSIFCHAIN -o $_ori_tun -p tcp -d $_a --dport 53"
		echo "-A $SELFDNSIFCHAIN -o $_ori_wan -p tcp -d $_a --dport 853"
		echo "-A $SELFDNSIFCHAIN -o $_ori_tun -p tcp -d $_a --dport 853"
	done
}

# selfdns_iface_apply — ТЕЛО датчика по выходу, ОТДЕЛЬНО от out_apply (тот же
# довод, что у out_mss_local_ensure): нужен ТОЛЬКО вместе со слоем out.
#
# НЕ ФАТАЛЕН для слоя out в целом. Если WAN-интерфейс сейчас не разобрать
# (PPP как раз переподключается) — саму пометку DNS в туннель это не портит,
# портит только этот диагностический датчик; out_apply() ставит метку раньше
# и от результата этой функции не зависит.
selfdns_iface_apply() {
	_sia_wan=$(wan_iface)
	_sia_tun=$(tun_name)
	if [ -z "$_sia_wan" ] || [ -z "$_sia_tun" ]; then
		say "ОТКАЗ (не фатально для out): WAN-интерфейс или туннель сейчас не разобрать — датчик selfdns_wan/selfdns_tun не поставлен."
		selfdns_iface_teardown
		return 1
	fi
	_sia_a=$(keep_dns 2>/dev/null)
	[ -n "$_sia_a" ] || return 1
	ipt -N "$SELFDNSIFCHAIN" 2>/dev/null
	ipt -F "$SELFDNSIFCHAIN" 2>/dev/null
	out_rules_iface "$_sia_a" "$_sia_wan" "$_sia_tun" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	# Эталон — тем же путём во временной цепочке (тот же приём, что у out_apply).
	ipt -N "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	ipt -F "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	out_rules_iface "$_sia_a" "$_sia_wan" "$_sia_tun" | sed "s/^-A $SELFDNSIFCHAIN /-A $SELFDNSIFCHAIN_CHK /" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	_si_want=$(ipt -S "$SELFDNSIFCHAIN_CHK" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSIFCHAIN_CHK /-A ЦЕПОЧКА /")
	_si_have=$(ipt -S "$SELFDNSIFCHAIN" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSIFCHAIN /-A ЦЕПОЧКА /")
	ipt -F "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	ipt -X "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	if [ -z "$_si_want" ] || [ "$_si_want" != "$_si_have" ]; then
		say "ОТКАЗ (не фатально для out): цепочка $SELFDNSIFCHAIN легла не так, как задумано — датчик выключен."
		selfdns_iface_teardown
		return 1
	fi
	ipt_check POSTROUTING -j "$SELFDNSIFCHAIN"; case $? in
		1) ipt -A POSTROUTING -j "$SELFDNSIFCHAIN" 2>/dev/null ;;
	esac
	ipt -C POSTROUTING -j "$SELFDNSIFCHAIN" 2>/dev/null || { say "ОТКАЗ (не фатально для out): прыжок на $SELFDNSIFCHAIN не встал."; return 1; }
	return 0
}

selfdns_iface_teardown() {
	while ipt -C POSTROUTING -j "$SELFDNSIFCHAIN" 2>/dev/null; do
		ipt -D POSTROUTING -j "$SELFDNSIFCHAIN" 2>/dev/null || break
	done
	ipt -F "$SELFDNSIFCHAIN" 2>/dev/null
	ipt -X "$SELFDNSIFCHAIN" 2>/dev/null
	ipt -F "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	ipt -X "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	return 0
}

# selfdns_nat_apply — MASQUERADE для трафика слоя out на выходе из туннеля
# (шаг 11, владелец, 22.09.2026, авария с DNS meridian-server).
#
# ПРИЧИНА: connect() выбирает адрес источника ДО пометки (тот же дефект,
# что объясняет SELFDNSIFCHAIN выше) — DoT/DNS-сокеты meridian-dns уходят с
# WAN-адресом роутера, а не с туннельным, даже когда пакет физически идёт в
# туннель. На meridian-server MASQUERADE стоит только для -s 10.77.0.0/16 —
# пакет с чужим (WAN) источником он не трогает и отпускает наружу как есть:
# либо режет анти-спуфинг хостера, либо ответ приходит мимо туннеля прямо на
# WAN роутера, и meridian-dns никогда его не видит (живой захват 22.09.2026:
# conntrack на сервере — src=WAN-адрес [UNREPLIED], счётчик на её enp0s3
# ловит эти же пакеты БЕЗ подмены). Починка ЗДЕСЬ, на выходе из туннеля,
# правит адрес до того, как пакет вообще покинет роутер — meridian-server
# увидит уже настоящий 10.77.77.x, и его собственный MASQUERADE больше не
# при чём.
#
# ОДНО ПРАВИЛО, НЕ ЦЕПОЧКА (иначе, чем у соседей выше): содержимое — ровно
# `-o туннель -m mark --mark $MARK/$MASK -j MASQUERADE`, расти ему некуда,
# цепочка с эталонной сверкой добавила бы машинерию без пользы.
#
# ПОРЯДОК — ПЕРВЫМ, НЕ ПОСЛЕДНИМ (владелец, 22.09.2026, второй заход живьём).
# Первая редакция ставила правило В КОНЕЦ (`-A`) — рассуждение было «хуже не
# станет, что бы ни стояло раньше». Ошиблось: у прошивки в nat POSTROUTING уже
# стоял СВОЙ безусловный `-o meridian -j MASQUERADE`, БЕЗ разбора по метке —
# и утечка (100.65.18.80 без подмены) продолжалась даже ДО него: значит кто-то
# из цепочек ЕЩЁ ВЫШЕ (_NDM_IPSEC_POSTROUTING_NAT, _NDM_SNAT, _NDM_SNAT_MAPT,
# _NDM_MASQ, nfqws_nat — у прошивки все пять стоят раньше) завершает таблицу
# ТЕРМИНАЛЬНОЙ целью для этого трафика раньше, чем очередь доходит хоть до
# какого-то `-o meridian`. В `nat` первое совпавшее с терминальной целью
# решает судьбу пакета — «в конце» ничем не лучше «нигде», если решение уже
# принято выше. ЕДИНСТВЕННОЕ надёжное место — ПЕРВОЕ: до него ничья
# терминальная цель ещё не сработала.
selfdns_nat_apply() {
	_snt=$(tun_name)
	[ -n "$_snt" ] || { say "ОТКАЗ: туннель сейчас не разобрать — правило MASQUERADE не по чему ставить."; return 1; }
	_sn_others=$(iptn -S POSTROUTING 2>/dev/null | grep -- "-o $_snt " | grep -v -- "mark $MARK/$MASK")
	[ -n "$_sn_others" ] && log "selfdns_nat: в nat POSTROUTING уже есть -o $_snt помимо нашего правила: $(printf '%s' "$_sn_others" | tr '\n' ';')"
	selfdns_nat_poryadok_ensure "$_snt" || return 1
	iptn_check POSTROUTING -o "$_snt" -m mark --mark "$MARK/$MASK" -j MASQUERADE || { say "ОТКАЗ: правило MASQUERADE (nat POSTROUTING) не встало."; return 1; }
	return 0
}

# selfdns_nat_poryadok_ensure — правило ОБЯЗАНО БЫТЬ ПЕРВЫМ В nat POSTROUTING,
# и остаётся им даже если прошивка пересобрала таблицу заново (тот же приём
# сравнения строк -S, что у out_poryadok_ensure/white_position_ensure: обе
# позиции смещены одной и той же политикой на первой строке, смещение
# сокращается при сравнении друг с другом, а не с зашитым числом). Идемпотентно
# — если правило уже первое, ничего не переставляет.
selfdns_nat_poryadok_ensure() {
	_snpe_t="$1"
	# «НЕ ЗНАЮ» — НЕ ТРОГАЕМ (тот же принцип, что у ipt_check выше в файле):
	# при занятом замке лучше не переставлять правило вслепую по -S, которая
	# в этот момент может врать, чем изображать починку.
	iptn_check POSTROUTING -o "$_snpe_t" -m mark --mark "$MARK/$MASK" -j MASQUERADE
	[ "$?" = 2 ] && { say "ОТКАЗ: замок xtables занят — позицию MASQUERADE не проверяю, не трогаю."; return 1; }
	_snpe_first=$(iptn -S POSTROUTING 2>/dev/null | grep -n '^-A POSTROUTING ' | head -1 | cut -d: -f1)
	_snpe_ours=$(iptn -S POSTROUTING 2>/dev/null | grep -n -- "-o $_snpe_t -m mark --mark $MARK/$MASK -j MASQUERADE\$" | head -1 | cut -d: -f1)
	if [ -n "$_snpe_ours" ] && [ -n "$_snpe_first" ] && [ "$_snpe_ours" = "$_snpe_first" ]; then
		return 0
	fi
	[ -n "$_snpe_ours" ] && say "ensure: MASQUERADE в nat POSTROUTING стоит не первым (стр.$_snpe_ours, первая стр.$_snpe_first) — переставляю"
	while iptn -C POSTROUTING -o "$_snpe_t" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null; do
		iptn -D POSTROUTING -o "$_snpe_t" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null || break
	done
	iptn -I POSTROUTING 1 -o "$_snpe_t" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null
	iptn -C POSTROUTING -o "$_snpe_t" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null || { say "ОТКАЗ: правило MASQUERADE не встало после перестановки в начало."; return 1; }
	return 0
}

selfdns_nat_teardown() {
	_snt=$(tun_name)
	[ -n "$_snt" ] || return 0
	while iptn -C POSTROUTING -o "$_snt" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null; do
		iptn -D POSTROUTING -o "$_snt" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null || break
	done
	return 0
}

# selfdns_wanin_rules — СЧЁТЧИК БЕЗ ЦЕЛИ (тот же приём, что out_rules_iface),
# НАПРАВЛЕНИЕ ОБРАТНОЕ: не куда уходит запрос, а откуда приходит ОТВЕТ. Если
# он приходит на WAN вместо туннеля — это и есть утечка, которую чинит
# selfdns_nat_apply выше; датчик должен видеть её ЧИСЛОМ, а не полагаться на
# то, что она когда-нибудь перестанет случаться. mangle PREROUTING — `-i`
# уже решён, тот же довод, что у POSTROUTING/`-o` в selfdns_iface_apply.
selfdns_wanin_rules() {
	_swr_wan="$2"
	printf '%s\n' "$1" | while IFS= read -r _a; do
		[ -n "$_a" ] || continue
		echo "-A $SELFDNSWANINCHAIN -i $_swr_wan -p udp -s $_a --sport 53"
		echo "-A $SELFDNSWANINCHAIN -i $_swr_wan -p tcp -s $_a --sport 53"
		echo "-A $SELFDNSWANINCHAIN -i $_swr_wan -p tcp -s $_a --sport 853"
	done
}

# selfdns_wanin_apply — ТЕЛО датчика, НЕ ФАТАЛЕН для out в целом (тот же
# довод, что у selfdns_iface_apply: WAN может быть временно не разобрать,
# пока PPP переподключается — это не поломка).
selfdns_wanin_apply() {
	_swa_wan=$(wan_iface)
	if [ -z "$_swa_wan" ]; then
		say "ОТКАЗ (не фатально для out): WAN-интерфейс сейчас не разобрать — датчик selfdns_wan_in не поставлен."
		selfdns_wanin_teardown
		return 1
	fi
	_swa_a=$(keep_dns 2>/dev/null)
	[ -n "$_swa_a" ] || return 1
	ipt -N "$SELFDNSWANINCHAIN" 2>/dev/null
	ipt -F "$SELFDNSWANINCHAIN" 2>/dev/null
	selfdns_wanin_rules "$_swa_a" "$_swa_wan" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	# Эталон — тем же путём во временной цепочке (тот же приём, что у out_apply).
	ipt -N "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	ipt -F "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	selfdns_wanin_rules "$_swa_a" "$_swa_wan" | sed "s/^-A $SELFDNSWANINCHAIN /-A $SELFDNSWANINCHAIN_CHK /" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	_swi_want=$(ipt -S "$SELFDNSWANINCHAIN_CHK" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSWANINCHAIN_CHK /-A ЦЕПОЧКА /")
	_swi_have=$(ipt -S "$SELFDNSWANINCHAIN" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSWANINCHAIN /-A ЦЕПОЧКА /")
	ipt -F "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	ipt -X "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	if [ -z "$_swi_want" ] || [ "$_swi_want" != "$_swi_have" ]; then
		say "ОТКАЗ (не фатально для out): цепочка $SELFDNSWANINCHAIN легла не так, как задумано — датчик выключен."
		selfdns_wanin_teardown
		return 1
	fi
	ipt_check PREROUTING -j "$SELFDNSWANINCHAIN"; case $? in
		1) ipt -A PREROUTING -j "$SELFDNSWANINCHAIN" 2>/dev/null ;;
	esac
	ipt -C PREROUTING -j "$SELFDNSWANINCHAIN" 2>/dev/null || { say "ОТКАЗ (не фатально для out): прыжок на $SELFDNSWANINCHAIN не встал."; return 1; }
	return 0
}

selfdns_wanin_teardown() {
	while ipt -C PREROUTING -j "$SELFDNSWANINCHAIN" 2>/dev/null; do
		ipt -D PREROUTING -j "$SELFDNSWANINCHAIN" 2>/dev/null || break
	done
	ipt -F "$SELFDNSWANINCHAIN" 2>/dev/null
	ipt -X "$SELFDNSWANINCHAIN" 2>/dev/null
	ipt -F "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	ipt -X "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	return 0
}

# out_poryadok_ensure — КЛЭМП ОБЯЗАН СТОЯТЬ НИЖЕ ПОМЕТКИ.
#
# MERIDIAN_MSS_LOCAL совпадает ТОЛЬКО по метке (1.56). Метку ставит цепочка
# $SELFDNSCHAIN. Прыжок на клэмп, оказавшийся в OUTPUT выше нашего, не поймает
# ни одного пакета — и при этом chain_mss_local=yes, jump_mss_local=yes будут
# говорить «да». Это ровно тот дефект, который в 1.56 разбирали у mss_packets,
# только повторённый порядком строк.
#
# Случай не выдуманный: прыжок на клэмп мог остаться от слоя dot, который
# ставил его САМ и раньше. Тогда наш прыжок допишется ПОСЛЕ него.
#
# Действие — только когда порядок ДЕЙСТВИТЕЛЬНО нарушен (тот же приём, что у
# gw_rules_apply): иначе два цикла ensure переставляли бы друг друга вечно.
#
# Номера строк берутся из `-S`, где первой идёт политика цепочки: обе строки
# смещены одинаково, а сравниваются они друг с другом — смещение сокращается.
out_poryadok_ensure() {
	_op_s=$(ipt -S OUTPUT 2>/dev/null | grep -n -- "-j $SELFDNSCHAIN\$" | head -1 | cut -d: -f1)
	_op_m=$(ipt -S OUTPUT 2>/dev/null | grep -n -- "-j $CH_MSS_LOCAL\$" | head -1 | cut -d: -f1)
	[ -n "$_op_s" ] || return 1
	[ -n "$_op_m" ] || return 0
	[ "$_op_m" -gt "$_op_s" ] 2>/dev/null && return 0
	say "ensure: клэмп $CH_MSS_LOCAL стоит РАНЬШЕ пометки $SELFDNSCHAIN (строка $_op_m, наша $_op_s) — переставляю ниже"
	log "порядок в OUTPUT: $CH_MSS_LOCAL ($_op_m) был выше $SELFDNSCHAIN ($_op_s) — переставляю"
	while ipt -C OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null; do
		ipt -D OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null || break
	done
	ipt -A OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null
	ipt -C OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null || { say "ОТКАЗ: прыжок на $CH_MSS_LOCAL не вернулся на место."; return 1; }
	return 0
}

# out_apply — поставить цепочку и прыжок ИДЕМПОТЕНТНО и со сверкой СОДЕРЖИМЫМ.
# Зовётся и из `out on`, и из `ensure`.
# out_mss_local_ensure — ТЕЛО клэмпа MERIDIAN_MSS_LOCAL (создание + MTU-
# рефреш), ОТДЕЛЬНО от rules_apply() (владелец, 21.09.2026). Довод — там же,
# у вызывающих: клэмп нужен ТОЛЬКО вместе со слоем out, и создаваться обязан
# только тогда, а не на каждом ensure чёрного режима независимо от слоя.
#
# ТЕЛО — БЕЗ -o: в mangle OUTPUT интерфейс ещё не выбран, определяющая —
# МЕТКА, и только она (тот же довод, что был у прежнего места в rules_apply).
out_mss_local_ensure() {
	_oml_m=$(want_mss)
	[ -n "$_oml_m" ] || return 0
	chain_exists "$CH_MSS_LOCAL"; case $? in
		1) ipt -N "$CH_MSS_LOCAL" 2>/dev/null ;;
	esac
	ipt_check "$CH_MSS_LOCAL" -p tcp --tcp-flags SYN,RST SYN -m mark --mark "$MARK/$MASK" -j TCPMSS --set-mss "$_oml_m"; case $? in
		1) # Старое значение MSS снимаем перед постановкой нового: иначе в
		   # цепочке накопятся правила на каждое изменение MTU.
		   ipt -S "$CH_MSS_LOCAL" 2>/dev/null | grep -- '-j TCPMSS' | sed 's/^-A /-D /' | while IFS= read -r _mr; do
		       ipt $_mr 2>/dev/null
		   done
		   ipt -A "$CH_MSS_LOCAL" -p tcp --tcp-flags SYN,RST SYN -m mark --mark "$MARK/$MASK" -j TCPMSS --set-mss "$_oml_m" ;;
	esac
	return 0
}

out_apply() {
	_oa=$(keep_dns 2>/dev/null)
	# ПУСТОЕ — НЕ СОВПАДЕНИЕ И НЕ «РЕЗОЛВЕРОВ НЕТ» (правило 39). Цепочка без
	# строк резолверов выглядит поставленной и не метит ничего.
	[ -n "$_oa" ] || { say "ОТКАЗ: clean_addrs у meridian-dns не прочитаны — правило резолверов писать не по чему."; return 1; }
	ipt -N "$SELFDNSCHAIN" 2>/dev/null
	ipt -F "$SELFDNSCHAIN" 2>/dev/null
	out_rules "$_oa" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	# Эталон строится ТЕМ ЖЕ ПУТЁМ во временной цепочке: iptables нормализует
	# то, что читает, и сравнивать рукописную строку с его выводом нельзя.
	ipt -N "$SELFDNSCHAIN_CHK" 2>/dev/null
	ipt -F "$SELFDNSCHAIN_CHK" 2>/dev/null
	out_rules "$_oa" | sed "s/^-A $SELFDNSCHAIN /-A $SELFDNSCHAIN_CHK /" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	_o_want=$(ipt -S "$SELFDNSCHAIN_CHK" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSCHAIN_CHK /-A ЦЕПОЧКА /")
	_o_have=$(ipt -S "$SELFDNSCHAIN" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSCHAIN /-A ЦЕПОЧКА /")
	ipt -F "$SELFDNSCHAIN_CHK" 2>/dev/null
	ipt -X "$SELFDNSCHAIN_CHK" 2>/dev/null
	[ -n "$_o_want" ] || { say "ОТКАЗ: не удалось построить эталон во временной цепочке — сверять не с чем."; return 1; }
	if [ "$_o_want" != "$_o_have" ]; then
		say "ОТКАЗ: цепочка $SELFDNSCHAIN легла не так, как задумано."
		say "ждали:"; printf '%s\n' "$_o_want" | sed 's/^/    /'
		say "получилось:"; printf '%s\n' "$_o_have" | sed 's/^/    /'
		return 1
	fi
	# МАСКАРАД — ДО ПРЫЖКА, НЕ ПОСЛЕ (владелец, 22.09.2026, авария с DNS):
	# пока прыжка на $SELFDNSCHAIN нет, ничего не метится и подменять ещё
	# нечего, но как только он встанет — трафик обязан сразу иметь готовый
	# путь исправления адреса, а не окно между «начали метить» и «научились
	# подменять». ФАТАЛЕН, в отличие от датчиков ниже: без него слой отмечает
	# трафик в туннель, но не чинит источник — именно так родилась авария,
	# оставлять слой в таком виде хуже, чем не включать его вовсе.
	selfdns_nat_apply || return 1
	# ПРЫЖОК — ПОСЛЕДНИМ ДЕЙСТВИЕМ: пока его нет, цепочка ни на что не влияет,
	# и любой отказ выше стоит ноль.
	#
	# В КОНЕЦ, а не на первую позицию. Разведка 20.09.2026: у прошивки в mangle
	# OUTPUT нет ни одного правила (_NDM_WGOBFS_OUT, _NDM_OUTPUT_DELAY,
	# _NDM_IPSEC_OUTPUT_MANGLE — все три пусты, только -N), спора за позицию
	# здесь нет. Тот же довод, что у white_position_ensure в PREROUTING: быть
	# ПОСЛЕДНИМ среди помечающих безопаснее, чем первым, — иначе поставивший
	# метку после нас молча её переопределит.
	ipt_check OUTPUT -j "$SELFDNSCHAIN"; case $? in
		1) ipt -A OUTPUT -j "$SELFDNSCHAIN" 2>/dev/null ;;
	esac
	ipt -C OUTPUT -j "$SELFDNSCHAIN" 2>/dev/null || { say "ОТКАЗ: прыжок на $SELFDNSCHAIN не встал."; return 1; }
	# ДАТЧИК ПО ВЫХОДУ — ВМЕСТЕ СО СЛОЕМ, НЕ ФАТАЛЕН (1.71, см. selfdns_iface_apply).
	selfdns_iface_apply || true
	# ДАТЧИК ВХОДЯЩИХ НА WAN — ВМЕСТЕ СО СЛОЕМ, ТОЖЕ НЕ ФАТАЛЕН (см.
	# selfdns_wanin_apply): ловит утечку, если маскарад выше почему-то не
	# спас (например, ответ пришёл на WAN по причине, не связанной с
	# источником запроса) — само наличие сенсора не гарантирует, что
	# чинить уже нечего.
	selfdns_wanin_apply || true
	# КЛЭМП ДЛЯ СВОЕГО ЖЕ ТРАФИКА — ВМЕСТЕ СО СЛОЕМ, а не отдельным глаголом.
	# TCP к резолверу (853, и 53 когда падаем на открытый текст) поедет в
	# туннель, у которого MTU меньше. Без клэмпа это тихие зависания на больших
	# ответах, которые не выглядят как DNS.
	#
	# ТЕЛО — ЗДЕСЬ, ВМЕСТЕ С ПРЫЖКОМ (владелец, 21.09.2026): раньше тело
	# ставилось в rules_apply() безусловно, на каждом ensure чёрного режима,
	# и парк получал пустую цепочку без единого прыжка на неё.
	out_mss_local_ensure
	ipt_check OUTPUT -j "$CH_MSS_LOCAL"; case $? in
		1) ipt -A OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null ;;
	esac
	# МЁРТВЫЙ ПРЫЖОК НА ОБЩУЮ ЦЕПОЧКУ — СНЯТЬ. На роутере, обновлённом с
	# 1.33-1.55, слой dot оставил в OUTPUT строку `-j MERIDIAN_MSS`. Она не
	# совпадает там ни с чем (в теле общей цепочки `-o <туннель>`, а в mangle
	# OUTPUT интерфейс ещё не выбран), но делает точку входа на общую цепочку
	# ВТОРОЙ — и mss_packets из-за неё перестаёт отвечать числом.
	while ipt -C OUTPUT -j "$CH_MSS" 2>/dev/null; do
		ipt -D OUTPUT -j "$CH_MSS" 2>/dev/null || break
	done
	out_poryadok_ensure || return 1
	return 0
}

# out_teardown — снять БЕЗ разговоров. Отдельно от out_cmd_off: зовётся и из
# отката по таймеру, и из общего off.
out_teardown() {
	while ipt -C OUTPUT -j "$SELFDNSCHAIN" 2>/dev/null; do
		ipt -D OUTPUT -j "$SELFDNSCHAIN" 2>/dev/null || break
	done
	ipt -F "$SELFDNSCHAIN" 2>/dev/null
	ipt -X "$SELFDNSCHAIN" 2>/dev/null
	ipt -F "$SELFDNSCHAIN_CHK" 2>/dev/null
	ipt -X "$SELFDNSCHAIN_CHK" 2>/dev/null
	# Датчик по выходу — тот же жизненный цикл, снимаем вместе с остальным.
	selfdns_iface_teardown
	# Маскарад и датчик входящих на WAN — тот же жизненный цикл.
	selfdns_nat_teardown
	selfdns_wanin_teardown
	# Клэмп ставили мы — мы и снимаем. Второго владельца у этого прыжка больше
	# нет: слой dot поглощён (dot on отказывает), и ставить его некому.
	mss_local_teardown
	rm -f "$OUTSTATE" "$OUTNOADDRMARK" 2>/dev/null
	return 0
}

# out_vorota — ВСЕ ворота одним местом, каждая со своим отказом.
# --------------------------------------------------------------------------
# СБРОС ПУЛА UPSTREAM-СОЕДИНЕНИЙ meridian-dns (шаг 11, владелец, 22.09.2026,
# третий заход: подмена адреса (selfdns_nat_apply) чинит НОВЫЕ соединения, но
# conntrack уже держит старые DoT/53-сессии к резолверам, открытые ДО
# перехода, без NAT — на сервере они видны как [UNREPLIED] от WAN-адреса
# роутера до собственного таймаута (у Keenetic FASTNAT — 1188 с). Снаружи
# снять только запись conntrack было бы не о том: соединение не разорвано,
# просто источник в нём неверный, закрыть сокет и открыть новый умеет только
# тот, кто им владеет. SIGUSR1 (Кот 2, 22.09.2026, meridian-dns 0.36) просит
# meridian-dns сделать это самому.
# --------------------------------------------------------------------------

DNSPIDFILE="${MERIDIAN_ROUTE_DNSPIDFILE:-/opt/var/run/meridian-dns.pid}"
DNSPOOLMINVER="0.36"

# dns_running_version — версия ИСПОЛНЯЕМОГО процесса, не файла на диске
# (Кот 2, 22.09.2026: бинарь на диске мог смениться без перезапуска, живьём
# ловили расхождение). Тот же TXT-канал, что и dot_ok/dot_fail — одна команда,
# ничего, кроме $DNSBIN status, не требуется, dig/drill не нужны.
dns_running_version() {
	[ -x "$DNSBIN" ] || return 1
	"$DNSBIN" status 2>/dev/null | sed -n 's/^server_version_running=//p' | head -1
}

# ver_ge А Б — истина, если А >= Б, формат X.YY, только цифры и одна точка.
ver_ge() {
	_vg_a1=${1%%.*}; _vg_a2=${1#*.}
	_vg_b1=${2%%.*}; _vg_b2=${2#*.}
	case "$_vg_a1$_vg_a2$_vg_b1$_vg_b2" in *[!0-9]*) return 1 ;; esac
	[ "$_vg_a1" -gt "$_vg_b1" ] 2>/dev/null && return 0
	[ "$_vg_a1" -lt "$_vg_b1" ] 2>/dev/null && return 1
	[ "$_vg_a2" -ge "$_vg_b2" ] 2>/dev/null
}

dns_pool_reset_supported() {
	_drs_v=$(dns_running_version)
	[ -n "$_drs_v" ] || return 1
	ver_ge "$_drs_v" "$DNSPOOLMINVER"
}

# dns_server_pid — PID процесса meridian-dns SERVER, ПРОВЕРЕННЫЙ по cmdline
# (Кот 2, 22.09.2026): /opt/var/run/meridian-dns.pid пишет сам server при
# старте, но файл может пережить процесс (крэш без чистки, pid переиспользован
# ядром) и указывать не туда. Последнее слово в /proc/PID/cmdline у server —
# ровно "run" (тем же признаком main.go отличает его от guard); guard сигнала
# никогда не получает — пул апстримов держит только server (владелец,
# 22.09.2026, подтверждено Котом 2).
dns_server_pid() {
	[ -f "$DNSPIDFILE" ] || return 1
	_dsp=$(cat "$DNSPIDFILE" 2>/dev/null)
	case "$_dsp" in ''|*[!0-9]*) return 1 ;; esac
	[ -d "/proc/$_dsp" ] || return 1
	_dsc=$(tr '\0' ' ' < "/proc/$_dsp/cmdline" 2>/dev/null)
	[ -n "$_dsc" ] || return 1
	if [ "$(printf '%s' "$_dsc" | awk '{print $NF}')" != "run" ]; then
		log "selfdns_pool_reset: pid $_dsp из $DNSPIDFILE — cmdline не оканчивается на «run» ($(dns_cmdline_redacted "$_dsc")), не трогаю"
		return 1
	fi
	if ! printf '%s' "$_dsc" | grep -q "meridian-dns"; then
		log "selfdns_pool_reset: pid $_dsp из $DNSPIDFILE не похож на meridian-dns ($(dns_cmdline_redacted "$_dsc")), не трогаю"
		return 1
	fi
	echo "$_dsp"
	return 0
}

# dns_cmdline_redacted — ДЛЯ ЛОГА, НИКОГДА для решений: -password и -vk несут
# секреты абонента, им нет места в meridian-route.log (владелец, 22.09.2026).
dns_cmdline_redacted() {
	printf '%s' "$1" | sed -E 's/-password [^ ]*/-password ***/g; s/-vk [^ ]*/-vk ***/g'
}

# dns_pool_reset — ЗОВЁТСЯ ПОСЛЕ применения правил, на каждом переходе out
# on/off (владелец, 22.09.2026). НЕ ФАТАЛЕН: к этому моменту поддержка уже
# проверена в out_vorota, отказ здесь — транзитный (процесс успел умереть
# между воротами и этой строкой), а не повод откатывать уже применённые
# правила NAT — они и без пула чинят все НОВЫЕ соединения, пул лечит только
# СТАРЫЕ.
dns_pool_reset() {
	dns_pool_reset_supported || { log "selfdns_pool_reset: meridian-dns не поддерживает сброс пула (версия $(dns_running_version 2>/dev/null || echo '?') < $DNSPOOLMINVER) — сигнал не посылаю"; return 1; }
	_dpr_pid=$(dns_server_pid)
	if [ -z "$_dpr_pid" ]; then
		log "selfdns_pool_reset: pid сервера meridian-dns не подтверждён — сигнал не посылаю"
		return 1
	fi
	if kill -USR1 "$_dpr_pid" 2>/dev/null; then
		log "selfdns_pool_reset: SIGUSR1 отправлен meridian-dns (pid $_dpr_pid)"
		return 0
	fi
	log "selfdns_pool_reset: kill -USR1 не удался (pid $_dpr_pid)"
	return 1
}

out_vorota() {
	if nft_meridian_active; then
		say "ОТКАЗ: на этом роутере разметка живёт в nftables (таблица inet meridian, путь OpenWrt) — этот движок её не понимает и не трогает."
		return 1
	fi
	if out_on; then
		say "ОТКАЗ: слой уже включён. Состояние: $0 out show"
		return 1
	fi
	if dot_on; then
		say "ОТКАЗ: включён слой dot — шаг 11 его ЗАМЕНЯЕТ и спорил бы с ним за прыжок клэмпа."
		say "Сначала: $0 dot off, затем $0 out on"
		return 1
	fi
	if [ "$(state_get confirmed)" != "yes" ]; then
		say "ОТКАЗ: режим не подтверждён — метить некуда."
		return 1
	fi
	case "$(state_get mode)" in
		black|white) : ;;
		*) say "ОТКАЗ: режим сейчас «$(state_get mode)» — метить некуда. Сначала: $0 on"; return 1 ;;
	esac
	if ! iface_exists; then
		say "ОТКАЗ: туннеля $(tun_name) сейчас нет. DNS роутера ушёл бы в удержание, а вместе с ним — и имя VPS, по которому туннель поднимается."
		return 1
	fi
	if ! route_mine_present; then
		say "ОТКАЗ: в таблице $TABLE нет нашего маршрута. Сначала: $0 ensure"
		return 1
	fi
	have ipset || { say "ОТКАЗ: нет ipset"; return 1; }
	# IPv6 — ВОРОТА БЕЗ ФЛАГА ОБХОДА, тот же класс, что в белом режиме. Есть
	# маршрут наружу по IPv6 — резолвер может быть спрошен по нему, мимо всей
	# этой цепочки, а проверки по IPv4 покажут зелёное.
	if [ -n "$(ip -6 route show default 2>/dev/null)" ]; then
		say "ОТКАЗ: у роутера есть маршрут по умолчанию для IPv6. Слой сделан на IPv4: DNS ушёл бы мимо туннеля по IPv6, а проверки показывали бы зелёное."
		return 1
	fi
	# НАБОР KEEP ОБЯЗАН СУЩЕСТВОВАТЬ: правило `-m set --match-set` на
	# несуществующий ipset — ошибка ядра, а не безвредная строка. Мы её не
	# увидим (2>/dev/null), и цепочка молча ляжет неполной.
	if ! set_exists "$KEEPSET"; then
		say "ОТКАЗ: набора $KEEPSET нет — правило выхода по keep не встанет. Сначала: $0 keep build"
		return 1
	fi
	_ov_a=$(keep_dns 2>/dev/null)
	if [ -z "$_ov_a" ]; then
		say "ОТКАЗ: clean_addrs у meridian-dns не прочитаны — адреса резолверов писать не по чему."
		say "Проверьте: $DNSBIN status | grep clean_addrs"
		return 1
	fi
	# СБРОС ПУЛА ОБЯЗАН БЫТЬ ДОСТУПЕН ДО ВКЛЮЧЕНИЯ, не после (владелец,
	# 22.09.2026): без него старые DoT/53-соединения остаются без NAT до
	# собственного таймаута — то же самое, ради чего чинили selfdns_nat_apply,
	# только для трафика, начатого ДО перехода. Включать слой, заранее зная,
	# что часть трафика останется сломанной, хуже, чем не включать вовсе.
	if ! dns_pool_reset_supported; then
		say "ОТКАЗ: meridian-dns не поддерживает сброс пула апстримов (нужна версия $DNSPOOLMINVER или новее, сейчас $(dns_running_version 2>/dev/null || echo 'неизвестна')) — без него старые DoT/53-соединения останутся сломаны после включения. Обновите meridian-dns."
		return 1
	fi
	# ЦЕЛЬ ОБЯЗАНА НАЙТИСЬ ЗАРАНЕЕ, А НЕ МОЛЧА ПРОПУСТИТЬСЯ (владелец,
	# 22.09.2026, четвёртый заход): meridian-dns может поддерживать сброс, но
	# server — быть поднят вручную мимо $DNSPIDFILE (ровно случай HERO прямо
	# сейчас), и тогда dns_pool_reset() внутри out_cmd_on() тихо отказался бы
	# слать сигнал, а слой включился бы как ни в чём не бывало — тот же обман,
	# от которого чинили молчаливые «стоит, но не работает» выше по файлу.
	if [ -z "$(dns_server_pid)" ]; then
		say "ОТКАЗ: meridian-dns поддерживает сброс пула, но server-процесс не найден или не подтверждён по $DNSPIDFILE (cmdline не оканчивается на «run») — сбрасывать нечего. Если server запущен вручную мимо своего pid-файла, поправьте это, а не игнорируйте отказ."
		return 1
	fi
	return 0
}

out_cmd_on() {
	_osec="$OUT_CONFIRM_DEFAULT"
	while [ $# -gt 0 ]; do
		case "$1" in
			--confirm) _osec="$2"; shift 2 ;;
			--confirm=*) _osec="${1#--confirm=}"; shift ;;
			*) say "непонятный аргумент: $1"; return 2 ;;
		esac
	done
	case "$_osec" in ''|*[!0-9]*) say "--confirm ждёт число секунд, получено «$_osec»"; return 2 ;; esac

	out_vorota || return 1
	_oaddrs=$(keep_dns 2>/dev/null | tr '\n' ' ')

	if ! out_apply; then
		say "Снимаю, ничего не оставляю."
		out_teardown
		return 1
	fi
	# СБРОС ПУЛА — ПОСЛЕ применения правил, не до (владелец, 22.09.2026):
	# закрывать старые соединения раньше, чем встал маскарад, означало бы
	# открывать новые с тем же дефектом источника. Не фатален — поддержка
	# уже проверена в out_vorota, откатывать применённые правила NAT из-за
	# транзитного сбоя здесь не за что.
	dns_pool_reset || true
	_odead=""
	[ "$_osec" -gt 0 ] 2>/dev/null && _odead=$(( $(date +%s) + _osec ))
	out_state_set "$(date +%s)" no "$_odead" "$_oaddrs" || { say "ОТКАЗ: состояние слоя не записано — снимаю."; out_teardown; return 1; }
	out_clear_noaddr_mark
	log "СВОЙ DNS РОУТЕРА В ТУННЕЛЬ: включено, резолверы $_oaddrs, подтвердить за $_osec с"
	say "ВКЛЮЧЕНО: DNS самого роутера идёт в туннель."
	say "Резолверы: $_oaddrs (порты 53 и 853)"
	say "ТУННЕЛЬ ЛЯЖЕТ — ЛЯЖЕТ И DNS РОУТЕРА. Это выбранный размен, не сбой."
	# ПАУЗА DNS НА ПЕРЕКЛЮЧЕНИИ — СКАЗАНО ВСЛУХ (владелец, 21.09.2026,
	# «родственное для движка», поймано вместе с ложным красным в блоке
	# приёмки). Соединение, живое В МОМЕНТ этой команды, меняет маршрут
	# (правило встаёт мгновенно), но несёт СТАРЫЙ адрес источника — и
	# обрывается, а не продолжается по новому пути. Секунды здесь не
	# называем: не измерено ЭТИМ движком, измерено приёмкой на живом
	# роутере (блок Б шага 11) — там же ждём число, не гадаем.
	say "Соединение DNS, живое ИМЕННО СЕЙЧАС, оборвётся и переподключится —"
	say "  короткая пауза, это не сбой, а смена маршрута под ним."
	if [ -n "$_odead" ]; then
		say "ПОДТВЕРДИТЬ за $_osec с: $0 out confirm"
		say "Не подтвердите — слой снимется сам и всё вернётся как было."
		if have setsid; then
			setsid "$SELF" _out_armed "$_odead" </dev/null >/dev/null 2>&1 &
		else
			( ( "$SELF" _out_armed "$_odead" </dev/null >/dev/null 2>&1 & ) & )
		fi
	else
		say "Подтверждение не требуется (--confirm 0): слой сам не снимется."
	fi
	return 0
}

out_cmd_confirm() {
	out_on || { say "подтверждать нечего: слой не включён"; return 1; }
	out_state_set "$(out_state_get since)" yes "" "$(out_state_get resolvers)"
	log "слой out подтверждён человеком — откат отменён"
	say "Принято. Откат отменён, слой остаётся до $0 out off."
	# РЕЗОЛВЕРЫ ПОКИДАЮТ $KEEPSET ПРЯМО СЕЙЧАС, а не на следующем ensure по
	# отпечатку (1.72, пункт 1 хвоста шага 11): подтверждение — тот самый
	# момент перехода, откладывать его на минуту нечем оправдать.
	if keep_build; then
		say "keep пересобран: резолверы вне набора, размен из status."
	else
		say "ВНИМАНИЕ: keep не пересобрался сразу — дособерёт ближайший ensure."
	fi
}

out_cmd_off() {
	out_on || {
		say "слой не включён — проверяю, не осталось ли следов"
		out_teardown
		_osl=$(ipt -S 2>/dev/null | grep -c "$SELFDNSCHAIN")
		[ "$_osl" = "0" ] && say "следов нет" || say "ВНИМАНИЕ: следы остались ($_osl строк)"
		return 0
	}
	out_teardown
	# СБРОС ПУЛА — И ПРИ ВЫКЛЮЧЕНИИ ТОЖЕ (владелец, 22.09.2026): старые
	# DoT/53-соединения, открытые ЧЕРЕЗ туннель, после off должны закрыться и
	# переоткрыться мимо него — иначе тот же класс дефекта в обратную сторону.
	dns_pool_reset || true
	_osl=$(ipt -S 2>/dev/null | grep -c "$SELFDNSCHAIN")
	if [ "$_osl" != "0" ]; then
		say "СНЯТО НЕ ВСЁ: в mangle осталось строк с $SELFDNSCHAIN: $_osl"
		return 1
	fi
	say "Снято. DNS роутера снова идёт прежним путём, мимо туннеля."
	say "Соединение DNS, живое ИМЕННО СЕЙЧАС, оборвётся и переподключится —"
	say "  короткая пауза, та же смена маршрута, что при включении."
	say "Следов не осталось."
	# РЕЗОЛВЕРЫ ВОЗВРАЩАЮТСЯ В $KEEPSET ПРЯМО СЕЙЧАС (1.72, пункт 1 хвоста
	# шага 11) — до следующего ensure они были бы без защиты набора лишнюю
	# минуту, хотя явные правила уже сняты этим же snyatiem.
	if keep_build; then
		say "keep пересобран: резолверы снова в наборе."
	else
		say "ВНИМАНИЕ: keep не пересобрался сразу — дособерёт ближайший ensure."
	fi
	return 0
}

out_cmd_show() {
	if out_on; then
		echo "out=on"
		echo "out_confirmed=$(out_state_get confirmed)"
		echo "out_since=$(out_state_get since)"
		echo "out_resolvers=$(out_state_get resolvers)"
		echo "out_chain=$SELFDNSCHAIN"
	else
		echo "out=off"
	fi
}

cmd_out() {
	case "${1:-}" in
		on)      shift; out_cmd_on "$@" ;;
		off)     out_cmd_off ;;
		confirm) out_cmd_confirm ;;
		show)    out_cmd_show ;;
		*)       say "usage: $0 out on [--confirm N] | off | confirm | show" ; return 2 ;;
	esac
}

# cmd_out_armed — предохранитель. Тот же приём, что у чёрного и белого режима:
# отцепленный процесс, дедлайн в аргументе, подтверждение отменяет. След об
# автооткате ставится СУЩЕСТВУЮЩИМ механизмом (fallback_mark).
cmd_out_armed() {
	trap '' HUP
	DEADLINE="$1"
	[ -n "$DEADLINE" ] || exit 1
	echo "$$" > "$OUTARMED" 2>/dev/null
	while [ "$(date +%s)" -lt "$DEADLINE" ] 2>/dev/null; do
		[ "$(out_state_get confirmed)" = "yes" ] && { rm -f "$OUTARMED"; exit 0; }
		out_on || { rm -f "$OUTARMED"; exit 0; }
		sleep 5
	done
	[ "$(out_state_get confirmed)" = "yes" ] && { rm -f "$OUTARMED"; exit 0; }
	log "СВОЙ DNS РОУТЕРА: подтверждения не было — снимаю слой"
	out_teardown >/dev/null 2>&1
	# СБРОС ПУЛА И ЗДЕСЬ — тот же переход out on->off, что у cmd_out_off, но
	# по таймеру, а не по руке (владелец, 22.09.2026).
	dns_pool_reset >/dev/null 2>&1 || true
	fallback_mark unconfirmed_out selfdns_removed \
		"слой «свой DNS роутера в туннель» не подтвердили в срок — снят, DNS роутера снова идёт мимо туннеля"
	log "откат слоя out выполнен"
	rm -f "$OUTARMED" 2>/dev/null
	exit 0
}

# upstream_vps_name — имя VPS, ЕСЛИ ОНО ИМЯ. То же чтение, что у keep_peer
# (RAW_PEER, иначе PEER), но БЕЗ резолва: список исключений upstream живёт
# ИМЕНАМИ, а не адресами (Кот 2, 20.09.2026) — резолв здесь был бы лишним
# шагом и лишней точкой расхождения.
upstream_vps_name() {
	_p=$(peer_host)
	[ -n "$_p" ] || return 1
	case "$_p" in
		*[!0-9.]*) echo "$_p" ;;   # есть буквы — имя
		*) return 1 ;;             # голые цифры и точки — уже IP, метить нечего
	esac
}

# upstream_exceptions_ensure — ИМЯ VPS ИЗ PEER ПОПАДАЕТ В СПИСОК ИСКЛЮЧЕНИЙ
# АВТОМАТИЧЕСКИ, человеком не вписывается (решение владельца 21.09.2026).
#
# ДОВОД ТОТ ЖЕ, ЧТО У АДРЕСА VPS В meridian_keep4: рукописная копия однажды
# разойдётся с конфигом молча, а цена здесь хуже, чем в keep, — не «утечёт
# трафик», а «туннель замкнётся сам на себя»: в upstream clean-only DNS едет
# через туннель, и если имя VPS не в исключениях, оно тоже уйдёт через
# туннель, которого в этот момент ещё/уже нет — сам себя не поднимет.
#
# ФАЙЛ ЧУЖОЙ И ОБЩИЙ. Формат Кота 2 разрешает человеку дописывать свои имена
# (оговорка про имена провайдера), и функция ТРОГАЕТ ТОЛЬКО СВОЮ СТРОКУ:
# метка-комментарий перед ней и файл состояния — как узнать, какую строку
# убрать, если PEER сменится. Чужие строки читаются и переписываются как
# есть, свои не участвуют дважды.
upstream_exceptions_ensure() {
	_ue_new=$(upstream_vps_name) || _ue_new=""
	_ue_old=$(cat "$UPSTREAM_EXC_STATE" 2>/dev/null | tr -d '
')
	[ "$_ue_new" = "$_ue_old" ] && return 0
	mkdir -p "$(dirname "$UPSTREAM_EXC")" 2>/dev/null
	_ue_rest=""
	if [ -f "$UPSTREAM_EXC" ]; then
		_ue_rest=$(grep -v "$UPSTREAM_EXC_MARK" "$UPSTREAM_EXC" 2>/dev/null)
		[ -n "$_ue_old" ] && _ue_rest=$(printf '%s
' "$_ue_rest" | grep -vix "$_ue_old")
	fi
	_ue_tmp="$UPSTREAM_EXC.tmp.$$"
	{
		[ -n "$_ue_rest" ] && printf '%s
' "$_ue_rest"
		if [ -n "$_ue_new" ]; then
			echo "# $UPSTREAM_EXC_MARK: имя VPS из PEER/RAW_PEER — не трогать руками, правит движок"
			echo "$_ue_new"
		fi
	} > "$_ue_tmp" 2>/dev/null || return 1
	mv -f "$_ue_tmp" "$UPSTREAM_EXC" 2>/dev/null || return 1
	if [ -n "$_ue_new" ]; then
		printf '%s' "$_ue_new" > "$UPSTREAM_EXC_STATE" 2>/dev/null
	else
		rm -f "$UPSTREAM_EXC_STATE" 2>/dev/null
	fi
	log "upstream-exceptions: имя VPS обновлено («$_ue_old» -> «$_ue_new»)"
	return 0
}

out_warn_noaddr_once() {
	[ -f "$OUTNOADDRMARK" ] && return 0
	: > "$OUTNOADDRMARK" 2>/dev/null
	say "ensure: clean_addrs у meridian-dns не прочитаны — цепочку $SELFDNSCHAIN НЕ трогаю"
	log "ensure: clean_addrs пусты — $SELFDNSCHAIN оставлен как есть (пустое не значит «резолверов не стало»)"
}
out_clear_noaddr_mark() { rm -f "$OUTNOADDRMARK" 2>/dev/null; }

# out_ensure — АВТОВОССТАНОВЛЕНИЕ СЛОЯ. Прошивка пересобирает правила по своим
# событиям, и без этого DNS роутера ушёл бы открытым путём молча.
#
# Дёшево в обычном случае: первая же строка читает ФАЙЛ, и на роутерах, где
# слой не включён, отсюда не уходит ни одного вызова iptables.
out_ensure() {
	out_on || return 0
	have iptables || return 0
	# MTU-РЕФРЕШ КЛЭМПА — ПОКА СЛОЙ ВКЛЮЧЁН, тем же приёмом, что у общего
	# MERIDIAN_MSS в rules_apply(): туннель мог сменить MTU, а тело клэмпа
	# больше не живёт там, где раньше рефрешилось на каждом ensure.
	out_mss_local_ensure
	_on=0
	ipt -S "$SELFDNSCHAIN" >/dev/null 2>&1 || _on=1
	[ "$_on" = 0 ] && { ipt -C OUTPUT -j "$SELFDNSCHAIN" 2>/dev/null || _on=1; }
	if [ "$_on" = 0 ]; then
		_oe_a=$(keep_dns 2>/dev/null)
		if [ -z "$_oe_a" ]; then
			# НЕ ПЕРЕСТРАИВАЕМ ПО ПУСТОМУ. Молчащий сервер дал бы цепочку без
			# единой строки резолверов — и слой выглядел бы стоящим, а DNS
			# уходил бы мимо туннеля. Лучше оставить прежнюю и сказать.
			out_warn_noaddr_once
			out_poryadok_ensure
			return 0
		fi
		out_clear_noaddr_mark
		# СВЕРКА ЧИСЛОМ ПРАВИЛ, а не фактом существования цепочки: пустая
		# цепочка с прыжком выглядит исправной и не метит ничего.
		_ov=$(ipt -S "$SELFDNSCHAIN" 2>/dev/null | grep -c "^-A ")
		_ow=$(out_rules "$_oe_a" | grep -c .)
		[ "$_ov" = "$_ow" ] || _on=1
	fi
	# ДАТЧИК ПО ВЫХОДУ ПРОВЕРЯЕТСЯ ТЕМ ЖЕ ЦИКЛОМ (1.71): если WAN сейчас
	# разбирается, а цепочка/прыжок MERIDIAN_SELFDNS_IFACE пропали (та же
	# природа отказа, что у основной цепочки), чинится тем же ремонтом ниже —
	# ОТДЕЛЬНОГО ensure для сиблинга не заводим (живут вместе со слоем out).
	# Когда WAN сейчас НЕ разобрать (PPP переподключается) — не считается
	# поломкой: selfdns_iface_apply сама откажется молча, ensure не будет
	# гоняться за временным отсутствием маршрута каждую минуту.
	if [ "$_on" = 0 ]; then
		_sie_wan=$(wan_iface); _sie_tun=$(tun_name)
		if [ -n "$_sie_wan" ] && [ -n "$_sie_tun" ]; then
			chain_exists "$SELFDNSIFCHAIN" || _on=1
			[ "$_on" = 0 ] && { ipt -C POSTROUTING -j "$SELFDNSIFCHAIN" 2>/dev/null || _on=1; }
		fi
	fi
	# МАСКАРАД — ПРОВЕРЯЕТСЯ ТЕМ ЖЕ ЦИКЛОМ (владелец, 22.09.2026, авария с
	# DNS): без него слой отмечает трафик в туннель, но подмены адреса нет —
	# именно так родилась авария, ensure обязан видеть эту поломку отдельно
	# от состояния SELFDNSCHAIN/SELFDNSIFCHAIN, они друг друга не гарантируют.
	# Только код 1 (точно нет) взводит пересборку — код 2 (замок занят,
	# «не знаю») её НЕ взводит, тот же принцип, что у ipt_check выше в файле.
	if [ "$_on" = 0 ]; then
		_sne_t=$(tun_name)
		iptn_check POSTROUTING -o "$_sne_t" -m mark --mark "$MARK/$MASK" -j MASQUERADE; case $? in
			1) _on=1 ;;
		esac
	fi
	# ДАТЧИК ВХОДЯЩИХ НА WAN — ТЕМ ЖЕ ЦИКЛОМ, тот же довод, что у
	# SELFDNSIFCHAIN чуть выше (сиблинг слоя, отдельного ensure не заводим).
	if [ "$_on" = 0 ] && [ -n "$_sie_wan" ]; then
		chain_exists "$SELFDNSWANINCHAIN" || _on=1
		[ "$_on" = 0 ] && { ipt -C PREROUTING -j "$SELFDNSWANINCHAIN" 2>/dev/null || _on=1; }
	fi
	if [ "$_on" = 0 ]; then
		out_poryadok_ensure
		# ЛЁГКАЯ ПЕРЕСТАНОВКА, НЕ ПЕРЕСБОРКА (тот же довод, что у
		# out_poryadok_ensure строкой выше): правило MASQUERADE на месте, но
		# прошивка могла пересобрать nat POSTROUTING и подвинуть его вниз —
		# чинится перестановкой, полный out_apply для этого не нужен.
		selfdns_nat_poryadok_ensure "$_sne_t"
		return 0
	fi
	say "ensure: слой out включён, а цепочка $SELFDNSCHAIN отсутствует или неполна — ставлю заново"
	log "ensure: восстанавливаю $SELFDNSCHAIN"
	out_apply || log "ensure: восстановить $SELFDNSCHAIN НЕ удалось"
	return 0
}

# cmd_hold — ЯВНОЕ решение человека про удержание, когда порог уже пройден
# (hold_policy=closed, умолчание с 15.09.2026): движок сам в open не выходит,
# единственный путь — эта команда (или панель, которая её же и позовёт).
cmd_hold() {
	case "${1:-}" in
		open)  hold_cmd_open ;;
		close) hold_cmd_close ;;
		show)  hold_cmd_show ;;
		*)     say "usage: $0 hold open | close | show" ; return 2 ;;
	esac
}

# hold_cmd_open — выпустить трафик из списка открытым каналом ПРЯМО СЕЙЧАС,
# по решению человека, а не по таймеру. Требует, чтобы туннель ДЕЙСТВИТЕЛЬНО
# лежал — открывать нечего, если он на месте, и это не тихий отказ, а
# названная причина.
hold_cmd_open() {
	_ts=$(tun_field state)
	[ "$_ts" = "down" ] || { say "ОТКАЗ: туннель не лежит (state=${_ts:-unknown}) — открывать нечего"; return 1; }
	_since=$(tun_field since); case "$_since" in ''|*[!0-9]*) _since=$(date +%s) ;; esac
	_open=$(tun_field open_since)
	if [ -n "$_open" ]; then
		say "уже открыто с $(rb_human "$_open")"
		return 0
	fi
	_held=$(tun_field held_total); case "$_held" in ''|*[!0-9]*) _held=0 ;; esac
	rules_ip_remove_hold
	_now=$(date +%s)
	tun_state_set down "$_since" "$_now" "$_held" "$_now"
	log "УДЕРЖАНИЕ СНЯТО ЧЕЛОВЕКОМ: трафик из списка идёт ОТКРЫТЫМ каналом до возвращения туннеля"
	say "открыто: трафик из списка идёт открытым каналом, пока туннель не вернётся"
}

# hold_cmd_close — вернуть удержание, если человек передумал (или включил
# open по ошибке). Симметрично open: отказ называется, а не молчит.
hold_cmd_close() {
	_open=$(tun_field open_since)
	if [ -z "$_open" ]; then
		say "уже под удержанием — закрывать нечего"
		return 0
	fi
	_since=$(tun_field since); case "$_since" in ''|*[!0-9]*) _since=$(date +%s) ;; esac
	_held=$(tun_field held_total); case "$_held" in ''|*[!0-9]*) _held=0 ;; esac
	hold_route_up
	_now=$(date +%s)
	tun_state_set down "$_since" "" "$_held" "$_now"
	log "УДЕРЖАНИЕ ВОЗВРАЩЕНО ЧЕЛОВЕКОМ: трафик из списка снова в blackhole"
	say "закрыто: трафик из списка снова удерживается"
}

hold_cmd_show() {
	echo "hold_policy=$(hold_policy)"
	echo "hold_state=$(hold_state_value)"
	echo "hold_open_since=$(tun_field open_since)"
}

# _dot_armed — сторож включения. Тот же приём, что у white-test и у чёрного
# режима: первая в истории движка пометка трафика самого роутера обязана
# уметь откатиться сама, если человек не подтвердил.
cmd_dot_armed() {
	trap '' HUP
	DEADLINE="$1"
	[ -n "$DEADLINE" ] || return 1
	echo "$$" > "$DOTARMED" 2>/dev/null
	while [ "$(date +%s)" -lt "$DEADLINE" ] 2>/dev/null; do
		dot_on || { rm -f "$DOTARMED"; return 0; }
		[ "$(dot_state_get confirmed)" = "yes" ] && { rm -f "$DOTARMED"; return 0; }
		sleep 5
	done
	dot_on || { rm -f "$DOTARMED"; return 0; }
	[ "$(dot_state_get confirmed)" = "yes" ] && { rm -f "$DOTARMED"; return 0; }
	log "dot: ПОДТВЕРЖДЕНИЯ НЕ БЫЛО — снимаю"
	dot_cmd_off >/dev/null 2>&1
	log "dot: снято по таймеру"
	rm -f "$DOTARMED" 2>/dev/null
	return 0
}

# cmd_home_ifaces — интерфейсы дома, ИМЕНАМИ, одной командой (1.69, владелец,
# 21.09.2026, инвариант 36). Заворот DNS у Кота 2 берёт список интерфейсов
# отсюда, а не держит свой IFACES=br0 — один источник факта на оба
