				bare = substr(line, bp + 2)
				if (index(bare, "-A " ch " ") != 1) next
				cnt = line
				sub(/^\[/, "", cnt); sub(/:.*/, "", cnt)
				cnt = cnt + 0
				for (i = 1; i <= np; i++) {
					if (bare ~ pat[i]) { found[i] = 1; sum[i] += cnt }
				}
			}
