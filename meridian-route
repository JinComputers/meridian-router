hold_open_percentile() {
	_v="${MERIDIAN_ROUTE_HOLD_PERCENTILE:-$(conf_value HOLD_OPEN_PERCENTILE 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 90 ;; *) echo "$_v" ;; esac
