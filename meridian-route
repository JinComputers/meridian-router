}
cmd_white_armed() {
	trap '' HUP
	DEADLINE="$1"
	[ -n "$DEADLINE" ] || return 1
	echo "$$" > "$WHITEARMED" 2>/dev/null
	while [ "$(date +%s)" -lt "$DEADLINE" ] 2>/dev/null; do
		white_on || { rm -f "$WHITEARMED"; return 0; }
		[ "$(white_state_get confirmed)" = "yes" ] && { rm -f "$WHITEARMED"; return 0; }
		sleep 5
	done
	white_on || { rm -f "$WHITEARMED"; return 0; }
	[ "$(white_state_get confirmed)" = "yes" ] && { rm -f "$WHITEARMED"; return 0; }
	log "white-test: ПОДТВЕРЖДЕНИЯ НЕ БЫЛО — снимаю слой"
	white_cmd_off >/dev/null 2>&1
