offload_managed() {
	[ "$OFFLOAD_MANAGE" = "off" ] && return 0
	[ "$(conf_value OFFLOAD)" = "off" ]
}
offload_get() { cat "$1" 2>/dev/null | tr -d ' \t\n'; }
offload_save_once() {
	[ -f "$OFFLOADSAVE" ] && return 0
	offload_present || return 0
	_fn=$(offload_get "$FASTNAT_PATH")
	_fr=$(offload_get "$FASTROUTE_PATH")
	case "$_fn" in ''|0|1) ;; *) log "разгрузка: fastnat читается как «$_fn» — не 0 и не 1, НЕ трогаю ручки вовсе"; return 1 ;; esac
	case "$_fr" in ''|0|1) ;; *) log "разгрузка: fastroute читается как «$_fr» — не 0 и не 1, НЕ трогаю ручки вовсе"; return 1 ;; esac
	mkdir_for "$OFFLOADSAVE"
	{ echo "fastnat=$_fn"; echo "fastroute=$_fr"; echo "saved_at=$(date +%s)"; } > "$OFFLOADSAVE.tmp" 2>/dev/null || return 1
	mv -f "$OFFLOADSAVE.tmp" "$OFFLOADSAVE" 2>/dev/null || return 1
	log "разгрузка: запомнил прежние значения fastnat=$_fn fastroute=$_fr (вернём их при снятии)"
	return 0
}
offload_saved_get() { [ -f "$OFFLOADSAVE" ] && sed -n "s/^$1=//p" "$OFFLOADSAVE" 2>/dev/null | head -1; }
offload_set() {
	_path=$1; _want=$2
	[ -f "$_path" ] || return 0
	[ -n "$_want" ] || return 0
	echo "$_want" > "$_path" 2>/dev/null
	_got=$(offload_get "$_path")
	[ "$_got" = "$_want" ] && return 0
	return 1
}
offload_disable() {
	offload_managed || return 1
	offload_present || return 1
	_was_fn=$(offload_get "$FASTNAT_PATH")
	_was_fr=$(offload_get "$FASTROUTE_PATH")
	if [ "$_was_fn" = "0" ] && [ "$_was_fr" = "0" ]; then
		return 1
	fi
	offload_save_once || return 2
	_bad=""
	offload_set "$FASTNAT_PATH" 0   || _bad="$_bad fastnat"
	offload_set "$FASTROUTE_PATH" 0 || _bad="$_bad fastroute"
	if [ -n "$_bad" ]; then
		log "разгрузка: НЕ выключилась ($_bad) — транзит через туннель будет рваться; проверьте вручную: cat $FASTNAT_PATH $FASTROUTE_PATH"
		return 2
	fi
	return 0
}
offload_restore() {
	[ -f "$OFFLOADSAVE" ] || return 1
	_fn=$(offload_saved_get fastnat)
	_fr=$(offload_saved_get fastroute)
	_bad=""
	offload_set "$FASTNAT_PATH" "$_fn"   || _bad="$_bad fastnat"
	offload_set "$FASTROUTE_PATH" "$_fr" || _bad="$_bad fastroute"
	if [ -n "$_bad" ]; then
		say "ОТКАЗ: не вернул прежние значения разгрузки ($_bad). Вручную:"
		[ -n "$_fn" ] && say "    echo $_fn > $FASTNAT_PATH"
		[ -n "$_fr" ] && say "    echo $_fr > $FASTROUTE_PATH"
		log "разгрузка: возврат НЕ удался ($_bad), запомненное оставлено в $OFFLOADSAVE"
		return 2
	fi
	log "разгрузка: вернул прежние значения fastnat=$_fn fastroute=$_fr"
	rm -f "$OFFLOADSAVE" 2>/dev/null
	return 0
}
TUNSTATE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.tunnel"
