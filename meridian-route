			-S) shift; _iptsnap_s "$_IPTSNAP_F" "${1:-}"; return $? ;;
		esac
	fi
	iptables $IPTW -t filter "$@" 2>/dev/null
}
iptn() {
	if [ -n "$_IPTSNAP_ON" ] && [ -n "$_IPTSNAP_N" ]; then
		case "$1" in
