out_rules() {
	echo "-A $SELFDNSCHAIN -m mark --mark $GWMARK/$GWMASK -j RETURN"
	printf '%s\n' "$1" | while IFS= read -r _a; do
		[ -n "$_a" ] || continue
		echo "-A $SELFDNSCHAIN -p udp -d $_a --dport 53 -j MARK --set-xmark $MARK/$MASK"
		echo "-A $SELFDNSCHAIN -p udp -d $_a --dport 53 -j RETURN"
		echo "-A $SELFDNSCHAIN -p tcp -d $_a --dport 53 -j MARK --set-xmark $MARK/$MASK"
		echo "-A $SELFDNSCHAIN -p tcp -d $_a --dport 53 -j RETURN"
		echo "-A $SELFDNSCHAIN -p tcp -d $_a --dport 853 -j MARK --set-xmark $MARK/$MASK"
		echo "-A $SELFDNSCHAIN -p tcp -d $_a --dport 853 -j RETURN"
	done
	echo "-A $SELFDNSCHAIN -m set --match-set $KEEPSET dst -j RETURN"
	echo "-A $SELFDNSCHAIN -p udp --dport 53"
	echo "-A $SELFDNSCHAIN -p tcp --dport 53"
	echo "-A $SELFDNSCHAIN -p tcp --dport 853"
}
out_rules_iface() {
	_ori_wan="$2"; _ori_tun="$3"
	printf '%s\n' "$1" | while IFS= read -r _a; do
		[ -n "$_a" ] || continue
		echo "-A $SELFDNSIFCHAIN -o $_ori_wan -p udp -d $_a --dport 53"
		echo "-A $SELFDNSIFCHAIN -o $_ori_tun -p udp -d $_a --dport 53"
		echo "-A $SELFDNSIFCHAIN -o $_ori_wan -p tcp -d $_a --dport 53"
		echo "-A $SELFDNSIFCHAIN -o $_ori_tun -p tcp -d $_a --dport 53"
		echo "-A $SELFDNSIFCHAIN -o $_ori_wan -p tcp -d $_a --dport 853"
		echo "-A $SELFDNSIFCHAIN -o $_ori_tun -p tcp -d $_a --dport 853"
	done
}
selfdns_iface_apply() {
	_sia_wan=$(wan_iface)
	_sia_tun=$(tun_name)
	if [ -z "$_sia_wan" ] || [ -z "$_sia_tun" ]; then
		say "ОТКАЗ (не фатально для out): WAN-интерфейс или туннель сейчас не разобрать — датчик selfdns_wan/selfdns_tun не поставлен."
		selfdns_iface_teardown
		return 1
	fi
	_sia_a=$(keep_dns 2>/dev/null)
	[ -n "$_sia_a" ] || return 1
	ipt -N "$SELFDNSIFCHAIN" 2>/dev/null
	ipt -F "$SELFDNSIFCHAIN" 2>/dev/null
	out_rules_iface "$_sia_a" "$_sia_wan" "$_sia_tun" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	ipt -N "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	ipt -F "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	out_rules_iface "$_sia_a" "$_sia_wan" "$_sia_tun" | sed "s/^-A $SELFDNSIFCHAIN /-A $SELFDNSIFCHAIN_CHK /" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	_si_want=$(ipt -S "$SELFDNSIFCHAIN_CHK" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSIFCHAIN_CHK /-A ЦЕПОЧКА /")
	_si_have=$(ipt -S "$SELFDNSIFCHAIN" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSIFCHAIN /-A ЦЕПОЧКА /")
	ipt -F "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	ipt -X "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	if [ -z "$_si_want" ] || [ "$_si_want" != "$_si_have" ]; then
		say "ОТКАЗ (не фатально для out): цепочка $SELFDNSIFCHAIN легла не так, как задумано — датчик выключен."
		selfdns_iface_teardown
		return 1
	fi
	ipt_check POSTROUTING -j "$SELFDNSIFCHAIN"; case $? in
		1) ipt -A POSTROUTING -j "$SELFDNSIFCHAIN" 2>/dev/null ;;
	esac
	ipt -C POSTROUTING -j "$SELFDNSIFCHAIN" 2>/dev/null || { say "ОТКАЗ (не фатально для out): прыжок на $SELFDNSIFCHAIN не встал."; return 1; }
	return 0
}
selfdns_iface_teardown() {
	while ipt -C POSTROUTING -j "$SELFDNSIFCHAIN" 2>/dev/null; do
		ipt -D POSTROUTING -j "$SELFDNSIFCHAIN" 2>/dev/null || break
	done
	ipt -F "$SELFDNSIFCHAIN" 2>/dev/null
	ipt -X "$SELFDNSIFCHAIN" 2>/dev/null
	ipt -F "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	ipt -X "$SELFDNSIFCHAIN_CHK" 2>/dev/null
	return 0
}
selfdns_nat_apply() {
	_snt=$(tun_name)
	[ -n "$_snt" ] || { say "ОТКАЗ: туннель сейчас не разобрать — правило MASQUERADE не по чему ставить."; return 1; }
	_sn_others=$(iptn -S POSTROUTING 2>/dev/null | grep -- "-o $_snt " | grep -v -- "mark $MARK/$MASK")
	[ -n "$_sn_others" ] && log "selfdns_nat: в nat POSTROUTING уже есть -o $_snt помимо нашего правила: $(printf '%s' "$_sn_others" | tr '\n' ';')"
	selfdns_nat_poryadok_ensure "$_snt" || return 1
	iptn_check POSTROUTING -o "$_snt" -m mark --mark "$MARK/$MASK" -j MASQUERADE || { say "ОТКАЗ: правило MASQUERADE (nat POSTROUTING) не встало."; return 1; }
	return 0
}
selfdns_nat_poryadok_ensure() {
	_snpe_t="$1"
	iptn_check POSTROUTING -o "$_snpe_t" -m mark --mark "$MARK/$MASK" -j MASQUERADE
	[ "$?" = 2 ] && { say "ОТКАЗ: замок xtables занят — позицию MASQUERADE не проверяю, не трогаю."; return 1; }
	_snpe_first=$(iptn -S POSTROUTING 2>/dev/null | grep -n '^-A POSTROUTING ' | head -1 | cut -d: -f1)
	_snpe_ours=$(iptn -S POSTROUTING 2>/dev/null | grep -n -- "-o $_snpe_t -m mark --mark $MARK/$MASK -j MASQUERADE\$" | head -1 | cut -d: -f1)
	if [ -n "$_snpe_ours" ] && [ -n "$_snpe_first" ] && [ "$_snpe_ours" = "$_snpe_first" ]; then
		return 0
	fi
	[ -n "$_snpe_ours" ] && say "ensure: MASQUERADE в nat POSTROUTING стоит не первым (стр.$_snpe_ours, первая стр.$_snpe_first) — переставляю"
	while iptn -C POSTROUTING -o "$_snpe_t" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null; do
		iptn -D POSTROUTING -o "$_snpe_t" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null || break
	done
	iptn -I POSTROUTING 1 -o "$_snpe_t" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null
	iptn -C POSTROUTING -o "$_snpe_t" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null || { say "ОТКАЗ: правило MASQUERADE не встало после перестановки в начало."; return 1; }
	return 0
}
selfdns_nat_teardown() {
	_snt=$(tun_name)
	[ -n "$_snt" ] || return 0
	while iptn -C POSTROUTING -o "$_snt" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null; do
		iptn -D POSTROUTING -o "$_snt" -m mark --mark "$MARK/$MASK" -j MASQUERADE 2>/dev/null || break
	done
	return 0
}
selfdns_wanin_rules() {
	_swr_wan="$2"
	printf '%s\n' "$1" | while IFS= read -r _a; do
		[ -n "$_a" ] || continue
		echo "-A $SELFDNSWANINCHAIN -i $_swr_wan -p udp -s $_a --sport 53"
		echo "-A $SELFDNSWANINCHAIN -i $_swr_wan -p tcp -s $_a --sport 53"
		echo "-A $SELFDNSWANINCHAIN -i $_swr_wan -p tcp -s $_a --sport 853"
	done
}
selfdns_wanin_apply() {
	_swa_wan=$(wan_iface)
	if [ -z "$_swa_wan" ]; then
		say "ОТКАЗ (не фатально для out): WAN-интерфейс сейчас не разобрать — датчик selfdns_wan_in не поставлен."
		selfdns_wanin_teardown
		return 1
	fi
	_swa_a=$(keep_dns 2>/dev/null)
	[ -n "$_swa_a" ] || return 1
	ipt -N "$SELFDNSWANINCHAIN" 2>/dev/null
	ipt -F "$SELFDNSWANINCHAIN" 2>/dev/null
	selfdns_wanin_rules "$_swa_a" "$_swa_wan" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	ipt -N "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	ipt -F "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	selfdns_wanin_rules "$_swa_a" "$_swa_wan" | sed "s/^-A $SELFDNSWANINCHAIN /-A $SELFDNSWANINCHAIN_CHK /" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	_swi_want=$(ipt -S "$SELFDNSWANINCHAIN_CHK" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSWANINCHAIN_CHK /-A ЦЕПОЧКА /")
	_swi_have=$(ipt -S "$SELFDNSWANINCHAIN" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSWANINCHAIN /-A ЦЕПОЧКА /")
	ipt -F "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	ipt -X "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	if [ -z "$_swi_want" ] || [ "$_swi_want" != "$_swi_have" ]; then
		say "ОТКАЗ (не фатально для out): цепочка $SELFDNSWANINCHAIN легла не так, как задумано — датчик выключен."
		selfdns_wanin_teardown
		return 1
	fi
	ipt_check PREROUTING -j "$SELFDNSWANINCHAIN"; case $? in
		1) ipt -A PREROUTING -j "$SELFDNSWANINCHAIN" 2>/dev/null ;;
	esac
	ipt -C PREROUTING -j "$SELFDNSWANINCHAIN" 2>/dev/null || { say "ОТКАЗ (не фатально для out): прыжок на $SELFDNSWANINCHAIN не встал."; return 1; }
	return 0
}
selfdns_wanin_teardown() {
	while ipt -C PREROUTING -j "$SELFDNSWANINCHAIN" 2>/dev/null; do
		ipt -D PREROUTING -j "$SELFDNSWANINCHAIN" 2>/dev/null || break
	done
	ipt -F "$SELFDNSWANINCHAIN" 2>/dev/null
	ipt -X "$SELFDNSWANINCHAIN" 2>/dev/null
	ipt -F "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	ipt -X "$SELFDNSWANINCHAIN_CHK" 2>/dev/null
	return 0
}
out_poryadok_ensure() {
	_op_s=$(ipt -S OUTPUT 2>/dev/null | grep -n -- "-j $SELFDNSCHAIN\$" | head -1 | cut -d: -f1)
	_op_m=$(ipt -S OUTPUT 2>/dev/null | grep -n -- "-j $CH_MSS_LOCAL\$" | head -1 | cut -d: -f1)
	[ -n "$_op_s" ] || return 1
	[ -n "$_op_m" ] || return 0
	[ "$_op_m" -gt "$_op_s" ] 2>/dev/null && return 0
	say "ensure: клэмп $CH_MSS_LOCAL стоит РАНЬШЕ пометки $SELFDNSCHAIN (строка $_op_m, наша $_op_s) — переставляю ниже"
	log "порядок в OUTPUT: $CH_MSS_LOCAL ($_op_m) был выше $SELFDNSCHAIN ($_op_s) — переставляю"
	while ipt -C OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null; do
		ipt -D OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null || break
	done
	ipt -A OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null
	ipt -C OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null || { say "ОТКАЗ: прыжок на $CH_MSS_LOCAL не вернулся на место."; return 1; }
	return 0
}
out_mss_local_ensure() {
	_oml_m=$(want_mss)
	[ -n "$_oml_m" ] || return 0
	chain_exists "$CH_MSS_LOCAL"; case $? in
		1) ipt -N "$CH_MSS_LOCAL" 2>/dev/null ;;
	esac
	ipt_check "$CH_MSS_LOCAL" -p tcp --tcp-flags SYN,RST SYN -m mark --mark "$MARK/$MASK" -j TCPMSS --set-mss "$_oml_m"; case $? in
		1) # Старое значение MSS снимаем перед постановкой нового: иначе в
		   ipt -S "$CH_MSS_LOCAL" 2>/dev/null | grep -- '-j TCPMSS' | sed 's/^-A /-D /' | while IFS= read -r _mr; do
		       ipt $_mr 2>/dev/null
		   done
		   ipt -A "$CH_MSS_LOCAL" -p tcp --tcp-flags SYN,RST SYN -m mark --mark "$MARK/$MASK" -j TCPMSS --set-mss "$_oml_m" ;;
	esac
	return 0
}
out_apply() {
	_oa=$(keep_dns 2>/dev/null)
	[ -n "$_oa" ] || { say "ОТКАЗ: clean_addrs у meridian-dns не прочитаны — правило резолверов писать не по чему."; return 1; }
	ipt -N "$SELFDNSCHAIN" 2>/dev/null
	ipt -F "$SELFDNSCHAIN" 2>/dev/null
	out_rules "$_oa" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	ipt -N "$SELFDNSCHAIN_CHK" 2>/dev/null
	ipt -F "$SELFDNSCHAIN_CHK" 2>/dev/null
	out_rules "$_oa" | sed "s/^-A $SELFDNSCHAIN /-A $SELFDNSCHAIN_CHK /" | while IFS= read -r _r; do
		ipt $_r 2>/dev/null
	done
	_o_want=$(ipt -S "$SELFDNSCHAIN_CHK" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSCHAIN_CHK /-A ЦЕПОЧКА /")
	_o_have=$(ipt -S "$SELFDNSCHAIN" 2>/dev/null | grep -v "^-N " | sed "s/^-A $SELFDNSCHAIN /-A ЦЕПОЧКА /")
	ipt -F "$SELFDNSCHAIN_CHK" 2>/dev/null
	ipt -X "$SELFDNSCHAIN_CHK" 2>/dev/null
	[ -n "$_o_want" ] || { say "ОТКАЗ: не удалось построить эталон во временной цепочке — сверять не с чем."; return 1; }
	if [ "$_o_want" != "$_o_have" ]; then
		say "ОТКАЗ: цепочка $SELFDNSCHAIN легла не так, как задумано."
		say "ждали:"; printf '%s\n' "$_o_want" | sed 's/^/    /'
		say "получилось:"; printf '%s\n' "$_o_have" | sed 's/^/    /'
		return 1
	fi
	selfdns_nat_apply || return 1
	ipt_check OUTPUT -j "$SELFDNSCHAIN"; case $? in
		1) ipt -A OUTPUT -j "$SELFDNSCHAIN" 2>/dev/null ;;
	esac
	ipt -C OUTPUT -j "$SELFDNSCHAIN" 2>/dev/null || { say "ОТКАЗ: прыжок на $SELFDNSCHAIN не встал."; return 1; }
	selfdns_iface_apply || true
	selfdns_wanin_apply || true
	out_mss_local_ensure
	ipt_check OUTPUT -j "$CH_MSS_LOCAL"; case $? in
		1) ipt -A OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null ;;
	esac
	while ipt -C OUTPUT -j "$CH_MSS" 2>/dev/null; do
		ipt -D OUTPUT -j "$CH_MSS" 2>/dev/null || break
	done
	out_poryadok_ensure || return 1
	return 0
}
out_teardown() {
	_otd_all=""; [ -f "$OUTSTATE" ] && _otd_all=1
	if [ -n "$_otd_all" ] || off_nado "$SELFDNSCHAIN"; then
		while ipt -C OUTPUT -j "$SELFDNSCHAIN" 2>/dev/null; do
			ipt -D OUTPUT -j "$SELFDNSCHAIN" 2>/dev/null || break
		done
		ipt -F "$SELFDNSCHAIN" 2>/dev/null
		ipt -X "$SELFDNSCHAIN" 2>/dev/null
		ipt -F "$SELFDNSCHAIN_CHK" 2>/dev/null
		ipt -X "$SELFDNSCHAIN_CHK" 2>/dev/null
	fi
	{ [ -n "$_otd_all" ] || off_nado "$SELFDNSIFCHAIN"; } && selfdns_iface_teardown
	selfdns_nat_teardown
	{ [ -n "$_otd_all" ] || off_nado "$SELFDNSWANINCHAIN"; } && selfdns_wanin_teardown
	mss_local_teardown
	rm -f "$OUTSTATE" "$OUTNOADDRMARK" 2>/dev/null
	return 0
}
DNSPIDFILE="${MERIDIAN_ROUTE_DNSPIDFILE:-/opt/var/run/meridian-dns.pid}"
DNSPOOLMINVER="0.36"
dns_running_version() {
