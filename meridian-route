			{ echo "at=$(date +%s)"; printf '%s\n' "$_sc_out"; } > "$STATUSCACHE.tmp.$$" 2>/dev/null \
				&& mv -f "$STATUSCACHE.tmp.$$" "$STATUSCACHE" 2>/dev/null \
				|| rm -f "$STATUSCACHE.tmp.$$" 2>/dev/null
		fi
		printf '%s\n' "$_sc_out"
		return 0
	fi
	if [ -n "$MERIDIAN_ROUTE_STATUS_PROFILE" ]; then
		cmd_status_compute
		return 0
	fi
	_sc_age=$(statuscache_age 2>/dev/null)
	if [ -n "$_sc_age" ] && [ "$_sc_age" -lt "$STATUSCACHE_TTL" ] 2>/dev/null; then
		statuscache_body
		return 0
	fi
	if statuslock_acquire; then
		_sc_out=$(cmd_status_compute)
		{ echo "at=$(date +%s)"; printf '%s\n' "$_sc_out"; } > "$STATUSCACHE.tmp.$$" 2>/dev/null \
			&& mv -f "$STATUSCACHE.tmp.$$" "$STATUSCACHE" 2>/dev/null
		statuslock_release
		printf '%s\n' "$_sc_out"
		return 0
	fi
	if statuslock_wait_or_takeover; then
		_a=$(statuscache_age 2>/dev/null)
		if [ -n "$_a" ] && [ "$_a" -lt "$STATUSCACHE_TTL" ] 2>/dev/null; then
			statuslock_release
			statuscache_body
			return 0
		fi
		_sc_out=$(cmd_status_compute)
		{ echo "at=$(date +%s)"; printf '%s\n' "$_sc_out"; } > "$STATUSCACHE.tmp.$$" 2>/dev/null \
			&& mv -f "$STATUSCACHE.tmp.$$" "$STATUSCACHE" 2>/dev/null
		statuslock_release
		printf '%s\n' "$_sc_out"
		return 0
	fi
	if [ -f "$STATUSCACHE" ]; then
		statuscache_body_stale
		return 0
	fi
	cmd_status_compute
}
