jump_drop() {
	JT="$1"; JC="$2"; JX="$3"; T=0
	if [ -n "$_OFFGATE_ON" ] && [ "$JT" != nat ]; then
		_jd=""
		while IFS= read -r _jl; do
			case "$_jl" in "-A $JC "*" -j $JX") _jd="$_jd
${_jl#-A }" ;; esac
		done <<JDEOF
$_OFFGATE
JDEOF
		while IFS= read -r SPEC; do
			[ -n "$SPEC" ] || continue
			iptables -t "$JT" -D $SPEC 2>/dev/null
		done <<JDEOF
$_jd
JDEOF
		while iptables -t "$JT" -D "$JC" -j "$JX" 2>/dev/null; do
			T=$((T+1)); [ "$T" -gt 10 ] && break
		done
		return 0
	fi
	while :; do
		SPEC=$(iptables -t "$JT" -S "$JC" 2>/dev/null | grep -- "-j $JX\$" | head -1 | sed 's/^-A //')
		[ -n "$SPEC" ] || break
		iptables -t "$JT" -D $SPEC 2>/dev/null || break
		T=$((T+1)); [ "$T" -gt 10 ] && break
	done
}
