home_nets_klass_zhivoj() {
	_wan=$(wan_iface)
	_tn=$(tun_name)
	_hk_pary=$(ip -o -f inet addr show 2>/dev/null | awk '
		{
			cidr = ""
			for (i = 1; i <= NF; i++) if ($i == "inet") { cidr = $(i+1); break }
			if (cidr == "") next
			split(cidr, p, "/")
			split(p[1], o, ".")
			if (p[2] == "") bits = 32
			else bits = p[2] + 0
			if (bits < 8 || bits > 32) next
			ip = o[1]*16777216 + o[2]*65536 + o[3]*256 + o[4]
			d = 1
			for (k = 0; k < 32 - bits; k++) d = d * 2
			net = int(ip / d) * d
			printf "%d.%d.%d.%d/%d %s\n", int(net / 16777216) % 256, int(net / 65536) % 256, int(net / 256) % 256, net % 256, bits, $2
		}')
	while read -r _hknt _hkif; do
		[ -n "$_hknt" ] || continue
		if [ "$_hkif" = "lo" ]; then echo "$_hknt $_hkif loopback"; continue; fi
		if [ -n "$_wan" ] && [ "$_hkif" = "$_wan" ]; then echo "$_hknt $_hkif wan"; continue; fi
		if [ "$_hkif" = "$_tn" ]; then echo "$_hknt $_hkif tunnel"; continue; fi
		if [ ! -d "/sys/class/net/$_hkif/bridge" ]; then
			echo "$_hknt $_hkif not-bridge"; continue
		fi
		case "$_hknt" in
			10.*|192.168.*) echo "$_hknt $_hkif home" ;;
			172.1[6-9].*|172.2[0-9].*|172.3[01].*) echo "$_hknt $_hkif home" ;;
			100.6[4-9].*|100.[7-9][0-9].*|100.1[01][0-9].*|100.12[0-7].*) echo "$_hknt $_hkif home" ;;
			*) echo "$_hknt $_hkif not-private" ;;
		esac
	done <<HKEOF
$_hk_pary
HKEOF
}
