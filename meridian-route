_iptsnap_c() {
	_isc_snap="$1"; _isc_ch="$2"; shift 2
	_isc_want="-A $_isc_ch"
	for _isc_a in "$@"; do _isc_want="$_isc_want $_isc_a"; done
	case "$_isc_snap
" in *"] $_isc_want
"*) return 0 ;; esac
	for _isc_p in tcp udp; do
		case "$_isc_want" in
			*"-p $_isc_p --"*)
				_isc_w2="${_isc_want%%"-p $_isc_p --"*}-p $_isc_p -m $_isc_p --${_isc_want#*"-p $_isc_p --"}"
				case "$_isc_snap
" in *"] $_isc_w2
"*) return 0 ;; esac ;;
		esac
	done
	return 1
}
_iptsnap_s() {
	_iss_snap="$1"; shift
	if [ -z "${1:-}" ]; then
		printf '%s\n' "$_iss_snap" | sed 's/^\[[0-9]*:[0-9]*\] //' | grep -v '^:'
		return 0
	fi
	printf '%s\n' "$_iss_snap" | awk -v ch="$1" '
		index($0, ":" ch " ") == 1 { found = 1; next }
		substr($0, 1, 1) == "[" {
			bp = index($0, "] ")
			if (bp == 0) next
			line = substr($0, bp + 2)
			if (index(line, "-A " ch " ") == 1) print line
		}
		END { exit (found ? 0 : 1) }
	'
}
ipt()  {
	if [ -n "$_IPTSNAP_ON" ]; then
		case "$1" in
			-C) shift; _iptsnap_c "$_IPTSNAP_S" "$@"; return $? ;;
			-S) shift; _iptsnap_s "$_IPTSNAP_S" "${1:-}"; return $? ;;
		esac
	fi
	iptables $IPTW -t mangle "$@" 2>/dev/null
}
iptf() {
	if [ -n "$_IPTSNAP_ON" ] && [ -n "$_IPTSNAP_F" ]; then
