_LOG_SZ_CHECKED=""
log() {
	case "$LOG" in */*) _lg_d=${LOG%/*} ;; *) _lg_d=. ;; esac
	[ -d "$_lg_d" ] || mkdir -p "$_lg_d" 2>/dev/null
	if [ -z "$_LOG_SZ_CHECKED" ]; then
		_LOG_SZ_CHECKED=1
		if [ -f "$LOG" ]; then
			SZ=$(wc -c < "$LOG" 2>/dev/null || echo 0)
			[ "$SZ" -gt "$LOG_MAX" ] 2>/dev/null && mv -f "$LOG" "$LOG.1" 2>/dev/null
		fi
	fi
	echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG" 2>/dev/null
}
say() { echo "$*"; }
fail() { say "$*"; log "ОТКАЗ: $*"; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }
run_bounded() {
	_rb_sec="$1"; shift
	if have timeout; then
		timeout "$_rb_sec" "$@"
		return $?
	fi
	mkdir -p "$RUNDIR" 2>/dev/null
	_rb_out="$RUNDIR/run_bounded.$$"
	rm -f "$_rb_out.predel" 2>/dev/null
	"$@" > "$_rb_out" 2>&1 &
	_rb_pid=$!
	(
		sleep "$_rb_sec" &
		echo "$!" > "$_rb_out.sp"
		wait $!
		[ -f "$_rb_out.gotovo" ] && exit 0
		if kill -0 "$_rb_pid" 2>/dev/null; then
			: > "$_rb_out.predel"
			kill -9 "$_rb_pid" 2>/dev/null
		fi
	) </dev/null >/dev/null 2>&1 &
	_rb_tp=$!
	wait "$_rb_pid" 2>/dev/null
	_rb_rc=$?
	: > "$_rb_out.gotovo"
	if [ ! -f "$_rb_out.predel" ]; then
		_rb_i=0
		while [ ! -s "$_rb_out.sp" ] && [ "$_rb_i" -lt 300 ]; do _rb_i=$((_rb_i + 1)); done
		[ -s "$_rb_out.sp" ] || sleep 1
		_rb_sp=""
		{ read -r _rb_sp < "$_rb_out.sp"; } 2>/dev/null
		[ -n "$_rb_sp" ] && kill "$_rb_sp" 2>/dev/null
	fi
	wait "$_rb_tp" 2>/dev/null
	if [ -f "$_rb_out.predel" ]; then
		_rb_rc=124
	fi
	cat "$_rb_out" 2>/dev/null
	rm -f "$_rb_out" "$_rb_out.sp" "$_rb_out.gotovo" "$_rb_out.predel" 2>/dev/null
	return $_rb_rc
}
ENSURELOCK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.ensurelock"
ENSURE_HAVE_FLOCK=""
ensure_lock_acquire() {
	mkdir_for "$ENSURELOCK"
	if have flock; then
		ENSURE_HAVE_FLOCK=1
		exec 9>"$ENSURELOCK.flock" || return 1
		flock -n 9 2>/dev/null || return 1
		return 0
	fi
	if [ -f "$ENSURELOCK" ]; then
		_el_pid=$(cat "$ENSURELOCK" 2>/dev/null)
		case "$_el_pid" in
			''|*[!0-9]*) : ;;
			*) kill -0 "$_el_pid" 2>/dev/null && return 1 ;;
		esac
	fi
	echo $$ > "$ENSURELOCK" 2>/dev/null
	return 0
}
ensure_lock_release() {
	[ -n "$ENSURE_HAVE_FLOCK" ] && return 0
	rm -f "$ENSURELOCK" 2>/dev/null
}
ENSURE_WAIT_MAX="${MERIDIAN_ROUTE_ENSURE_WAIT_MAX:-10}"
ensure_lock_acquire_wait() {
	mkdir_for "$ENSURELOCK"
	if have flock; then
		ENSURE_HAVE_FLOCK=1
		exec 7>"$ENSURELOCK.flock" || return 1
		flock -w "$ENSURE_WAIT_MAX" 7 2>/dev/null && return 0
		return 1
	fi
	_ewa=0
	while [ "$_ewa" -lt "$ENSURE_WAIT_MAX" ]; do
		if [ -f "$ENSURELOCK" ]; then
			_el_pid=$(cat "$ENSURELOCK" 2>/dev/null)
			case "$_el_pid" in
				''|*[!0-9]*) echo $$ > "$ENSURELOCK" 2>/dev/null; return 0 ;;
				*) kill -0 "$_el_pid" 2>/dev/null || { echo $$ > "$ENSURELOCK" 2>/dev/null; return 0; } ;;
			esac
		else
			echo $$ > "$ENSURELOCK" 2>/dev/null
			return 0
		fi
		sleep 1
		_ewa=$((_ewa + 1))
	done
	return 1
}
_CONF_LOADED=""
conf_value_preload() {
	[ -n "$_CONF_LOADED" ] && return 0
	if [ ! -f "$CONF" ]; then _CONF_LOADED=nofile; return 0; fi
	eval "$(awk '
		{
			l = $0; sub(/^[ \t\r\f\v]+/, "", l)
			if (!match(l, /^[A-Za-z_][A-Za-z0-9_]*/)) next
			k = substr(l, 1, RLENGTH); r = substr(l, RLENGTH + 1)
			sub(/^[ \t\r\f\v]*/, "", r)
			if (substr(r, 1, 1) != "=") next
			r = substr(r, 2); sub(/^[ \t\r\f\v]*/, "", r)
			c = substr(r, 1, 1); if (c == "\"" || c == "\047") r = substr(r, 2)
			if (match(r, /["\047#]/)) r = substr(r, 1, RSTART - 1)
			sub(/[ \t\r\f\v]+$/, "", r)
			val[k] = r
		}
		END { for (k in val) printf "_CV_%s=\047%s\047\n", k, val[k] }' "$CONF" 2>/dev/null)"
	_CONF_LOADED=yes
}
conf_value() {
	if [ -n "$_CONF_LOADED" ]; then
		case "$1" in
			''|[!A-Za-z_]*|*[!A-Za-z0-9_]*) : ;;
			*)
				[ "$_CONF_LOADED" = nofile ] && return 1
				eval "[ -n \"\${_CV_$1+x}\" ] && printf '%s\\n' \"\$_CV_$1\""
				return 0 ;;
		esac
	fi
	[ -f "$CONF" ] || return 1
	sed -n "s/^[[:space:]]*$1[[:space:]]*=[[:space:]]*[\"']\{0,1\}\([^\"'#]*\).*/\1/p" "$CONF" \
		| tail -1 | sed 's/[[:space:]]*$//'
}
