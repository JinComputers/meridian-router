rule_present() { ip rule show 2>/dev/null | grep -q "^$1:"; }
IP_WHAT=""
rules_ip_apply() {
	RC=0
	IP_WHAT=""
	_rip=$(ip rule show 2>/dev/null)
	_rip_tun=""; _rip_hold=""
	case "
$_rip" in *"
$PREF_TUN:"*) _rip_tun=1 ;; esac
	case "
$_rip" in *"
$PREF_HOLD:"*) _rip_hold=1 ;; esac
	[ -n "$_rip_tun" ] || { ip rule add fwmark "$MARK/$MASK" lookup "$TABLE" pref "$PREF_TUN" 2>/dev/null && RC=1 && IP_WHAT="$IP_WHAT правило политики;"; }
	if [ -z "$(tun_field open_since)" ]; then
		hold_route_present || { hold_route_up && RC=1 && IP_WHAT="$IP_WHAT удержание (маршрут в таблице $TABLE);"; }
	fi
	if [ -n "$_rip_hold" ]; then
		T=0
		while rule_present "$PREF_HOLD"; do
			ip rule del pref "$PREF_HOLD" 2>/dev/null || break
			T=$((T+1)); [ "$T" -gt 10 ] && break
		done
		log "снято старое правило политики $PREF_HOLD: удержание теперь маршрутом в таблице $TABLE"
		RC=1
	fi
	return $((1 - RC))
}
rules_ip_remove() {
	T=0
	while rule_present "$PREF_HOLD"; do
		ip rule del pref "$PREF_HOLD" 2>/dev/null || break
		T=$((T+1)); [ "$T" -gt 10 ] && break
	done
