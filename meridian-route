iptw_probe() {
	[ -n "$IPTW_PROBED" ] && return 0
	IPTW_PROBED=1
	IPTW=""
	_iw_f="$RUNDIR/iptw"
	_iw_bin=$(command -v iptables 2>/dev/null)
	if [ -n "$_iw_bin" ] && [ -f "$_iw_f" ] && ! [ "$_iw_bin" -nt "$_iw_f" ]; then
		_iw_v=""
		read -r _iw_v < "$_iw_f" 2>/dev/null
		case "$_iw_v" in
			w5) IPTW="-w 5"; return 0 ;;
			w)  IPTW="-w";   return 0 ;;
		esac
	fi
	_iw_v=""
	if iptables -w 5 -t mangle -S >/dev/null 2>&1; then
		IPTW="-w 5"; _iw_v=w5
	elif iptables -w -t mangle -S >/dev/null 2>&1; then
		IPTW="-w"; _iw_v=w
	fi
	if [ -n "$_iw_v" ] && [ -n "$_iw_bin" ]; then
		mkdir -p "$RUNDIR" 2>/dev/null
		echo "$_iw_v" > "$_iw_f.$$" 2>/dev/null && mv -f "$_iw_f.$$" "$_iw_f" 2>/dev/null
		rm -f "$_iw_f.$$" 2>/dev/null
	fi
}
