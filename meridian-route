	return 0
}

cmd_keep() {
	case "${1:-}" in
		build)
			keep_build || return 1
			if keep_check; then
				say "Набор $KEEPSET собран и проверен: записей $(ipset list "$KEEPSET" 2>/dev/null | sed -n '/^Members:/,$p' | grep -vc '^Members:')"
				say "Это ЕЩЁ НЕ белый режим: пометка не инвертирована, ничего не изменилось."
				return 0
			fi
			say "Набор собран, но проверку НЕ прошёл — см. выше. Белый режим начинать нельзя."
			return 1
			;;
		check)
			if keep_check; then
				say "Набор $KEEPSET полон: адрес VPS, сети роутера и постоянная часть на месте."
				return 0
			fi
			return 1
			;;
		gate)
			# ВОРОТА ОТДЕЛЬНЫМ ГЛАГОЛОМ: их надо уметь спросить, не ставя ничего.
			# Приёмка на роутере иначе проверяла бы ворота постановкой слоя, то
			# есть риском, а не вопросом.
			keep_gate
			return $?
			;;
		show)
			set_exists "$KEEPSET" || { say "набора $KEEPSET нет"; return 1; }
			ipset list "$KEEPSET" 2>/dev/null | sed -n '/^Members:/,$p' | grep -v '^Members:'
			return 0
			;;
		refresh)
			# Ручной вызов того же, что делает периодика: свой глагол, чтобы
			# приёмку можно было гонять без ожидания минуты (правило про
			# положительный контроль, разводящий редакции — свежо/протухло).
			keep_refresh_if_stale
			return $?
			;;
		*)
			say "usage: $0 keep build|check|gate|show|refresh"
			return 2
			;;
	esac
}

# --------------------------------------------------------------------------
# Проверка строк списка
# --------------------------------------------------------------------------
# valid_cidr — синтаксис: a.b.c.d или a.b.c.d/nn, октеты 0..255, маска 8..32.
# Маска меньше 8 запрещена намеренно: /0 в чёрном режиме — это белый режим без
# единой защиты, вместе с транспортом собственного туннеля.
valid_cidr() {
	printf '%s\n' "$1" | awk -F'[./]' '
		{
			if (NF != 4 && NF != 5) exit 1
			for (i = 1; i <= 4; i++) {
				if ($i !~ /^[0-9]+$/) exit 1
				if ($i + 0 > 255) exit 1
				if (length($i) > 1 && substr($i,1,1) == "0") exit 1
			}
			if (NF == 5) {
				if ($5 !~ /^[0-9]+$/) exit 1
				if ($5 + 0 < 8 || $5 + 0 > 32) exit 1
			}
			exit 0
		}'
}

# cidr_contains CIDR ADDR — арифметика, а не сравнение строк: нам надо ловить
# «10.0.0.0/8 покрывает адрес шлюза», а не только точное совпадение.
cidr_contains() {
	printf '%s %s\n' "$1" "$2" | awk '
		function toi(s,  p) { split(s, p, "."); return ((p[1]*256+p[2])*256+p[3])*256+p[4] }
		{
			n = $1; a = $2
			slash = index(n, "/")
			if (slash > 0) { pfx = substr(n, slash+1) + 0; net = substr(n, 1, slash-1) }
			else { pfx = 32; net = n }
			if (pfx == 0) { m = 0 } else { m = 4294967295 - (2 ^ (32 - pfx) - 1) }
			ni = toi(net); ai = toi(a)
			# and() есть не во всех awk, поэтому маскируем вычитанием остатка
			if (int(ni / (2 ^ (32 - pfx))) == int(ai / (2 ^ (32 - pfx)))) exit 0
			exit 1
		}'
}

# forbidden_reason CIDR — почему строку нельзя пускать в набор. Пустой ответ =
# можно. Проверка НЕ формальность: 192.168.0.0/16 в наборе означает, что локалка
# уедет в туннель и человек потеряет и роутер, и панель.
forbidden_reason() {
	E="$1"
	A=${E%%/*}
	O1=$(echo "$A" | cut -d. -f1)
	O2=$(echo "$A" | cut -d. -f2)
	case "$O1" in
		0)   echo "0.0.0.0/8 — «этот сеть», такого назначения не бывает"; return ;;
		10)  echo "частная сеть 10/8 — это локалка, в туннель её нельзя"; return ;;
		127) echo "127/8 — сам роутер"; return ;;
	esac
	[ "$O1" = "192" ] && [ "$O2" = "168" ] && { echo "частная сеть 192.168/16 — это локалка"; return; }
	[ "$O1" = "169" ] && [ "$O2" = "254" ] && { echo "169.254/16 — служебные адреса канала"; return; }
	if [ "$O1" = "172" ] && [ "$O2" -ge 16 ] 2>/dev/null && [ "$O2" -le 31 ] 2>/dev/null; then
		echo "частная сеть 172.16/12 — это локалка"; return
	fi
	if [ "$O1" -ge 224 ] 2>/dev/null; then
		echo "224.0.0.0/4 и выше — многоадресные и зарезервированные"; return
	fi
	PH=$(peer_host)
	if [ -n "$PH" ] && cidr_contains "$E" "$PH"; then
		echo "покрывает адрес шлюза $PH — туннель зарубит сам себя (рекурсия)"; return
	fi
	echo ""
}

# list_check — проверить ВЕСЬ список до первой записи в систему. Частичное
# применение хуже отказа: человек видит «включено», а работает половина.
list_check() {
	# ОТСУТСТВИЕ ФАЙЛА — ЭТО «НОЛЬ АДРЕСОВ», А НЕ ОТКАЗ.
	#
	# 08.09.2026, указание владельца. Помеченный трафик имеет ДВА независимых
	# источника: список адресов и доменные группы, чьи наборы md_* наполняет
	# сервер DNS. Проверка судила по одному, пока работу делал другой: на чистом
	# роутере файла списка не заводит НИКТО — ни install.sh, ни движок, ни
	# панель, — и `on` отказывал при полностью исправной доменной маршрутизации.
	# Ровно то, о чём мой же комментарий от 04.09: «сервер наполняет наборы, но
	# без движка нет ни ip rule, ни таблицы; обошли заглушкой 192.0.2.1; так
	# жить нельзя». Заглушка была лечением симптома этого самого отказа.
	#
	# Дальше решает ОБЩЕЕ условие внизу: пусто и то, и другое.
	N=0; BAD=0
	if [ ! -f "$LIST" ]; then
		say "файла списка нет ($LIST) — считаю, что адресов ноль; решать будут доменные группы"
	fi
	while IFS= read -r LN || [ -n "$LN" ]; do
		LN=$(echo "$LN" | sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//')
		[ -n "$LN" ] || continue
		if ! valid_cidr "$LN"; then
			say "строка не адрес и не подсеть: «$LN»"; BAD=$((BAD+1)); continue
		fi
		R=$(forbidden_reason "$LN")
		if [ -n "$R" ]; then
			say "нельзя «$LN»: $R"; BAD=$((BAD+1)); continue
		fi
		N=$((N+1))
	done < "${LIST:-/dev/null}"
	if [ "$BAD" -gt 0 ]; then
		say "в списке $BAD негодных строк — не применяю НИЧЕГО"
		return 1
	fi
	if [ "$N" -eq 0 ]; then
		# ОБА ИСТОЧНИКА НАЗЫВАЮТСЯ ЧИСЛАМИ. Отказ, не назвавший, ЧЕГО именно
		# нет, посылает человека искать вслепую (правило 27).
		_grupp=$(dns_set_count)
		_zapisej=$(dns_entry_count)
		if [ "$_grupp" -eq 0 ] 2>/dev/null; then
			say "включать нечего: адресов в списке 0, доменных групп с пометкой 0"
			say "  Добавить адрес: $0 list add <адрес|подсеть>"
			say "  Либо включить доменную группу в панели — её наборы наполняет сервер DNS."
			return 1
		fi
		if [ "$_zapisej" -eq 0 ] 2>/dev/null; then
			# НЕ ОТКАЗ, И ЭТО ОСОЗНАННО. Отказ здесь вернул бы тупик, ради
			# которого и появилась заглушка 192.0.2.1: наборы наполняет сервер
			# DNS, но пока движок не включён, нет ни ip rule, ни таблицы, и
			# наполнение ничего не даёт. Отказав на пустых наборах, мы бы
			# требовали от человека включить движок ПОСЛЕ первого запроса —
			# то есть угадать момент.
			say "адресов 0; доменных групп с пометкой $_grupp, но записей в их наборах пока 0 —"
			say "  включаюсь: наборы наполнит сервер DNS при первом же запросе, а без движка"
			say "  наполнение ничего не даст (ни ip rule, ни таблицы)."
		else
			say "список адресов пуст, но есть доменные группы ($_grupp, записей $_zapisej) — включаюсь ради них"
		fi
	fi
	echo "$N" > /dev/null
	return 0
}

list_clean() {
	sed 's/#.*//; s/^[[:space:]]*//; s/[[:space:]]*$//' "$LIST" 2>/dev/null | grep -v '^$'
}

# Считаем УНИКАЛЬНЫЕ строки: ipset дублей не хранит, и без sort -u сверка
# «сколько хотели / сколько легло» ругалась бы на честный дубль в списке.
list_count() { list_clean | sort -u | grep -c . ; }

# list_empty — в списке нет ни одной годной строки (файла нет, пуст, одни
# комментарии). Отдельная функция, потому что от этого зависит РЕШЕНИЕ, а не текст.
list_empty() { [ "$(list_count)" = "0" ]; }

# --------------------------------------------------------------------------
# Доменные группы сервера DNS
#
# 04.09.2026: сервер наполняет наборы md_* и ставит на них пометку, но БЕЗ
# движка нет ни ip rule, ни таблицы — и пометка уходит в никуда. При этом
# движок отказывался включаться с пустым списком адресов, хотя маршрутизировать
# было что. Обошли заглушкой 192.0.2.1; так жить нельзя.
#
# Движок НЕ ЧИТАЕТ конфиг сервера: разбор YAML в ash мы отвергли. Сервер сам
# сообщает ФАКТ — число наборов, которые он пометил, — одной строкой в файле.
# Это тот же приём, что у последних рабочих кандидатов: сторона, которая знает,
# кладёт число; сторона, которой нужно решение, его читает.
#
# Файла нет — считаем, что групп нет. Ошибка в эту сторону даёт прежнее
# поведение (отказ с внятным текстом), а не молчаливое включение впустую.
# --------------------------------------------------------------------------
DNSMARKCHAIN="${MERIDIAN_DNS_MARKCHAIN:-MERIDIAN_DNS_MARK}"

# Считаем ПРАВИЛА В ЦЕПОЧКЕ, а не число из файла.
#
# Сначала я сделал так: сервер писал число в meridian-dns.marking, движок его
# читал. Это тот же класс, что и «правило: нет» в показателе — вера в чужое
# утверждение вместо взгляда на предмет. Убили сервер сигналом 9 — файл остался
# с прежним числом, и движок продолжал считать, что метить есть что.
#
# Истина одна: правила пометки либо стоят в цепочке, либо нет. Вызов iptables
# раз в минуту стоит копейки.
#
# Побочное следствие, о котором надо знать: при загрузке роутера движок может
# спросить раньше, чем сервер создаст цепочку, и в тот раз не включится.
# Через минуту периодика спросит снова и включит. Это медленнее файла, но
# самоисправляется, а файл — нет.
dns_set_count() {
	ipt -S "$DNSMARKCHAIN" 2>/dev/null | grep -c -- '--match-set'
}
dns_has_sets() { [ "$(dns_set_count)" -gt 0 ]; }

# dns_entry_count — сколько ЗАПИСЕЙ лежит в наборах доменных групп.
#
# Правил в цепочке и записей в наборах — РАЗНЫЕ величины: группа бывает включена
# с пустым набором. Считаем членов построчно: поля «Number of entries» в сборке
# ipset НА РОУТЕРЕ нет вовсе, заголовок обрывается на References (замерено
# 19.08.2026) — тем же приёмом, что и у keep выше.
dns_entry_count() {
	_vsego=0
	for _s in $(ipt -S "$DNSMARKCHAIN" 2>/dev/null | sed -n 's/.*--match-set \([^ ]*\) .*/\1/p' | sort -u); do
		_n=$(ipset list "$_s" 2>/dev/null | sed -n '/^Members:/,$p' | grep -vc '^Members:')
		case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
		_vsego=$((_vsego + _n))
	done
	echo "$_vsego"
}

# warn_empty_once — сказать про пустой список ОДИН раз, а не на каждый вызов.
# Ключ подавления — файл-метка, а не текст сообщения (правило 21).
warn_empty_once() {
	[ -f "$EMPTYMARK" ] && return 0
	: > "$EMPTYMARK" 2>/dev/null
	log "список пуст — восстанавливать нечего: набор не создаю и правил не ставлю. Режим числится включённым, но помечать нечего; добавь адреса (list add) или сними режим (off)."
}
clear_empty_mark() { rm -f "$EMPTYMARK" 2>/dev/null; }

# crond_alive — работает ли сам crond, а не только стоит ли наша строка в его
# файле. Строка без работающего crond — это молчаливая деградация: расписание
# заведено, а никто по нему не ходит.
crond_alive() { ps w 2>/dev/null | grep -q '[c]rond'; }

# warn_crond_dead_once — раз, не на каждый вызов nf-reapply (крючок зовётся
# часто). Снимается сама на следующем cron_install/cron_remove, а не только
# руками — если crond подняли, а движок ни разу не звали, метка иначе живёт
# вечно и врёт, что crond всё ещё мёртв.
warn_crond_dead_once() {
	[ -f "$CRONDEADMARK" ] && return 0
	: > "$CRONDEADMARK" 2>/dev/null
	log "!!! ПЕРИОДИКА НЕ РАБОТАЕТ: строка в $CRONFILE стоит, но crond не запущен — минутная проверка не идёт, маршрут держится только на крючке netfilter и ручном ensure"
}
clear_crond_dead_mark() { rm -f "$CRONDEADMARK" 2>/dev/null; }

# --------------------------------------------------------------------------
# Состояние. Читается ФАКТ на роутере, а состояние на диске — только про режим и
# подтверждение (что именно стоит в системе, спрашиваем у системы).
# --------------------------------------------------------------------------
state_get() {
	[ -f "$STATE" ] || { echo ""; return; }
	sed -n "s/^$1=//p" "$STATE" | tail -1
}

# fallback_mark — записать след отката. Причина и следствие — КОДАМИ, а не
# свободным текстом: панель и бот сравнивают значения, а не читают по-русски.
# Человеческая строка идёт отдельным полем, для показа.
fallback_mark() {
	mkdir -p "$(dirname "$FALLBACKMARK")" 2>/dev/null
	TMP="$FALLBACKMARK.tmp.$$"
	{
		echo "at=$(date +%s)"
		echo "reason=$1"
		echo "effect=$2"
		echo "note=$3"
	} > "$TMP" 2>/dev/null || return 1
	mv -f "$TMP" "$FALLBACKMARK" 2>/dev/null
}

# fallback_get — одно поле из следа.
fallback_get() { [ -f "$FALLBACKMARK" ] && sed -n "s/^$1=//p" "$FALLBACKMARK" 2>/dev/null | head -1; }

state_set() {
	mkdir -p "$(dirname "$STATE")" 2>/dev/null
	TMP="$STATE.tmp.$$"
	{
		echo "mode=$1"
		echo "confirmed=$2"
		echo "changed=$(date +%s)"
		[ -n "$3" ] && echo "note=$3"
	} > "$TMP" 2>/dev/null || return 1
	mv -f "$TMP" "$STATE" 2>/dev/null
	statuscache_drop
}

# --------------------------------------------------------------------------
# Платформа
# --------------------------------------------------------------------------
platform_check() {
	if ! have iptables; then
		fail "нет iptables — этот скрипт только для Keenetic/Entware. На OpenWrt нужна ветка nft, её ещё нет."
	fi
	if ! have ipset; then
		fail "нет ipset — набор адресов делать нечем. Поставь пакет ipset (opkg install ipset)."
	fi
	if ! have ip; then
		fail "нет утилиты ip"
	fi
}

# --------------------------------------------------------------------------
# Набор адресов
# --------------------------------------------------------------------------
set_exists() { ipset list -n 2>/dev/null | grep -qx "$1"; }

# Считаем членов по секции «Members:». Поля «Number of entries» в сборке ipset на
# роутере НЕТ вовсе (заголовок обрывается на References), поэтому путь через него был
# мёртвым: он всегда возвращал пустоту, а работала запасная ветка.
set_entries() {
	ipset list "$SET" 2>/dev/null | sed -n '/^Members:/,$p' | grep -vc '^Members:'
}

# Сколько правил ссылается на набор. В отличие от числа членов это НЕ меняется само
# и падает ровно тогда, когда правила сломаны.
set_refs() {
	ipset list "$1" 2>/dev/null | sed -n 's/^References: *//p' | tail -1
}

# MTU туннеля читаем из /sys — без разбора вывода `ip link`. Пусто = интерфейса нет.
tun_mtu() {
	cat "/sys/class/net/$(tun_name)/mtu" 2>/dev/null
}

# MSS = MTU − 20 (IP) − 20 (TCP). Никакой константы: при смене MTU интерфейса
# константа стала бы неверной молча, а выглядело бы это как «большие страницы висят».
want_mss() {
	M=$(tun_mtu)
	case "$M" in ''|*[!0-9]*) return 1 ;; esac
	[ "$M" -gt 100 ] 2>/dev/null || return 1
	echo $((M - 40))
}

# set_load — залить список ПОДМЕНОЙ, а не «очистить и залить»: между очисткой и
# заливкой набор пуст, то есть трафик секунды идёт не туда, куда человек просил.
#
# Заливка идёт ОДНОЙ операцией `ipset restore`, а не циклом `ipset add`. Разница не
# в красоте: цикл — это по процессу на запись, и на 20 000 адресов (белый режим,
# RU-диапазоны) он превращается в минуты, потому что цена там не в ядре, а в
# запуске процесса. Замер этого железа (этап 0, роутер владельца): 20 000 записей
# `hash:net` — **443 260 байт памяти и 2,24 с одной операцией restore**.
#
# last_load_ms хранит, сколько заняла последняя заливка: это число печатает status
# и пишет крючок, чтобы «дёшево» и «дорого» не приходилось угадывать.
LAST_LOAD_MS=""

set_load() {
	T0=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)
	ipset destroy "$SETNEW" 2>/dev/null
	ipset create "$SETNEW" hash:net family inet 2>/dev/null || return 1
	# Поток для restore: по строке на запись. Одна труба, один процесс.
	list_clean | sort -u | sed "s|^|add $SETNEW |" | ipset restore 2>/dev/null || {
		ipset destroy "$SETNEW" 2>/dev/null
		return 1
	}
	if ! set_exists "$SET"; then
		ipset create "$SET" hash:net family inet 2>/dev/null || return 1
	fi
	ipset swap "$SETNEW" "$SET" 2>/dev/null || return 1
	ipset destroy "$SETNEW" 2>/dev/null
	T1=$(cut -d' ' -f1 /proc/uptime 2>/dev/null)
	LAST_LOAD_MS=$(awk -v a="$T0" -v b="$T1" 'BEGIN{ printf "%d", (b-a)*1000 }' 2>/dev/null)
	return 0
}

# --------------------------------------------------------------------------
# Правила iptables. Свои цепочки, в чужих — ровно по одному прыжку: снятие тогда
# сводится к «убрать прыжок и цепочку», а не к поиску своих правил среди чужих.
# --------------------------------------------------------------------------
# IPTW — ключ ожидания замка xtables. ПРОВЕРЯЕТСЯ, а не предполагается
# (правило 25): в старых и урезанных сборках -w нет вовсе, и с ним iptables
# просто откажется работать.
#
# Зачем: 04.09.2026 в логе роутера владельца найдено
# «Another app is currently holding the xtables lock. Perhaps you want to use
# the -w option?». Наши вызовы шли без -w, а stderr глушился — правило просто
# НЕ ВСТАВАЛО, и мы этого не замечали. Так пропала цепочка MERIDIAN_MSS: дом
# остался без подрезки, а `on` отвечал «применено».
# ФОРМА ключа перебирается, а не предполагается. Проверка только «-w 5»
# была НЕПОЛНОЙ: на iptables 1.4.21 (роутер владельца) числового аргумента у -w
# нет — он появился в 1.4.22, — проба не проходила, и мы оставались БЕЗ
# ОЖИДАНИЯ ВОВСЕ. Дальше каждый `-C` гонялся с замком наперегонки, проигрывал,
# возвращал 4 — и это читалось как «правила нет» (см. ipt_check ниже).
[ -n "$MERIDIAN_ROUTE_STATUS_PROFILE" ] && echo "status_profile: -1_pered_iptw_probe $(awk '{print $1}' /proc/uptime 2>/dev/null)" >&2
IPTW=""
if iptables -w 5 -t mangle -S >/dev/null 2>&1; then
	IPTW="-w 5"
elif iptables -w -t mangle -S >/dev/null 2>&1; then
	IPTW="-w"
fi
[ -n "$MERIDIAN_ROUTE_STATUS_PROFILE" ] && echo "status_profile: -1b_posle_iptw_probe $(awk '{print $1}' /proc/uptime 2>/dev/null)" >&2

# ГОЛЫЙ -w (iptables 1.4.21, роутер владельца — числового -w N там нет) НЕ
# ИМЕЕТ ВСТРОЕННОГО ПРЕДЕЛА ОЖИДАНИЯ ЗАМКА (владелец, 21.09.2026: ensure в
# белом режиме завис и не вернулся, оборвано вручную ^C; в логе того же
# вечера — «Another app is currently holding the xtables lock», ndm держит
# замок). ОСТАВЛЕНО КАК ЕСТЬ СОЗНАТЕЛЬНО, не обёрнуто в run_bounded: живая
# диагностика владельца назвала ПОДТВЕРЖДЁННОЙ причиной meridian-dns (status
# 19с под нагрузкой, ноль связи с iptables), а вызовов ipt/iptf — десятки за
# один ensure; оборачивать их под давлением времени, не имея живого
# подтверждения вины, — риск внести новую задержку туда, где её не было.
# Назовёт диагностика iptables — отдельной правкой (см. 1.65 в истории).
#
# _IPTSNAP_* — СНИМОК mangle ОДНИМ `iptables-save -c` ВМЕСТО МНОГИХ ЖИВЫХ
# ВЫЗОВОВ (1.76, владелец, 21.09.2026, пункт 3 хвоста шага 11: «iptables-save
# + awk — корень, делай»). Диагностика в этот раз (заходы Е/Г профиля status)
# ПОДТВЕРДИЛА связь с iptables/ipset — в отличие от исторического случая в
# комментарии выше (там виноват оказался meridian-dns): schyot_pravil_mnogo()
# уже one раз снизил раздел «белый дом» правкой того же рода (1.72), и он же
# остался среди самых тяжёлых разделов профиля.
#
# ВКЛЮЧАЕТСЯ ТОЛЬКО ВНУТРИ cmd_status_compute() — больше нигде. on/off/ensure/
# apply ОБЯЗАНЫ видеть живые правила всегда: снимок мог устареть на миллисекунды
# между чтением и решением, а там от решения зависит РЕАЛЬНАЯ метка пакета,
# не просто строка в отчёте. status — единственное место, где секунда-другая
# устаревания уже принята явно (тот же довод, что у status --cache, только
# здесь речь о снимке ВНУТРИ одного расчёта, не между расчётами).
#
# ЧТО ПОДМЕНЯЕТСЯ: `ipt -S [ЦЕПОЧКА]` и `ipt -C ЦЕПОЧКА АРГУМЕНТЫ` читают из
# снимка, когда он взят; -A/-D/-N/-F/-X/-I/-R (всё, что МЕНЯЕТ правила) —
# ВСЕГДА живые, снимок их вообще не касается по построению этой развилки.
_IPTSNAP_S=""
_IPTSNAP_N=""
_IPTSNAP_F=""
_IPTSNAP_ON=""

# iptsnap_capture — взять снимок mangle ОДИН РАЗ. Отказ (нет iptables-save,
# либо пустой вывод) — снимок просто не включается, ipt() продолжает ходить
# живьём как раньше: это ускорение, а не обязательное условие корректности.
#
# ПОПЫТКА 1.77 (нарезать снимок ОДНИМ awk на файлы по цепочкам) ОТКАЧЕНА
# (1.78, владелец, 22.09.2026, живой замер на HERO): status --full стал НЕ
# быстрее, а медленнее — 4-6с вместо 3-4с у этой, файловой, версии; сам
# захват снимка подорожал с 0,07с до 0,20-0,28с. На слабом роутере запись
# и чтение десятков мелких файлов (open/write/close на каждый) обошлась
# дороже, чем повторный `grep` по строке в памяти — угадал направление
# (меньше проходов по ПОЛНОМУ тексту), но выбрал неверную реализацию (диск
# вместо памяти). Возврат к строке в памяти — ДОКАЗАННЫЙ результат 3-4с;
# следующая попытка ускорения обязана остаться в памяти, без файлов.
# 1.90: СНИМОК ТЕПЕРЬ НА ТРИ ТАБЛИЦЫ, А НЕ НА ОДНУ (владелец, 23.09.2026,
# по профилю на HERO). `iptables-save` и раньше печатал ВСЕ таблицы за один
# запуск — мы брали из его вывода только mangle и выбрасывали остальное, а
# потом ходили в nat и filter живьём, своим процессом на каждую проверку.
# Разбор профиля `status` на HERO показал, где это стоит: участок
# 7_wantun -> 8_partial 4.52с и 5_whitehome -> 6_selfdns 2.07с из девяти
# секунд — это десятки форков `iptables` ровно по nat и filter. Лишних
# запусков iptables-save НЕ добавилось: он как был один, так и остался,
# добавились два разбора уже прочитанного в память текста.
iptsnap_capture() {
	# ТОЛЬКО ДЛЯ СТЕНДА (1.90): выключить снимок и заставить движок опрашивать
	# таблицы живьём. Нужно для проверки «ускорение не меняет ОТВЕТ»: без
	# такого выключателя сравнить снимок с живым опросом нечем, и правка
	# проверялась бы сама собой. В бою переменная не задана.
	[ -n "${MERIDIAN_ROUTE_NO_IPTSNAP:-}" ] && return 1
	have iptables-save || return 1
	_is_all=$(iptables-save -c 2>/dev/null)
	[ -n "$_is_all" ] || return 1
	_IPTSNAP_S=$(printf '%s\n' "$_is_all" | awk '/^\*mangle$/{p=1;next} /^\*/{p=0} p')
	_IPTSNAP_N=$(printf '%s\n' "$_is_all" | awk '/^\*nat$/{p=1;next} /^\*/{p=0} p')
	_IPTSNAP_F=$(printf '%s\n' "$_is_all" | awk '/^\*filter$/{p=1;next} /^\*/{p=0} p')
	_is_all=""
	# mangle — ОБЯЗАТЕЛЕН: на нём держится весь расчёт. nat и filter могут
	# оказаться пустыми (ядро без модуля, урезанная прошивка) — это не повод
	# отказываться от снимка целиком: iptn()/iptf() тогда просто ходят живьём,
	# как в 1.89, а mangle всё равно ускорен.
	[ -n "$_IPTSNAP_S" ] || return 1
	_IPTSNAP_ON=1
	return 0
}
iptsnap_release() { _IPTSNAP_ON=""; _IPTSNAP_S=""; _IPTSNAP_N=""; _IPTSNAP_F=""; }

# _RTSNAP_* — ТОТ ЖЕ ПРИЁМ, ЧТО У _IPTSNAP_*, НО ДЛЯ `ip route show table
# $TABLE` (1.81, владелец, 22.09.2026, «возвращаемся к ≤1с»). route_mine_present()/
# route_others()/hold_route_present() внутри status звали эту команду ЖИВЬЁМ
# ТРИ РАЗА подряд на одну и ту же таблицу, которая за время одного расчёта не
# меняется (то же рассуждение про «секунда-другая устаревания уже принята
# явно», что у mangle-снимка). СТРОКА В ПАМЯТИ, НЕ ФАЙЛ — урок 1.77/1.78:
# файловый I/O на роутере дороже, чем повторный grep по строке.
_RTSNAP_S=""
_RTSNAP_ON=""
rtsnap_capture() {
	_rs_s=$(ip route show table "$TABLE" 2>/dev/null) || return 1
	_RTSNAP_S="$_rs_s"
	_RTSNAP_ON=1
	return 0
}
rtsnap_release() { _RTSNAP_ON=""; _RTSNAP_S=""; }

# _iptsnap_c — ipt -C ЦЕПОЧКА АРГУМЕНТЫ... по снимку. ТОЧНОЕ совпадение
# строки «-A ЦЕПОЧКА АРГУМЕНТЫ» (счётчик [пакеты:байты] отрезан) — тот же
# протокол, что у живого -C: у всех вызовов -C внутри status аргумент — голый
# `-j ЦЕЛЬ`, семантика точного совпадения совпадает без всяких оговорок.
# ОДИН awk (1.79) вместо sed+grep (было 2 форка на вызов, тут 1); сравнение
# СТРОКОЙ (==), не регэкспом — та же точность, что у прежнего grep -F, точки
# в адресах и прочие спецсимволы не должны толковаться как шаблон.
_iptsnap_c() {
	_isc_snap="$1"; _isc_ch="$2"; shift 2
	_isc_want="-A $_isc_ch"
	for _isc_a in "$@"; do _isc_want="$_isc_want $_isc_a"; done
	printf '%s\n' "$_isc_snap" | awk -v want="$_isc_want" '
		{
			line = $0
			sub(/^\[[0-9]*:[0-9]*\] /, "", line)
			if (line == want) { f = 1; exit }
		}
		END { exit (f ? 0 : 1) }
	'
}
# _iptsnap_s — ipt -S [ЦЕПОЧКА] по снимку. Без аргумента — вся таблица (как
# живой -S без цепочки); с аргументом — сначала проверка, что цепочка вообще
# существует (строка «:ИМЯ »), потом её правила. ОДИН awk (1.79) вместо трёх
# отдельных printf|grep/sed проходов по всему снимку.
_iptsnap_s() {
	_iss_snap="$1"; shift
	if [ -z "${1:-}" ]; then
		printf '%s\n' "$_iss_snap" | sed 's/^\[[0-9]*:[0-9]*\] //' | grep -v '^:'
		return 0
	fi
	printf '%s\n' "$_iss_snap" | awk -v ch="$1" '
		$0 ~ ("^:" ch " ") { found = 1 }
		/^\[/ {
			line = $0
			sub(/^\[[0-9]*:[0-9]*\] /, "", line)
			if (line ~ ("^-A " ch " ")) print line
		}
		END { exit (found ? 0 : 1) }
	'
}
ipt()  {
	if [ -n "$_IPTSNAP_ON" ]; then
		case "$1" in
			-C) shift; _iptsnap_c "$_IPTSNAP_S" "$@"; return $? ;;
			-S) shift; _iptsnap_s "$_IPTSNAP_S" "${1:-}"; return $? ;;
		esac
	fi
	iptables $IPTW -t mangle "$@" 2>/dev/null
}
# iptf/iptn — ЧИТАЮТ ИЗ СНИМКА ТОЧНО ТАК ЖЕ, ЧТО ipt (1.90). Условие строже,
# чем у mangle: нужен НЕ ТОЛЬКО взятый снимок, но и непустой кусок своей
# таблицы — пустой означает «этой таблицы в снимке нет», и отвечать по нему
# «правила нет» значило бы врать правдоподобно (инвариант 22). Меняющие
# ключи (-A/-D/-I/-N/-F/-X/-R) сюда не попадают по построению развилки: она
# ловит только -C и -S.
iptf() {
	if [ -n "$_IPTSNAP_ON" ] && [ -n "$_IPTSNAP_F" ]; then
		case "$1" in
			-C) shift; _iptsnap_c "$_IPTSNAP_F" "$@"; return $? ;;
			-S) shift; _iptsnap_s "$_IPTSNAP_F" "${1:-}"; return $? ;;
		esac
	fi
	iptables $IPTW -t filter "$@" 2>/dev/null
}
# iptn — ТАБЛИЦА nat (шаг 11, владелец, 22.09.2026: маскарад помеченного
# трафика на выходе из туннеля). Той же формы, что iptf, и с 1.90 так же
# читает из снимка: утверждение 1.89 «правило одно, живёт не в горячем пути
# cmd_status_compute()» оказалось неверным — профиль на HERO поймал обратное,
# nat опрашивается внутри расчёта и делает это живыми процессами.
iptn() {
	if [ -n "$_IPTSNAP_ON" ] && [ -n "$_IPTSNAP_N" ]; then
		case "$1" in
			-C) shift; _iptsnap_c "$_IPTSNAP_N" "$@"; return $? ;;
			-S) shift; _iptsnap_s "$_IPTSNAP_N" "${1:-}"; return $? ;;
		esac
	fi
	iptables $IPTW -t nat "$@" 2>/dev/null
}

# ipt_check / iptf_check — есть ли правило. ТРИ ИСХОДА, и это не украшение:
#
#   0 — правило есть
#   1 — правила нет
#   2 — СПРОСИТЬ НЕ СМОГЛИ (обычно код 4: занят замок xtables)
#
# 04.09.2026, роутер владельца: `ensure` два часа подряд каждые 2-5 минут писал
# «восстановлено — правила;», а при снятии в цепочках нашлось пять `--ctdir
# REPLY -j RETURN`, девять `--match-set` и четыре MSS. Причина ровно здесь:
# отказ проверки читался как «правила нет», и периодика ДОБАВЛЯЛА ещё копию,
# каждый раз рапортуя об успехе. Она не приводила к состоянию, а накапливала.
#
# «Не знаю» и «нет» — разные ответы, и на них разные действия: на «нет» надо
# ставить, на «не знаю» — не трогать и сказать об этом.
ipt_check() {
	ipt -C "$@" >/dev/null 2>&1
	_c=$?
	[ "$_c" = 0 ] && return 0
	[ "$_c" = 1 ] && return 1
	return 2
}
iptf_check() {
	iptf -C "$@" >/dev/null 2>&1
	_c=$?
	[ "$_c" = 0 ] && return 0
	[ "$_c" = 1 ] && return 1
	return 2
}
iptn_check() {
	iptn -C "$@" >/dev/null 2>&1
	_c=$?
	[ "$_c" = 0 ] && return 0
	[ "$_c" = 1 ] && return 1
	return 2
}

# chain_exists — те же три исхода. Цепочки нет (1) и спросить не смогли (2)
# различаются: во втором случае `-N` вернёт «уже существует», и мы ничего не
# сломаем, но и рапортовать о создании не имеем права.
chain_exists()   { ipt  -S "$1" >/dev/null 2>&1; _c=$?; [ "$_c" = 0 ] && return 0; [ "$_c" = 1 ] && return 1; return 2; }
chain_exists_f() { iptf -S "$1" >/dev/null 2>&1; _c=$?; [ "$_c" = 0 ] && return 0; [ "$_c" = 1 ] && return 1; return 2; }

# jump_drop ТАБЛИЦА ЦЕПОЧКА ЦЕЛЬ — снять прыжок, сколько бы его копий ни было.
# Удаляем ФАКТИЧЕСКОЙ строкой из -S: если прыжок кто-то поставил с дополнительными
# условиями, слепое -D не удалит ничего, а выглядеть будет как «удалил».
jump_drop() {
	JT="$1"; JC="$2"; JX="$3"; T=0
	while :; do
		SPEC=$(iptables -t "$JT" -S "$JC" 2>/dev/null | grep -- "-j $JX\$" | head -1 | sed 's/^-A //')
		[ -n "$SPEC" ] || break
		iptables -t "$JT" -D $SPEC 2>/dev/null || break
		T=$((T+1)); [ "$T" -gt 10 ] && break
	done
}

rules_apply() {
	RC=0        # 1 — что-то ДЕЙСТВИТЕЛЬНО поставили
	UNSURE=0    # 1 — хотя бы одну проверку выполнить не смогли
	# Цепочки: 1 — нет, создаём; 2 — не смогли спросить, НЕ ТРОГАЕМ.
	chain_exists "$CH_MARK"; case $? in
		1) ipt  -N "$CH_MARK" && RC=1 ;;
		2) UNSURE=1 ;;
	esac
	chain_exists "$CH_MSS"; case $? in
		1) ipt  -N "$CH_MSS"  && RC=1 ;;
		2) UNSURE=1 ;;
	esac
	chain_exists_f "$CH_FWD"; case $? in
		1) iptf -N "$CH_FWD"  && RC=1 ;;
		2) UNSURE=1 ;;
	esac

	# Метка ставится ТОЛЬКО в своих битах: --set-xmark с маской. --set-mark
	# затёр бы метку целиком вместе с прошивочными NDMMARK, то есть сломал бы
	# политики Keenetic на нашем же трафике.
	ipt_check "$CH_MARK" -m set --match-set "$SET" dst -j MARK --set-xmark "$MARK/$MASK"; case $? in
		1) ipt -A "$CH_MARK" -m set --match-set "$SET" dst -j MARK --set-xmark "$MARK/$MASK" && RC=1 ;;
		2) UNSURE=1 ;;
	esac

	# СОХРАНЕНИЕ МЕТКИ В СОЕДИНЕНИЕ. Взято у MagiTrickle, вместе с их же
	# комментарием в исходнике ipset-to-link.go:
	#
	#   "Without this rule, routing on Keenetic routers did not work; DO NOT REMOVE!"
	#
	# Почему это важно именно здесь: аппаратная разгрузка Keenetic (fastnat и
	# fastroute) забирает поток себе после первых пакетов и ведёт его мимо
	# ядра. Метка на ПАКЕТЕ при этом перестаёт учитываться — а метка на
	# СОЕДИНЕНИИ едет вместе с записью conntrack, которую разгрузка как раз и
	# держит. MagiTrickle разгрузку не выключает вовсе и работает; значит
	# механизм, который она уважает, — именно этот.
	#
	# Маску ставим СВОЮ, в отличие от MagiTrickle: у них `--save-mark` без
	# масок копирует слово целиком вместе с прошивочными NDMMARK. Мы трогаем
	# только свои биты — по той же причине, по которой всюду ставим xmark с
	# маской, а не запись слова целиком.
	#
	# Восстановление (--restore-mark) НЕ добавляем сознательно: у MagiTrickle
	# его тоже нет, каждый пакет и так проходит проверку по набору, а
	# восстановление затронуло бы метки прошивки на чужом трафике.
	ipt_check "$CH_MARK" -m set --match-set "$SET" dst -j CONNMARK --save-mark --nfmask "$MASK" --ctmask "$MASK"; case $? in
		1) ipt -A "$CH_MARK" -m set --match-set "$SET" dst -j CONNMARK --save-mark --nfmask "$MASK" --ctmask "$MASK" && RC=1 ;;
		2) UNSURE=1 ;;
	esac

	# Обратное направление уже установленного соединения помечать незачем: у
	# такого пакета получатель — наш клиент, и в наборе его нет. Выход ПЕРВОЙ
	# строкой избавляет половину пакетов от поиска в наборе.
	#
	# Приём взят у MagiTrickle (первая строка его цепочки в mangle) — там же,
	# где взят образец разрешения транзита. Ставится ВСТАВКОЙ в начало, а не
	# добавлением: строка, оказавшаяся после проверки набора, не экономит
	# ничего и выглядит при этом рабочей.
	ipt_check "$CH_MARK" -m conntrack --ctdir REPLY -j RETURN; case $? in
		1) ipt -I "$CH_MARK" 1 -m conntrack --ctdir REPLY -j RETURN && RC=1 ;;
		2) UNSURE=1 ;;
	esac

	# --- Разрешение транзита в туннель. Без него всё остальное бесполезно:
	# у прошивки Keenetic политика FORWARD = DROP, и промаркированный пакет,
	# доехав до межсетевого экрана, умирает там молча. Найдено приёмкой
	# 19.08.2026: маршрут, метка, маскарад и клэмп работали, а счётчик политики
	# DROP рос ровно на число пингов. Образец взят у соседа (MagiTrickle делает
	# то же самое своей цепочкой).
	#
	# Обратное направление НЕ открываем сознательно: ответы уже проходят по
	# ACCEPT state RELATED,ESTABLISHED, который в FORWARD стоит выше, а правило
	# `-i meridian -j ACCEPT` открыло бы локальную сеть всему, что придёт со
	# стороны туннеля. Это разница между «пустить наш трафик наружу» и «впустить
	# чужой внутрь».
	# Определяющей является МЕТКА, а не интерфейс и не набор.
	#
	# Было `-o $(tun_name) -m set --match-set $SET dst`. Я предлагал упростить
	# до одного `-o $(tun_name)` — и это была ДЫРА. Довод под ней тоже был
	# негодным: я проверил, что пишет НАШ КОД (route_up пишет только в
	# $TABLE), а не что ЛЕЖИТ в таблице. Ядро само кладёт в main маршрут
	# 10.77.77.0/24 dev meridian proto kernel при назначении адреса, и правило
	# `-o meridian -j ACCEPT` начало бы пропускать транзит из домашней сети к
	# ЧУЖИМ роутерам в общей подсети RAW-клиентов.
	#
	# Проверено пакетами в netns (04.09.2026):
	#   -o meridian -j ACCEPT              → транзит на 10.77.77.5 ПРОШЁЛ
	#   -o meridian -m mark ... -j ACCEPT  → транзит на 10.77.77.5 не прошёл
	# Сегодня это умирает на политике DROP только потому, что 10.77.77.x нет
	# в наборе; убрав набор и не добавив метку, мы бы дыру открыли.
	#
	# `-o $(tun_name)` оставлен рядом как ДОПОЛНИТЕЛЬНОЕ сужение, а не как
	# определяющее условие.
	iptf_check "$CH_FWD" -o "$(tun_name)" -m mark --mark "$MARK/$MASK" -j ACCEPT; case $? in
		1) iptf -A "$CH_FWD" -o "$(tun_name)" -m mark --mark "$MARK/$MASK" -j ACCEPT && RC=1 ;;
		2) UNSURE=1 ;;
	esac

	# MSS считается от ФАКТИЧЕСКОГО MTU интерфейса. Если интерфейса ещё нет,
	# правило не ставим вовсе — его поставит on-tunnel-up/ensure, когда туннель
	# поднимется. Клэмп с чужим числом хуже отсутствующего: «сайты открываются,
	# а большие страницы висят» ищут не там.
	M=$(want_mss)
	if [ -n "$M" ]; then
		# Условие по набору обязательно: через туннель ходит не только наш
		# трафик (у MagiTrickle те же интерфейсы), и клэмп без набора правит
		# ЧУЖИЕ пакеты. На приёмке 19.08 он успел поправить 119 штук.
		ipt_check "$CH_MSS" -o "$(tun_name)" -p tcp --tcp-flags SYN,RST SYN -m mark --mark "$MARK/$MASK" -j TCPMSS --set-mss "$M"
		case $? in
			1)
				# старое правило с другим MSS (MTU сменился) снимаем
				OLD=$(ipt -S "$CH_MSS" 2>/dev/null | grep -- '--set-mss' | head -1 | sed 's/^-A //')
				[ -n "$OLD" ] && { ipt -D $OLD; log "MSS пересчитан: было «$OLD», MTU теперь $(tun_mtu)"; }
				ipt -A "$CH_MSS" -o "$(tun_name)" -p tcp --tcp-flags SYN,RST SYN -m mark --mark "$MARK/$MASK" -j TCPMSS --set-mss "$M" && RC=1
				;;
			2) UNSURE=1 ;;
		esac
	fi

	ipt_check  PREROUTING -j "$CH_MARK"; case $? in
		1) ipt  -A PREROUTING -j "$CH_MARK" && RC=1 ;;
		2) UNSURE=1 ;;
	esac
	# ЛОКАЛЬНЫЙ КЛЭМП СЮДА НЕ ХОДИТ (владелец, 21.09.2026, поймано на живом
	# парке заходом А шага 11): эта функция зовётся на КАЖДОМ ensure в
	# ЧЁРНОМ режиме, независимо от слоя out. Раньше здесь ставилось ТЕЛО
	# MERIDIAN_MSS_LOCAL безусловно — и парк, где out никто не включал,
	# получал бы пустую (0 references) цепочку на каждом роутере: строка
	# в чужом iptables-save, которую каждый будет разбирать заново. Тело
	# живёт вместе с прыжком, в out_mss_local_ensure(), которую зовут
	# out_apply() (создание) и out_ensure() (МТU-рефреш, пока слой включён).

	ipt_check  FORWARD -j "$CH_MSS"; case $? in
		1) ipt  -A FORWARD -j "$CH_MSS" && RC=1 ;;
		2) UNSURE=1 ;;
	esac
	iptf_check FORWARD -j "$CH_FWD"; case $? in
		1) iptf -A FORWARD -j "$CH_FWD" && RC=1 ;;
		2) UNSURE=1 ;;
	esac
	# ТРИ исхода наружу: 0 — поставили что-то, 1 — всё уже стояло, 2 — часть
	# проверок не удалась и мы НИЧЕГО не добавляли. Третий обязателен: без него
	# «не смог посмотреть» неотличимо от «всё на месте», и периодика два часа
	# подряд рапортует об успехе, накапливая копии.
	[ "$RC" = 1 ] && return 0
	[ "$UNSURE" = 1 ] && return 2
	return 1
}

# rules_dedup — СХОЖДЕНИЕ. Убирает лишние копии наших правил, оставляя по одной.
#
# 04.09.2026 на роутере владельца накопилось: пять «--ctdir REPLY -j RETURN»,
# девять «--match-set», четыре MSS. Их наплодила периодика, читавшая отказ
# проверки как «правила нет». Проверку я починил (ipt_check), но починка не
# убирает уже накопленное, а «привести систему в соответствие с состоянием»
# означает именно привести, а не «больше не портить».
#
# ТРОГАЕМ ТОЛЬКО СВОЁ: строки внутри наших цепочек и переходы, чья ЦЕЛЬ — наша
# цепочка. Ни одного чужого правила эта функция коснуться не может.
#
# Печатает число снятых копий (0 — ничего не делали).
dedup_one() {
	# $1 — таблица, $2 — цепочка, $3 — образец строки (grep -F -x)
	_tab=$1; _ch=$2; _line=$3
	_k=$(iptables $IPTW -t "$_tab" -S "$_ch" 2>/dev/null | grep -c -F -x -- "$_line")
	_gone=0
	while [ "$_k" -gt 1 ]; do
		# Строка вида «-A ЦЕПОЧКА ...»; для -D нужен остаток без «-A ЦЕПОЧКА».
		# Без кавычек СОЗНАТЕЛЬНО: это набор аргументов, а не одна строка.
		_spec=${_line#-A $_ch }
		iptables $IPTW -t "$_tab" -D "$_ch" $_spec 2>/dev/null || break
		_k=$((_k - 1))
		_gone=$((_gone + 1))
	done
	echo "$_gone"
}

dedup_chain() {
	_tab=$1; _ch=$2
	_dups=$(iptables $IPTW -t "$_tab" -S "$_ch" 2>/dev/null | grep "^-A $_ch " | sort | uniq -d)
	[ -n "$_dups" ] || { echo 0; return 0; }
	_total=0
	# Через файл, а не через конвейер: `while read` в конвейере крутится в
	# подоболочке, и счётчик наружу не выходит — тихий ноль вместо числа.
	_tmp="$STATE.dedup"
	printf '%s\n' "$_dups" > "$_tmp" 2>/dev/null || { echo 0; return 0; }
	while IFS= read -r _l; do
		[ -n "$_l" ] || continue
		_total=$((_total + $(dedup_one "$_tab" "$_ch" "$_l")))
	done < "$_tmp"
	rm -f "$_tmp" 2>/dev/null
	echo "$_total"
}

rules_dedup() {
	_n=0
	_n=$((_n + $(dedup_chain mangle "$CH_MARK")))
	_n=$((_n + $(dedup_chain mangle "$CH_MSS")))
	_n=$((_n + $(dedup_chain filter "$CH_FWD")))
	# Переходы: дубли возможны там же и по той же причине.
	_n=$((_n + $(dedup_one mangle PREROUTING "-A PREROUTING -j $CH_MARK")))
	_n=$((_n + $(dedup_one mangle FORWARD    "-A FORWARD -j $CH_MSS")))
	_n=$((_n + $(dedup_one filter FORWARD    "-A FORWARD -j $CH_FWD")))
	echo "$_n"
}

# --- аппаратная разгрузка -----------------------------------------------------

# offload_present — есть ли ручки вообще. На OpenWRT и в стенде их может не
# быть, и это НЕ отказ: это другая среда, и говорить о ней надо прямо.
offload_present() { [ -f "$FASTNAT_PATH" ] || [ -f "$FASTROUTE_PATH" ]; }

# offload_managed — просили ли нас трогать ручки. Проверяется В ОДНОМ месте:
# рассыпать это условие по трём вызовам значит однажды забыть его в четвёртом.
# FASTNATPROP — временная подпорка владельца: init-скрипт, выключающий обе
# ручки при загрузке. С 1.16 она не нужна — метку держит CONNMARK.
#
# УДАЛЯТЬ ЕЁ МЫ НЕ БУДЕМ. Это файл человека, он его положил, он и снимет:
# движок не трогает того, чего не создавал. Наше дело — сказать.
FASTNATPROP="${MERIDIAN_ROUTE_FASTNATPROP:-/opt/etc/init.d/S00meridian-fastnat}"

# fastnat_prop_notice — сказать про подпорку. Печатает строку, если файл есть.
fastnat_prop_notice() {
	[ -f "$FASTNATPROP" ] || return 1
	say "ПОДПОРКА БОЛЬШЕ НЕ НУЖНА: $FASTNATPROP"
	say "  Она выключает аппаратную разгрузку при загрузке. С версии $VERSION это"
	say "  делать не требуется: метка сохраняется в соединение (CONNMARK), и"
	say "  разгрузка её уважает — так же работает MagiTrickle."
	say "  Снимите файл сами, когда убедитесь, что всё работает: удалять чужие"
	say "  файлы движок не станет."
	return 0
}

offload_managed() {
	[ "$OFFLOAD_MANAGE" = "off" ] && return 0
	# Конфиг движок НЕ подключает через «.» (правило 31: неудачное подключение
	# молча гасит оболочку) — читаем ключ тем же способом, что и остальные.
	# И читаем ЛЕНИВО: conf_value объявлена ниже по файлу, а переменные наверху
	# вычисляются при загрузке, когда её ещё нет.
	[ "$(conf_value OFFLOAD)" = "off" ]
}

offload_get() { cat "$1" 2>/dev/null | tr -d ' \t\n'; }

# offload_save_once — ЗАПОМНИТЬ прежние значения. Ровно один раз за включение.
#
# Повторное сохранение поверх уже своего значения — это «копия отравленного
# состояния» (правило 37): второй проход записал бы наши нули как «прежние», и
# вернуть человеку его настройку стало бы нечем. Поэтому пишем, только если
# файла ещё нет, и только если прочитанное похоже на настоящее значение.
offload_save_once() {
	[ -f "$OFFLOADSAVE" ] && return 0
	offload_present || return 0
	_fn=$(offload_get "$FASTNAT_PATH")
	_fr=$(offload_get "$FASTROUTE_PATH")
	case "$_fn" in ''|0|1) ;; *) log "разгрузка: fastnat читается как «$_fn» — не 0 и не 1, НЕ трогаю ручки вовсе"; return 1 ;; esac
	case "$_fr" in ''|0|1) ;; *) log "разгрузка: fastroute читается как «$_fr» — не 0 и не 1, НЕ трогаю ручки вовсе"; return 1 ;; esac
	mkdir -p "$(dirname "$OFFLOADSAVE")" 2>/dev/null
	{ echo "fastnat=$_fn"; echo "fastroute=$_fr"; echo "saved_at=$(date +%s)"; } > "$OFFLOADSAVE.tmp" 2>/dev/null || return 1
	mv -f "$OFFLOADSAVE.tmp" "$OFFLOADSAVE" 2>/dev/null || return 1
	log "разгрузка: запомнил прежние значения fastnat=$_fn fastroute=$_fr (вернём их при снятии)"
	return 0
}

offload_saved_get() { [ -f "$OFFLOADSAVE" ] && sed -n "s/^$1=//p" "$OFFLOADSAVE" 2>/dev/null | head -1; }

# offload_set — записать значение и СВЕРИТЬ СОДЕРЖИМЫМ, а не кодом возврата
# echo (правило 37: «конфиг восстановлен» печаталось по коду возврата cp, а в
# файле лежало мёртвое значение).
offload_set() {
	_path=$1; _want=$2
	[ -f "$_path" ] || return 0
	[ -n "$_want" ] || return 0
	echo "$_want" > "$_path" 2>/dev/null
	_got=$(offload_get "$_path")
	[ "$_got" = "$_want" ] && return 0
	return 1
}

# offload_disable — выключить обе ручки. Возвращает 0, если что-то ИЗМЕНИЛИ,
# 1 — если и так было выключено, 2 — если не смогли.
offload_disable() {
	offload_managed || return 1
	offload_present || return 1
	_was_fn=$(offload_get "$FASTNAT_PATH")
	_was_fr=$(offload_get "$FASTROUTE_PATH")
	if [ "$_was_fn" = "0" ] && [ "$_was_fr" = "0" ]; then
		return 1
	fi
	offload_save_once || return 2
	_bad=""
	offload_set "$FASTNAT_PATH" 0   || _bad="$_bad fastnat"
	offload_set "$FASTROUTE_PATH" 0 || _bad="$_bad fastroute"
	if [ -n "$_bad" ]; then
		log "разгрузка: НЕ выключилась ($_bad) — транзит через туннель будет рваться; проверьте вручную: cat $FASTNAT_PATH $FASTROUTE_PATH"
		return 2
	fi
	return 0
}

# offload_restore — вернуть ЗАПОМНЕННОЕ. Сверка содержимым; разошлось — ОТКАЗ и
# точная команда ручного возврата.
# ВОЗВРАТ не спрашивает про ключ: если запомненное есть, значит мы когда-то
# трогали ручки, и вернуть обязаны — даже если ключ с тех пор выключили.
# Обратный порядок оставил бы человеку наши настройки навсегда.
offload_restore() {
	[ -f "$OFFLOADSAVE" ] || return 1
	_fn=$(offload_saved_get fastnat)
	_fr=$(offload_saved_get fastroute)
	_bad=""
	offload_set "$FASTNAT_PATH" "$_fn"   || _bad="$_bad fastnat"
	offload_set "$FASTROUTE_PATH" "$_fr" || _bad="$_bad fastroute"
	if [ -n "$_bad" ]; then
		say "ОТКАЗ: не вернул прежние значения разгрузки ($_bad). Вручную:"
		[ -n "$_fn" ] && say "    echo $_fn > $FASTNAT_PATH"
		[ -n "$_fr" ] && say "    echo $_fr > $FASTROUTE_PATH"
		log "разгрузка: возврат НЕ удался ($_bad), запомненное оставлено в $OFFLOADSAVE"
		return 2
	fi
	log "разгрузка: вернул прежние значения fastnat=$_fn fastroute=$_fr"
	# Файл снимаем ТОЛЬКО после успешной сверки: он единственный след того,
	# что было до нас.
	rm -f "$OFFLOADSAVE" 2>/dev/null
	return 0
}

# --------------------------------------------------------------------------
# ПРИБОР: пропажи туннеля считаются НАМИ, а не по чужим вызовам
# --------------------------------------------------------------------------
# 05.09.2026, замер владельца: за 22.08 в логе ШЕСТЬ строк «туннель упал» и НИ
# ОДНОЙ «поднят». Причина найдена в чужом файле (qwdtt-init-entware.sh):
# `route_call on-tunnel-up` стоит ТОЛЬКО в ветке RAW, а `on-tunnel-down` —
# на общем пути остановки. В режиме WG подъём не приходит никогда.
#
# Но чинить это там — лечить симптом. Прибор, зависящий от того, позвал ли нас
# кто-то, не прибор: любая правка чужого скрипта снова его ослепит. Поэтому
# состояние туннеля движок определяет САМ, при каждом своём проходе (периодика
# раз в минуту, крючок на каждом сетевом событии), а чужие вызовы только
# уточняют момент.
#
# И считаются ПРОПАЖИ, а не события: шесть «упал» подряд без единого «поднят» —
# это ОДНА пропажа, а не шесть. Прежний прибор считал события и потому не мог
# ответить на вопрос «сколько длилась».
TUNSTATE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.tunnel"
OUTAGES="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.outages"
# Потолок журнала пропаж — В СТРОКАХ, и файл лежит на флеше рядом с состоянием:
# он обязан пережить и перезапуск движка (несколько раз в день), и перезагрузку
# роутера, иначе распределения за неделю не собрать вовсе.
#
# 200 строк вместо прежних 50 — арифметика простая: неделя при двадцати пропажах
# в сутки это 140 записей, и в 50 они бы не поместились. Строка около 20 байт,
# весь журнал — 4 КБ. Журнал без потолка это правило 21 с другим содержимым, но
# потолок, не вмещающий замер, ради которого журнал заведён, бесполезен так же.
OUTAGES_MAX=200

# --------------------------------------------------------------------------
# ЖУРНАЛ ПЕРЕХОДОВ КЛИЕНТА (шаг 10б-2, пункт 1, владелец 20-21.09.2026).
#
# ДЛЯ ЧЕГО. Автопереход в белый режим по релею нуждается в гистерезисе
# (N минут непрерывно на релее — войти, M минут непрерывно на прямом —
# выйти, M заметно больше N), и оба числа владелец велел брать ЗАМЕРОМ, не
# назначением. Отдельного журнала переходов у клиента нет, но он пишет
# журнал (`ПЕРЕЕЗД БЕЗ РАЗРЫВА` и обратные) — и, важнее, кладёт ТЕКУЩЕЕ
# состояние пути в файл специально для внешних читателей:
# `/opt/var/run/qwdtt-path.json` (`session_raw_path.go:792`, комментарий
# автора: «маркер режима для панели... клиент знает правду о своём канале,
# панель — нет, поэтому правду кладут в файл, а не в догадку по логам»).
# Движок — ровно такой читатель, как панель.
#
# ПОЧЕМУ НЕ `since` ИЗ ФАЙЛА КЛИЕНТА. `since` там — «с какого момента держится
# ТЕКУЩАЯ СЕССИЯ», и сбрасывается при КАЖДОЙ пересборке сессии, включая
# плановую ротацию (`rawRotateAfter`), даже если ТИП пути не менялся. «Непрерывно
# на релее» — про ТИП пути, а не про одну сессию; движок обязан считать это
# сам, а не наследовать чужой таймер с другим смыслом.
QWDTT_PATH_STATE="${MERIDIAN_ROUTE_QWDTT_PATH_STATE:-/opt/var/run/qwdtt-path.json}"
TRANSITIONS="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.transitions"
TRANSITIONS_LASTMODE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.transitions.lastmode"
# Тот же довод, что у OUTAGES_MAX: без потолка — растущий без предела файл;
# 200 строк на смены пути (не на события пропажи) хватает на месяцы обычной
# жизни и с запасом покрывает суточный потолок переключений автомата.
TRANSITIONS_MAX=200

# qwdtt_path_mode/qwdtt_path_since — ОДНО скалярное поле из JSON клиента.
# Полноценный парсер не заводим: файл плоский, поля не вложены, и то же
# самое чтение уже используется во всём движке для .state-файлов (sed по
# одной строке) — второй формат для одного поля был бы лишней зависимостью.
qwdtt_path_mode() {
	[ -r "$QWDTT_PATH_STATE" ] || return 1
	sed -n 's/.*"mode"[[:space:]]*:[[:space:]]*"\([a-z]*\)".*/\1/p' "$QWDTT_PATH_STATE" 2>/dev/null | head -1
}
qwdtt_path_since() {
	[ -r "$QWDTT_PATH_STATE" ] || return 1
	sed -n 's/.*"since"[[:space:]]*:[[:space:]]*\([0-9]*\).*/\1/p' "$QWDTT_PATH_STATE" 2>/dev/null | head -1
}

# transitions_ensure — ЗАПИСЬ ТОЛЬКО ПРИ СМЕНЕ mode, одна строка "unix
# было -> стало" на переход. Журнал служит ДВУМ задачам владельца сразу
# (замер N/M и суточный потолок переключений автомата) — второй файл под
# вторую задачу не заводим, обе читают один.
#
# ФАЙЛА КЛИЕНТА НЕТ (старая прошивка, клиент не запущен) — ТИХО НИЧЕГО НЕ
# ПИШЕМ, а не считаем это переходом «в неизвестность»: пустая история молчит
# честнее, чем выдуманная запись.
transitions_ensure() {
	_tm=$(qwdtt_path_mode) || return 0
	[ -n "$_tm" ] || return 0
	_tprev=$(cat "$TRANSITIONS_LASTMODE" 2>/dev/null)
	[ "$_tm" = "$_tprev" ] && return 0
	mkdir -p "$(dirname "$TRANSITIONS")" 2>/dev/null
	echo "$(date +%s) ${_tprev:-start} -> $_tm" >> "$TRANSITIONS" 2>/dev/null
	# ПОТОЛОК — ХВОСТОМ, тот же приём, что LOG_MAX у самого лога движка.
	if [ -f "$TRANSITIONS" ]; then
		_tn=$(wc -l < "$TRANSITIONS" 2>/dev/null)
		[ "${_tn:-0}" -gt "$TRANSITIONS_MAX" ] 2>/dev/null && {
			tail -n "$TRANSITIONS_MAX" "$TRANSITIONS" > "$TRANSITIONS.tmp" 2>/dev/null \
				&& mv -f "$TRANSITIONS.tmp" "$TRANSITIONS" 2>/dev/null
		}
	fi
	printf '%s' "$_tm" > "$TRANSITIONS_LASTMODE" 2>/dev/null
	log "переход клиента: ${_tprev:-(впервые увиден)} -> $_tm"
}

# transitions_continuous_since — момент ПОСЛЕДНЕЙ смены (не since клиента).
# Пусто, если журнала ещё нет: движок увидел путь впервые только что, и это
# не то же самое, что «давно», это надо назвать честно, а не подставить 0.
transitions_continuous_since() {
	[ -f "$TRANSITIONS" ] || return 1
	tail -1 "$TRANSITIONS" 2>/dev/null | awk '{print $1}'
}

tun_field() { [ -f "$TUNSTATE" ] && sed -n "s/^$1=//p" "$TUNSTATE" 2>/dev/null | head -1; }

tun_state_set() {
	mkdir -p "$(dirname "$TUNSTATE")" 2>/dev/null
	{ echo "state=$1"; echo "since=$2"; echo "open_since=$3"
	  echo "held_total=${4:-0}"; echo "seen=${5:-0}"; } > "$TUNSTATE.tmp" 2>/dev/null || return 1
	mv -f "$TUNSTATE.tmp" "$TUNSTATE" 2>/dev/null
}

# outage_record — длительность пропажи в журнал, с потолком.
# Строка журнала: «<когда закончилась> <сколько длилась>». Время нужно, чтобы
# распределение можно было привязать ко времени суток — «каждый вечер по десять
# минут» и «раз в неделю на час» лечатся по-разному, а по одной длительности они
# неразличимы.
outage_record() {
	echo "$(date +%s) $1" >> "$OUTAGES" 2>/dev/null || return 0
	_n=$(grep -c . "$OUTAGES" 2>/dev/null)
	case "$_n" in ''|*[!0-9]*) return 0 ;; esac
	[ "$_n" -le "$OUTAGES_MAX" ] && return 0
	tail -n "$OUTAGES_MAX" "$OUTAGES" > "$OUTAGES.tmp" 2>/dev/null && mv -f "$OUTAGES.tmp" "$OUTAGES" 2>/dev/null
	return 0
}

# outages_clean — журнал БЕЗ строк, не годных для счёта: только «время
# длительность», оба поля — цифры.
#
# Найдено 15.09.2026 на живом журнале владельца: первые две строки — голые
# «87» и «40», без второго поля вовсе. Это не порча записи прямо сейчас, а
# ХВОСТ ФОРМАТА ДО «время длительность» — видимо, ровно то самое, что дало
# необъяснённый провал outage_max_seconds с 87 до 7 при переходе версий
# 05.09.2026 (см. ПРОЕКТ-БЕЛЫЙ-РЕЖИМ.md): число 87 из того замера — буквально
# первая строка этого файла, просто прочитанная тогда по другому полю.
#
# Без фильтра голая строка портит СРАЗУ несколько показателей, которые её не
# ждут: `grep -c .` считает её отдельной записью, раздувая n сверх реальных
# пропаж; `awk 'NR==1{print $1}'` (outages_since) читает «87» как метку
# времени и получает 1970 год вместо реальной даты — это баг, который прямо
# сейчас печатает бессмысленную дату в status на роутере владельца.
#
# Единственное место, где фильтр применяется, — здесь, а не в каждом
# читателе по отдельности: правило 43 (сторож у одной двери, а дверей много) в
# применении к чтению, не к защите.
outages_clean() {
	[ -f "$OUTAGES" ] || return 0
	awk 'NF==2 && $1 ~ /^[0-9]+$/ && $2 ~ /^[0-9]+$/' "$OUTAGES" 2>/dev/null
}

# outages_clean_cached — ТО ЖЕ, ОДИН РАЗ НА ПРОЦЕСС (1.75, владелец,
# 21.09.2026, пункт 2 хвоста шага 11: «журнал читать не грепом по всему,
# один раз»). До правки один вызов status читал и разбирал $OUTAGES ПЯТЬ
# РАЗ: hold_open_after_calc() дважды внутри себя, hold_open_after_from()
# ещё раз своим отдельным счётом, outage_stat() и сам cmd_status() —
# каждый со своим проходом awk по одному и тому же файлу. Тот же приём, что
# у dns_status_live() (кэш на время жизни процесса, файл по $$, убирает
# общий _on_exit_cleanup): первый вызов читает и разбирает, остальные —
# просто cat уже готового.
OUTAGESCLEANTMP="$RUNDIR/outages_clean.$$"
outages_clean_cached() {
	if [ ! -f "$OUTAGESCLEANTMP" ]; then
		mkdir -p "$RUNDIR" 2>/dev/null
		outages_clean > "$OUTAGESCLEANTMP.tmp" 2>/dev/null
		mv -f "$OUTAGESCLEANTMP.tmp" "$OUTAGESCLEANTMP" 2>/dev/null
	fi
	cat "$OUTAGESCLEANTMP" 2>/dev/null
}

# wan_alive — ЖИВ ЛИ КАНАЛ ПРОВАЙДЕРА.
#
# Зачем отдельно от туннеля: если лежит WAN, переход в open не даёт НИЧЕГО —
# интернета нет ни так, ни этак, — а правила мы при этом снимем и получим утечку
# в момент возвращения канала. Последний обрыв в логе клиента прямо об этом:
# «write udp ...: network is unreachable», то есть ppp0.
#
# Признак: в главной таблице есть маршрут по умолчанию через интерфейс, который
# НЕ наш туннель, и у этого интерфейса есть адрес. Двух условий достаточно и
# каждое дёшево: Keenetic снимает маршрут по умолчанию вместе с падением ppp0, а
# оставшийся без адреса интерфейс не пропустит ничего.
#
# Пинг сознательно НЕ используем: он платит временем на каждом проходе периодики
# и врёт при блокировке ICMP, а мы спрашиваем не «есть ли интернет», а «есть ли
# у нас куда его отправить».
wan_alive() {
	_dev=$(ip route show default 2>/dev/null | awk -v t="$(tun_name)" '{ for (i=1;i<=NF;i++) if ($i=="dev" && $(i+1)!=t) { print $(i+1); exit } }')
	[ -n "$_dev" ] || return 1
	ip -o -f inet addr show dev "$_dev" 2>/dev/null | grep -q 'inet ' || return 1
	return 0
}

# hold_open_after — сколько держим, прежде чем пустить трафик открытым каналом.
#
# УМОЛЧАНИЕ 180 СЕКУНД — ПРЕДВАРИТЕЛЬНОЕ, до недели нормальных замеров.
# Откуда: три измеренные пропажи — 16 с (01.09), 73 с (04.09), около 120 с
# (05.09). Девяноста секунд не хватило бы на третью. Распределения по логу
# построить нельзя, пока прибор считал события, а не пропажи (см. выше).
#
# Почему в сторону БОЛЬШЕГО: ранний open в белом режиме — это утечка ВСЕГО дома,
# поздний — отсутствие интернета. Первое дороже и незаметнее.
# hold_open_max — потолок на СУММАРНОЕ время в удержании, а не только на
# непрерывное.
#
# Зачем: отсчёт начинается заново каждый раз, когда возвращается канал
# провайдера. Если канал моргает раз в минуту, непрерывный отсчёт не дойдёт до
# конца НИКОГДА, и человек останется без интернета навсегда при живом канале.
# Вопрос владельца, и он верный.
#
# 900 секунд, предварительно, как и 180: пятнадцать минут — тот срок, за который
# человек уже точно заметил «интернета нет» и начал звонить. Пять базовых сроков
# подряд — значит связь не «моргнула», а не работает.
#
# ВАЖНО: этот потолок тоже НЕ открывает канал, пока WAN лежит. Он лечит
# моргание, а не отменяет правило «при мёртвом канале открывать нечего»: иначе
# мы снимем правила ровно к моменту возвращения канала и получим утечку.
hold_open_max() {
	_v="${MERIDIAN_ROUTE_HOLD_MAX:-$(conf_value HOLD_OPEN_MAX 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 900 ;; *) echo "$_v" ;; esac
}

# hold_open_min_samples — сколько пропаж в журнале считаем ДОСТАТОЧНЫМ, чтобы
# доверять процентилю оттуда больше, чем запасу-полу (см. hold_open_floor).
#
# 20, ПРЕДВАРИТЕЛЬНО. Прежний порог для «максимум+запас» был 10 — годился и
# для одной точки (максимума). Процентиль p90 у совсем малой выборки — это по
# сути тот же максимум (при n=10 девятая по счёту из десяти), поэтому порог
# поднят: 20 — тот размер, на котором p90 уже отличим от максимума на глаз.
hold_open_min_samples() {
	_v="${MERIDIAN_ROUTE_HOLD_MIN_SAMPLES:-$(conf_value HOLD_MIN_SAMPLES 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 20 ;; *) echo "$_v" ;; esac
}

# hold_open_percentile — какой процентиль длительностей считаем «почти все
# пропажи». ПРЕДВАРИТЕЛЬНО 90.
#
# Обоснование ПРОДУКТОВОЕ, не вычислительное — поправлено 15.09.2026 по
# указанию владельца: довод «p95 на живом журнале упирается в потолок, а p90
# нет» отвергнут как подгонка метода под желаемый ответ — так можно оправдать
# любой процентиль, чей результат попал внутрь полосы, это не довод сам по
# себе. Настоящий довод: p90 означает «девять пропаж из десяти дом переживает
# молча, десятая стоит открытия через `hold_open_after` секунд» — такую цену
# владелец может взвесить и принять осознанно, а не «мы вычислили и получилось
# удобное число». Настраивается (`HOLD_OPEN_PERCENTILE`), если продуктовое
# решение изменится.
hold_open_percentile() {
	_v="${MERIDIAN_ROUTE_HOLD_PERCENTILE:-$(conf_value HOLD_OPEN_PERCENTILE 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 90 ;; *) echo "$_v" ;; esac
}

# hold_open_floor — минимум для порога, даже если процентиль или запас без
# данных сказали бы меньше. Число то же, что было прежним умолчанием (180) —
# не совпадение: то умолчание уже переживало три реальные пропажи (16, 73,
# ~120 с). Роль сменилась (было «угаданное число», стало «нижняя граница»), а
# основание для величины — то же самое измерение.
hold_open_floor() {
	_v="${MERIDIAN_ROUTE_HOLD_FLOOR:-$(conf_value HOLD_OPEN_FLOOR 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 180 ;; *) echo "$_v" ;; esac
}

# hold_open_ceiling — потолок, и это РЕШЕНИЕ ВЛАДЕЛЬЦА (15.09.2026), а не
# вычисление. Обоснование его словами: дольше пятнадцати минут ждать
# бессмысленно — пропажа такой длины сама собой не рассосётся, а цена
# ожидания в белом режиме это тёмный дом. 900 с (15 минут).
hold_open_ceiling() {
	_v="${MERIDIAN_ROUTE_HOLD_CEILING:-$(conf_value HOLD_OPEN_CEILING 2>/dev/null)}"
	case "$_v" in ''|*[!0-9]*) echo 900 ;; *) echo "$_v" ;; esac
}

# hold_open_after_calc — считает ВСЁ за один проход журнала и печатает одной
# строкой: "<итог> <метка> <сырой_процентиль> <n>". Одно место для расчёта,
# а не два (у hold_open_after() и hold_open_after_from()), которые иначе могли
# бы посчитать по-разному, читая один и тот же файл порознь (правило 51).
#
# Метка одна из: percentile (внутри [пол,потолок]), floor (процентиль ниже
# пола), ceiling (процентиль выше потолка). Отказ (код 1), если данных мало —
# вызывающий обязан отличить «посчитано» от «взят запас» (правило 39).
#
# Метод процентиля — «ближайший ранг» (nearest-rank): idx = ceil(n * p/100) по
# отсортированным длительностям. Простой и достаточный на выборках в десятки
# записей; интерполяцией между соседними не усложняю — разница на таких n
# внутри погрешности самого измерения.
hold_open_after_calc() {
	[ -f "$OUTAGES" ] || return 1
	_n=$(outages_clean_cached | grep -c .)
	case "$_n" in ''|*[!0-9]*) return 1 ;; esac
	[ "$_n" -ge "$(hold_open_min_samples)" ] || return 1
	_p=$(outages_clean_cached | awk '{print $2}' | sort -n | awk -v n="$_n" -v pct="$(hold_open_percentile)" '
		{ a[NR] = $1 }
		END {
			idx = int(n * pct / 100)
			if (n * pct / 100 > idx) idx++
			if (idx < 1) idx = 1
			if (idx > n) idx = n
			print a[idx]
		}')
	case "$_p" in ''|*[!0-9]*) return 1 ;; esac
	_floor=$(hold_open_floor)
	_ceiling=$(hold_open_ceiling)
	if [ "$_p" -lt "$_floor" ]; then
		echo "$_floor floor $_p $_n"
	elif [ "$_p" -gt "$_ceiling" ]; then
		echo "$_ceiling ceiling $_p $_n"
	else
		echo "$_p percentile $_p $_n"
	fi
	return 0
}

hold_open_after() {
	_v="${MERIDIAN_ROUTE_HOLD_OPEN:-$(conf_value HOLD_OPEN_AFTER 2>/dev/null)}"
	case "$_v" in
		''|*[!0-9]*) ;;
		# Явная настройка человека сильнее любого замера — тот же порядок,
		# что у выбора инструмента в meridian-dns (resolveInstrument):
		# намерение не отменяют пробой.
		*) echo "$_v"; return 0 ;;
	esac
	_calc=$(hold_open_after_calc) && { echo "${_calc%% *}"; return 0; }
	hold_open_floor
}

# hold_open_after_from — ОТКУДА взято число hold_open_after: настройкой,
# процентилем, полом, потолком или запасом без данных. Без этой строки 266 и
# 900 неотличимы по причине человеку, читающему status (правило 47).
hold_open_after_from() {
	_v="${MERIDIAN_ROUTE_HOLD_OPEN:-$(conf_value HOLD_OPEN_AFTER 2>/dev/null)}"
	case "$_v" in
		''|*[!0-9]*) ;;
		*) echo "настройкой HOLD_OPEN_AFTER=$_v"; return 0 ;;
	esac
	_n=$(outages_clean_cached | grep -c .); case "$_n" in ''|*[!0-9]*) _n=0 ;; esac
	_calc=$(hold_open_after_calc) || {
		echo "запас по умолчанию: пропаж в журнале мало ($_n < $(hold_open_min_samples))"
		return 0
	}
	set -- $_calc
	_final=$1; _tag=$2; _raw=$3; _cn=$4
	case "$_tag" in
		floor) echo "замерено: p$(hold_open_percentile)=$_raw с, упёрлось в пол $_final с (пропаж учтено $_cn)" ;;
		ceiling) echo "замерено: p$(hold_open_percentile)=$_raw с, упёрлось в потолок $_final с (пропаж учтено $_cn)" ;;
		*) echo "замерено по процентилю p$(hold_open_percentile): $_final с (пропаж учтено $_cn)" ;;
	esac
}

# hold_policy — closed держит удержание ПОСЛЕ порога, пока человек не
# откроет явно; hold открывает по таймеру САМ. Явная настройка
# (HOLD_POLICY=hold|closed) побеждает всегда, независимо от режима.
#
# УМОЛЧАНИЕ — ПО РЕЖИМУ, не одно на движок. Переписано 16.09.2026: 15.09.2026
# я сделал closed ЕДИНЫМ умолчанием для всего движка, решение принималось
# ПРО БЕЛЫЙ режим (там после порога гаснет весь дом, и выбор — за человеком).
# Применённое к чёрному режиму, то же самое умолчание воспроизводит РЕГРЕССИЮ,
# уже разобранную и исправленную раньше (claude/stop_hold_regressiya_1_26.md,
# замер 1.28: адрес из списка гаснет и остаётся погашенным навсегда, пока
# человек не дойдёт до панели) — только теперь я бы внёс её заново, сознательно
# приняв за улучшение.
#
# Правильная граница — не «движок», а «что гаснет при открытии». В белом
# режиме open отпускает ВЕСЬ ДОМ — цена такая, что решение обязано быть за
# человеком (closed). В чёрном режиме open отпускает только адреса из списка,
# запасной путь остаётся видимым и рабочим — там прежнее умолчание (hold,
# открывается само) уже было проверено и остаётся разумным.
hold_policy() {
	_v="${MERIDIAN_ROUTE_HOLD_POLICY:-$(conf_value HOLD_POLICY 2>/dev/null)}"
	case "$_v" in
		hold|closed) echo "$_v"; return 0 ;;
	esac
	# ПРИЗНАК — РЕЖИМ, А НЕ СЛОЙ. До 10б белый режим существовал только как
	# опытный слой на одно устройство, и признаком служил white_on. Теперь
	# белым бывает САМ режим (mode=white), и умолчание обязано считаться по
	# нему тоже: в белом режиме open отпускает ВЕСЬ ДОМ, и этот размен делает
	# человек, а не движок.
	if white_on || white_home_on; then
		echo closed
	else
		echo hold
	fi
}

# restart_in_progress — идёт ли ПЕРЕЗАПУСК прямо сейчас.
#
# Три случая сведены в два намеренно:
#   * признака нет вовсе — «человек выключил». Так же и на роутере, который
#     обновился с 1.25 и метки не видел ни разу: отсутствие обязано означать
#     остановку, иначе первое же выключение погасит адреса из списка;
#   * признак есть, но ПРОТУХ — тоже «человек выключил», иначе авария между
#     stop и start оставила бы дом в удержании навсегда;
#   * признак есть и свеж — перезапуск, удержание сохраняем.
#
# Метку времени читаем ИЗ ФАЙЛА, а не по mtime: mtime переживает копирование и
# врёт после смены времени на роутере, а число внутри — нет.
restart_in_progress() {
	[ -f "$RESTARTMARK" ] || return 1
	_t=$(cat "$RESTARTMARK" 2>/dev/null)
	case "$_t" in ''|*[!0-9]*) return 1 ;; esac
	_age=$(( $(date +%s) - _t ))
	[ "$_age" -lt 0 ] && return 1
	[ "$_age" -le "$RESTART_TTL" ]
}

# tunnel_observe — ОДНО место, где меняется состояние туннеля и решается судьба
# удержания. Зовётся из периодики и из крючка; чужие вызовы on-tunnel-* только
# добавляют точность момента.
tunnel_observe() {
	_now=$(date +%s)
	_prev=$(tun_field state)
	_since=$(tun_field since)
	_open=$(tun_field open_since)
	_held=$(tun_field held_total)
	_seen=$(tun_field seen)
	case "$_since" in ''|*[!0-9]*) _since=$_now ;; esac
	case "$_held" in ''|*[!0-9]*) _held=0 ;; esac
	case "$_seen" in ''|*[!0-9]*) _seen=$_now ;; esac
	# СУММАРНОЕ время в удержании копим по шагам между проходами. Шаг ограничен
	# сверху: часы могли переехать (NTP на холодной загрузке), и один прыжок не
	# должен разом исчерпать потолок.
	_step=$((_now - _seen))
	[ "$_step" -lt 0 ] && _step=0
	[ "$_step" -gt 300 ] && _step=300

	if iface_exists; then
		if [ "$_prev" = "down" ]; then
			_dur=$((_now - _since))
			[ "$_dur" -lt 0 ] && _dur=0
			outage_record "$_dur"
			if [ -n "$_open" ]; then
				# Возвращаем удержание: пока туннель был мёртв, трафик шёл
				# открытым каналом, и это состояние обязано закончиться вместе
				# с причиной.
				hold_route_up
				log "туннель ВЕРНУЛСЯ через $_dur с — удержание возвращено, открытый канал закрыт"
			else
				log "туннель ВЕРНУЛСЯ через $_dur с"
			fi
			# Отметка «порог пройден» — про ЭТУ пропажу. Туннель вернулся,
			# следующая пропажа начинает отсчёт заново и заслуживает своё
			# собственное объявление, если тоже дойдёт до порога.
			rm -f "$TUNSTATE.thresholdmark" 2>/dev/null
		fi
		[ "$_prev" = "up" ] || tun_state_set up "$_now" "" 0 "$_now"
		return 0
	fi

	# Туннеля нет. Копим суммарное время в удержании — оно нужно, даже когда
	# непрерывный отсчёт сбрасывается морганием канала.
	_held=$((_held + _step))
	if [ "$_prev" != "down" ]; then
		tun_state_set down "$_now" "" 0 "$_now"
		log "туннель ПРОПАЛ (интерфейс $(tun_name) отсутствует) — трафик из списка удерживается. Причина не важна: остановка клиента, перезапуск и падение туннеля здесь одно и то же событие"
		return 0
	fi

	# Уже лежал. Решаем про открытый канал.
	if [ -n "$_open" ]; then
		# Напоминаем, что дом идёт открытым каналом. Раз в 15 минут: молчание
		# здесь опаснее лишней строки — состояние может длиться часами, а
		# первая строка уйдёт из виду за минуты.
		if [ $(( (_now - _open) % 900 )) -lt 60 ] && [ $((_now - _open)) -ge 900 ]; then
			log "НАПОМИНАНИЕ: трафик из списка идёт ОТКРЫТЫМ каналом уже $((_now - _open)) с — туннеля нет с $(rb_human "$_since")"
		fi
		tun_state_set down "$_since" "$_open" "$_held" "$_now"
		return 0
	fi
	if ! wan_alive; then
		# КАНАЛ ПРОВАЙДЕРА ЛЕЖИТ. Открывать нечего: интернета нет ни так, ни
		# этак, а снятые правила дадут утечку в момент возвращения канала.
		# Отсчёт начинается заново, когда канал вернётся.
		tun_state_set down "$_now" "" "$_held" "$_now"
		if [ ! -f "$TUNSTATE.wanwarn" ]; then
			: > "$TUNSTATE.wanwarn" 2>/dev/null
			log "канал провайдера тоже лежит — отсчёт до открытого канала НЕ идёт, остаёмся в удержании"
		fi
		return 0
	fi
	rm -f "$TUNSTATE.wanwarn" 2>/dev/null

	_after=$(hold_open_after)
	_max=$(hold_open_max)
	_elapsed=$((_now - _since))
	# ДВА условия, и второе лечит моргание канала: непрерывный отсчёт при
	# моргании не дойдёт до конца никогда, а суммарное время копится.
	_why=""
	[ "$_elapsed" -ge "$_after" ] && _why="подряд $_elapsed с"
	[ -z "$_why" ] && [ "$_held" -ge "$_max" ] && _why="суммарно $_held с (канал моргал, непрерывный отсчёт сбрасывался)"
	if [ -z "$_why" ]; then
		tun_state_set down "$_since" "" "$_held" "$_now"
		return 0
	fi

	# ПОРОГ ПРОЙДЕН. Что дальше — решает hold_policy, а не движок сам по себе
	# (владелец, 15.09.2026): hold открывает САМ (прежнее поведение, теперь
	# опт-ин), closed (умолчание) остаётся в удержании и только НАЗЫВАЕТ факт,
	# что порог пройден — открыть может только явная команда человека
	# ($0 hold open) или панель.
	if [ "$(hold_policy)" = "hold" ]; then
		rules_ip_remove_hold
		tun_state_set down "$_since" "$_now" "$_held" "$_now"
		log "УДЕРЖАНИЕ СНЯТО ($_why): туннеля нет, канал провайдера жив — трафик из списка идёт ОТКРЫТЫМ каналом до возвращения туннеля"
		return 0
	fi

	# closed: удержание остаётся НА МЕСТЕ. Отметка «порог пройден» — ОДИН раз,
	# не спамить лог каждую минуту, пока человек не решил.
	if [ ! -f "$TUNSTATE.thresholdmark" ]; then
		date +%s > "$TUNSTATE.thresholdmark" 2>/dev/null
		log "ПОРОГ ПРОЙДЕН ($_why): туннеля нет, удержание ОСТАЁТСЯ — трафик из списка не идёт никуда, пока человек не откроет явно: $0 hold open"
	fi
	tun_state_set down "$_since" "" "$_held" "$_now"
	return 0
}

# rb_human — читаемая дата рядом с меткой Unix.
#
# Голая метка 1788550206 человеку не говорит ничего, а показатель существует
# ровно для человека. Метку оставляем: по ней сравнивают и сортируют.
# Способ перевода ВЫБИРАЕТСЯ ПРОБОЙ: `date -d @N` есть в GNU и в части сборок
# BusyBox, `date -D %s -d N` — busybox-специфичный, и обеих может не быть
# (правило 25). Не вышло ни одной — так и говорим, а не печатаем пустоту.
rb_human() {
	_t=$1
	case "$_t" in ''|*[!0-9]*) echo "метка нечисловая"; return 0 ;; esac
	_h=$(date -d "@$_t" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)   # bb-ok: результат проверяется, есть запасные пути
	[ -n "$_h" ] && { echo "$_h"; return 0; }
	_h=$(date -D %s -d "$_t" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)   # bb-ok: то же
	[ -n "$_h" ] && { echo "$_h"; return 0; }
	echo "date этой сборки метку не переводит"
}

# missing — ЧЕГО НЕ ХВАТАЕТ после применения. Зеркало leftovers(), которое
# проверяет снятие; здесь проверяется постановка.
#
# Заведено 04.09.2026. До этого `on` отчитывался об успехе по коду возврата
# своих же вызовов, а вызовы глушили stderr. Когда iptables проиграл гонку за
# замок xtables, цепочка MERIDIAN_MSS не создалась, и `on` сказал «применено».
# Дом остался без подрезки MSS — тихий отказ, который выглядит как работа.
#
# Проверяем ФАКТ, а не то, что мы пытались сделать.
missing() {
	_m=""
	chain_exists   "$CH_MARK" || _m="$_m
цепочка $CH_MARK"
	chain_exists   "$CH_MSS"  || _m="$_m
цепочка $CH_MSS"
	chain_exists_f "$CH_FWD"  || _m="$_m
цепочка $CH_FWD"
	ipt  -C PREROUTING -j "$CH_MARK" || _m="$_m
переход в $CH_MARK"
	ipt  -C FORWARD    -j "$CH_MSS"  || _m="$_m
переход в $CH_MSS"
	iptf -C FORWARD    -j "$CH_FWD"  || _m="$_m
переход в $CH_FWD"
	ipt -S "$CH_MARK" 2>/dev/null | grep -q -- '--match-set' || _m="$_m
правило пометки в $CH_MARK"
	ipt -S "$CH_MARK" 2>/dev/null | grep -q -- '--save-mark' || _m="$_m
сохранение метки в соединение (CONNMARK) в $CH_MARK"
	iptf -S "$CH_FWD" 2>/dev/null | grep -q 'ACCEPT' || _m="$_m
правило транзита в $CH_FWD"
	# Клэмп проверяем только когда интерфейс есть: без него MSS не посчитать,
	# и его отсутствие — не поломка, а «туннель ещё не поднялся».
	if [ -n "$(want_mss)" ]; then
		ipt -S "$CH_MSS" 2>/dev/null | grep -q -- '--set-mss' || _m="$_m
правило клэмпа MSS в $CH_MSS"
	fi
	printf '%s' "$_m" | grep -v '^$' || true
}

rules_remove() {
	jump_drop mangle PREROUTING "$CH_MARK"
	jump_drop mangle FORWARD    "$CH_MSS"
	jump_drop filter FORWARD    "$CH_FWD"
	ipt  -F "$CH_MARK"; ipt  -X "$CH_MARK"
	ipt  -F "$CH_MSS";  ipt  -X "$CH_MSS"
	iptf -F "$CH_FWD";  iptf -X "$CH_FWD"
}

# Счётчик пакетов на нашем правиле метки. Проверять надо ПРОВОДКУ, а не наличие:
# правило может стоять и не срабатывать ни разу, и это не «данных пока нет», а
# поломка (правило 15).
marked_packets() {
	# БЫЛО: первая строка с «match-set». Сегодня в этой цепочке помечающее
	# правило ровно одно, и ключ не врал, — но признак держался на этом и
	# сломался бы от второго правила молча. Считаем по тому, что правило
	# ДЕЛАЕТ, и складываем все такие.
	schyot_pravil "$CH_MARK" "-j MARK --set-xmark $MARK/$MASK" ipt || echo "нет"
}

# Пакеты, которым мы РАЗРЕШИЛИ транзит в туннель. Ноль здесь при ненулевом
# marked_packets означает ровно то, на чём провалилась приёмка 19.08: пометили,
# завернули — и убили в межсетевом экране.
# Ищем по ACCEPT, а не по match-set: с 1.11 правило стоит на МЕТКЕ, набора в
# этой цепочке больше нет. Оставь я здесь match-set — счётчик молча печатал бы
# «нет» навсегда, и это выглядело бы как «данных пока нет», а не как поломка
# (правило 15: датчик, который никто не дёргает).
accepted_packets() {
	# То же самое: правил ACCEPT в цепочке сегодня одно, завтра может быть два.
	schyot_pravil "$CH_FWD" "-j ACCEPT" iptf || echo "нет"
}

# --------------------------------------------------------------------------
# Правила политики и таблица
# --------------------------------------------------------------------------
rule_present() { ip rule show 2>/dev/null | grep -q "^$1:"; }

# IP_WHAT — ЧТО ИМЕННО вернула rules_ip_apply. Раньше здесь было одно слово
# «правила», и после переноса удержания в маршрут оно стало неточным: крючок
# писал «правила восстановлены» там, где вернулось удержание. Своя проверка это
# и поймала. Строка в логе обязана называть предмет, иначе через неделю по ней
# ничего не найти.
IP_WHAT=""

rules_ip_apply() {
	RC=0
	IP_WHAT=""
	rule_present "$PREF_TUN" || { ip rule add fwmark "$MARK/$MASK" lookup "$TABLE" pref "$PREF_TUN" 2>/dev/null && RC=1 && IP_WHAT="$IP_WHAT правило политики;"; }
	# Удержание — МАРШРУТОМ в той же таблице, а не вторым правилом (см. route_up).
	#
	# НО НЕ В СОСТОЯНИИ open. Владелец у правила один: если таймер осознанно снял
	# удержание (туннеля нет, канал провайдера жив), возвращать его здесь значит
	# воевать с самим собой — в логе это выглядело бы как «снято» и
	# «восстановлено» каждую минуту. Поймано собственным стендом.
	if [ -z "$(tun_field open_since)" ]; then
		hold_route_present || { hold_route_up && RC=1 && IP_WHAT="$IP_WHAT удержание (маршрут в таблице $TABLE);"; }
	fi
	# ПЕРЕЕЗД С 1.16 И РАНЬШЕ: на роутере может лежать старое правило 1001.
	# Оно теперь лишнее и вредное — снимаем, иначе после обновления останутся
	# оба механизма сразу, и снятие удержания перестанет работать.
	if rule_present "$PREF_HOLD"; then
		T=0
		while rule_present "$PREF_HOLD"; do
			ip rule del pref "$PREF_HOLD" 2>/dev/null || break
			T=$((T+1)); [ "$T" -gt 10 ] && break
		done
		log "снято старое правило политики $PREF_HOLD: удержание теперь маршрутом в таблице $TABLE"
		RC=1
	fi
	return $((1 - RC))
}

rules_ip_remove() {
	T=0
	while rule_present "$PREF_HOLD"; do
		ip rule del pref "$PREF_HOLD" 2>/dev/null || break
		T=$((T+1)); [ "$T" -gt 10 ] && break
	done
	T=0
	while rule_present "$PREF_TUN"; do
		ip rule del pref "$PREF_TUN" 2>/dev/null || break
		T=$((T+1)); [ "$T" -gt 10 ] && break
	done
}

# route_others — любые маршруты по умолчанию в нашей таблице, КРОМЕ нашего и
# кроме blackhole-удержания (оно тоже default, и слепая уборка убила бы его).
#
# Защита ОДНА и она здесь: якорь `^default`. Строка удержания начинается со
# слова blackhole и под якорь не попадает. Второй предохранитель (пропуск строк
# «blackhole*» в самой уборке) стоял рядом и был снят сознательно: два
# предохранителя от одного дефекта означают, что один из них не проверяется
# ничем — мутация каждого по отдельности оставалась зелёной.
# _rtsnap_or_live <live-команда...> — печатает $_RTSNAP_S, если снимок взят
# (см. rtsnap_capture, только внутри status), иначе выполняет живую команду.
# Общий кусок для route_others()/route_mine_present()/hold_route_present().
_rtsnap_or_live() {
	if [ -n "$_RTSNAP_ON" ]; then
		printf '%s\n' "$_RTSNAP_S"
	else
		"$@"
	fi
}
route_others() {
	_rtsnap_or_live ip route show table "$TABLE" 2>/dev/null | grep '^default' | grep -v "metric $ROUTE_METRIC_TUN\b"
}

# route_present — есть ли НАШ маршрут, с НАШЕЙ метрикой.
#
# Раньше проверялось просто «есть строка default», и это оставляло роутер,
# обновлённый с версии до 1.18, с маршрутом БЕЗ метрики навсегда: route_up при
# «маршрут есть» не звался вовсе. Работало по случайности — ноль меньше двухсот,
# — но значение маршрута зависело от того, с какой версии роутер пришёл.
# Возвращает 0, только когда маршрут ПРАВИЛЬНЫЙ: наш есть, а чужих вариантов
# того же маршрута нет. Иначе route_up не позвался бы вовсе на роутере, где
# рядом с нашим лежит старый безметочный, — и привести к одному значению было
# бы некому.
# route_mine_present — есть ли ИМЕННО НАШ маршрут. Отдельно от route_present,
# потому что вопросов два и они разные: «наш на месте» (это проверяет возврат в
# route_up) и «в таблице порядок» (наш есть, чужих нет). Одна запись условия на
# оба вопроса: две разошлись бы молча.
route_mine_present() {
	_rtsnap_or_live ip route show table "$TABLE" 2>/dev/null | grep -q "^default .*metric $ROUTE_METRIC_TUN\b"
}

route_present() {
	route_mine_present || return 1
	[ -z "$(route_others)" ]
}


iface_exists() { ip link show "$(tun_name)" >/dev/null 2>&1; }

# ДВА МАРШРУТА В ОДНОЙ ТАБЛИЦЕ вместо двух правил политики (пункт 2 белого
# режима, но нужен уже сейчас).
#
# Было: правило 1000 «помеченное — в таблицу 129» и правило 1001 «помеченное — в
# blackhole». Между ними есть состояние, которого не должно существовать:
# удержание снято, правило политики осталось. Тогда помеченный пакет не находит
# маршрута в 129, проваливается в main и уходит в WAN ОТКРЫТЫМ каналом. В чёрном
# режиме это утечка адресов из списка, в белом — утечка ВСЕГО дома.
# Воспроизведено замером.
#
# Стало: правило политики ОДНО, а выбор «туннель или blackhole» делает ядро
# внутри одной таблицы по метрике. Пропал интерфейс — маршрут через него
# перестаёт быть годным, и лукап падает на blackhole В ТОЙ ЖЕ таблице. Состояния
# «правило есть, удержания нет» больше не существует: их нечем рассинхронизировать.
#
# Метрики: 100 у туннеля, 200 у blackhole. Числа явные и с запасом друг от
# друга, чтобы никакая чужая правка не оказалась между ними случайно.
ROUTE_METRIC_TUN=100
ROUTE_METRIC_HOLD=200

route_up() {
	iface_exists || return 1
	# ПОРЯДОК ЗДЕСЬ — НЕ СТИЛЬ. Измерено 05.09.2026 в сетевом пространстве.
	#
	# Было: сначала поставить свой маршрут, потом снять чужие варианты. Это
	# СНИМАЛО СВОЙ ЖЕ маршрут, и вот почему. Строки из route_others у роутеров,
	# обновлённых с версий до 1.18, выглядят как `default dev meridian scope link`
	# — БЕЗ метрики. А спецификация без метрики совпадает с маршрутом ЛЮБОЙ
	# метрики: повторный `ip route del` той же строкой снимает наш metric 100 и
	# возвращает НОЛЬ, то есть молча. Явная `metric 0` не спасает, проверено — она
	# тоже читается как «любая».
	#
	# Повториться del может легко: ensure из периодики и route-up от клиента,
	# оба прочитали список до чужой уборки. Замер с эталоном, 60 проходов по паре
	# одновременных вызовов: прежний порядок — 4 расхождения, новый — 0.
	#
	# Стало: снять чужое, ПОТОМ поставить своё, и в конце сверить СОДЕРЖИМЫМ.
	# Тогда каждый процесс заканчивает установкой, и чей бы del ни пришёл
	# последним, следующий replace его перекрывает.
	#
	# На роутерах без безметочного маршрута route_others пуст, ни одного del не
	# выполняется, и дефект не срабатывал никогда — он бьёт только по пришедшим
	# со старых версий.
	# И СНИМАЕМ ЧУЖИЕ ВАРИАНТЫ ТОГО ЖЕ МАРШРУТА.
	#
	# `ip route replace` с ДРУГОЙ метрикой не заменяет, а ДОБАВЛЯЕТ: метрика
	# входит в ключ маршрута (проверено в netns). Роутер, обновлённый с версии
	# до 1.18, получил бы два маршрута по умолчанию сразу — старый без метрики и
	# новый со сотней. Работает по случайности (ноль меньше двухсот), но значение
	# зависит от того, с какой версии роутер пришёл, а маршрут создаётся в двух
	# местах — командой on и крючком NDM. Однажды кто-то положится на сотню.
	#
	# Через файл, а не через конвейер: `while read` в конвейере крутится в
	# подоболочке, и счётчик наружу не выходит.
	_tmp="$STATE.routes"
	# Пустой список — НЕ повод выходить: установка своего маршрута идёт ниже.
	# В прежней редакции здесь стоял `|| return 0`, и он был безвреден только
	# потому, что установка стояла ВЫШЕ. С новым порядком это был бы выход до
	# главного действия.
	route_others > "$_tmp" 2>/dev/null
	_n=0
	while IFS= read -r _l; do
		[ -n "$_l" ] || continue
		ip route del $_l table "$TABLE" 2>/dev/null && _n=$((_n + 1))
		[ "$_n" -gt 10 ] && break
	done < "$_tmp"
	rm -f "$_tmp" 2>/dev/null
	ip route replace default dev "$(tun_name)" table "$TABLE" metric "$ROUTE_METRIC_TUN" 2>/dev/null || return 1
	# СВЕРКА СОДЕРЖИМЫМ, а не кодом возврата replace (правило 37): именно код
	# возврата и врал в снятом дефекте — del отвечал нулём, сняв не то.
	if ! route_mine_present; then
		ip route replace default dev "$(tun_name)" table "$TABLE" metric "$ROUTE_METRIC_TUN" 2>/dev/null
		if ! route_mine_present; then
			log "ОТКАЗ: маршрут в таблице $TABLE не встаёт — после установки его в таблице нет"
			return 1
		fi
		log "маршрут в таблице $TABLE пришлось ставить второй раз (после первой установки его в таблице не оказалось)"
	fi
	[ "$_n" -gt 0 ] && log "приведён к одному значению маршрут в таблице $TABLE: снято лишних вариантов $_n, оставлен metric $ROUTE_METRIC_TUN"
	return 0
}

# ---------- СЧЁТЧИКИ ПРЕДОХРАНИТЕЛЯ ----------
#
# Заказ владельца 09.09.2026: политика без счётчиков — это порог, выбранный на
# глаз. У нас за двое суток 4 разрыва и 1 самопочин; по пяти событиям порог не
# назначают.
#
# ЧТО ДВИЖОК МОЖЕТ ЗНАТЬ, А ЧТО НЕТ — замерено, а не решено:
#   * last_iface_absent_s и число обрывов — НАШИ: движок сам видит появление и
#     исчезновение интерфейса и пишет журнал обрывов ($OUTAGES, строка на обрыв
#     «<когда> <сколько секунд>»);
#   * rx_silence_* и last_recovery_s — НЕ НАШИ. Тишина эха измеряется по lastRx
#     внутри сессии клиента (qwdtt-client-src/go_client/session_raw.go:259), в
#     памяти процесса; движку она не видна ни через что. Их обязан отдавать
#     клиент, а status — republish, чтобы панель читала ОДНО место.
# Печатать их пустыми, будто мы их знаем, нельзя: пустое значение и «мы этого не
# измеряем» выглядят одинаково, а лечатся по-разному (правило 47).

# hold_state_value — СОСТОЯНИЕ ПРЕДОХРАНИТЕЛЯ ОДНИМ СЛОВОМ, В ОДНОМ МЕСТЕ.
#
# Три состояния, названные словами: hold (держим, откроем по таймеру), open
# (правило снято, дом идёт открытым каналом), closed (держим без срока, выбрал
# человек).
#
# Заведена 09.09.2026: значение печаталось в status двумя ветками if/elif, и
# новое имя whitemode_state пришлось бы вычислять ТРЕТЬЕЙ копией того же
# условия. Две записи одного знания расходятся молча (правило 51), поэтому
# источник теперь один, а имён у него два — hold_state для панели, которая уже
# его читает, и whitemode_state для белого режима.
hold_state_value() {
	[ -n "$(tun_field open_since)" ] && { echo open; return 0; }
	# ЗДЕСЬ — МГНОВЕННОЕ СОСТОЯНИЕ, НЕ ИМЯ ПОЛИТИКИ (правка 15.09.2026).
	# С closed-умолчанием политика неизменна всё время падения туннеля, а
	# состояние — нет: до порога идёт тихое удержание (hold) ровно так же,
	# как и при hold_policy=hold, разница только в том, что случится ПОСЛЕ
	# порога. Слово closed здесь означает «порог пройден и открывать не
	# будем сами», а не «так называется настройка».
	[ -f "$TUNSTATE.thresholdmark" ] && { echo closed; return 0; }
	echo hold
}

# outage_stat — сводка по журналу обрывов. Печатает ключ=значение.
outage_stat() {
	if [ ! -f "$OUTAGES" ]; then
		echo "iface_absent_events="
		echo "last_iface_absent_s="
		echo "iface_absent_total_s="
		return 0
	fi
	outages_clean_cached | awk '
		{ n++; sum += $2; last = $2 }
		END {
			printf "iface_absent_events=%d\n", n
			if (n > 0) printf "last_iface_absent_s=%d\n", last
			else print "last_iface_absent_s="
			printf "iface_absent_total_s=%d\n", sum
		}'
	return 0
}

# hold_notice — ЧЕЛОВЕЧЕСКИМИ СЛОВАМИ, что сейчас с трафиком и что будет дальше.
#
# Строка в журнале для нас, этот ключ — для человека: журнал никто не читает, а
# панель показывает то, что мы дадим. Поэтому здесь названы три вещи сразу —
# факт, срок и последствие, — и во втором случае прямо сказано, что провайдер
# видит адреса. Текст окончательный: панель показывает его дословно, без
# пересказа.
#
# Пусто, когда туннель на месте: показывать нечего, а пустая строка отличима от
# любого сообщения.
hold_notice() {
	iface_exists && return 0
	_hn_since=$(tun_field since)
	case "$_hn_since" in ''|*[!0-9]*) return 0 ;; esac
	_hn_now=$(date +%s)
	_hn_net=$((_hn_now - _hn_since))
	[ "$_hn_net" -lt 0 ] && _hn_net=0
	_hn_open=$(tun_field open_since)
	if [ -n "$_hn_open" ]; then
		printf 'Туннеля нет %s мин. Трафик выбранных сайтов идёт ОТКРЫТЫМ каналом — провайдер видит, куда вы ходите. Это временно и закончится, как только туннель вернётся.' "$((_hn_net / 60))"
		return 0
	fi
	if [ "$(hold_policy)" = "closed" ]; then
		printf 'Туннеля нет %s с. Трафик удерживается и открытым каналом не пойдёт. Чтобы выпустить его напрямую, нужно снять режим: meridian-route off.' "$_hn_net"
		return 0
	fi
	_hn_left=$(( $(hold_open_after) - _hn_net ))
	[ "$_hn_left" -lt 0 ] && _hn_left=0
	printf 'Туннеля нет %s с. Трафик выбранных сайтов удерживается — они не открываются, но и не идут открытым каналом. Через %s с он будет выпущен напрямую, чтобы вы не остались без интернета; когда туннель вернётся, удержание восстановится само.' "$_hn_net" "$_hn_left"
	return 0
}

# hold_route_up — маршрут-удержание. Ставится ВСЕГДА, пока режим включён, даже
# когда интерфейса нет: он и есть то, что не пускает трафик в открытый канал.
hold_route_up() {
	ip route replace blackhole default table "$TABLE" metric "$ROUTE_METRIC_HOLD" 2>/dev/null
}

hold_route_present() {
	_rtsnap_or_live ip route show table "$TABLE" 2>/dev/null | grep -q '^blackhole default'
}

hold_route_down() {
	ip route del blackhole default table "$TABLE" metric "$ROUTE_METRIC_HOLD" 2>/dev/null
	ip route del blackhole default table "$TABLE" 2>/dev/null
	return 0
}

# --------------------------------------------------------------------------
# Крючок NDM. Соглашение снято с соседей на живом роутере (18.08.2026):
# переменные $type (iptables/ip6tables) и $table (mangle/nat), а не аргументы.
# Соседи сначала проверяют, что их движок жив, и молча выходят, если нет, —
# делаем так же: крючок зовётся часто, и он не место для работы.
# --------------------------------------------------------------------------
hook_install() {
	mkdir -p "$HOOKDIR" 2>/dev/null || return 1
	TMP="$HOOK.tmp.$$"
	cat > "$TMP" <<HOOKEOF
#!/bin/sh
# Ставится meridian-route. NDM зовёт этот скрипт после каждой пересборки netfilter.
# По таблице НЕ фильтруем: наши правила живут и в mangle, и в filter (разрешение
# транзита), а какое имя таблицы NDM передаст при пересборке filter — не гарантия.
# Проверка дешёвая: несколько -C и выход, поэтому лишний вызов ничего не стоит.
[ "\$type" = "ip6tables" ] && exit 0
[ -x "$SELF" ] || exit 0
exec $SELF nf-reapply
HOOKEOF
	chmod +x "$TMP" 2>/dev/null
	# НЕУДАЧА НЕ ИМЕЕТ ПРАВА БЫТЬ МОЛЧАНИЕМ.
	#
	# Было: `mv -f … 2>/dev/null` последней строкой, а вызывающий писал
	# `hook_install && WHAT="…"`. Не прошло — WHAT не пополнился, и всё; ensure
	# при этом отдавал 0. Тот же класс, что и ворота выше, только на шаг ниже:
	# показатель говорит «сделано», а не сделано ничего (правило 52).
	if ! mv -f "$TMP" "$HOOK" 2>/dev/null; then
		rm -f "$TMP" 2>/dev/null
		say "ОТКАЗ: крючок $HOOK не установлен — подмена файла не прошла."
		say "  Без него правила не переживут пересборку netfilter прошивкой."
		say "  Проверьте: есть ли каталог $HOOKDIR и место на разделе."
		log "крючок $HOOK НЕ установлен: подмена файла не прошла"
		return 1
	fi
	# СВЕРКА СОДЕРЖИМЫМ, а не кодом возврата mv (правило 37).
	if [ ! -x "$HOOK" ]; then
		say "ОТКАЗ: крючок $HOOK лёг, но не исполняемый — NDM его не позовёт."
		log "крючок $HOOK не исполняемый"
		return 1
	fi
	return 0
}

hook_remove() { rm -f "$HOOK" 2>/dev/null; }

# --------------------------------------------------------------------------
# Периодика (1.6) — раз в минуту вызывает `ensure` сама, своим cron-файлом.
# Не через сторож клиента: тот уже показал разрыв (правило 5 минут, только
# при живом пинге, чужое имя вызова). cron_install идемпотентен: строка с
# CRONMARK — признак «уже стоит», второй вызов её не дублирует.
# --------------------------------------------------------------------------
cron_install() {
	mkdir -p "$(dirname "$CRONFILE")" 2>/dev/null
	[ -f "$CRONFILE" ] || : > "$CRONFILE" 2>/dev/null
	if ! grep -qF "$CRONMARK" "$CRONFILE" 2>/dev/null; then
		# Дописываем в конец, не переписываем файл целиком: в нём могут быть
		# чужие строки (client watchdog, соседи), и переписывание — риск их
		# потерять при гонке с чужой записью в тот же файл.
		echo "* * * * * $SELF ensure >/dev/null 2>&1 # $CRONMARK" >> "$CRONFILE" 2>/dev/null || return 1
	fi
	crond_ensure_running
}

cron_remove() {
	[ -f "$CRONFILE" ] || return 0
	TMP="$CRONFILE.tmp.$$"
	grep -vF "$CRONMARK" "$CRONFILE" > "$TMP" 2>/dev/null
	mv -f "$TMP" "$CRONFILE" 2>/dev/null
	clear_crond_dead_mark
}

# crond_ensure_running — молчаливая деградация недопустима: строка в файле
# ничего не стоит, если её некому читать. Если crond уже жив — просто
# перечитываем расписание (иначе новая строка ждёт следующей перезагрузки).
# Если мёртв — пробуем поднять сами и в любом случае говорим об исходе прямо.
crond_ensure_running() {
	if crond_alive; then
		for c in /opt/etc/init.d/S*cron*; do
			[ -x "$c" ] && "$c" restart >/dev/null 2>&1 && break
		done
		clear_crond_dead_mark
		return 0
	fi
	if crond -c "$(dirname "$CRONFILE")" >/dev/null 2>&1; then
		log "периодика: crond не был запущен, поднял сам ($CRONFILE)"
		clear_crond_dead_mark
		return 0
	fi
	log "!!! ПЕРИОДИКА НЕ УСТАНОВЛЕНА: crond не запускается — строка в $CRONFILE лежит без дела, минутная проверка не идёт"
	return 1
}

# --------------------------------------------------------------------------
# Снимок «до» — нужен и откату, и разбору
# --------------------------------------------------------------------------
snapshot() {
	mkdir -p "$RUNDIR" 2>/dev/null
	{
		# Только -S: iptables-save печатает счётчики прямо в строках политики
		# (`:PREROUTING ACCEPT [708790:346240071]`), и снимок с ними невозможно
		# сравнить — расхождение будет всегда.
		echo "### iptables -t mangle -S"
		iptables -t mangle -S 2>/dev/null
		echo "### iptables -t filter -S"
		iptables -t filter -S 2>/dev/null
		echo "### ip rule"
		ip rule show 2>/dev/null
		echo "### ip route table $TABLE"
		ip route show table "$TABLE" 2>/dev/null
		echo "### ipset -n"
		ipset list -n 2>/dev/null
	} > "$RUNDIR/meridian-route-$1.txt" 2>/dev/null
}

# --------------------------------------------------------------------------
# Команды
# --------------------------------------------------------------------------
cmd_on() {
	CONFIRM="$CONFIRM_DEFAULT"
	while [ $# -gt 0 ]; do
		case "$1" in
			--confirm) CONFIRM="$2"; shift 2 ;;
			--confirm=*) CONFIRM="${1#--confirm=}"; shift ;;
			*) shift ;;
		esac
	done
	case "$CONFIRM" in
		''|*[!0-9]*) fail "--confirm ждёт число секунд, получено «$CONFIRM»" ;;
	esac

	platform_check
	list_check || fail "список не прошёл проверку — ничего не применено"

	if rule_present "$PREF_TUN" && [ "$(state_get mode)" = "black" ]; then
		say "режим уже включён; применяю заново (это безопасно)"
	fi

	snapshot before

	if ! set_load; then
		say "не удалось залить набор — откатываюсь"
		ipset destroy "$SETNEW" 2>/dev/null
		fail "набор не залит, система не тронута"
	fi
	WANT=$(list_count); GOT=$(set_entries)
	if [ "$WANT" != "$GOT" ]; then
		say "в наборе $GOT записей из $WANT — залилось не всё, откатываюсь"
		# Крючок НЕ трогаем: включение не состоялось, а крючок мог стоять от
		# прошлого удачного включения. Он сам себя сдерживает по режиму.
		rules_remove; rules_ip_remove
		ipset destroy "$SET" 2>/dev/null; ipset destroy "$SETNEW" 2>/dev/null
		fail "набор неполон, режим не включён"
	fi

	rules_apply
	rules_ip_apply
	# РАЗГРУЗКА выключается ЗДЕСЬ, вместе с правилами: без этого правила стоят,
	# а транзит рвётся на восьмом пакете — ровно то, что мы ловили весь вечер.
	offload_disable
	fastnat_prop_notice
	hook_install || say "предупреждение: крючок $HOOK не установлен — правила не переживут пересборку netfilter"
	cron_install || say "предупреждение: периодика не установлена — минутная проверка не идёт, см. лог"
	# ИСКЛЮЧЕНИЕ ПО ИМЕНИ VPS — СРАЗУ, НЕ ЖДЁТ СЛЕДУЮЩЕЙ МИНУТЫ ПЕРИОДИКИ.
	# Между `on` и первым `white on` (который зовёт переключение апстрима)
	# может пройти меньше минуты — а замок «DNS в туннеле, имя VPS не
	# резолвится» страшнее, чем цена одного лишнего вызова.
	upstream_exceptions_ensure
	route_up && ROUTE="есть" || ROUTE="нет (интерфейс $(tun_name) не поднят)"

	state_set black no "применено, ждём подтверждения"
	log "включён чёрный режим: записей $(list_count), маршрут в таблице $TABLE: $ROUTE, подтвердить за ${CONFIRM} с"

	armed_stop
	if [ "$CONFIRM" -gt 0 ] 2>/dev/null; then
		DEADLINE=$(( $(date +%s) + CONFIRM ))
		# Сторож ОБЯЗАН пережить смерть родителя: предохранитель нужен ровно
		# тогда, когда оборвался ssh, а вместе с ssh умирает всё, что висит на
		# терминале. setsid, если он есть; иначе двойное отцепление.
		if have setsid; then
			setsid "$SELF" _armed "$DEADLINE" </dev/null >/dev/null 2>&1 &
		elif have nohup; then
			( ( nohup "$SELF" _armed "$DEADLINE" </dev/null >/dev/null 2>&1 & ) & )
		else
			( ( "$SELF" _armed "$DEADLINE" </dev/null >/dev/null 2>&1 & ) & )
		fi
		MISS=$(missing)
		if [ -n "$MISS" ]; then
			say "ПРИМЕНЕНО НЕ ВСЁ. Не встало:"
			printf '%s\n' "$MISS" | sed 's/^/    /'
			say "Чаще всего это гонка за замок xtables. Повторите: $SELF on"
			log "после применения не хватает: $(printf '%s' "$MISS" | tr '\n' ';')"
		fi
		say "Применено. Записей в наборе: $(set_entries). Маршрут: $ROUTE."
		# Молчать об этом нельзя: у человека невыполненный переезд выглядит
		# как «включил и не работает». 04.09.2026 это стоило вечера — chatgpt
		# не открылся, потому что соединение было заведено ДО включения и
		# держалось FASTNAT на прямом канале.
		say "ВАЖНО: уже открытые соединения останутся на прежнем пути."
		say "  Закройте и откройте вкладку либо перезапустите приложение."
		say "ПОДТВЕРДИ за ${CONFIRM} с, иначе всё снимется само:"
		say "    $SELF confirm"
	else
		state_set black yes "применено без подтверждения (--confirm 0)"
		say "Применено без предохранителя (--confirm 0). Записей: $(set_entries)."
	fi
}

cmd_confirm() {
	[ "$(state_get mode)" = "black" ] || fail "подтверждать нечего: режим не включён"
	state_set black yes "подтверждено человеком"
	log "подтверждено человеком — откат отменён"
	say "Принято. Откат отменён, правила остаются."
}

cmd_off() {
	FORCE=0
	[ "$1" = "--force" ] && FORCE=1
	# Сторожа снимаем первым делом: иначе он проснётся позже и снесёт то, что
	# человек к тому времени успел включить заново.
	[ "$FORCE" = 1 ] || armed_stop
	snapshot before-off
	# КРЮЧОК ОСТАЁТСЯ. Раньше он здесь удалялся, и 04.09.2026 это дало вот что:
	# автооткат в 22:30 снял правила и заодно снёс
	# /opt/etc/ndm/netfilter.d/50-meridian-route.sh — движок потерял способность
	# самовосстанавливаться ровно после события, которое эту способность и
	# требует. Возвращал крючок только следующий `on`.
	#
	# Удаление стояло не зря: без него крючок вернул бы правила прямо во время
	# снятия. Но это решается меткой — на время снятия крючок и периодика
	# выходят молча (см. OFFMARK и off_in_progress), — а не сносом файла.
	# Крючок и сам себя сдерживает: он выходит, если режим не black или нет
	# подтверждения. Метка закрывает окно ВНУТРИ снятия, пока состояние ещё
	# прежнее.
	#
	# Снимается крючок только при `purge`, то есть перед сносом пакета.
	echo "$$" > "$OFFMARK" 2>/dev/null
	cron_remove
	rules_remove
	rules_ip_remove
	# Возвращаем ЗАПОМНЕННОЕ, а не единицы: у клиента могло быть выключено и
	# до нас, и вернуть ему «как у всех» — это тоже изменить его роутер.
	offload_restore
	ip route flush table "$TABLE" 2>/dev/null
	# СНИМАЕМ И БЕЛЫЙ РЕЖИМ ДОМА, ПРИ ЛЮБОМ значении mode.
	#
	# Условие выката из замысла: откат на старый движок при mode=white
	# оставляет роутер, у которого правила стоят, а движок их не признаёт
	# своими. Поэтому off не спрашивает, какой сейчас режим, — он снимает всё,
	# что мы умеем ставить.
	white_home_teardown
	out_teardown
	mss_local_teardown
	ipset destroy "$SET" 2>/dev/null
	ipset destroy "$SETNEW" 2>/dev/null
	ipset destroy "$DIRECTSET" 2>/dev/null
	rm -f "$WHITEPREV" "$WHITEHOMESINCE" "$WHITEHOMEDEAD" "$WHITEHOMEARMED" "$AUTOSWITCHACTIVE" 2>/dev/null
	rm -f "$OFFMARK" 2>/dev/null
	# Снятый режим не может быть подтверждённым: иначе следующий `on --confirm`
	# стартует с признаком, который выглядит как уже подтверждённый.
	state_set off no "снято"
	log "чёрный режим снят${FORCE:+ (force=$FORCE)}"

	LEFT=$(leftovers)
	if [ -n "$LEFT" ]; then
		say "СНЯТО НЕ ВСЁ, осталось:"
		printf '%s\n' "$LEFT" | sed 's/^/    /'
		log "после снятия осталось: $(printf '%s' "$LEFT" | tr '\n' ';')"
		[ "$FORCE" = 1 ] && return 0
		return 1
	fi
	say "Снято полностью. Список адресов ($LIST) сохранён — он ваш, а не наш."
	return 0
}

# leftovers — что от нас осталось в системе. Успех снятия определяется ФАКТОМ, а
# не кодами возврата: правило 6 в CLAUDE.md про процесс, здесь то же про правила.
leftovers() {
	{
		ipt  -S 2>/dev/null | grep -e "$CH_MARK" -e "$CH_MSS" -e "$WHITEHOMECHAIN" | sed 's/^/mangle: /'
		iptf -S 2>/dev/null | grep -e "$CH_FWD"                | sed 's/^/filter: /'
		ip rule show 2>/dev/null | grep -e "^$PREF_TUN:" -e "^$PREF_HOLD:" | sed 's/^/ip rule: /'
		ip route show table "$TABLE" 2>/dev/null | sed 's/^/таблица '"$TABLE"': /'
		ipset list -n 2>/dev/null | grep -e "^$SET$" -e "^$SETNEW$" | sed 's/^/набор: /'
		# КРЮЧОК ЗДЕСЬ НЕ СЧИТАЕТСЯ ОСТАТКОМ. С 1.15 `off` его не снимает
		# сознательно: он сам себя сдерживает по режиму, а движку он нужен,
		# чтобы вернуться после автоотката. Считать его «недоснятым» значило бы
		# заставить `off` вечно отвечать «СНЯТО НЕ ВСЁ» — то есть ложным
		# красным, а он приучает не верить прогону не хуже ложного зелёного.
		# В purge крючок проверяется отдельно (leftovers_purge).
		grep -qF "$CRONMARK" "$CRONFILE" 2>/dev/null && echo "периодика: строка в $CRONFILE"
	} 2>/dev/null | grep -v '^$'
}

# leftovers_purge — то же плюс крючок: перед сносом пакета он обязан уйти.
leftovers_purge() {
	leftovers
	[ -f "$HOOK" ] && echo "крючок: $HOOK"
	return 0
}

# ---------- ИСКЛЮЧЕНИЕ АДРЕСА ШЛЮЗА ОТ ОБХОДЧИКА DPI (nfqws) ----------
#
# ЗАЧЕМ. 19.09.2026: nfqws2 на роутере владельца ставил в очередь 500 и
# губил СОБСТВЕННЫЙ UDP клиента к его же шлюзу (порты 443/56004/56005 попали
# в диапазоны обходчика) — клиент годами залипал на худшем пути, и это
# выглядело как блокировка оператора, а била нас наша же DPI-защита.
#
# СТОПГЭП, не решение навсегда: правильное место — SO_MARK в самом клиенте
# (шаг 9), не зависящий ни от какого внешнего списка адресов. Это правило
# снимается целиком, когда шаг 9 обкатан — см. gw_teardown ниже и договор об
# откате движка.
#
# НЕ СВЯЗАНО С ЧЁРНЫМ/БЕЛЫМ РЕЖИМОМ. Ворота may_restore здесь ни при чём:
# это не маршрутизация выбранных адресов в туннель, а защита ТУННЕЛЬНОГО
# ТРАНСПОРТА от локального же обходчика. Правило ничего не рвёт (RETURN/DROP
# нет вовсе, только MARK) — держать его за воротами black-режима значило бы
# резать клиенту связь на роутерах, где чёрный режим не включён никогда.
GWFILE="${MERIDIAN_ROUTE_GWFILE:-/opt/etc/qwdtt/qwdtt-gateway.conf}"
GWSET="${MERIDIAN_ROUTE_GWSET:-meridian_gw4}"
GWSETNEW="${GWSET}_new"
GWMARK="0x40000000"
GWMASK="0x40000000"
GWCOMMENT="meridian-nfqws-stopgap-do-etap9"
# GW_TEARDOWN_WINDOW — окно сбора доказательства для gw-teardown (шаг 10):
# не версия клиента (у него нет флага версии), а факт — пара голых счётчиков
# на трафик к адресам из $GWSET, тот же приём, что на приёмке шага 9.
GW_TEARDOWN_WINDOW="${MERIDIAN_ROUTE_GW_TEARDOWN_WINDOW:-30}"
# Метки подавления — по СМЕНЕ СОСТОЯНИЯ, не по времени (тот же приём, что
# EMPTYMARK/warn_empty_once чуть выше в этом файле): временной порог сорвался
# бы на первой же паузе между ensure (пять минут у сторожа — истечёт раньше,
# чем изменится состояние). Две РАЗНЫЕ метки: «файла нет» — штатное состояние
# на роутере, где клиент ещё не научился его писать; «файл есть, не читается»
# — подозрительное, владелец, 19.09.2026, звучать обязано иначе.
GWNOFILEMARK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.gwnofile"
GWUNREADMARK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.gwunread"

gw_valid_ip() {
	case "$1" in
		*[!0-9.]*) return 1 ;;
	esac
	echo "$1" | grep -qE '^([0-9]{1,3}\.){3}[0-9]{1,3}$'
}

# gw_read_addrs — адреса из файла клиента, построчно, с проверкой каждой
# строки. Печатает НЕВАЛИДНУЮ строку дословно и пропускает её (остальные
# применяются) — владелец, 19.09.2026.
#
# ТРИ СОСТОЯНИЯ ОШИБКИ/ОТСУТСТВИЯ, НЕ ДВА (владелец, 19.09.2026, уточнение
# после первой редакции): «файла нет вовсе» и «файл есть, но не читается» —
# разные факты, и разной степени тревожности. На роутере, где клиент ещё не
# научился писать этот файл, «файла нет» — ШТАТНОЕ состояние навсегда, пока
# не появится клиентская часть; «файл есть, но не читается» (права, ошибка
# ввода-вывода) — подозрительное, файл кто-то создал, а прочитать не даёт.
# Смешивать их в одно «не читается» значило бы через месяц отправить
# человека чинить права на файл, которого попросту нет.
#
#   код 1 — файла НЕТ (`! -e`) — штатно;
#   код 2 — файл ЕСТЬ, но НЕ ЧИТАЕТСЯ (`-e` и не `-r`) — подозрительно;
#   код 0 — прочитан (пуст или с адресами).
#
# Была ещё «qwdtt.stopped стоит — чистим набор явно» — снята 19.09.2026 ДО
# выката, поймано test-route.sh (TestAdminStopDropsHold): чтение $STOPFLAG —
# ровно та конструкция, которую убрали в 1.26 (нельзя отличить «выключено» от
# «идёт перезапуск», stop+start дают на входе то же самое событие). Для ЭТОГО
# случая третье состояние в этом смысле и не нужно: если клиент действительно
# не работает, трафика к шлюзу и так не будет, а оставшаяся метка (только
# MARK, не RETURN и не DROP) ничего не портит и никого не режет.
#
# ДИАГНОСТИКА НЕВАЛИДНОЙ СТРОКИ — В STDERR, НЕ В STDOUT. Вызывающая сторона
# читает stdout ЭТОЙ функции через `$(...)` как СПИСОК АДРЕСОВ; сообщение,
# написанное туда же (say есть просто echo), не терялось бы — оно попало бы В
# ЭТОТ ЖЕ СПИСОК как ложная запись и ушло бы дальше в ipset restore. Поймано
# тестом (TestGwSyncSkipsInvalidLineButKeepsRest) ДО выката: строка «не
# разобран» тонула внутри списка и не доходила до человека.
gw_read_addrs() {
	[ -e "$GWFILE" ] || return 1
	# `-r` одна недостаточна: под root она истинна и для каталога на месте
	# файла (ошибка ввода-вывода при попытке читать, не отсутствие прав) —
	# `-f` отдельно проверяет, что это вообще ОБЫЧНЫЙ файл.
	[ -f "$GWFILE" ] && [ -r "$GWFILE" ] || return 2
	while IFS= read -r _gwl || [ -n "$_gwl" ]; do
		_gwl=$(printf '%s' "$_gwl" | tr -d '[:space:]')
		[ -n "$_gwl" ] || continue
		if gw_valid_ip "$_gwl"; then
			echo "$_gwl"
		else
			echo "ensure: адрес шлюза в $GWFILE не разобран: \"$_gwl\" — исключение для него НЕ ПОСТАВЛЕНО" >&2
		fi
	done < "$GWFILE"
	return 0
}

# gw_set_sync — набор РОВНО как файл, атомарно (тот же приём, что keep_build:
# наполняем в стороне, потом swap — momента с пустым набором нет).
gw_set_sync() {
	_gwaddrs=$(gw_read_addrs)
	_gwrc=$?
	case "$_gwrc" in
	1)
		# Файла нет — штатно, пока клиент не научился его писать. Подавлено
		# по смене состояния: иначе строка печаталась бы на КАЖДОМ ensure
		# бесконечно, пока эта клиентская часть не будет сделана.
		if [ ! -f "$GWNOFILEMARK" ]; then
			: > "$GWNOFILEMARK" 2>/dev/null
			say "ensure: адрес шлюза от клиента ещё не получен ($GWFILE не существует) — исключение от обходчика DPI не действует"
		fi
		rm -f "$GWUNREADMARK" 2>/dev/null
		return 1
		;;
	2)
		# Файл ЕСТЬ, но не читается — подозрительно: кто-то его создал, а
		# прав/доступа нет. Отдельная метка подавления — своя, не общая с
		# «файла нет», чтобы переход между этими двумя состояниями заново
		# показал громкую строку для НОВОГО состояния, а не молчал по чужой.
		if [ ! -f "$GWUNREADMARK" ]; then
			: > "$GWUNREADMARK" 2>/dev/null
			say "ensure: файл адреса шлюза $GWFILE ЕСТЬ, но НЕ ЧИТАЕТСЯ (права? ошибка ввода-вывода?) — набор $GWSET НЕ ТРОГАЮ (прежнее исключение остаётся в силе)"
		fi
		rm -f "$GWNOFILEMARK" 2>/dev/null
		return 1
		;;
	esac
	# Прочитан успешно — обе метки снимаем: следующий уход в любое из двух
	# состояний выше обязан прозвучать заново, а не молчать по старой метке.
	rm -f "$GWNOFILEMARK" "$GWUNREADMARK" 2>/dev/null
	if [ -z "$_gwaddrs" ]; then
		say "ensure: адрес шлюза от клиента ещё не получен ($GWFILE пуст) — исключение от обходчика DPI НЕ ДЕЙСТВУЕТ"
	fi
	ipset destroy "$GWSETNEW" 2>/dev/null
	ipset create "$GWSETNEW" hash:ip family inet 2>/dev/null || return 1
	if [ -n "$_gwaddrs" ]; then
		printf '%s\n' "$_gwaddrs" | sed "s|^|add $GWSETNEW |" | ipset restore 2>/dev/null
	fi
	set_exists "$GWSET" || ipset create "$GWSET" hash:ip family inet 2>/dev/null
	ipset swap "$GWSETNEW" "$GWSET" 2>/dev/null
	ipset destroy "$GWSETNEW" 2>/dev/null
	return 0
}

# gw_rule_line ЦЕПОЧКА — ОДНА И ТА ЖЕ строка на постановку/проверку/снятие,
# комментарий включён. Разные строки для этих трёх операций — путь к дублям,
# накапливающимся на каждом ensure (владелец, 19.09.2026).
gw_rule_line() {
	case "$1" in
		POSTROUTING) echo "-m set --match-set $GWSET dst -j MARK --set-xmark $GWMARK/$GWMASK -m comment --comment $GWCOMMENT" ;;
		PREROUTING)  echo "-m set --match-set $GWSET src -j MARK --set-xmark $GWMARK/$GWMASK -m comment --comment $GWCOMMENT" ;;
	esac
}
gw_nfqws_target() {
	case "$1" in
		POSTROUTING) echo nfqws_post ;;
		PREROUTING)  echo nfqws_pre ;;
	esac
}

# gw_rules_apply — условие «стою РАНЬШЕ перехода в nfqws_post/nfqws_pre», а
# НЕ «стою на позиции 1». Первая редакция (19.09.2026) снимала и переставляла
# правило на позицию 1 БЕЗУСЛОВНО, каждый вызов — если рядом есть ЧУЖОЙ
# компонент, тоже держащийся за позицию 1, оба ensure-цикла переставляли бы
# друг друга бесконечно, и это чистый шум в логе без единой настоящей причины
# (владелец, 19.09.2026, поймано ДО выката). Действие — только когда условие
# ДЕЙСТВИТЕЛЬНО нарушено: правила нет, оно не то (снято/подменено кем-то), или
# переход в обходчик оказался раньше него. Иначе — ничего не трогаем.
#
# Снимаем старые копии ПО НАБОРУ В ПРАВИЛЕ, а не по байт-в-байт совпадению
# всей строки: правило в чуть другом виде (без комментария, другой порядок
# ключей) обязано быть ЗАМЕНЕНО, а не остаться рядом второй копией — но это
# СНЯТИЕ выполняется только внутри уже принятого решения «действие нужно»,
# не на каждом проходе.
#
# НАБОР ОБЯЗАН СУЩЕСТВОВАТЬ, ИНАЧЕ НЕ СТАВИМ ПРАВИЛО ВООБЩЕ. `iptables -m set
# --match-set` на несуществующий ipset — ошибка ядра (xt_set), не «правило
# ни на что не похоже, но безвредно». На свежем роутере, где клиент ещё не
# написал файл адреса (gw_set_sync отказался создавать набор — состояние
# «файл не читается», см. gw_read_addrs), эта строка молча провалилась бы
# (`2>/dev/null` ниже съел бы ошибку), и не было бы ни правила, ни объяснения
# почему. Стенд ЭТОГО не ловит: подделка iptables не проверяет существование
# набора в --match-set вовсе — разница между стендом и роутером, а не дефект
# стенда (роутер строже подделки, не наоборот).
gw_rules_apply() {
	set_exists "$GWSET" || return 0
	for _gwch in POSTROUTING PREROUTING; do
		_gwline=$(gw_rule_line "$_gwch")
		_gwtgt=$(gw_nfqws_target "$_gwch")
		_gwexact=$(iptables -t mangle -S "$_gwch" 2>/dev/null | grep -n -F -x -- "-A $_gwch $_gwline" | head -1 | cut -d: -f1)
		_gwjpos=""
		[ -n "$_gwtgt" ] && _gwjpos=$(iptables -t mangle -S "$_gwch" 2>/dev/null | grep -n -- "-j $_gwtgt\$" | head -1 | cut -d: -f1)

		if [ -n "$_gwexact" ] && { [ -z "$_gwjpos" ] || [ "$_gwexact" -lt "$_gwjpos" ]; }; then
			continue	# правило верно и уже раньше обходчика (или обходчика нет) — не трогаем
		fi

		if [ -n "$_gwexact" ] && [ -n "$_gwjpos" ]; then
			say "ensure: переход в $_gwtgt в $_gwch оказался РАНЬШЕ нашего исключения (строка $_gwjpos <= $_gwexact) — переставляю"
		fi

		while :; do
			_gwspec=$(iptables -t mangle -S "$_gwch" 2>/dev/null | grep -- "--match-set $GWSET " | head -1 | sed "s|^-A $_gwch ||")
			[ -n "$_gwspec" ] || break
			iptables -t mangle -D "$_gwch" $_gwspec 2>/dev/null || break
		done
		iptables -t mangle -I "$_gwch" 1 $_gwline 2>/dev/null
	done
}

# white_position_ensure — наш прыжок ОБЯЗАН быть ПОСЛЕДНИМ среди помечающих
# в PREROUTING (CH_MARK движка, цепочка DNS). RETURN из MERIDIAN_WHITE снимает
# нашу метку и возвращает пакет в PREROUTING; если ниже нас стоит ещё одна
# помечающая цепочка, она поставит метку заново, и исключение перестанет
# что-либо значить (0 из 136 сегодня, но meridian_direct4 в белом режиме
# наполняет человек — пересечение станет вопросом времени).
#
# DNS сам за позицией не следит вовсе (markchain.go: JumpPresent — это `-C`,
# не `-D`+`-A`, позиция после первой установки не меняется никогда), поэтому
# однажды переставленные — мы останемся последними, пока DNS не переустановят
# заново на чистом PREROUTING. GWMARK держится верха и трогает другой бит
# (0x40000000/бит 30, не пересекается с нашим 0x1ff) — нижний край, где стоим
# мы, им не оспаривается.
#
# Действие — ТОЛЬКО когда порядок ДЕЙСТВИТЕЛЬНО нарушен (тот же приём, что у
# gw_rules_apply): иначе два независимых ensure-цикла переставляли бы друг
# друга бесконечно на пустом месте.
white_position_ensure() {
	# ВОРОТА ПО СОСТОЯНИЮ, А НЕ ПО ЦЕПОЧКЕ — и это главное свойство функции
	# для парка: и white_on, и white_home_on читают ФАЙЛ, а не iptables.
	# На одиннадцати роутерах, где белого нет и не будет, отсюда не уходит
	# НИ ОДНОГО вызова iptables, даже читающего.
	_wch=""
	white_on && _wch="$WHITECHAIN"
	# АКТИВНАЯ ПОЛОВИНА, НЕ БАЗОВОЕ ИМЯ (1.70): $WHITEHOMECHAIN сам по себе
	# больше не физическая цепочка, её никогда не бывает в PREROUTING.
	white_home_on && _wch=$(white_home_active_chain)
	[ -n "$_wch" ] || return 0
	have iptables || return 0
	_wpos=$(iptables -t mangle -S PREROUTING 2>/dev/null | grep -n -- "-j $_wch\$" | head -1 | cut -d: -f1)
	[ -n "$_wpos" ] || return 0
	_below=""
	for _ch in "$CH_MARK" "$DNSMARKCHAIN"; do
		[ -n "$_ch" ] || continue
		_p=$(iptables -t mangle -S PREROUTING 2>/dev/null | grep -n -- "-j $_ch\$" | head -1 | cut -d: -f1)
		[ -n "$_p" ] || continue
		[ "$_p" -gt "$_wpos" ] 2>/dev/null && _below="$_below $_ch(стр.$_p)"
	done
	[ -n "$_below" ] || return 0
	say "ensure: ниже $_wch (стр.$_wpos) появилось помечающее:$_below — переставляю в конец PREROUTING"
	while ipt -C PREROUTING -j "$_wch" 2>/dev/null; do
		ipt -D PREROUTING -j "$_wch" 2>/dev/null || break
	done
	ipt -A PREROUTING -j "$_wch" 2>/dev/null
	log "white_position_ensure: $_wch переставлен в конец PREROUTING (было ниже:$_below)"
}

# gw_verify_mark — истина о смысле метки не в нашей памяти, а в ЖИВЫХ правилах
# обходчика (владелец, 19.09.2026: скрипт мог смениться с момента публикации,
# сверять надо с тем, что реально стоит). Отсутствие цепочек nfqws_* — НЕ
# отказ: обходчика на роутере может не быть вовсе, правило от этого не хуже.
gw_verify_mark() {
	chain_exists nfqws_pre
	case $? in
		1) return 0 ;;
		2) return 0 ;;
	esac
	if ! ipt -S nfqws_pre 2>/dev/null | grep -q -- "$GWMARK"; then
		say "ensure: ОБХОДЧИК DPI БОЛЬШЕ НЕ РАСПОЗНАЁТ МЕТКУ $GWMARK — исключение НЕ ДЕЙСТВУЕТ, сверить с /opt/etc/init.d/S51nfqws2 (MARK_PROCESSED)"
		return 1
	fi
	return 0
}

# gw_ensure — точка входа, зовётся из cmd_ensure ДО ворот may_restore.
gw_ensure() {
	have ipset || return 0
	gw_set_sync
	gw_rules_apply
	gw_verify_mark
}

# gw_teardown — снятие СТОПГЭПА ЦЕЛИКОМ, когда шаг 9 (SO_MARK в клиенте)
# обкатан и это правило больше не нужно. Не вызывается ниоткуда сама —
# отдельная ручная команда, чтобы не снять защиту раньше времени.
gw_teardown() {
	for _gwch in POSTROUTING PREROUTING; do
		while :; do
			_gwspec=$(iptables -t mangle -S "$_gwch" 2>/dev/null | grep -- "--match-set $GWSET " | head -1 | sed "s|^-A $_gwch ||")
			[ -n "$_gwspec" ] || break
			iptables -t mangle -D "$_gwch" $_gwspec 2>/dev/null || break
		done
	done
	ipset destroy "$GWSET" 2>/dev/null
	say "gw_teardown: правила и набор $GWSET сняты"
}

# cmd_gw_teardown — глагол gw-teardown. Снятие стопгэпа НЕ на доверии к
# версии клиента (у него нет флага версии, проверить нечем), а на
# ДОКАЗАТЕЛЬСТВЕ: та же пара голых счётчиков на трафик к адресам из $GWSET,
# что отработала на приёмке шага 9 руками, теперь автоматически. Снятие
# разрешено, только если ПОМЕЧЕННЫХ БОЛЬШЕ НУЛЯ И НЕПОМЕЧЕННЫХ РОВНО НОЛЬ —
# иначе стопгэп остаётся, потому что живой nfqws против непомеченного
# туннеля хуже, чем лишняя ручная проверка. Полминуты на роутер честнее,
# чем дисциплина по 11 роутерам вручную.
cmd_gw_teardown() {
	have iptables || { say "ОТКАЗ: нет iptables"; return 1; }
	set_exists "$GWSET" || { say "gw-teardown: набора $GWSET нет — снимать нечего"; return 0; }
	if [ "$(ipset list "$GWSET" 2>/dev/null | sed -n '/^Members:/,$p' | grep -vc '^Members:')" -eq 0 ] 2>/dev/null; then
		say "ОТКАЗ: набор $GWSET пуст — доказать нечем, стопгэп ОСТАВЛЕН"
		return 1
	fi
	_pc="MERIDIAN_GWPROOF"
	ipt -F "$_pc" 2>/dev/null
	ipt -X "$_pc" 2>/dev/null
	ipt -N "$_pc" 2>/dev/null
	ipt -A "$_pc" -p udp -m set --match-set "$GWSET" dst -m mark --mark "$GWMARK/$GWMASK"
	ipt -A "$_pc" -p udp -m set --match-set "$GWSET" dst -m mark ! --mark "$GWMARK/$GWMASK"
	if ! ipt -I POSTROUTING 1 -j "$_pc" 2>/dev/null; then
		say "ОТКАЗ: пробную цепочку не удалось подключить — не измеряю вслепую"
		ipt -F "$_pc" 2>/dev/null; ipt -X "$_pc" 2>/dev/null
		return 1
	fi
	if ! ipt -C POSTROUTING -j "$_pc" 2>/dev/null; then
		say "ОТКАЗ: переход на пробную цепочку не подтверждён — не измеряю вслепую"
		ipt -F "$_pc" 2>/dev/null; ipt -X "$_pc" 2>/dev/null
		return 1
	fi
	say "gw-teardown: жду ${GW_TEARDOWN_WINDOW}с доказательства (клиент должен слать трафик к шлюзу прямо сейчас)"
	sleep "$GW_TEARDOWN_WINDOW"
	# Разбор ПО СОДЕРЖИМОМУ ("mark match !"/"mark match 0x"), а не по номеру
	# строки: у -L разное число заголовочных строк на разных iptables, а этот
	# же приём уже подтверждён на живом роутере в приёмке шага 9 (парный
	# счётчик клиента).
	_gwout=$(iptables -t mangle -L "$_pc" -v -n -x 2>/dev/null)
	_marked=$(printf '%s\n' "$_gwout" | awk '/mark match !/{next} /mark match 0x/{print $1; exit}')
	_unmarked=$(printf '%s\n' "$_gwout" | awk '/mark match !/{print $1; exit}')
	ipt -D POSTROUTING -j "$_pc" 2>/dev/null
	ipt -F "$_pc" 2>/dev/null
	ipt -X "$_pc" 2>/dev/null
	_marked="${_marked:-0}"
	_unmarked="${_unmarked:-0}"
	say "gw-teardown: доказательство — помечено=$_marked непомечено=$_unmarked"
	if [ "$_marked" -gt 0 ] 2>/dev/null && [ "$_unmarked" -eq 0 ] 2>/dev/null; then
		gw_teardown
		log "gw-teardown: доказательство принято (помечено=$_marked непомечено=$_unmarked) — стопгэп снят"
		say "СНЯТО: помеченный трафик подтверждён, непомеченного нет."
		return 0
	fi
	log "gw-teardown: ОТКАЗ (помечено=$_marked непомечено=$_unmarked) — стопгэп ОСТАВЛЕН"
	say "ОТКАЗ: доказательство не сошлось — стопгэп ОСТАВЛЕН. Проверьте клиент на этом роутере (SO_MARK, шаг 9)."
	return 1
}

# cmd_ensure — привести систему в соответствие с состоянием. Идемпотентно и
# МОЛЧА, когда всё уже так: иначе получим строку в лог каждые пять минут навсегда.
cmd_ensure() {
	# ОДИН ensure ЗА РАЗ — ПЕРВЫМ ДЕЙСТВИЕМ, ДО ВСЕГО ОСТАЛЬНОГО (владелец,
	# 21.09.2026, живой роутер). Живой предыдущий — выходим сразу, молча и
	# кодом 0: крон глушит вывод (>/dev/null 2>&1) всё равно, «занято» и
	# «отказ» выглядели бы для него одинаково, а лог видит оба.
	ensure_lock_acquire || {
		log "ensure: предыдущий экземпляр ещё выполняется — выхожу"
		return 0
	}
	# ФЛАГ, НЕ СВОЙ trap: снятие замка делает ОБЩИЙ _on_exit_cleanup (конец
	# файла) — второй `trap ... EXIT` здесь молча стёр бы его.
	_ENSURE_LOCKED=1
	# КЭШ meridian-dns ДЛЯ status — ОДИН РАЗ ЗА ЭТОТ ЗАПУСК, РАНО: то же
	# значение потом переиспользуют keep_dns()/dns_direct_sets() внутри
	# ЭТОГО ЖЕ процесса (dns_status_live кэширует на процесс) — второго
	# живого обращения к meridian-dns этот ensure не сделает.
	dns_status_cache_refresh
	# То же самое: cron_line=yes говорит «строка стоит», ensure_runs — «её
	# действительно зовут». Пять минут ожидания в блоке приёмки мы как раз и
	# тратили на то, чтобы узнать второе косвенно.
	hod_plyus "$ENSURERUNS"
	# Исключение от обходчика — ДО ворот: это не про маршрутизацию в туннель,
	# ворота black-режима здесь не к месту (см. блок выше).
	if have iptables && have ipset; then
		gw_ensure
		white_position_ensure
	fi
	# Правила, отрезавшие человека от роутера, не имеют права вернуться сами —
	# ни после перезагрузки, ни из watchdog. Что считается «сами», решают ворота
	# (may_restore): окно подтверждения — не «сами», там человек смотрит.
	# ТРИ ПРИЧИНЫ ОДНОГО НУЛЯ ЧИТАЮТСЯ РАЗДЕЛЬНО.
	#
	# 09.09.2026, пилот на arm64: движок ставили впервые, `ensure` вернул 0 и не
	# поставил ни крючок, ни периодику. Приёмка считала ноль доказательством
	# установки — а он пришёл от ВОРОТ: mode пуст, `on` не звали. Ноль от ворот
	# и ноль от работы выглядели одинаково (правило 52, записанное мной же
	# 06.09 и не проверенное на собственном экземпляре).
	#
	# Печатаем через say, а НЕ в журнал: периодика зовёт нас раз в минуту
	# строкой `... ensure >/dev/null 2>&1`, вывод уходит в никуда. Строка в
	# журнал стала бы потоком на каждом роутере с выключенным режимом —
	# ровно утечка из правила 21. Человеку, запустившему ensure руками, видно.
	if ! may_restore; then
		say "ensure: НЕ ПУСТИЛИ ВОРОТА — ничего не делал."
		say "  $(vorota_stroka)"
		say "  интерфейс $(tun_name): $(iface_exists && echo есть || echo нет)"
		say "  Это НЕ ошибка: правил не применено, возвращать нечего, крючок и"
		say "  периодика не ставятся намеренно. Сначала: $0 on, затем $0 confirm."
		return 0
	fi
	# ВОССТАНОВЛЕНИЕ РЕЖИМА ДОМА — ПОСЛЕ ВОРОТ, а не до них.
	#
	# Найдено мутацией 20.09.2026: сначала вызов стоял рядом с gw_ensure, то
	# есть ДО may_restore. Для gw_ensure это верно (он не про маршрутизацию в
	# туннель), а для белого режима — нет: пока человек снимает режим, стоит
	# метка OFFMARK, may_restore закрыт именно ради этого окна, и вызов до
	# ворот возвращал бы цепочку ровно во время её снятия. Мутация «вернуть
	# may_restore к одному чёрному» пережила тест, потому что вызов её не
	# спрашивал — это и вскрыло порядок.
	white_home_ensure
	# СЛОЙ «СВОЙ DNS РОУТЕРА» — ТАМ ЖЕ И ПО ТОЙ ЖЕ ПРИЧИНЕ: после ворот
	# may_restore, а не до них. Пока человек снимает режим, стоит OFFMARK, и
	# возвращать цепочку ровно во время её снятия нельзя.
	out_ensure
	# ИСКЛЮЧЕНИЕ ПО ИМЕНИ VPS — ВСЕГДА, НЕЗАВИСИМО ОТ СЛОЯ out. Файл обязан
	# быть готов ДО первого upstream clean-only, а не после первого out on:
	# переключатель апстрима живёт в движке отдельно от слоя out (это
	# следующий кусок шага 11) и может быть позван раньше.
	upstream_exceptions_ensure
	# ЖУРНАЛ ПЕРЕХОДОВ — КАЖДЫЙ ЦИКЛ ПЕРИОДИКИ, НЕЗАВИСИМО ОТ РЕЖИМА (10б-2,
	# пункт 1). Замер N/M и будущий суточный потолок автомата читают этот
	# журнал независимо от того, включён ли уже сам автопереход.
	transitions_ensure
	if ! have iptables || ! have ipset || ! have ip; then
		say "ensure: НЕТ ИНСТРУМЕНТА — ничего не делал."
		say "  iptables: $(have iptables && echo есть || echo НЕТ); ipset: $(have ipset && echo есть || echo НЕТ); ip: $(have ip && echo есть || echo НЕТ)"
		return 0
	fi
	# АВТОПЕРЕХОД 10б-2 — ЗДЕСЬ, ДО проверки «список пуст» НИЖЕ (1.83).
	# Белый дом маршрутизирует ДОМАШНИЕ СЕТИ, не список/доменные группы —
	# пустой список не повод молчать автомату: на роутере, который живёт
	# только белым режимом, список может быть пуст всегда, и ранний return
	# ниже никогда не давал бы автомату шанса сработать.
	autoswitch_ensure
	# СВЕЖЕСТЬ KEEP — раз в минуту, независимо от списка/доменных групп ниже:
	# keep нужен под white-test уже сегодня (он тоже требует чёрный режим
	# подтверждённым — ту же дверь, что открыла нас в этот код) и под белый
	# режим завтра. Отпечаток дешёвый, пересборка — только при изменении входа
	# (шаг 3 обновлённого порядка работ, 15.09.2026). Результат не влияет на
	# остальной ensure: неудача здесь не должна мешать применению правил ниже.
	keep_refresh_if_stale
	if list_empty && ! dns_has_sets; then
		say "ensure: ПОМЕЧАТЬ НЕЧЕГО — ничего не делал."
		say "  адресов в списке 0, доменных групп с пометкой 0"
		warn_empty_once
		return 0
	fi
	clear_empty_mark

	# СОСТОЯНИЕ ТУННЕЛЯ — ПЕРВЫМ ДЕЛОМ, до применения правил. Порядок не
	# стилистический: rules_ip_apply смотрит на состояние (в open удержание не
	# возвращается), и спрашивать его надо у свежего значения, а не у вчерашнего.
	# Первый заход стенда поймал обратный порядок: таймер снимал удержание, а
	# rules_ip_apply тем же проходом возвращал — и так каждую минуту.
	tunnel_observe

	# Учёт раздельный, как в крючке: «восстановлено что-то» в логе через неделю
	# означает, что искать придётся заново. Пишем, ЧТО именно вернули.

	WHAT=""
	UNSURE_NOTE=""
	set_exists "$SET" || { set_load && WHAT="$WHAT набор (${LAST_LOAD_MS:-?} мс);"; }

	# СХОЖДЕНИЕ ПЕРЕД ПРИМЕНЕНИЕМ: сначала убираем лишние копии, потом ставим
	# недостающее. Обратный порядок оставил бы только что поставленное правило
	# кандидатом на снятие в этом же проходе.
	_dedup=$(rules_dedup)
	case "$_dedup" in ''|*[!0-9]*) _dedup=0 ;; esac
	[ "$_dedup" -gt 0 ] && WHAT="$WHAT снято лишних копий: $_dedup;"

	# Прошивка возвращает свои настройки при пересборке — мы это видели весь
	# вечер на цепочках. Значит ручки надо поддерживать, а не выставить раз.
	offload_disable && WHAT="$WHAT разгрузка выключена;"

	rules_apply
	case $? in
		0) WHAT="$WHAT правила;" ;;
		2) UNSURE_NOTE="часть проверок iptables не удалась (обычно занят замок xtables) — НИЧЕГО не добавлял" ;;
	esac
	rules_ip_apply  && WHAT="$WHAT правила политики;"
	if [ ! -f "$HOOK" ]; then
		if hook_install; then
			WHAT="$WHAT крючок;"
		else
			say "ensure: крючок поставить НЕ УДАЛОСЬ (причина выше)"
		fi
	fi
	grep -qF "$CRONMARK" "$CRONFILE" 2>/dev/null || { cron_install && WHAT="$WHAT периодика;"; }
	# Срок удержания начинается здесь: правил не снимаем ни при каком условии
	# (это отдельно, по имени, а не по коду возврата — см. rules_ip_remove,
	# который отсюда никогда не зовётся), только фиксируем ФАКТ и МОМЕНТ, чтобы
	# было что показать в status. Момент — один раз за переход, не на каждый
	# проход: без guard'а на существование файла длительность блокировки была
	# бы вечным нулём.
	# Состояние туннеля уже снято выше, до применения правил (tunnel_observe).
	# Здесь остался только BLOCKEDMARK — старый показатель для панели.
	if iface_exists; then
		if [ -f "$BLOCKEDMARK" ]; then
			rm -f "$BLOCKEDMARK" 2>/dev/null
		fi
		if ! route_present; then
			route_up && WHAT="$WHAT маршрут в таблице $TABLE;"
		fi
	elif [ ! -f "$BLOCKEDMARK" ]; then
		date +%s > "$BLOCKEDMARK" 2>/dev/null
	fi
	[ -n "$WHAT" ] && log "ensure: восстановлено —$WHAT"
	# «Не смог проверить» — ОТДЕЛЬНАЯ строка и с подавлением повторов: при
	# устойчиво занятом замке она печаталась бы каждый проход навсегда
	# (правило 21). Ключ подавления — постоянная метка, а не текст.
	if [ -n "$UNSURE_NOTE" ]; then
		if [ ! -f "$UNSUREMARK" ]; then
			date +%s > "$UNSUREMARK" 2>/dev/null
			log "ensure: $UNSURE_NOTE"
		fi
	else
		[ -f "$UNSUREMARK" ] && rm -f "$UNSUREMARK" 2>/dev/null
	fi
	return 0
}

# off_in_progress — жив ли процесс, который сейчас снимает правила.
# Метка без проверки живости — это вечная блокировка после первого же убитого
# процесса; проверяем по /proc, а не по времени файла (правило 25: `find -mmin`
# на этом BusyBox может не быть).
# our_process_alive <номер> — жив ли процесс И НАШ ЛИ ОН.
#
# Одного [ -d /proc/PID ] мало. На этом роутере счётчик номеров переполняется
# (в один день видели meridian-dns pid 31393 и qwdtt pid 1874 — номера пошли по
# второму кругу), значит номер переиспользуется, и «файл есть, каталог в /proc
# есть» однажды означает ЧУЖОЙ процесс. Тогда мы решим, что наш ещё работает,
# когда его давно нет: вечная блокировка снятия или вечно «живой»
# предохранитель. Читаем cmdline и требуем в нём своё имя — одно чтение.
#
# cmdline разделён нулевыми байтами; tr переводит их в переносы, иначе grep
# видит одну длинную строку и на коротких аргументах может совпасть случайно.
our_process_alive() {
	case "${1:-}" in ''|*[!0-9]*) return 1 ;; esac
	[ -d "/proc/$1" ] || return 1
	tr '\0' '\n' < "/proc/$1/cmdline" 2>/dev/null | grep -q "$SELFNAME"
}

off_in_progress() {
	_p=$(cat "$OFFMARK" 2>/dev/null)
	case "$_p" in ''|*[!0-9]*) rm -f "$OFFMARK" 2>/dev/null; return 1 ;; esac
	our_process_alive "$_p" && return 0
	rm -f "$OFFMARK" 2>/dev/null
	return 1
}

# armed_alive — жив ли предохранитель, ждущий подтверждения.
# Проверка через our_process_alive, а не через [ -d /proc/PID ]: номера
# процессов на этом роутере переиспользуются.
armed_alive() {
	our_process_alive "$(cat "$ARMEDPID" 2>/dev/null)"
}

# --------------------------------------------------------------------------
# ВОРОТА. ОДНА функция на всё, что мы возвращаем: и правила, и маршрут.
#
# Зачем одна: условие «чёрный режим и подтверждено» стояло тремя отдельными
# копиями (ensure, крючок NDM, on-tunnel-up). Копии условия расходятся, и
# расходятся молча — мы это ловили уже дважды (правило 43: сторож у одной двери,
# а дверей несколько).
#
# ПОЧЕМУ ОКНО ПОДТВЕРЖДЕНИЯ ПУСКАЕТ. Пока человек не подтвердил (120 с),
# confirmed=no, и раньше не возвращалось НИЧЕГО: ни правила, ни маршрут. А
# прошивка Keenetic пересобирает правила именно тогда, когда человек дёргает
# панель — измерено на роутере владельца 05.09.2026: ШЕСТЬ пересборок за
# двадцать две секунды, все внутри окна. Пересборка стирает цепочки, крючок по
# строгим воротам отказывался их вернуть, разметки не было — и человек видел
# «не работает» и откатывал РАБОТАЮЩЕЕ.
#
# Возврат в окне ничего нового не открывает: правила и маршрут применены прямой
# командой человека секунды назад, и он прямо сейчас на них смотрит.
#
# Гарантию «после перезагрузки САМО не вернётся» держат не ворота, а
# armed_alive: предохранитель — живой процесс, и после перезагрузки его нет.
# Плюс сам автооткат никуда не делся — не подтвердят, снимет всё.
#
# 05.09.2026: до этого дня ворот было двое, may_touch_rules и may_restore_route,
# и вторые были шире первых. Разделение закрывало щель поменьше (маршрут) и
# оставляло открытой большую (правила). Второго аргумента нет намеренно: два
# имени для одного условия — это и есть та самая вторая копия, только с
# отсрочкой.
# vorota_stroka — ЧЕМ ЗАКРЫТЫ ВОРОТА, одной строкой.
#
# Живёт РЯДОМ С ВОРОТАМИ и читает состояние там же, где они. 09.09.2026 я
# сначала напечатал те же значения прямо в cmd_ensure — и сторож
# TestGateIsNotDuplicated поймал это как вторую копию условия. Он прав: две
# записи одного знания разъезжаются молча, а «читаю только чтобы показать»
# отличить от «читаю чтобы решить» нельзя ни сканером, ни глазами через месяц.
vorota_stroka() {
	echo "mode=$(state_get mode) confirmed=$(state_get confirmed) armed_pid=$(cat "$ARMEDPID" 2>/dev/null)"
}

# ВНИМАНИЕ, ЭТО ОБЩИЕ ВОРОТА ВСЕХ ПУТЕЙ ВОССТАНОВЛЕНИЯ: ensure, nf-reapply,
# route-up, confirm — все висят на них. Белый режим (mode=white) обязан
# проходить их наравне с чёрным, иначе после перезагрузки или пересборки
# правил прошивкой дом молча вываливается в открытый канал — а автономное
# восстановление и есть та причина, по которой белый режим сделан отдельным
# глаголом, а не аргументом к white-test.
may_restore() {
	case "$(state_get mode)" in
		black|white) : ;;
		*) return 1 ;;
	esac
	[ -f "$OFFMARK" ] && off_in_progress && return 1
	[ "$(state_get confirmed)" = "yes" ] && return 0
	armed_alive
}

# cmd_nf_reapply — то же, но дешевле: зовётся из крючка NDM при каждом событии
# интерфейса. Ничего не ждёт, ничего не качает, набор не пересоздаёт без нужды.
cmd_nf_reapply() {
	# СЧЁТ ХОДОВ — ПЕРВЫМ ДЕЛОМ, ДО ЛЮБЫХ ВОРОТ. Вопрос ключа hook_runs —
	# «крючок вообще зовут?», а не «крючок сделал работу». Считать после ворот
	# значило бы смешать «не зовут» с «позвали и не пустило».
	hod_plyus "$HOOKRUNS"
	# СЛОЙ out — ДО ВОРОТ, НЕ ПОСЛЕ (владелец, 22.09.2026, авария с DNS: NDM
	# пересобирает nat при каждом сетевом событии и может подвинуть наш
	# MASQUERADE вниз — тот же класс поломки, что чинит крючок для чёрного и
	# белого режима, только слой out от may_restore НЕ ЗАВИСИТ (независимый
	# слой, см. cmd_ensure) — ждать её здесь значило бы иногда пропускать
	# восстановление позиции правила именно тогда, когда оно нужнее всего.
	# out_ensure() сама дёшева, когда слой выключен (первая строка — чтение
	# файла), лишнего iptables на одиннадцати роутерах без out отсюда не уйдёт.
	out_ensure
	# Ворота одни на всех для ОСТАЛЬНОГО (см. may_restore). Внутри них и
	# проверка «идёт снятие»: без неё крючок вернул бы ровно то, что человек
	# прямо сейчас снимает. Раньше от этого спасало удаление самого крючка —
	# ценой потери самовосстановления после автоотката.
	may_restore || exit 0
	have iptables || exit 0
	# Периодика не может сообщить о своей смерти сама — если crond не работает,
	# её просто никто не зовёт. Проверка здесь ДЁШЕВА (один `ps`) и канал вызова
	# у этой команды подтверждённо рабочий (крючок netfilter), поэтому именно
	# отсюда, не изнутри самой периодики.
	if crond_alive; then
		clear_crond_dead_mark
	else
		warn_crond_dead_once
	fi
	# Набор после ПЕРЕЗАГРУЗКИ исчезает (ipset живёт в памяти ядра), и раньше
	# крючок на этом просто выходил. Тогда роутер, у которого init-скрипт
	# откатили до версии без вызовов, оставался без маршрутизации совсем — и
	# узнать об этом было неоткуда: панель зелёная, режим «включён».
	#
	# СКОЛЬКО ЭТО СТОИТ ПО ВРЕМЕНИ. Обычный вызов — несколько `iptables -C` и
	# выход, единицы миллисекунд. Но ПЕРВЫЙ вызов после перезагрузки заливает
	# набор, и это уже не «проверил и вышел»:
	#   * список чёрного режима (десятки адресов) — доли секунды;
	#   * 20 000 записей (белый режим, RU-диапазоны) — **2,24 с** по замеру этого
	#     железа одной операцией `ipset restore` (этап 0). Циклом `ipset add`
	#     было бы в десятки раз дольше — поэтому там restore.
	# Сколько заняло на самом деле, крючок пишет в лог: гадать не нужно.
	#
	# ПРЕДЕЛ ВРЕМЕНИ У NDM НАМ НЕИЗВЕСТЕН. В документации Keenetic его нет, а
	# гадать здесь нельзя: если предел есть и мы в него не уложимся, NDM убьёт
	# скрипт на середине заливки. Поэтому: (1) заливка одной операцией, а не
	# циклом; (2) время печатается в лог, чтобы после первого же прогона на
	# роутере число было измеренным, а не предполагаемым; (3) в приёмке этапа 1
	# стоит шаг, который это время снимает.
	# Пустой список — это НЕ повод поднимать всё остальное. Иначе получаем
	# состояние, которое выглядит исправным и не работает: режим «включён»,
	# правила стоят, набор пуст, не помечается ни байта, и `partial=` молчит,
	# потому что формально всё на месте. `on` в такой ситуации отказывается
	# работать (list_check), и крючок обязан вести себя так же.
	if list_empty && ! dns_has_sets; then
		warn_empty_once
		exit 0
	fi
	clear_empty_mark
	offload_disable && log "крючок NDM: разгрузка снова была включена прошивкой — выключил"
	# Крючок зовётся на каждом сетевом событии — это самый точный момент, когда
	# можно заметить пропажу и возврат туннеля.
	tunnel_observe
	if ! set_exists "$SET"; then
		set_load || exit 0
		# ФАКТ, А НЕ ПРИЧИНА. Раньше здесь стояло «создан заново после
		# перезагрузки»: мы видели «набора нет», а утверждали, ОТЧЕГО его нет.
		# Набор исчезает и от пересборки правил прошивкой, и это не редкость —
		# 05.09.2026 крючок сработал так шесть раз подряд без единой перезагрузки.
		# Показатель, называющий причину вместо факта, врёт дважды: и о причине,
		# и о том, что причина известна.
		log "крючок NDM: набор отсутствовал, создан заново — $(set_entries) записей за ${LAST_LOAD_MS:-?} мс"
	fi
	# Два признака, а не один. Раньше восстановление ТОЛЬКО маршрута выставляло
	# общий флаг, и в лог уходила строка «правила восстановлены» — утверждение о
	# том, чего не было. Лог разбирают через недели, и такая строка уводит поиск
	# в сторону: человек идёт смотреть, кто снёс правила, а их никто не трогал.
	RULES_CHANGED=0
	ROUTE_CHANGED=0
	rules_apply    && RULES_CHANGED=1
	rules_ip_apply && RULES_CHANGED=1

	# Маршрут восстанавливаем ЗДЕСЬ ЖЕ, а не только в ensure. Иначе движок
	# зависит от версии init-скрипта: при откате скриптов (или если строки вызова
	# в них ещё не уехали) роутер приходит в состояние «метка ставится, правило
	# политики стоит, таблица пуста, удержание держит» — и весь список молчит,
	# причём молчит ПРАВИЛЬНО с точки зрения каждой отдельной проверки.
	# Обе проверки дешёвые (`ip link show`, `ip route show table`), а крючок
	# зовётся часто — поэтому порядок такой: сначала спрашиваем, потом ставим.
	if iface_exists && ! route_present; then
		route_up && ROUTE_CHANGED=1
	fi

	[ "$RULES_CHANGED" = 1 ] && log "крючок NDM: восстановлено —${IP_WHAT:- правила политики;}"
	[ "$ROUTE_CHANGED" = 1 ] && log "крючок NDM: маршрут в таблице $TABLE восстановлен ($(tun_name) на месте, маршрута не было)"
	exit 0
}

# cmd_route_up — УЗКАЯ ветка: только маршрут в таблице TABLE, ничего больше.
#
# Зачем отдельно от ensure. Клиент пересоздаёт TUN на каждой новой RAW-сессии, а
# маршрут `default dev <туннель>` привязан к УСТРОЙСТВУ и умирает вместе с ним.
# До этой ветки маршрут возвращала периодика — то есть окно чёрной дыры длилось
# до минуты (05.09.2026 измерено четырежды: 1, 2, 9 и 36 секунд). Клиент зовёт
# эту ветку сразу после подъёма интерфейса, и окна не остаётся.
#
# Почему НЕ ensure. Ensure делает около тридцати порождений процесса: три
# dedup_one с двумя `iptables -S` каждый, девять проверок правил, политика,
# крючок, периодика, разгрузка. На каждую смену сессии это дорого и незачем:
# при пересоздании TUN исчезает ТОЛЬКО маршрут в таблице — измерено 05.09.2026
# в сетевом пространстве. Правила iptables хранят имя устройства СТРОКОЙ и
# переживают его удаление; ip rule, наборы ipset и MASQUERADE тоже на месте.
# Здесь два-три вызова `ip`.
#
# Молчание при исправном состоянии — обязательное: сессии сменяются часто, и
# строка на каждую смену была бы логом без потолка (правило 21).
cmd_route_up() {
	may_restore || return 0
	have ip || return 1
	# Интерфейса нет — молча. Эту ветку зовёт и периодика в окне подтверждения,
	# и строка «интерфейса нет» печаталась бы там каждую минуту.
	iface_exists || return 1
	route_present && return 0
	route_up || return 1
	log "маршрут в таблице $TABLE поставлен: интерфейс $(tun_name) есть, маршрута не было"
	# И ВСЛУХ — тому, кто позвал. Клиент печатает в свой журнал только то, что
	# движок сказал: молчание означает «всё и так было на месте», и строки на
	# каждую смену сессии не появляется.
	say "маршрут в таблице $TABLE поставлен (интерфейс есть, маршрута не было)"
	return 0
}

cmd_on_tunnel_up() {
	may_restore || exit 0
	I=0
	while [ "$I" -lt "$IFACE_WAIT" ]; do
		if iface_exists; then
			route_up || true
			# Удержание могло быть снято осознанной остановкой или таймером —
			# возвращаем. Строку про возврат и ДЛИТЕЛЬНОСТЬ печатает
			# tunnel_observe: одно событие — одна строка, из одного места.
			hold_route_present || hold_route_up
			tunnel_observe
			exit 0
		fi
		sleep 2
		I=$((I+2))
	done
	log "интерфейс $(tun_name) не появился за ${IFACE_WAIT} с — маршрут не поставлен, помеченный трафик удерживается"
	exit 0
}

cmd_on_tunnel_down() {
	[ "$(state_get mode)" = "black" ] || exit 0
	# ОСОБОГО СЛУЧАЯ «ЧЕЛОВЕК ВЫКЛЮЧИЛ» БОЛЬШЕ НЕТ, и это ВЫЧИТАНИЕ, а не замена.
	#
	# Было: наличие метки остановки означало «выключил человек», и удержание
	# снималось немедленно. Признака различить намерение у нас не было вовсе:
	# метку пишет stop() в init-скрипте, а restart() — это stop плюс start, то
	# есть КАЖДЫЙ перезапуск выглядел как осознанное выключение. 05.09.2026 на
	# роутере владельца это дало семь строк «туннель выключен человеком» подряд
	# за сорок секунд, пока шёл прогон приёмки.
	#
	# Стало: остановка клиента, падение туннеля и перезапуск — для нас ОДНО И ТО
	# ЖЕ событие: интерфейса нет. Дальше работает обычный путь — удержание, а
	# через hold_open_after оно откроется само. Забота о человеке, ради которой
	# особый случай заводился, никуда не делась: она сделана таймером, то есть
	# по факту, а не по догадке о намерении.
	#
	# Удержание снимает ТОЛЬКО явная команда off (её же зовёт кнопка «Стоп» в
	# панели). Намерение выражается командой, а остановка службы — это авария до
	# доказательства обратного.
	# ЧЕЛОВЕК ВЫКЛЮЧИЛ — УДЕРЖАНИЕ СНИМАЕТСЯ. Замер 09.09.2026, чёрный режим,
	# адрес из списка 142.250.1.1 после выключения клиента:
	#     1.25:  via 192.168.200.1 dev wan0   — идёт напрямую
	#     1.28:  (пусто)                      — ПОГАШЕН, это blackhole
	# То есть выключение гасило ровно те адреса, ради которых нас поставили.
	#
	# Довод редакции 1.26 «удержание снимает явная команда off, её зовёт кнопка
	# Стоп» ЗАМЕРОМ НЕ ПОДТВЕРДИЛСЯ: кнопка «Стоп» зовёт runCtl("stop")
	# (qwdtt-web-src/main.go:2275), а runRoute("off") стоит в другом месте
	# (:4890) и за другой кнопкой. Панель это и сама пишет в комментарии.
	#
	# Различить остановку от перезапуска изнутри нельзя — признак приходит
	# снаружи, от того, кто инициирует (см. RESTARTMARK).
	if restart_in_progress; then
		log "остановка ради ПЕРЕЗАПУСКА (признак свеж) — удержание сохраняю"
	else
		hold_route_down
		log "клиента остановил человек — удержание снято, адреса из списка идут напрямую"
	fi
	tunnel_observe
	exit 0
}

rules_ip_remove_hold() {
	hold_route_down
	# И старое правило, если роутер пришёл с 1.16: два механизма сразу — это
	# «снял удержание, а оно осталось».
	T=0
	while rule_present "$PREF_HOLD"; do
		ip rule del pref "$PREF_HOLD" 2>/dev/null || break
		T=$((T+1)); [ "$T" -gt 10 ] && break
	done
}

# _armed — сторож предохранителя. Просыпается часто, чтобы уйти сразу после
# подтверждения, и снимает всё, если подтверждения не было.
# armed_stop — снять прежнего сторожа. Кого убивать, решаем по /proc/<pid>/cmdline
# и своему PID, а не по совпадению имени: `ps | grep | kill` на BusyBox убивает и
# сам скрипт, потому что его имя стоит в собственной командной строке (правило 25).
armed_stop() {
	[ -f "$ARMEDPID" ] || return 0
	P=$(cat "$ARMEDPID" 2>/dev/null)
	rm -f "$ARMEDPID" 2>/dev/null
	case "$P" in ''|*[!0-9]*) return 0 ;; esac
	[ "$P" = "$$" ] && return 0
	[ -r "/proc/$P/cmdline" ] || return 0
	grep -aq 'meridian-route' "/proc/$P/cmdline" 2>/dev/null || return 0
	grep -aq '_armed' "/proc/$P/cmdline" 2>/dev/null || return 0
	kill "$P" 2>/dev/null
	return 0
}

cmd_armed() {
	# Обрыв ssh — это SIGHUP всей группе процессов. setsid уводит нас в свою
	# сессию, но если его в сборке нет, работает запасное отцепление, а оно
	# группу НЕ меняет — поэтому сигнал глушим явно. Без этой строки
	# предохранитель умирает ровно в тот момент, ради которого он нужен.
	trap '' HUP
	DEADLINE="$1"
	[ -n "$DEADLINE" ] || exit 1
	echo "$$" > "$ARMEDPID" 2>/dev/null
	while [ "$(date +%s)" -lt "$DEADLINE" ] 2>/dev/null; do
		[ "$(state_get confirmed)" = "yes" ] && { rm -f "$ARMEDPID"; exit 0; }
		[ "$(state_get mode)" = "black" ] || { rm -f "$ARMEDPID"; exit 0; }
		sleep 5
	done
	[ "$(state_get confirmed)" = "yes" ] && { rm -f "$ARMEDPID"; exit 0; }
	log "ПОДТВЕРЖДЕНИЯ НЕ БЫЛО — снимаю всё, что применял"
	cmd_off --force >/dev/null 2>&1
	state_set off no "откат: подтверждения не было"
	# След ставится ПОСЛЕ cmd_off, а не до: cmd_off зовёт state_set, и порядок
	# важен только для note в состоянии. Сам след в отдельном файле, его
	# cmd_off не трогает — но пусть отметка появляется, когда откат уже
	# СЛУЧИЛСЯ, а не когда только начался.
	fallback_mark unconfirmed rules_removed_traffic_open \
		"подтверждение не пришло в срок — правила политики сняты, трафик из списка идёт открытым каналом"
	log "откат выполнен"
	rm -f "$ARMEDPID" 2>/dev/null
	exit 0
}

# cmd_purge — ПОЛНОЕ снятие перед сносом пакета.
#
# Зачем отдельно от `off`. Правила политики (1000/1001), цепочки и наборы
# снимает только сам движок. Удалили /opt/bin/meridian-route — снимать их
# стало НЕЧЕМ, и роутер остаётся с маршрутизацией в никуда: помеченный трафик
# уходит в пустую таблицу или в blackhole, а причины на роутере уже нет.
# Поэтому деинсталлятор обязан звать эту команду ДО удаления файла.
#
# От `off --force` отличается тем, что убирает и наши файлы состояния: после
# сноса пакета они уже ничьи, и следующая установка начиналась бы с чужого
# состояния, включая след отката от прошлой жизни.
#
# Список адресов НЕ удаляется без явного --with-list: он собран человеком, а
# не нами, и молча стереть его при деинсталляции — это потерять чужую работу.
cmd_purge() {
    WITHLIST=0
    for a in "$@"; do [ "$a" = "--with-list" ] && WITHLIST=1; done

    # Считаем ДО снятия, чтобы отличить «сняли» от «нечего было снимать».
    # Без этого «снято полностью» печаталось бы и на чистой машине, то есть
    # выглядело бы одинаково при работе и при бездействии.
    HAD=0
    rule_present "$PREF_TUN"  && HAD=$((HAD+1))
    rule_present "$PREF_HOLD" && HAD=$((HAD+1))
    chain_exists   "$CH_MARK" && HAD=$((HAD+1))
    chain_exists   "$CH_MSS"  && HAD=$((HAD+1))
    chain_exists_f "$CH_FWD"  && HAD=$((HAD+1))
    set_exists "$SET"         && HAD=$((HAD+1))
    [ -f "$STATE" ]           && HAD=$((HAD+1))
    grep -qF "$CRONMARK" "$CRONFILE" 2>/dev/null && HAD=$((HAD+1))
    [ -f "$HOOK" ]            && HAD=$((HAD+1))
    [ -f "$OFFLOADSAVE" ]     && HAD=$((HAD+1))

    cmd_off --force >/dev/null 2>&1

    # Крючок снимается ЗДЕСЬ и только здесь: purge — это подготовка к сносу
    # пакета, после которого звать будет нечего. При обычном `off` он остаётся
    # (см. cmd_off): движок обязан уметь вернуться сам после автоотката.
    hook_remove

    # Разгрузку возвращает cmd_off выше; здесь только следим, чтобы файл
    # запомненного не остался мусором, если возврат прошёл.
    rm -f "$STATE" "$ARMEDPID" "$EMPTYMARK" "$CRONDEADMARK" "$BLOCKEDMARK" \
          "$FALLBACKMARK" "$OFFMARK" "$UNSUREMARK" "$TUNSTATE" "$TUNSTATE.wanwarn" "$OUTAGES" 2>/dev/null
    if [ "$WITHLIST" = 1 ]; then
        rm -f "$LIST" 2>/dev/null
    fi

    LEFT=$(leftovers_purge)
    if [ -n "$LEFT" ]; then
        say "СНЯТО НЕ ВСЁ. Осталось:"
        printf '%s\n' "$LEFT" | sed 's/^/    /'
        say "Пакет удалять НЕЛЬЗЯ: снять это станет нечем."
        log "purge: осталось $(printf '%s' "$LEFT" | tr '\n' ';')"
        return 1
    fi
    if [ "$HAD" = 0 ]; then
        say "Снимать было нечего: правил, цепочек, наборов и состояния движка нет."
        log "purge: снимать было нечего"
    else
        say "Снято полностью: правила политики, цепочки, наборы, периодика, крючок и состояние движка."
        log "purge: снято полностью (было следов: $HAD)"
    fi
    [ "$WITHLIST" = 1 ] || [ ! -f "$LIST" ] || \
        say "Список адресов оставлен: $LIST — он ваш, а не наш. Удалить вместе: purge --with-list"
    return 0
}

# cmd_fallback_ack — «понял». СНИМАЕТ след, и это единственный способ его
# снять: ни `on`, ни `off`, ни перезапуск движка его не трогают.
#
# Почему человеком, а не следующим включением: откат означает, что трафик шёл
# ОТКРЫТЫМ каналом, и об этом надо узнать, даже если зайти через час. Снятие
# по `on` означало бы, что человек, включивший маршрутизацию заново, стирает
# улику до того, как её увидел.
cmd_fallback_ack() {
	if [ ! -f "$FALLBACKMARK" ]; then
		say "следа отката нет — снимать нечего"
		return 0
	fi
	WAS="$(fallback_get at)"
	rm -f "$FALLBACKMARK" 2>/dev/null
	log "след отката снят человеком (был от $WAS)"
	say "След отката снят."
}

# _status_mark — ОТЛАДОЧНАЯ ПЕЧАТЬ ВРЕМЕНИ (1.73, владелец, 21.09.2026, пункт
# 2 хвоста шага 11: «замерь по разделам, потом правь»). Молчит и стоит ноль,
# если MERIDIAN_ROUTE_STATUS_PROFILE не задан. /proc/uptime вместо
# date +%s%N: доступен на любом Linux независимо от сборки busybox (date %N
# поддерживают не все прошивки), даёт сотые доли секунды.
_status_mark() {
	[ -n "$MERIDIAN_ROUTE_STATUS_PROFILE" ] || return 0
	_sm_t=$(awk '{print $1}' /proc/uptime 2>/dev/null)
	echo "status_profile: $1 $_sm_t" >&2
}

STATUSCACHE="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.statuscache"
STATUSCACHE_TTL="${MERIDIAN_ROUTE_STATUS_CACHE_TTL:-5}"
# STATUS_WAIT_MAX — ОТДЕЛЬНОЕ ЧИСЛО ОТ STATUSCACHE_TTL (1.84, владелец,
# 22.09.2026, после живой находки на HERO: 5 параллельных --cache дали 6
# расчётов вместо 1, потому что сам расчёт на загруженном роутере регулярно
# не укладывается в STATUSCACHE_TTL=5с — прежняя логика «не дождался TTL,
# считай сам» превращала это в положительную обратную связь (медленно -> не
# дождались -> все считают параллельно -> ещё медленнее), ровно то
# накопление процессов, что уже было 19.09. STATUSCACHE_TTL — по-прежнему
# «насколько старый кэш ещё годится», не про ожидание чужого расчёта.
# STATUS_WAIT_MAX — «сколько ждать ПРАВО СЧИТАТЬ, прежде чем сдаться и
# отдать честно старое».
STATUS_WAIT_MAX="${MERIDIAN_ROUTE_STATUS_WAIT_MAX:-30}"
STATUSLOCK="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.statuslock"
# STATUSCOMPUTECOUNT — сколько раз тело status РЕАЛЬНО посчиталось (1.76,
# владелец, 21.09.2026, пункт 2: доказать single-flight числом, не на слово).
# Растёт БЕЗУСЛОВНО на каждый настоящий расчёт (не на попадание в кэш) —
# пятёрка одновременных `status --cache &` обязана дать здесь ровно +1, а не
# +5. Не atomic (обычный read-modify-write), и это осознанно: если
# single-flight работает, гонки тут в принципе нет (расчёт всего один); если
# не работает — число всё равно вырастет больше чем на 1, и это и есть сигнал.
STATUSCOMPUTECOUNT="${MERIDIAN_ROUTE_STATE:-/opt/etc/qwdtt/meridian-route.state}.statuscomputecount"

# statuscache_age — секунд с последнего готового снимка. Пусто/отказ = снимка
# ещё не было или он не читается. Тот же приём, что у dns_status_cache_age —
# первая строка снимка служебная («at=unix-время»), остальное — сам ответ.
statuscache_age() {
	[ -f "$STATUSCACHE" ] || return 1
	_sca=$(sed -n '1{s/^at=//p}' "$STATUSCACHE" 2>/dev/null)
	case "$_sca" in ''|*[!0-9]*) return 1 ;; esac
	echo $(( $(date +%s) - _sca ))
}
# statuscache_body — снимок status БЕЗ служебной первой строки.
statuscache_body() { tail -n +2 "$STATUSCACHE" 2>/dev/null; }
# statuscache_body_stale — последний снимок + честная пометка, что он не
# досчитан заново (1.84): не дождались права считать за STATUS_WAIT_MAX —
# отдаём старое, но НАЗВАННОЕ старым, а не молчим и не считаем вторым разом
# поверх и без того медленного роутера.
statuscache_body_stale() {
	_scs_age=$(statuscache_age 2>/dev/null)
	case "$_scs_age" in ''|*[!0-9]*) _scs_age="?" ;; esac
	statuscache_body
	echo "status_stale=yes"
	echo "status_age_s=$_scs_age"
}

# statuslock_acquire/wait_or_takeover/release — ПРЕДПОЧИТАЕМ flock, ЕСЛИ ЕСТЬ
# (1.84, владелец, 22.09.2026; ПРОВЕРЯЕТСЯ, не предполагается — тот же приём,
# что у ensure_lock_acquire): атомарен по построению, и это здесь особенно
# важно — «хозяин замка умер -> замок перехватывает ОДИН ждущий» СВОЙСТВО
# САМОГО flock (ядро снимает замок при закрытии fd, в том числе когда
# процесс-хозяин просто умер, и будит РОВНО ОДНОГО из ждущих), а не то, что
# нужно выстраивать вручную поверх pid-файла. Без flock — pid-файл с
# проверкой живости, тот же класс короткого окна гонки, что и без flock у
# ensure_lock_acquire, — принято как компромисс, не идеал.
STATUS_HAVE_FLOCK=""
statuslock_acquire() {
	if have flock; then
		STATUS_HAVE_FLOCK=1
		exec 8>"$STATUSLOCK.flock" || return 1
		flock -n 8 2>/dev/null || return 1
		return 0
	fi
	if [ -f "$STATUSLOCK" ]; then
		_sl_pid=$(cat "$STATUSLOCK" 2>/dev/null)
		case "$_sl_pid" in
			''|*[!0-9]*) : ;;
			*) kill -0 "$_sl_pid" 2>/dev/null && return 1 ;;
		esac
	fi
	echo $$ > "$STATUSLOCK" 2>/dev/null
	return 0
}
# statuslock_wait_or_takeover — ждать до STATUS_WAIT_MAX секунд ЗА ПРАВО
# СЧИТАТЬ, не просто наблюдать чужой кэш со стороны. С flock — ОДИН
# блокирующий вызов с таймаутом: ядро само разбудит нас, когда прежний
# хозяин освободит замок (сдал сам ИЛИ процесс умер — для ядра оба случая
# закрывают fd одинаково), и тогда замок достаётся нам. Без flock — poll раз
# в секунду, проверяя живость pid хозяина; та же цена короткого окна гонки,
# что у acquire без flock.
statuslock_wait_or_takeover() {
	if have flock; then
		STATUS_HAVE_FLOCK=1
		exec 8>"$STATUSLOCK.flock" || return 1
		flock -w "$STATUS_WAIT_MAX" 8 2>/dev/null && return 0
		return 1
	fi
	_sw=0
	while [ "$_sw" -lt "$STATUS_WAIT_MAX" ]; do
		if [ -f "$STATUSLOCK" ]; then
			_sl_pid=$(cat "$STATUSLOCK" 2>/dev/null)
			case "$_sl_pid" in
				''|*[!0-9]*) echo $$ > "$STATUSLOCK" 2>/dev/null; return 0 ;;
				*) kill -0 "$_sl_pid" 2>/dev/null || { echo $$ > "$STATUSLOCK" 2>/dev/null; return 0; } ;;
			esac
		else
			echo $$ > "$STATUSLOCK" 2>/dev/null
			return 0
		fi
		sleep 1
		_sw=$((_sw + 1))
	done
	return 1
}
# statuslock_release — с flock замок снимается закрытием fd (выход процесса
# делает это сам); без flock — свой pid-файл убираем сами. Тот же приём, что
# ensure_lock_release.
statuslock_release() {
	[ -n "$STATUS_HAVE_FLOCK" ] && return 0
	rm -f "$STATUSLOCK" 2>/dev/null
}

# cmd_status — ОДИН РАСЧЁТ НА ВСЕХ, НЕ СТАРШЕ STATUSCACHE_TTL (1.75, владелец,
# 21.09.2026, пункт 3 хвоста шага 11). Панель и тестировщики опрашивают
# status каждые несколько секунд, каждый своим процессом — пересчитывать один
# и тот же снимок заново на каждый опрос значит копить процессы ровно там,
# где раньше уже копились (разгон 19.09.2026 начинался с похожей картины).
#
# КЭШ ИЗ 1.66 (DNSSTATCACHE) ЭТО НЕ ЗАКРЫВАЛ: он кэширует ответ meridian-dns
# ВНУТРИ расчёта status, а не сам status целиком — расчёт всё равно шёл заново
# на каждый вызов, дорогая часть была не в DNS, а в iptables/ipset (см. заход
# «профиль status по разделам», 1.73).
#
# `status --full` В ОБХОД КЭША ВСЕГДА: приёмкам и живой диагностике нужна
# правда именно в этот момент, а не то, что было пять секунд назад.
cmd_status() {
	# УМОЛЧАНИЕ И --full — ВСЕГДА СВЕЖИЙ РАСЧЁТ, БЕЗ КЭША (1.75, владелец,
	# 21.09.2026, поймано регрессией той же правки: кэш по умолчанию ломал
	# «действие -> сразу проверка status», на котором держится большая часть
	# приёмок и тестов — `on; status` обязан видеть СВЕЖЕЕ состояние, а не то,
	# что кто-то успел закэшировать секундой раньше). Кэш — ТОЛЬКО по явному
	# --cache: его зовёт панель, которая опрашивает status чаще, чем состояние
	# вообще может измениться, и ей действительно достаточно ответа не старше
	# STATUSCACHE_TTL. Кто не просил --cache, тот кэш не увидит никогда.
	if [ "${1:-}" != "--cache" ]; then
		cmd_status_compute
		return 0
	fi
	# ПРОФИЛЬ — В ОБХОД КЭША ДАЖЕ ПРИ --cache: ему нужно измерить сам расчёт
	# (Блок Е, 1.73). Попади он в кэш, готовый ответ вернулся бы без единой
	# метки в stderr, и цифры профиля стали бы врать о том, что посчиталось.
	if [ -n "$MERIDIAN_ROUTE_STATUS_PROFILE" ]; then
		cmd_status_compute
		return 0
	fi
	_sc_age=$(statuscache_age 2>/dev/null)
	if [ -n "$_sc_age" ] && [ "$_sc_age" -lt "$STATUSCACHE_TTL" ] 2>/dev/null; then
		statuscache_body
		return 0
	fi
	if statuslock_acquire; then
		_sc_out=$(cmd_status_compute)
		{ echo "at=$(date +%s)"; printf '%s\n' "$_sc_out"; } > "$STATUSCACHE.tmp.$$" 2>/dev/null \
			&& mv -f "$STATUSCACHE.tmp.$$" "$STATUSCACHE" 2>/dev/null
		statuslock_release
		printf '%s\n' "$_sc_out"
		return 0
	fi
	# ЗАМОК ЗАНЯТ — ЖДЁМ ПРАВО СЧИТАТЬ, А НЕ СЧИТАЕМ ВТОРЫМ ПРОЦЕССОМ ПАРАЛЛЕЛЬНО
	# (1.84, владелец, 22.09.2026, живая находка на HERO: старое поведение
	# «не дождался STATUSCACHE_TTL — считай сам» на загруженном роутере, где
	# сам расчёт регулярно ЗАНИМАЕТ БОЛЬШЕ STATUSCACHE_TTL, превращалось в
	# положительную обратную связь — медленно -> не дождались -> все считают
	# параллельно -> ещё медленнее — ровно то накопление процессов, что уже
	# было 19.09. Замер: пять параллельных --cache дали 6 расчётов вместо 1.
	#
	# Теперь ждём до STATUS_WAIT_MAX (отдельное число, см. его объявление)
	# ИМЕННО ПРАВА СЧИТАТЬ, атомарно (statuslock_wait_or_takeover, flock -w —
	# хозяин умер, замок сам достанется ровно одному ждущему). Достали замок —
	# сперва смотрим, не появился ли уже свежий кэш (прежний хозяин мог
	# успеть закончить и отпустить замок сам, штатно): тогда просто отдаём
	# его, считать поверх не нужно. Не появился — теперь СЧИТАЕМ МЫ. Не
	# дождались права за весь бюджет — сдаёмся честно: отдаём последний кэш,
	# ПОМЕЧЕННЫЙ status_stale=yes, а не молчим и не считаем вторым разом.
	if statuslock_wait_or_takeover; then
		_a=$(statuscache_age 2>/dev/null)
		if [ -n "$_a" ] && [ "$_a" -lt "$STATUSCACHE_TTL" ] 2>/dev/null; then
			statuslock_release
			statuscache_body
			return 0
		fi
		_sc_out=$(cmd_status_compute)
		{ echo "at=$(date +%s)"; printf '%s\n' "$_sc_out"; } > "$STATUSCACHE.tmp.$$" 2>/dev/null \
			&& mv -f "$STATUSCACHE.tmp.$$" "$STATUSCACHE" 2>/dev/null
		statuslock_release
		printf '%s\n' "$_sc_out"
		return 0
	fi
	# НЕ ДОЖДАЛИСЬ ВООБЩЕ НИЧЕГО ЗА STATUS_WAIT_MAX. Кэша нет ни разу
	# (самый первый всплеск параллельных опросов на свежепоставленном
	# роутере, отдавать панели ещё нечего) — считать всё же приходится,
	# другого источника ответа нет. Кэш ЕСТЬ, просто старый — отдаём его
	# честно помеченным, а не считаем вторым разом поверх и без того
	# перегруженного роутера.
	if [ -f "$STATUSCACHE" ]; then
		statuscache_body_stale
		return 0
	fi
	cmd_status_compute
}
cmd_status_compute() {
	_status_mark "0_start"
	_scc=$(cat "$STATUSCOMPUTECOUNT" 2>/dev/null); case "$_scc" in ''|*[!0-9]*) _scc=0 ;; esac
	echo $((_scc + 1)) > "$STATUSCOMPUTECOUNT" 2>/dev/null
	# ТОЛЬКО ДЛЯ СТЕНДА (1.84): искусственно медленный хозяин расчёта, чтобы
	# проверить statuslock_wait_or_takeover под настоящей нагрузкой ожидания,
	# не дожидаясь живого медленного роутера. В бою переменная не задана —
	# строка не выполняется никогда.
	[ -n "${MERIDIAN_ROUTE_STATUS_TEST_DELAY:-}" ] && sleep "$MERIDIAN_ROUTE_STATUS_TEST_DELAY" 2>/dev/null
	# СНИМОК mangle ОДНИМ iptables-save -c (1.76, пункт 3 хвоста шага 11) —
	# метки ДО и ПОСЛЕ отдельно, чтобы видеть цену самого снимка отдельно от
	# цены разбора (владелец, 21.09.2026: «замерь отдельно, сколько ждёт сам
	# iptables-save»). Отказ снимка НЕ останавливает status — ipt()/
	# schyot_pravil*() сами откатываются на живые вызовы, когда _IPTSNAP_ON
	# пуст, снимок — ускорение, а не условие для правильного ответа.
	_status_mark "0b_pered_snap"
	iptsnap_capture
	rtsnap_capture
	_status_mark "0c_posle_snap"
	echo "version=$VERSION"
	# Пустое значение и «выключено» — это две разные вещи только для нас; панели
	# и человеку нужно одно понятное слово, поэтому умолчания подставляем здесь.
	M=$(state_get mode);      [ -n "$M" ] || M="off"
	C=$(state_get confirmed); [ -n "$C" ] || C="no"
	echo "mode=$M"
	echo "confirmed=$C"
	# ПОКАЗАНИЕ ПРОВЕРЯЕТСЯ ПО ЖИВЫМ ПРАВИЛАМ, НЕ ТОЛЬКО ПО ФАЙЛУ СОСТОЯНИЯ
	# (1.74, владелец, 21.09.2026, живой дефект на HERO, пункт 3, инвариант
	# 22: «показание не должно врать правдоподобно»). mode=black читался бы
	# зелёным, пока в PREROUTING жил прыжок на MERIDIAN_WHITE_HOME_A и весь
	# дом шёл туннелем — теперь при расхождении white_residue=yes и назван
	# словами, а не спрятан за спокойным mode=.
	_whlive=no
	for _whc in $(white_home_all_names); do
		ipt -C PREROUTING -j "$_whc" 2>/dev/null && _whlive=yes
	done
	echo "white_home_jump=$_whlive"
	if [ "$_whlive" = "yes" ] && [ "$M" != "white" ]; then
		echo "white_residue=yes"
		echo "white_residue_pochemu=прыжок на цепочку белого дома жив в PREROUTING, а mode=«$M» — дом фактически идёт туннелем несмотря на видимость чёрного режима"
	else
		echo "white_residue=no"
	fi
	echo "mark=$MARK/$MASK"
	echo "table=$TABLE"
	echo "iface=$(tun_name)"
	if iface_exists; then echo "iface_present=yes"; else echo "iface_present=no"; fi
	# route_blocked* — не mode и не confirmed: mode/confirmed про НАМЕРЕНИЕ
	# (включено ли, подтверждено ли человеком), эти два поля — про ФАКТ прямо
	# сейчас (работает ли маршрут) и про то, с какого момента он не работает,
	# если не работает. Пишет их только cmd_ensure (см. BLOCKEDMARK там же).
	if [ -f "$BLOCKEDMARK" ]; then
		echo "route_blocked=yes"
		# Метка Unix — машине, читаемая дата — человеку. ВТОРОГО КЛЮЧА не
		# заводим: у панели уже есть договор на route_blocked_since, и второе
		# имя для того же значения — это второй источник истины.
		_bs=$(cat "$BLOCKEDMARK" 2>/dev/null)
		echo "route_blocked_since=$_bs"
		echo "route_blocked_since_human=$(rb_human "$_bs")"
	else
		echo "route_blocked=no"
		echo "route_blocked_since="
		echo "route_blocked_since_human="
	fi
	if set_exists "$SET"; then echo "set=yes"; echo "set_entries=$(set_entries)"; else echo "set=no"; echo "set_entries=0"; fi

	_status_mark "1_pered_fallback"
	# --- след автоматического отката ---
	#
	# ТРИ явных исхода, и ни один не пустой. Отсутствие файла и пустое поле —
	# разные вещи, и обе не должны читаться как «всё в порядке»: 31.08.2026 нам
	# уже стоило круга то, что пустой эталон выглядел как совпавший.
	#
	#   last_rollback=none    — откатов не было НИКОГДА (файла нет)
	#   last_rollback=<unix>  — откат был, вот когда; поля ниже заполнены
	#   last_rollback=unknown — файл есть, но нечитаем или без времени. НЕ «none»:
	#                      это поломка, и молча выдавать её за «всё хорошо»
	#                      значит терять ровно то событие, ради которого след
	#                      и заведён.
	if [ ! -f "$FALLBACKMARK" ]; then
		echo "last_rollback=none"
		echo "last_rollback_human="
	elif [ -n "$(fallback_get at)" ]; then
		# ДВА КЛЮЧА, а не одно значение с датой в скобках. Панель читает
		# last_rollback как ЧИСЛО (strconv.ParseInt), и приписка в скобках
		# сломала бы разбор — то есть починка показателя для человека убила бы
		# показатель для программы. Одно значение — один смысл.
		echo "last_rollback=$(fallback_get at)"
		echo "last_rollback_human=$(rb_human "$(fallback_get at)")"
		echo "last_rollback_reason=$(fallback_get reason)"
		echo "last_rollback_effect=$(fallback_get effect)"
		echo "last_rollback_note=$(fallback_get note)"
	else
		echo "last_rollback=unknown"
		echo "last_rollback_human="
	fi
	# РАЗГРУЗКА — отдельной строкой, вместе с тем, что мы запомнили. Человек
	# должен видеть, что мы изменили в его роутере, и чем это было до нас.
	if [ -f "$FASTNATPROP" ]; then
		echo "fastnat_propka=$FASTNATPROP (больше не нужна, снимите сами)"
	else
		echo "fastnat_propka="
	fi
	if offload_managed; then
		echo "offload_managed_by_us=yes (аварийный ключ OFFLOAD=off включён)"
	else
		echo "offload_managed_by_us=no"
	fi
	if offload_present; then
		echo "offload_fastnat=$(offload_get "$FASTNAT_PATH")"
		echo "offload_fastroute=$(offload_get "$FASTROUTE_PATH")"
		if [ -f "$OFFLOADSAVE" ]; then
			echo "offload_saved_fastnat=$(offload_saved_get fastnat)"
			echo "offload_saved_fastroute=$(offload_saved_get fastroute)"
			echo "offload_changed_by_us=yes"
		else
			echo "offload_saved_fastnat="
			echo "offload_saved_fastroute="
			echo "offload_changed_by_us=no"
		fi
	else
		echo "offload_fastnat=absent"
		echo "offload_fastroute=absent"
		echo "offload_changed_by_us=no"
	fi
	_status_mark "2_pered_hold"
	# --- прибор пропаж и политика удержания ---
	_ts=$(tun_field state); [ -n "$_ts" ] || _ts=unknown
	echo "tunnel_state=$_ts"
	_tsince=$(tun_field since)
	echo "tunnel_since=$_tsince"
	echo "tunnel_since_human=$(rb_human "$_tsince")"
	echo "wan_alive=$(wan_alive && echo yes || echo no)"
	echo "hold_policy=$(hold_policy)"
	echo "hold_open_after=$(hold_open_after)"
	echo "hold_open_after_from=$(hold_open_after_from)"
	echo "hold_open_max=$(hold_open_max)"
	_ht=$(tun_field held_total); case "$_ht" in ''|*[!0-9]*) _ht=0 ;; esac
	echo "hold_held_total=$_ht"
	echo "hold_notice=$(hold_notice)"
	# ИМЕНА БЕЛОГО РЕЖИМА. Значение то же, что у hold_state — считается ОДИН
	# раз и печатается под двумя именами намеренно: hold_state уже читает
	# панель, и менять договор ради нашей перестановки нельзя (тот же довод,
	# что у hold_kind). Две записи одного знания допустимы, только когда
	# источник один; здесь он один — переменная ниже.
	echo "whitemode_state=$(hold_state_value)"
	echo "whitemode_open_since=$(tun_field open_since)"
	outage_stat
	# ЧЕГО МЫ НЕ ИЗМЕРЯЕМ — СКАЗАНО ВСЛУХ, а не оставлено пустым.
	echo "rx_silence_source=клиент (движку не видно: lastRx живёт в памяти сессии)"
	_status_mark "3_pered_zhurnal"
	# --- ПУТЬ КЛИЕНТА И ЖУРНАЛ ПЕРЕХОДОВ (10б-2, пункт 1) ---
	# КЛЮЧИ ПАРАМИ: mode — присутствие (что сейчас), continuous_since —
	# действие (с какого момента непрерывно, движковым счётом, не since
	# клиента). qwdtt_path_mode пуст = файла нет (старая прошивка/клиент не
	# запущен) — это НЕ то же самое, что mode=none (клиент есть, сессии нет).
	_qpm=$(qwdtt_path_mode) || _qpm=""
	echo "qwdtt_path_mode=$_qpm"
	_qpcs=$(transitions_continuous_since) || _qpcs=""
	echo "qwdtt_path_continuous_since=$_qpcs"
	echo "qwdtt_path_continuous_since_human=$([ -n "$_qpcs" ] && rb_human "$_qpcs")"
	_trn=0; [ -f "$TRANSITIONS" ] && _trn=$(wc -l < "$TRANSITIONS" 2>/dev/null)
	echo "transitions_total=${_trn:-0}"
	echo "transitions_last=$(tail -1 "$TRANSITIONS" 2>/dev/null)"
	# АВТОПЕРЕХОД 10б-2 (1.83) — рядом с путём клиента, читает те же данные.
	echo "autoswitch=$(autoswitch_enabled && echo on || echo off)"
	echo "autoswitch_n=$(autoswitch_n)"
	echo "autoswitch_m=$(autoswitch_m)"
	echo "autoswitch_active=$([ -f "$AUTOSWITCHACTIVE" ] && echo yes || echo no)"
	echo "autoswitch_daily_count=$(autoswitch_daycount_get)"
	echo "autoswitch_daily_cap=$(autoswitch_cap)"
	_status_mark "4_pered_whitetest"
	# --- опытный слой белого режима ---
	if white_on; then
		echo "white_test=on"
		echo "white_test_addr=$(white_state_get addr)"
		if [ "$(white_state_get confirmed)" = "yes" ]; then
			echo "white_test_confirmed=yes"
			echo "white_test_deadline="
		else
			echo "white_test_confirmed=no"
			echo "white_test_deadline=$(white_state_get deadline)"
		fi
		_wm=$(white_marked); case "$_wm" in ''|*[!0-9]*) _wm=unknown ;; esac
		echo "white_test_marked=$_wm"
	else
		echo "white_test=off"
		echo "white_test_addr="
		echo "white_test_confirmed="
		echo "white_test_deadline="
		echo "white_test_marked="
	fi
	_status_mark "5_pered_whitehome"
	# --- БЕЛЫЙ РЕЖИМ НА ВЕСЬ ДОМ (шаг 10б-1). Состав ключей — по договору
	# /root/ДОГОВОР-ПАНЕЛЬ-БЕЛЫЙ-ДОМ-10б.md, менять его в одностороннем
	# порядке нельзя: Кот 2 строит экран по нему.
	if white_home_on; then
		echo "white=on"
		# КТО ВКЛЮЧИЛ БЕЛЫЙ (1.89, владелец 23.09.2026). Раньше здесь стояло
		# жёсткое human — и включение автоматом 10б-2 подписывалось как
		# «подтверждён человеком». 23.09 это и произошло: автомат включил
		# белый в 01:32 ошибочно, а в журнале и в панели выглядело решением
		# владельца. Признак берём из уже существующего маркера автомата,
		# новых сущностей не заводим: файл ставится ровно там, где автомат
		# включает белый, и снимается вместе с уходом белого.
		if [ -f "$AUTOSWITCHACTIVE" ]; then
			echo "white_by=auto"
		else
			echo "white_by=human"
		fi
		# $C — то же самое "confirmed" из $STATE, уже прочитанное в начале
		# расчёта (1.82) — white_confirmed использует ОБЩИЙ ключ, не свой.
		echo "white_confirmed=$C"
		# ИМЕНОВАННЫЕ ЗНАЧЕНИЯ: слово и число в одном ключе. Тот же приём и та
		# же ловушка, что у hold_open_in — прочитанное числом слово даёт ноль,
		# то есть «подтвердить немедленно» вместо «подтверждение не нужно».
		if [ "$C" = "yes" ]; then
			echo "white_confirm_in=confirmed"
		else
			_wd=$(cat "$WHITEHOMEDEAD" 2>/dev/null)
			case "$_wd" in
				''|*[!0-9]*) echo "white_confirm_in=never" ;;
				*) _wl=$(( _wd - $(date +%s) )); [ "$_wl" -lt 0 ] && _wl=0
				   echo "white_confirm_in=$_wl" ;;
			esac
		fi
		_ws=$(cat "$WHITEHOMESINCE" 2>/dev/null)
		echo "white_since=$_ws"
		echo "white_since_human=$([ -n "$_ws" ] && rb_human "$_ws")"
		echo "white_prev_mode=$(cat "$WHITEPREV" 2>/dev/null)"
		_wm=$(white_marked); case "$_wm" in ''|*[!0-9]*) _wm=unknown ;; esac
		echo "white_marked=$_wm"
		echo "white_direct_entries=$(white_direct_entries)"
		# ДОМЕННЫЙ НАБОР — КЛЮЧИ ПАРАМИ: имя (присутствие) и СЧЁТЧИК ПАКЕТОВ,
		# прошедших через RETURN этого набора (действие). Не число строк —
		# ЖИВОЕ доказательство того же рода, что владелец просил в приёмке:
		# растущий счётчик match-set доказывает, что исключение по доменам
		# реально ловит трафик, а не просто стоит в цепочке.
		#
		# ИМЕНА — ИЗ САМОЙ ЦЕПОЧКИ, А НЕ ИЗ dns_direct_sets() ЗАНОВО. Вторая
		# такая же проверка (повторяющая set_exists) была бы вторым местом,
		# решающим тот же вопрос, — и однажды разошлась бы с первым молча.
		# Пойман на себе же: раньше здесь звался dns_direct_sets() напрямую,
		# и ключ называл набор, которого в ipset нет и в цепочке нет —
		# ровно то «присутствие без действия», за которым и следит это
		# правило (SOSTOYANIE.md, 1.54).
		# АКТИВНАЯ ПОЛОВИНА, НЕ БАЗОВОЕ ИМЯ (1.70) — см. запись у WHITEHOMECHAIN_A.
		_wsc=$(white_home_active_chain)
		_hdn=$(ipt -S "$_wsc" 2>/dev/null \
			| sed -n "s/.*--match-set \([^ ]*\) dst -j RETURN.*/\1/p" \
			| grep -vx "$KEEPSET" | grep -vx "$DIRECTSET" | sort -u | tr '\n' ' ')
		echo "white_direct_dns_sets=$_hdn"
		# ОДИН СНИМОК НА ВСЕ НАБОРЫ СРАЗУ (1.72, владелец, 21.09.2026, пункт 2
		# хвоста шага 11: status уходил на 3-11с). Прежняя редакция звала
		# schyot_pravil() ОТДЕЛЬНО на каждый _hds — а он сам, БЕЗ snapshot-
		# оптимизации schyot_pravil_mnogo, делает свою `-L -v -n -x` ПОВТОРНО
		# на КАЖДОЕ совпадение (по разу на домашнюю сеть): при K доменных
		# наборах и N домашних сетях это K x (1 + N) живых вызовов iptables на
		# одну и ту же (часто большую) цепочку белого дома. schyot_pravil_mnogo
		# читает -S и -L РОВНО ОДИН РАЗ на всю группу образцов, дальше только
		# разбор уже прочитанного — тот же приём, что уже применён к
		# selfdns_marked/selfdns_direct.
		_hdp=0
		if [ -n "$_hdn" ]; then
			_hdp_res=$(
				set --
				for _hds in $_hdn; do
					set -- "$@" "match-set $_hds dst -j RETURN"
				done
				schyot_pravil_mnogo "$_wsc" ipt "$@"
			)
			for _hdv in $_hdp_res; do
				case "$_hdv" in ''|*[!0-9]*) continue ;; esac
				_hdp=$(( _hdp + _hdv ))
			done
		fi
		echo "white_direct_dns_packets=$_hdp"
		# ХВОСТ ЖИВОЙ ЦЕПОЧКИ — ОДНИМ КЛЮЧОМ (1.70, инвариант 41): владелец не
		# обязан помнить формулу счёта правил, чтобы увидеть, цела ли сборка.
		_wcok=$(sed -n 's/^ok=//p' "$WHITECHAINOK_STATE" 2>/dev/null | head -1)
		_wcor=$(sed -n 's/^reason=//p' "$WHITECHAINOK_STATE" 2>/dev/null | head -1)
		echo "white_chain_ok=${_wcok:-нет данных}"
		echo "white_chain_ok_reason=$_wcor"
	else
		echo "white=off"
		echo "white_by="
		echo "white_confirmed="
		echo "white_confirm_in="
		echo "white_since="
		echo "white_since_human="
		echo "white_prev_mode="
		echo "white_marked="
		echo "white_direct_entries="
		echo "white_direct_dns_sets="
		echo "white_direct_dns_packets="
		echo "white_chain_ok="
		echo "white_chain_ok_reason="
	fi
	# НАБОР ИСКЛЮЧЕНИЙ ПО ИСТОЧНИКУ (meridian_src4) — это ШАГ 10Б-2. Ключ
	# печатается пустым НАМЕРЕННО: панель уже строится по договору, и лучше
	# пустое значение, чем отсутствующий ключ, на котором она споткнётся.
	echo "white_bypass_entries="
	# ОТСЕВ ДОМАШНИХ СЕТЕЙ ВСЛУХ. Ключи печатаются ВСЕГДА, в том числе пустыми:
	# исчезнувший ключ панель не покажет никак, а «отсеянных нет» — покажет.
	# IPv6 — ВИДИМОЕ СОСТОЯНИЕ, А НЕ ТОЛЬКО ВОРОТА. Ворота в white_home_vorota
	# срабатывают один раз при включении; ключ отвечает каждую минуту, и по
	# нему видно ДЕНЬ, когда провайдер включил IPv6.
	if [ -n "$(ip -6 route show default 2>/dev/null)" ]; then
		echo "ipv6_default=yes"
	else
		echo "ipv6_default=no"
	fi
	# ОДИН ИСТОЧНИК, ДВА КЛЮЧА — то, что взято (home_nets=, сетями, как и
	# раньше — по ним строится -s в цепочке) и то, что отсеяно (home_nets_iskl=,
	# ПОИНТЕРФЕЙСНО, «интерфейс:причина», через запятую — 1.69, владелец,
	# 21.09.2026, инвариант 25: отсев обязан быть виден и назван, не только
	# посчитан). Переименовано с white_home_nets=/white_excluded_nets=: второе
	# имя лишним словом «white» не было точным — сети эти нужны и статусу
	# заворота DNS у Кота 2 (глагол home-ifaces), не только белому режиму.
	# ОДИН ОБХОД ИНТЕРФЕЙСОВ НА ОБА КЛЮЧА (1.80, владелец, 22.09.2026: «делай в
	# свою сторону» после разведки нагрузки). Было: home_nets_klass() (свой
	# `ip -o -f inet addr show` плюс подпроцесс проверки моста НА КАЖДЫЙ
	# интерфейс) звалась здесь ДВАЖДЫ за один status — один раз через
	# home_nets(), второй раз напрямую для home_nets_iskl=. Тот же класс
	# дублирования, что уже чинили у outages_clean_cached()/dns_status_live()
	# (инвариант «читать источник один раз на процесс»), просто пропущенный
	# здесь. Читаем один раз, оба ключа — разбором уже прочитанного.
	_hnk=$(home_nets_klass)
	echo "home_nets=$(printf '%s\n' "$_hnk" | awk '$3 == "home" { print $1 }' | tr '\n' ' ' | sed 's/ *$//')"
	# ЧИСТЫЕ РЕЗОЛВЕРЫ — ТЕМ ЖЕ СПОСОБОМ, ЧТО И СЕТИ. Цепочку по ним строит
	# движок; кто читает их отдельно и в другой момент, получит другое число.
	# ИЗ КЭША, НЕ ЖИВЫМ ВЫЗОВОМ (владелец, 21.09.2026): status зовёт панель
	# каждые несколько секунд и в сеть не ходит никогда — кэш обновляет
	# только ensure. Ключи парами: значение и возраст, чтобы «данных нет»
	# не путалось с «данные свежие».
	echo "white_resolvers=$(dns_status_cache_field clean_addrs 2>/dev/null | tr ',' ' ')"
	_dsca=$(dns_status_cache_age) || _dsca=""
	echo "dns_status_cache_age_s=$_dsca"
	echo "home_nets_iskl=$(printf '%s\n' "$_hnk" | awk '$3 != "home" { printf "%s:%s,", $2, $3 }' | sed 's/,$//')"
	# ПОЧЕМУ умолчание удержания именно такое. Одно значение hold_policy
	# означает три разные причины, и человеку нужна причина, а не значение.
	if [ -n "${MERIDIAN_ROUTE_HOLD_POLICY:-$(conf_value HOLD_POLICY 2>/dev/null)}" ]; then
		echo "hold_policy_reason=explicit"
	elif white_home_on || white_on; then
		echo "hold_policy_reason=white_human"
	else
		echo "hold_policy_reason=black"
	fi
	_open=$(tun_field open_since)
	if [ -n "$_open" ]; then
		echo "hold_state=$(hold_state_value)"
		echo "hold_open_since=$_open"
		echo "hold_open_since_human=$(rb_human "$_open")"
		echo "hold_open_in="
	elif [ "$(hold_policy)" = "closed" ]; then
		echo "hold_state=$(hold_state_value)"
		echo "hold_open_since="
		echo "hold_open_since_human="
		echo "hold_open_in=never"
	elif [ "$_ts" = "down" ]; then
		echo "hold_state=$(hold_state_value)"
		echo "hold_open_since="
		echo "hold_open_since_human="
		if wan_alive; then
			_left=$(( $(hold_open_after) - ( $(date +%s) - ${_tsince:-0} ) ))
			[ "$_left" -lt 0 ] && _left=0
			echo "hold_open_in=$_left"
		else
			# Отсчёт НЕ идёт: канал провайдера лежит, открывать нечего.
			echo "hold_open_in=paused_wan_down"
		fi
	else
		echo "hold_state=$(hold_state_value)"
		echo "hold_open_since="
		echo "hold_open_since_human="
		echo "hold_open_in="
	fi
	# С КАКОГО МОМЕНТА ВЕДЁТСЯ СЧЁТ. Без этого ключа числа ниже читаются как
	# «за всё время», а на деле они за столько, сколько живёт файл. 05.09.2026
	# на переходе версий outage_max_seconds упал с 87 до 7, и понять по статусу,
	# что это разные окна наблюдения, было нечем. Файл переживает подмену версии
	# в обе стороны — проверено прогоном перехода, — поэтому вопрос «за какой
	# срок» встаёт всегда, а не только при обновлении.
	#
	# ЧИТАЕМ ЧЕРЕЗ outages_clean, А НЕ НАПРЯМУЮ. Найдено 15.09.2026 на живом
	# журнале владельца: первая строка была голым «87» без второго поля —
	# хвост формата ДО «время длительность» (буквально то самое число 87 из
	# провала выше, только тогда его читали по другому полю). Читая NR==1
	# напрямую, outages_since печатал бы «87» — 1970 год вместо реальной
	# даты первой пропажи, притом что показатель существует РОВНО чтобы такое
	# не путать.
	# ОДИН ЧИТАННЫЙ ЖУРНАЛ НА ВСЕ ЧЕТЫРЕ ПОЛЯ (1.73, владелец, 21.09.2026,
	# пункт 2 хвоста шага 11): было четыре отдельных вызова outages_clean(),
	# каждый — свой проход по файлу; на журнале, выросшем за месяцы, это
	# четыре лишних чтения там, где хватает одного.
	_oc=$(outages_clean_cached)
	_os=$(printf '%s\n' "$_oc" | awk 'NR == 1 {print $1}')
	case "$_os" in ''|*[!0-9]*) _os="" ;; esac
	echo "outages_since=$_os"
	echo "outages_since_human=$(rb_human "$_os")"
	echo "outages_recorded=$(printf '%s\n' "$_oc" | grep -c . || echo 0)"
	echo "outage_last_seconds=$(printf '%s\n' "$_oc" | awk '{print $2}' | tail -1)"
	echo "outage_max_seconds=$(printf '%s\n' "$_oc" | awk '{print $2}' | sort -n | tail -1)"
	echo "list_entries=$(list_count)"
	echo "dns_sets=$(dns_set_count)"
	chain_exists   "$CH_MARK" && echo "chain_mark=yes" || echo "chain_mark=no"
	chain_exists   "$CH_MSS"  && echo "chain_mss=yes"  || echo "chain_mss=no"
	chain_exists_f "$CH_FWD"  && echo "chain_fwd=yes"  || echo "chain_fwd=no"
	ipt  -C PREROUTING -j "$CH_MARK" && echo "jump_mark=yes" || echo "jump_mark=no"
	ipt  -C FORWARD    -j "$CH_MSS"  && echo "jump_mss=yes"  || echo "jump_mss=no"
	ipt  -C OUTPUT     -j "$CH_MSS"  && echo "jump_mss_output=yes" || echo "jump_mss_output=no"
	# ПАРНЫЙ СЧЁТЧИК К chain_mss/jump_mss — НО ТОЛЬКО КОГДА ОН ОТВЕЧАЕТ НА
	# ЗАДАННЫЙ ВОПРОС.
	#
	# Цепочка MERIDIAN_MSS одна, а прыжков на неё может быть два: из FORWARD
	# (трафик дома, там -o <туннель> совпадает законно) и из OUTPUT (трафик
	# роутера, там не совпадает никогда). Счётчики правил суммируют попадания
	# с ОБЕИХ точек входа и разделить их не могут. Ненулевое число при двух
	# прыжках означает лишь «дом клэмпается» и НИЧЕГО не говорит про OUTPUT —
	# а прочтено будет как «клэмп работает».
	#
	# Поэтому: число — только когда точка входа ОДНА. Иначе not-separable.
	_mf=no; _mo=no
	ipt -C FORWARD -j "$CH_MSS" 2>/dev/null && _mf=yes
	ipt -C OUTPUT  -j "$CH_MSS" 2>/dev/null && _mo=yes
	# ЛОКАЛЬНЫЙ КЛЭМП: присутствие И СЧЁТЧИК, сразу парой. У этой цепочки
	# точка входа одна по построению, поэтому число всегда осмысленно.
	chain_exists "$CH_MSS_LOCAL" && echo "chain_mss_local=yes" || echo "chain_mss_local=no"
	ipt -C OUTPUT -j "$CH_MSS_LOCAL" 2>/dev/null && echo "jump_mss_local=yes" || echo "jump_mss_local=no"
	echo "mss_local_packets=$(schyot_pravil "$CH_MSS_LOCAL" "-j TCPMSS" ipt || echo нет)"
	_status_mark "6_pered_selfdns"
	# --- СВОЙ DNS РОУТЕРА В ТУННЕЛЬ (шаг 11) ---
	# КЛЮЧИ ПАРАМИ: присутствие и счётчик действия, ПО ТОЧКЕ ВХОДА. Вход у этой
	# цепочки один — mangle OUTPUT, — поэтому число относится к нему всегда, и
	# оговорки not-separable здесь быть не может по построению.
	chain_exists "$SELFDNSCHAIN" && echo "chain_selfdns=yes" || echo "chain_selfdns=no"
	ipt -C OUTPUT -j "$SELFDNSCHAIN" 2>/dev/null && echo "jump_selfdns=yes" || echo "jump_selfdns=no"
	# ОДИН СНИМОК -S/-L НА marked И НА ТРИ ПРАВИЛА-СЧЁТЧИКА УТЕЧКИ СРАЗУ
	# (1.68, schyot_pravil_mnogo) — окно, где эти числа могли разъехаться
	# по времени (инвариант 22), схлопнуто до одной пары чтений. packets —
	# ДРУГАЯ цепочка (OUTPUT), читается ОТДЕЛЬНО и ПОСЛЕ: счётчик только
	# растёт, и более позднее чтение не может оказаться меньше того, что уже
	# насчитано мгновением раньше.
	_sd_res=$(schyot_pravil_mnogo "$SELFDNSCHAIN" ipt \
		"--set-xmark $MARK/$MASK" \
		"^-A $SELFDNSCHAIN -p udp.*--dport 53\$" \
		"^-A $SELFDNSCHAIN -p tcp.*--dport 53\$" \
		"^-A $SELFDNSCHAIN -p tcp.*--dport 853\$")
	_sd_m=$(printf '%s\n' "$_sd_res" | sed -n '1p')
	_sd_l1=$(printf '%s\n' "$_sd_res" | sed -n '2p')
	_sd_l2=$(printf '%s\n' "$_sd_res" | sed -n '3p')
	_sd_l3=$(printf '%s\n' "$_sd_res" | sed -n '4p')
	_sd_p=$(schyot_pravil OUTPUT "-j $SELFDNSCHAIN" ipt)
	echo "selfdns_packets=${_sd_p:-нет}"
	echo "selfdns_marked=${_sd_m:-нет}"
	# ТРИ ПРАВИЛА БЕЗ ЦЕЛИ, БЕЗ -m comment (владелец, 21.09.2026, инвариант
	# 32 — см. out_rules). Сумма их живых счётчиков и есть selfdns_direct;
	# не читается СРАЗУ вся тройка — «нет», а не нолём, чтобы непрочитанное
	# не выглядело чистым.
	if [ -n "$_sd_l1" ] && [ -n "$_sd_l2" ] && [ -n "$_sd_l3" ]; then
		echo "selfdns_direct=$(( _sd_l1 + _sd_l2 + _sd_l3 ))"
	else
		echo "selfdns_direct=нет"
	fi
	# ЧТО ЭТО ЧИСЛО НЕ ЛОВИТ — СКАЗАНО ЗДЕСЬ, А НЕ ОСТАВЛЕНО ДОГАДКЕ.
	echo "selfdns_direct_pochemu=DNS роутера мимо туннеля К АДРЕСУ ВНЕ $KEEPSET; резолвер провайдера в приватном диапазоне попал бы в keep и сюда не дошёл бы — такой случай ловится conntrack-разделом приёмки"
	_status_mark "7_pered_wantun"
	# --- ПО ТОЧКЕ ВЫХОДА (POSTROUTING) — WAN ПРОТИВ ТУННЕЛЯ (1.71) ---
	# ЗАЧЕМ ОТДЕЛЬНО ОТ selfdns_marked/selfdns_direct: те читаются в mangle
	# OUTPUT, где для TCP-соединений самого роутера REPLY-адрес в conntrack
	# может врать (адрес источника фиксирован в connect() ДО пометки — см.
	# комментарий у SELFDNSIFCHAIN). В POSTROUTING -o уже решён, врать нечему.
	# Один снимок -S/-L на обе стороны сразу, тем же приёмом, что у marked/direct.
	_swt_wan=$(wan_iface); _swt_tun=$(tun_name)
	if chain_exists "$SELFDNSIFCHAIN" && [ -n "$_swt_wan" ] && [ -n "$_swt_tun" ]; then
		# БЕЗ ЯКОРЯ ^-A ...: iptables -S нормализует порядок ключей при выводе
		# (владелец, 21.09.2026, поймано живьём) — вписывали -o сразу за именем
		# цепочки, а -d уходит ПЕРЕД -o всегда, когда он есть («-d АДРЕС -o
		# ИНТЕРФЕЙС -p ...»). У старых голых правил selfdns_direct якорь работал
		# только потому, что там нет -d вовсе — здесь есть, и якорь молчал
		# нулём. Подстрока «-o ИНТЕРФЕЙС » (с пробелом) однозначна и без якоря:
		# schyot_pravil_mnogo уже отфильтровал -S по нужной цепочке.
		_swt_res=$(schyot_pravil_mnogo "$SELFDNSIFCHAIN" ipt \
			"-o $_swt_wan " \
			"-o $_swt_tun ")
		_swt_w=$(printf '%s\n' "$_swt_res" | sed -n '1p')
		_swt_t=$(printf '%s\n' "$_swt_res" | sed -n '2p')
		echo "selfdns_wan=${_swt_w:-нет}"
		echo "selfdns_tun=${_swt_t:-нет}"
	else
		echo "selfdns_wan=нет"
		echo "selfdns_tun=нет"
	fi
	# ВХОДЯЩИЕ ОТВЕТЫ РЕЗОЛВЕРА НА WAN (владелец, 22.09.2026, авария с DNS
	# meridian-server) — ДОЛЖНО БЫТЬ 0. selfdns_wan/selfdns_tun выше зелёные,
	# даже когда обрыв уже случился: они про то, КУДА УШЁЛ запрос, а не про
	# то, ОТКУДА ПРИШЁЛ ответ. Ненулевое здесь — прямое доказательство утечки
	# мимо туннеля, тем же классом захвата, что поймал причину аварии живьём.
	if chain_exists "$SELFDNSWANINCHAIN" && [ -n "$_swt_wan" ]; then
		_swi_v=$(schyot_pravil "$SELFDNSWANINCHAIN" "--sport" ipt)
		echo "selfdns_wan_in=${_swi_v:-нет}"
	else
		echo "selfdns_wan_in=нет"
	fi
	# СБРОС ПУЛА — ПОДДЕРЖИВАЕТСЯ ЛИ, ВСЕГДА, НЕЗАВИСИМО ОТ out (владелец,
	# 22.09.2026): владелец должен видеть ДО попытки «out on», отказ он
	# получит или нет — не только в момент отказа.
	if dns_pool_reset_supported; then
		echo "selfdns_pool_reset=supported"
		# ЦЕЛЬ — pid ИЛИ «none» (владелец, 22.09.2026, четвёртый заход): server
		# на HERO прямо сейчас поднят вручную, и неизвестно заранее, совпадает
		# ли он с $DNSPIDFILE — видимость этого числа ДО попытки out on и есть
		# приёмка (сверяется с netstat -tnp на :853 живьём).
		echo "selfdns_pool_reset_target=$(dns_server_pid 2>/dev/null || echo none)"
	else
		echo "selfdns_pool_reset=unsupported"
		echo "selfdns_pool_reset_target=none"
	fi
	if out_on; then
		echo "out=on"
		# ПОЗИЦИЯ И СЧЁТЧИК, НЕ ПРОСТО ДА/НЕТ (владелец, 22.09.2026, второй
		# заход): «правило стоит» ничего не говорит о том, работает ли оно —
		# первая редакция стояла безобидным мусором в конце nat POSTROUTING,
		# терминальная цель прошивки решала судьбу пакета раньше. Позиция 1 —
		# единственно верная; счётчик растущий при out=on — подтверждение,
		# что пакеты ДЕЙСТВИТЕЛЬНО доходят до правила, а не просто «стоит».
		_snt_t=$(tun_name)
		# ПОЗИЦИЯ СЧИТАЕТСЯ ОТ ПЕРВОГО ПРАВИЛА, А НЕ ОТ ПЕРВОЙ СТРОКИ ВЫВОДА
		# (владелец, 23.09.2026, живой прогон приёмки #45). Было: номер строки
		# из -S как есть — а первая строка вывода это политика (-P POSTROUTING
		# ACCEPT), не правило. Поэтому наше правило, реально стоящее ПЕРВЫМ,
		# показывалось как selfdns_nat_pos=2 и выглядело сдвинутым вниз, хотя
		# iptables --line-numbers показывал его первым. Логика ПЕРЕСТАНОВКИ
		# (selfdns_nat_poryadok_ensure) была верна всегда: она сравнивает две
		# позиции между собой, и общий сдвиг там сокращается. Врал только этот
		# показатель. Считаем так же, как ensure: относительно первой -A строки.
		_snt_first=$(iptn -S POSTROUTING 2>/dev/null | grep -n '^-A POSTROUTING ' | head -1 | cut -d: -f1)
		_snt_syroj=$(iptn -S POSTROUTING 2>/dev/null | grep -n -- "-o $_snt_t -m mark --mark $MARK/$MASK -j MASQUERADE\$" | head -1 | cut -d: -f1)
		if [ -n "$_snt_syroj" ] && [ -n "$_snt_first" ]; then
			_snt_pos=$((_snt_syroj - _snt_first + 1))
		else
			_snt_pos=""
		fi
		if [ -n "$_snt_pos" ]; then
			echo "selfdns_nat_pos=$_snt_pos"
			_snt_pk=$(schyot_pravil POSTROUTING "-o $_snt_t -m mark --mark $MARK/$MASK -j MASQUERADE" iptn)
			echo "selfdns_nat_pkts=${_snt_pk:-нет}"
		else
			echo "selfdns_nat_pos=нет"
			echo "selfdns_nat_pkts=нет"
		fi
		# ОДИН ЧИТАННЫЙ КЛЮЧ НА ТРИ МЕСТА (1.82, владелец, 22.09.2026: «продолжай»
		# после разведки — панель уже кэширует сама, цель осталась «раз в 4с
		# расчёт короче»). Было: out_state_get confirmed звался живьём ТРИ раза
		# подряд (out_confirmed=, out_confirm_in=, keep_resolvers=) — та же
		# цена, тот же приём, что уже применён к state_get выше. Имя _ocnf, не
		# _oc — _oc уже занято чуть выше (outages_clean_cached), развести во
		# избежание путаницы, хоть по порядку исполнения они и не пересекаются.
		_ocnf=$(out_state_get confirmed)
		echo "out_confirmed=$_ocnf"
		# ИМЕНОВАННЫЕ ЗНАЧЕНИЯ, как у white_confirm_in: слово и число в одном
		# ключе, иначе «подтверждение не нужно» прочтётся числом как ноль.
		if [ "$_ocnf" = "yes" ]; then
			echo "out_confirm_in=confirmed"
		else
			_od=$(out_state_get deadline)
			case "$_od" in
				''|*[!0-9]*) echo "out_confirm_in=never" ;;
				*) _ol=$(( _od - $(date +%s) )); [ "$_ol" -lt 0 ] && _ol=0
				   echo "out_confirm_in=$_ol" ;;
			esac
		fi
		_os=$(out_state_get since)
		echo "out_since=$_os"
		echo "out_since_human=$([ -n "$_os" ] && rb_human "$_os")"
		echo "out_resolvers=$(out_state_get resolvers)"
		# ХВОСТ ШАГА 11 (1.72, владелец, 21.09.2026, пункт 1): словами про
		# размен, а не только числом в $KEEPSET, которое панель не читает.
		if [ "$_ocnf" = "yes" ]; then
			echo "keep_resolvers=excluded"
			echo "keep_resolvers_pochemu=резолверы вне $KEEPSET — ЛЮБОЙ порт к ним идёт через туннель, не только 53/853; упадёт туннель — упадёт и DNS роутера, это выбранный размен шага 11"
		else
			echo "keep_resolvers=kept"
			echo "keep_resolvers_pochemu=слой out ещё не подтверждён — резолверы остаются в $KEEPSET, как в чёрном режиме"
		fi
	else
		echo "out=off"
		echo "out_confirmed="
		echo "out_confirm_in="
		echo "out_since="
		echo "out_since_human="
		echo "out_resolvers="
		echo "keep_resolvers=kept"
		echo "keep_resolvers_pochemu=слой out выключен — резолверы в $KEEPSET, как всегда в чёрном режиме"
	fi
	if [ "$_mf" = yes ] && [ "$_mo" = yes ]; then
		echo "mss_packets=not-separable"
		echo "mss_packets_pochemu=прыжки и из FORWARD, и из OUTPUT — одна цепочка, счётчики не разделяются; разделит шаг 11"
	elif [ "$_mf" = no ] && [ "$_mo" = no ]; then
		echo "mss_packets="
		echo "mss_packets_pochemu=прыжка на цепочку нет ни из FORWARD, ни из OUTPUT"
	else
		echo "mss_packets=$(schyot_pravil "$CH_MSS" "-j TCPMSS" ipt || echo нет)"
		echo "mss_packets_pochemu=точка входа одна ($([ "$_mf" = yes ] && echo FORWARD || echo OUTPUT)) — число относится к ней"
	fi
	iptf -C FORWARD    -j "$CH_FWD"  && echo "jump_fwd=yes"  || echo "jump_fwd=no"
	echo "mtu=$(tun_mtu)"
	echo "mss=$(ipt -S "$CH_MSS" 2>/dev/null | sed -n 's/.*--set-mss \([0-9]*\).*/\1/p' | tail -1)"
	echo "set_refs=$(set_refs "$SET")"
	echo "last_load_ms=${LAST_LOAD_MS:-}"
	rule_present "$PREF_TUN"  && echo "rule_tunnel=yes" || echo "rule_tunnel=no"
	# Ключ прежний — панель читает именно его, — а МЕХАНИЗМ другой: удержание
	# теперь маршрут в таблице, а не второе правило политики. Менять имя ключа
	# ради этого нельзя: договор с панелью важнее нашей внутренней перестановки.
	hold_route_present && echo "rule_hold=yes"   || echo "rule_hold=no"
	echo "hold_kind=route"
	route_present && echo "default_route=yes" || echo "default_route=no"
	[ -f "$HOOK" ] && echo "hook=yes" || echo "hook=no"
	echo "hook_runs=$(hod_schyot "$HOOKRUNS")"
	# cron_line и crond_running — раздельно и намеренно: строка стоит, а crond
	# мёртв — это не то же самое, что периодики нет вовсе, и объединять их в
	# одно поле значило бы прятать именно тот случай молчаливой деградации,
	# ради которого поле вообще заводили.
	grep -qF "$CRONMARK" "$CRONFILE" 2>/dev/null && echo "cron_line=yes" || echo "cron_line=no"
	crond_alive && echo "crond_running=yes" || echo "crond_running=no"
	echo "ensure_runs=$(hod_schyot "$ENSURERUNS")"
	# У ip rule СЧЁТЧИКОВ НЕТ — ядро их не ведёт. Выдумывать парный ключ для
	# rule_tunnel/rule_hold не стану: косвенный ответ даёт marked_packets
	# (пометка ставится) плюс hold_state. Сказано прямо, чтобы никто не искал
	# ключ, которого не будет.
	echo "rule_counters=нет (ip rule счётчиков не ведёт; действие видно по marked_packets и hold_state)"
	echo "marked_packets=$(marked_packets)"
	echo "accepted_packets=$(accepted_packets)"
	echo "armed_pid=$(cat "$ARMEDPID" 2>/dev/null)"
	# ОДНО ЧТЕНИЕ НА changed=/changed_human= (1.82) — было два живых
	# state_get changed подряд на один и тот же ключ.
	_chg=$(state_get changed)
	echo "changed=$_chg"
	# Та же беда, что у last_rollback: значение читает программа, а смотрит
	# человек. Отдельным ключом, не припиской в скобках.
	echo "changed_human=$(rb_human "$_chg")"
	echo "note=$(state_get note)"
	# Расхождение «включено» с фактом — это не «включено», а «включено частично».
	# Говорим об этом отдельной строкой, чтобы панели не пришлось догадываться.
	_status_mark "8_pered_partial"
	# $M — тот же mode= из $STATE, уже прочитанный в начале расчёта (1.82).
	if [ "$M" = "black" ]; then
		P=""
		list_empty && ! dns_has_sets && P="$P СПИСОК ПУСТ и доменных групп нет — помечать нечего, режим ничего не делает;"
		rule_present "$PREF_TUN" || P="$P нет правила политики;"
		set_exists "$SET"        || P="$P нет набора;"
		ipt  -C PREROUTING -j "$CH_MARK" || P="$P нет прыжка в PREROUTING;"
		iptf -C FORWARD    -j "$CH_FWD"  || P="$P нет разрешения транзита (FORWARD);"
		chain_exists_f "$CH_FWD"         || P="$P нет цепочки $CH_FWD;"
		route_present            || P="$P нет маршрута в таблице $TABLE;"
		if [ -n "$P" ]; then echo "partial=$P"; else echo "partial="; fi
	else
		echo "partial="
	fi
	_status_mark "9_end"
	iptsnap_release
	rtsnap_release
}

cmd_list() {
	case "$1" in
		show|"") [ -f "$LIST" ] && list_clean || say "список пуст ($LIST не существует)" ;;
		add)
			shift
			[ -n "$1" ] || fail "что добавить?"
			valid_cidr "$1" || fail "не адрес и не подсеть: «$1»"
			R=$(forbidden_reason "$1"); [ -n "$R" ] && fail "нельзя «$1»: $R"
			mkdir -p "$(dirname "$LIST")" 2>/dev/null
			if list_clean | grep -qx "$1"; then say "уже есть: $1"; return 0; fi
			echo "$1" >> "$LIST"
			clear_empty_mark
			say "добавлено: $1"
			log "в список добавлено $1"
			[ "$(state_get mode)" = "black" ] && { set_load && say "набор обновлён: $(set_entries) записей"; }
			;;
		del)
			shift
			[ -n "$1" ] || fail "что убрать?"
			[ -f "$LIST" ] || fail "списка нет"
			TMP="$LIST.tmp.$$"
			grep -vx "$1" "$LIST" > "$TMP" 2>/dev/null
			mv -f "$TMP" "$LIST"
			say "убрано: $1"
			log "из списка убрано $1"
			[ "$(state_get mode)" = "black" ] && { set_load && say "набор обновлён: $(set_entries) записей"; }
			;;
		*) fail "list show|add <адрес>|del <адрес>" ;;
	esac
}

usage() {
	cat <<USAGEEOF
meridian-route $VERSION — чёрный режим: выбранные адреса в туннель Meridian

  on [--confirm N]   применить (по умолчанию N=$CONFIRM_DEFAULT с на подтверждение)
  confirm            подтвердить, что связь жива — отменить откат
  off [--force]      снять ВСЁ одной операцией и проверить, что не осталось следов
  status             факт на роутере, строками ключ=значение
  ensure             привести в соответствие, молча (своя периодика, раз в минуту — cron_install)
  route-up           ТОЛЬКО маршрут в таблице TABLE, дёшево (зовёт клиент сразу после создания TUN)
  keep build|check|gate|show   набор неснимаемых исключений белого режима
  home-ifaces        интерфейсы дома (мосты), ИМЕНАМИ — один источник для
                     заворота DNS (Кот 2) и для home_nets= в status. Мостов
                     нет ни одного — отказ словами, код 2, список не гадаем.
  white on [--confirm N] | off | confirm | show
  white list show | add <адрес|подсеть|домен> | del <запись> | clear --yes
                     ИСКЛЮЧЕНИЯ белого режима: что идёт НАПРЯМУЮ, минуя туннель.
                     Адреса и подсети — свой файл, между режимами не
                     переносится, переживает перезагрузку. Домены — через
                     meridian-dns (add по синтаксису: буквы = домен), показ и
                     удаление объединяют оба хранилища. dns_direct_merge_ready
                     — аварийный выключатель слияния, в бою открыт; закрытый
                     возвращает поведение 1.47 (домен отказывается кодом 1).
                     БЕЛЫЙ РЕЖИМ НА ВЕСЬ ДОМ: весь трафик домашних сетей,
                     кроме исключений, идёт в туннель. Не подтвердили за N
                     секунд — снимается сам и возвращает прежний режим.
                     Удержание в белом режиме — closed: пропадёт туннель,
                     дом останется без интернета до 'hold open'.
  white-test on <адрес> [--confirm N] | off | confirm | show
                     белый режим ДЛЯ ОДНОГО УСТРОЙСТВА: весь его трафик, кроме
                     исключений, идёт в туннель. Остальной дом не затронут.
                     Не подтвердили за N секунд — снимается сам.
  out on [--confirm N] | off | confirm | show
                     СВОЙ DNS РОУТЕРА — В ТУННЕЛЬ. Пакеты самого роутера
                     рождаются в OUTPUT и в цепочку дома не заходят: без этого
                     слоя дом внутри туннеля, а его резолвер спрашивается мимо.
                     Метятся 53 и 853 к ЧИСТЫМ резолверам (адреса спрошены у
                     meridian-dns). Транспорт клиента не метится никогда.
                     ТУННЕЛЬ ЛЯЖЕТ — ЛЯЖЕТ И DNS РОУТЕРА: размен выбран.
                     Не подтвердили за N секунд — снимается сам.
  auto on | off | show | check
                     АВТОПЕРЕХОД 10б-2: N секунд непрерывно на резервном пути
                     клиента — включает белый режим на весь дом; M секунд
                     непрерывно на быстром — возвращает чёрный. Выключен по
                     умолчанию. Любое РУЧНОЕ переключение white — гасит
                     автомат (включить снова: 'auto on'). Суточный потолок
                     переключений — против дребезга при нестабильном канале.
                     Перед включением белого проверяется «зарубежное доступно
                     напрямую?» (2-3 крупных зарубежных адреса + наш вход) —
                     отвечают, значит это НЕ белый список, белый не включается.
                     'auto check' — та же проверка вручную, без переключения
                     режима, печатает, что именно ответило.
  dot off | confirm | show
                     ПОГЛОЩЁН шагом 11: 'dot on' отказывает и отсылает к
                     'out on'. Снятие оставлено живым — на роутерах, где слой
                     успели включить, след должно быть чем убрать.
  nf-reapply         то же дёшево (зовётся крючком NDM; крючки на смену состояния
                     интерфейса измерены 21.08.2026 и не подошли — ndmd не видит
                     TUN, который создаёт не прошивка)
  on-tunnel-up       туннель поднялся: поставить маршрут в таблицу $TABLE
  on-tunnel-down     туннель ушёл: решить, что делать с удержанием
  list show|add <адрес>|del <адрес>
  purge [--with-list]
                     ПОЛНОЕ снятие перед сносом пакета: всё, что снимает off,
                     плюс файлы состояния движка. Деинсталлятор обязан звать
                     ЭТО и до удаления /opt/bin/meridian-route: после удаления
                     снимать правила станет нечем
  hold open|close|show
                     явное решение человека про удержание после порога:
                     open — выпустить трафик открытым каналом сейчас;
                     close — вернуть удержание; show — текущее состояние.
                     С hold_policy=closed (умолчание) это единственный путь
                     в open — движок сам туда больше не переходит
  version            напечатать номер версии
  gw-teardown        снять стопгэп исключения от обходчика DPI (meridian_gw4,
                     шаг 9-10) — ТОЛЬКО по доказательству: 30с считает пакеты
                     к адресам шлюза с меткой и без; снимает, если помеченных
                     больше нуля и непомеченных ровно ноль, иначе отказывает
                     и оставляет стопгэп как есть
  fallback-ack       «понял»: снять след автоматического отката. Единственный
                     способ его снять — ни on, ни off, ни перезапуск движка
                     его не трогают: откат означает, что трафик шёл открытым
                     каналом, и стирать улику должен человек, а не машина

Числа (метка $MARK/$MASK, таблица $TABLE) — умолчания в коде; MSS считается от
фактического MTU интерфейса.
В qwdtt.conf они не пишутся: см. правило 17 в CLAUDE.md.
USAGEEOF
}

# _on_exit_cleanup — ОДИН EXIT trap НА ВЕСЬ СКРИПТ (не по одному на каждую
# команду): trap — один слот на сигнал, второй `trap ... EXIT` где-нибудь
# внутри молча стёр бы этот. Убирает временный файл dns_status_live() (см.
# его комментарий) и снимает замок ensure, если ОН ИМЕННО ЭТА команда его
# взяла ($_ENSURE_LOCKED — флаг, а не сам факт вызова cmd_ensure: другая
# команда замок не трогала и снимать чужой не должна).
_on_exit_cleanup() {
	rm -f "$DNSLIVETMP" "$DNSLIVETMP.tmp" 2>/dev/null
	rm -f "$OUTAGESCLEANTMP" "$OUTAGESCLEANTMP.tmp" 2>/dev/null
	[ -n "${_ENSURE_LOCKED:-}" ] && ensure_lock_release
}
trap '_on_exit_cleanup' EXIT

case "$1" in
	on)             shift; cmd_on "$@" ;;
	confirm)        cmd_confirm ;;
	off)            shift; cmd_off "$@" ;;
	status)         shift; cmd_status "$@" ;;
	ensure)         cmd_ensure ;;
	gw-teardown)    cmd_gw_teardown ;;
	keep)           shift; cmd_keep "$@" ;;
	home-ifaces)    cmd_home_ifaces ;;
	white-test)     shift; cmd_white_test "$@" ;;
	white)          shift; cmd_white "$@" ;;
	auto)           shift; cmd_auto "$@" ;;
	_white_armed)   shift; cmd_white_armed "$@" ;;
	_white_home_armed) shift; cmd_white_home_armed "$@" ;;
	dot)            shift; cmd_dot "$@" ;;
	out)            shift; cmd_out "$@" ;;
	hold)           shift; cmd_hold "$@" ;;
	_dot_armed)     shift; cmd_dot_armed "$@" ;;
	_out_armed)     shift; cmd_out_armed "$@" ;;
	_run_bounded_test) shift; _sec="$1"; shift; run_bounded "$_sec" "$@" ;;
	_white_home_apply_test) white_home_apply; echo "rc=$?" ;;
	route-up)       shift; cmd_route_up "$@" ;;
	nf-reapply)     cmd_nf_reapply ;;
	on-tunnel-up)   cmd_on_tunnel_up ;;
	on-tunnel-down) cmd_on_tunnel_down ;;
	list)           shift; cmd_list "$@" ;;
	fallback-ack)   cmd_fallback_ack ;;
	purge)          shift; cmd_purge "$@" ;;
	_armed)         shift; cmd_armed "$@" ;;
	version)        echo "$VERSION" ;;
	*)              usage ;;
esac
