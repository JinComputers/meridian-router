#!/bin/sh
# meridian-antidpi-ctl — управление анти-DPI для панели (договор с Котом 2).
#
#   status [--machine]      состояние (key=value при --machine)
#   on | off                весь анти-DPI: служба + автозапуск
#   group <имя> on|off      одна группа: youtube | discord | cloudflare | other | social
#
# Коды: 0 — сделано; 1 — отказ (текст отказа одной строкой в stderr,
# начинается с «ОТКАЗ:»); 2 — неверные аргументы.
#
# Белый режим: движок сам встаёт на паузу (paused_white=1 в status), читая
# /etc/qwdtt/meridian-mode.state раз в 2 с; enabled/running при этом не меняются.
#
# Окно подтверждения НЕ нужно: очередь стоит с bypass и касается только
# трафика из домашней сети на внешние адреса. Упавший движок = трафик идёт
# как без анти-DPI; к панели (192.168.x -> роутер) правила не относятся вовсе.

INIT=/etc/init.d/meridian-antidpi
GROUPS=${MERIDIAN_ANTIDPI_GROUPS:-/etc/meridian-antidpi/groups}
STATUS=${MERIDIAN_ANTIDPI_STATUS:-/var/run/meridian-antidpi.status}
LOCK=${MERIDIAN_ANTIDPI_LOCK:-/var/lock/meridian-antidpi-ctl.lock}
ALL="youtube discord cloudflare other social"

otkaz() { echo "ОТКАЗ: $*" >&2; exit 1; }

with_lock() {
	mkdir -p "$(dirname "$LOCK")" 2>/dev/null
	exec 9>"$LOCK"
	_i=0
	# busybox flock без -w: ждём сами, до 15 с
	until flock -n 9; do
		_i=$((_i + 1))
		[ "$_i" -ge 15 ] && otkaz "занято другой командой (замок $LOCK)"
		sleep 1
	done
}

group_val() { # $1 — группа; нет строки/файла = 1
	_v=$(grep -E "^$1=" "$GROUPS" 2>/dev/null | tail -1 | cut -d= -f2)
	case "$_v" in 0|off) echo 0 ;; *) echo 1 ;; esac
}

running() {
	pidof meridian-antidpi >/dev/null 2>&1
}

cmd_status() {
	if running; then _r=1; else _r=0; fi
	if [ -x "$INIT" ] && "$INIT" enabled 2>/dev/null; then _e=1; else _e=0; fi
	if [ "$1" = "--machine" ]; then
		echo "installed=$([ -x /usr/sbin/meridian-antidpi ] && echo 1 || echo 0)"
		echo "enabled=$_e"
		echo "running=$_r"
		for g in $ALL; do echo "group_$g=$(group_val "$g")"; done
		# счётчики — из файла движка (обновляется раз в 10 с)
		[ "$_r" = 1 ] && grep -E '^(paused_white|strategy_[a-z]+|packets|tls_handled|tls_group_off|quic_handled|udp_handled)=' "$STATUS" 2>/dev/null
		return 0
	fi
	echo "анти-DPI: $([ "$_r" = 1 ] && echo работает || echo остановлен), автозапуск $([ "$_e" = 1 ] && echo вкл || echo выкл)"
	for g in $ALL; do echo "  $g: $([ "$(group_val "$g")" = 1 ] && echo вкл || echo выкл)"; done
}

cmd_onoff() {
	[ -x "$INIT" ] || otkaz "анти-DPI не установлен (нет $INIT)"
	with_lock
	if [ "$1" = on ]; then
		"$INIT" enable && "$INIT" start || otkaz "служба не запустилась"
		_i=0
		while ! running; do
			_i=$((_i + 1)); [ "$_i" -ge 10 ] && otkaz "движок не поднялся за 5 с (logread -e meridian-antidpi)"
			sleep 0.5 2>/dev/null || sleep 1
		done
		echo "анти-DPI включён"
	else
		# АВТОЗАПУСК НЕ СНИМАЕМ (владелец 27.09: движок включён всегда, панель
		# общий выключатель убрала — «выкл всех групп» = пропуск трафика, а не
		# остановка службы). `off` только останавливает сейчас; после
		# перезагрузки движок поднимется сам. Полностью убрать — блоком отката.
		"$INIT" stop
		echo "анти-DPI остановлен (автозапуск сохранён — вернётся после перезагрузки)"
	fi
}

cmd_group() {
	case " $ALL " in *" $1 "*) ;; *) echo "неизвестная группа «$1»; можно: $ALL" >&2; exit 2 ;; esac
	case "$2" in on) _v=1 ;; off) _v=0 ;; *) echo "ждали on или off" >&2; exit 2 ;; esac
	with_lock
	mkdir -p "$(dirname "$GROUPS")" || otkaz "нет каталога для $GROUPS"
	_tmp="$GROUPS.tmp.$$"
	{
		echo "# meridian-antidpi: включённость групп (1/0). Правит meridian-antidpi-ctl."
		for g in $ALL; do
			if [ "$g" = "$1" ]; then echo "$g=$_v"; else echo "$g=$(group_val "$g")"; fi
		done
	} > "$_tmp" || { rm -f "$_tmp"; otkaz "не записать $GROUPS"; }
	mv -f "$_tmp" "$GROUPS" || { rm -f "$_tmp"; otkaz "не заменить $GROUPS"; }
	# движок перечитает по SIGHUP; не запущен — прочтёт при старте
	running && { "$INIT" reload >/dev/null 2>&1 || otkaz "группа записана, но движок не перечитал (reload)"; }
	echo "группа $1: $([ "$_v" = 1 ] && echo вкл || echo выкл)"
}

case "$1" in
	status) cmd_status "$2" ;;
	on|off) [ $# -eq 1 ] || { echo "лишние аргументы" >&2; exit 2; }; cmd_onoff "$1" ;;
	group) [ $# -eq 3 ] || { echo "использование: $0 group <имя> on|off" >&2; exit 2; }; cmd_group "$2" "$3" ;;
	*) echo "использование: $0 status [--machine] | on | off | group <$ALL> on|off" >&2; exit 2 ;;
esac
