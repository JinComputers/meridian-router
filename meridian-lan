#!/bin/sh
# meridian-lan — защита от совпадения LAN роутера с подсетью апстрима.
#
# ЗАЧЕМ. 11.09.2026 на стенде LAN 192.168.1.1 совпал с подсетью апстрима, и
# роутер стал недоступен. Клиент failsafe не сделает: для него это просто
# «интернета нет и панель не открывается».
#
# КОГДА. Только на загрузке и ровно один раз за неё: сдвиг LAN рвёт связь тому,
# кто уже подключён. Отметка в /tmp (tmpfs) исчезает при перезагрузке сама.
#
# START=19: после сети (uci network поднят), до всего нашего.
# БЕЗ /etc/rc.common — НАМЕРЕННО.
#
# 11.09.2026: служба была включена (ссылка S19 на месте), `start` отрабатывал
# без единой строки и без эффекта. Из трёх наших служб молчала ровно эта — и
# ровно она одна была не procd, а rc.common с USE_PROCD=0. Две соседние
# (meridian-nft, meridian-route-min) на procd работали и говорили.
#
# Разбираться в семантике rc.common на чужом роутере, без возможности замера,
# значит гадать. Здесь этого не нужно вовсе: задача разовая — посмотреть
# подсети и, если надо, сдвинуть LAN. Свой разбор аргумента короче любого
# объяснения и не зависит ни от чего.
#
# Ссылку автозапуска ставит установщик: /etc/rc.d/S19meridian-lan. Её вызывают
# как `<скрипт> boot`, поэтому boot обязателен и делает то же, что start.
START=19
STOP=99

OTMETKA=/tmp/meridian-lan.sdvinuto

# skazat — И В ЖУРНАЛ, И НА ЭКРАН.
#
# 11.09.2026 установщик читал наши строки через logread и не нашёл ни одной:
# logd — чужой кольцевой буфер, он может не успеть, может быть переполнен, а
# метка тега зависит от системы. Тот, кто нас запускает, обязан видеть наш
# ответ НАПРЯМУЮ, а не через третью службу (правило 31: сравнивать надо с тем,
# что читает программа). В журнал пишем тоже — для загрузки, где нас никто не
# читает с экрана.
skazat() {
    echo "[meridian-lan] $*"
    logger -t meridian-lan "$*"
}
ZAPASNYE="192.168.8 192.168.77 192.168.144 10.144.144"

# peresekaet — пересекаются ли две сети. РАВЕНСТВО НЕ ГОДИТСЯ: при разных
# масках строки различны, а сети вложены. Замерено: LAN 192.168.1.0/24 и WAN
# 192.168.0.0/16 сравнением строк «различны», хотя роутер недоступен.
# Признак — совпадение префиксов по БОЛЕЕ ШИРОКОЙ из двух масок.
peresekaet() {
    echo "$1 $2" | awk '{
        split($1,a,"/"); split($2,b,"/")
        split(a[1],x,"."); split(b[1],y,".")
        ab=(a[2]==""?32:a[2]+0); bb=(b[2]==""?32:b[2]+0)
        if (ab<8||ab>32||bb<8||bb>32) exit 1
        ia=x[1]*16777216+x[2]*65536+x[3]*256+x[4]
        ib=y[1]*16777216+y[2]*65536+y[3]*256+y[4]
        m=(ab<bb?ab:bb)
        d=1; for(k=0;k<32-m;k++) d=d*2
        if (int(ia/d)==int(ib/d)) exit 0
        exit 1
    }'
}

adres_seti() {   # $1 — интерфейс; печатает CIDR первого IPv4
    ip -o -f inet addr show "$1" 2>/dev/null | awk '
        { for (i=1;i<=NF;i++) if ($i=="inet") { print $(i+1); exit } }'
}

wan_ustrojstvo() {
    ip -4 route show default 2>/dev/null | sed -n 's/.*[[:space:]]dev[[:space:]]\([^ ]*\).*/\1/p' | head -1
}

start() {
    if [ -f "$OTMETKA" ]; then
        skazat "за эту загрузку LAN уже сдвигали — второй раз не трогаю"
        return 0
    fi

    LANCIDR=$(adres_seti br-lan)
    if [ -z "$LANCIDR" ]; then
        skazat "адреса br-lan не прочитать — НЕ ЗНАЮ, есть ли конфликт; не трогаю"
        return 0
    fi

    WANDEV=$(wan_ustrojstvo)
    if [ -z "$WANDEV" ]; then
        skazat "маршрута по умолчанию нет — апстрим ещё не поднялся."
        skazat "  Это НЕ «конфликта нет», это «мы не знаем». Не трогаю."
        return 0
    fi
    WANCIDR=$(adres_seti "$WANDEV")
    if [ -z "$WANCIDR" ]; then
        skazat "у $WANDEV нет адреса IPv4 — не знаю подсеть апстрима, не трогаю"
        return 0
    fi

    if ! peresekaet "$LANCIDR" "$WANCIDR"; then
        skazat "LAN $LANCIDR и апстрим $WANCIDR ($WANDEV) не пересекаются — всё в порядке"
        return 0
    fi

    skazat "КОНФЛИКТ: LAN $LANCIDR пересекается с апстримом $WANCIDR ($WANDEV)"

    # ЗАПАСНАЯ ВЫБИРАЕТСЯ ИЗ СПИСКА И ПРОВЕРЯЕТСЯ. «Сдвинуть на +1» попало бы в
    # следующий по популярности конфликт.
    NOVAJA=""
    for P in $ZAPASNYE; do
        if ! peresekaet "$P.0/24" "$WANCIDR"; then
            NOVAJA="$P"
            break
        fi
        skazat "  запасная $P.0/24 тоже пересекается с апстримом — беру следующую"
    done
    if [ -z "$NOVAJA" ]; then
        skazat "ОТКАЗ: ни одна запасная подсеть не свободна. LAN не трогаю."
        skazat "  Задайте вручную: uci set network.lan.ipaddr=...; uci commit network"
        return 1
    fi

    uci set network.lan.ipaddr="$NOVAJA.1"
    uci set network.lan.netmask="255.255.255.0"
    uci commit network
    : > "$OTMETKA"
    /etc/init.d/network reload

    # ПРОВЕРЯЕМ СОДЕРЖИМЫМ, а не кодом возврата uci: «commit прошёл» и «адрес
    # сменился» — разные события.
    sleep 3
    STALO=$(adres_seti br-lan)
    case "$STALO" in
        "$NOVAJA".*) skazat "LAN сдвинут на $STALO — подтверждено чтением" ;;
        *) skazat "ОТКАЗ: после сдвига на br-lan адрес $STALO, ждали $NOVAJA.1"
           return 1 ;;
    esac
    return 0
}

# ГОВОРИМ ПРИ КАЖДОЙ ЗАГРУЗКЕ, пока смещение действует: человек придёт по
# СТАРОМУ адресу и увидит пустоту, а однократная строка в момент сдвига к тому
# времени уже уехала из кольцевого буфера logd.
boot() {
    start
    LANC=$(adres_seti br-lan)
    for P in $ZAPASNYE; do
        case "$LANC" in
            "$P".*) skazat "ВНИМАНИЕ: LAN сейчас $LANC — это ЗАПАСНАЯ подсеть, сдвинутая из-за конфликта с апстримом" ;;
        esac
    done
}

# ---------------------------------------------------------------- свой разбор
#
# Принимаем И `boot` (так зовёт /etc/rc.d), И `start` (так зовёт человек и
# установщик), И запуск без аргумента. Неизвестный аргумент НАЗЫВАЕТСЯ вслух:
# «такой команды нет» неотличимо от «команда есть, но ничего не сделала», а мы
# уже один раз на этом стояли (правило 53).
case "${1:-start}" in
    boot|start)
        boot
        exit $?
        ;;
    stop|restart|reload|enable|disable)
        # Снимать нечего: служба ничего не держит. Говорим прямо, а не молчим
        # с кодом 0 — тихий ноль это «не делал», а не «сделано» (правило 52).
        skazat "команда '$1' этой службе не нужна: она разовая, ничего не держит"
        exit 0
        ;;
    enabled)
        if [ -e "/etc/rc.d/S${START}meridian-lan" ]; then
            exit 0
        fi
        exit 1
        ;;
    *)
        echo "meridian-lan: неизвестная команда '$1'. Бывают: boot, start, enabled"
        exit 2
        ;;
esac
