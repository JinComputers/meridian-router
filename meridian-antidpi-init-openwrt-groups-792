#!/bin/sh /etc/rc.common
# meridian-antidpi на OpenWrt (procd). Замена nfqws2 (решение владельца 26.09.2026).
#
# start: грузит свою nft-таблицу (очередь 301, bypass), потом движок.
# stop:  снимает СВОЮ таблицу — трафик идёт как без анти-DPI.
# reload: SIGHUP движку — перечитать /etc/meridian-antidpi/groups (переключатели
#         групп в панели), очередь не переоткрывается.
# Состояние для панели: /var/run/meridian-antidpi.status (ключ=значение).

USE_PROCD=1
START=52
STOP=10

BIN=${MERIDIAN_ANTIDPI_BIN:-/usr/sbin/meridian-antidpi}
NFT=${MERIDIAN_ANTIDPI_NFT:-/etc/meridian-antidpi/antidpi.nft}
QUEUE=301
GROUPSF=${MERIDIAN_ANTIDPI_GROUPS:-/etc/meridian-antidpi/groups}
AUTOPAUSE=${MERIDIAN_ANTIDPI_AUTOPAUSE:-$(dirname "$GROUPSF")/all-groups-paused}
all_groups_off() {
 for _g in youtube discord cloudflare other social; do
  _v=$(grep -E "^$_g=" "$GROUPSF" 2>/dev/null | tail -1 | cut -d= -f2)
  case "$_v" in 0|off) ;; *) return 1 ;; esac
 done
 return 0
}

start_service() {
 if all_groups_off; then
  mkdir -p "$(dirname "$AUTOPAUSE")" || return 1
  (umask 077; : > "$AUTOPAUSE") || return 1
  _tables=$(nft list tables 2>/dev/null) || return 1
  if echo "$_tables" | grep -q '^table inet meridian_antidpi$'; then
   nft delete table inet meridian_antidpi || return 1
  fi
  return 0
 fi
	[ -x "$BIN" ] || { echo "нет $BIN"; return 1; }
	nft -c -f "$NFT" || { echo "ОТКАЗ: $NFT не проходит nft -c"; return 1; }
	nft -f "$NFT" || { logger -t meridian-antidpi "таблица не загружена"; return 1; }
	procd_open_instance
	procd_set_param command "$BIN" -queue "$QUEUE"
	_mem_kb=$(awk '/^MemTotal:/ {print $2; exit}' /proc/meminfo 2>/dev/null); case "$_mem_kb" in ''|*[!0-9]*) _mem_kb=0 ;; esac
	if [ "$_mem_kb" -gt 0 ] && [ "$_mem_kb" -lt 200000 ]; then
		procd_set_param env GOGC="${GOGC:-50}" GOMEMLIMIT="${GOMEMLIMIT:-6MiB}"
	fi
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
    rm -f "$AUTOPAUSE"
}

stop_service() {
	nft delete table inet meridian_antidpi 2>/dev/null
	rm -f /var/run/meridian-antidpi.status
}

reload_service() {
	procd_send_signal meridian-antidpi '*' HUP
}
