#!/bin/sh
# qwdtt-run — запускатель клиента. Читает конфиг сам и делает exec.
#
# ЗАЧЕМ ОТДЕЛЬНЫЙ ЗАПУСКАТЕЛЬ, А НЕ ПРЯМОЙ ЗАПУСК ИЗ procd. Две причины, обе
# измерены 10.09.2026:
#
#  1. STDIN. Клиент читает стандартный ввод в отдельной горутине (main.go:164)
#     и исполняет строки PAUSE, RESUME, STOP, CAPTCHA_RESULT|… . STOP вызывает
#     cancel(), то есть ЧУЖАЯ СТРОКА ГАСИТ КЛИЕНТА. Боевой init на Keenetic
#     запускает его с < /dev/null именно поэтому. У procd параметра для stdin
#     нет — значит нужен exec с перенаправлением, и это здесь.
#
#  2. ARGV БЕЗ ПЕРЕВОДОВ СТРОКИ. Перевод строки внутри значения расщепляет
#     список доводов: 10.09.2026 -n получил "\n", клиент напечатал справку и
#     вышел. Здесь каждое значение чистится ПЕРЕД сборкой argv, и если после
#     чистки в нём всё равно остался перевод — отказ, а не запуск наугад.

CONF="${QWDTT_CONF:-/etc/qwdtt/qwdtt.conf}"
# ПУТЬ К КОНФИГУ ОТДАЁТСЯ КЛИЕНТУ. Без этой строки он искал его по зашитому
# Entware-пути /opt/etc/qwdtt/qwdtt.conf, которого на OpenWrt нет, и МОЛЧА брал
# умолчания — ВСЕ ОДИННАДЦАТЬ настроек: TRANSPORT, DIRECT_RECHECK, DIRECT_NOTLS,
# DIRECT_NOTLS_PORT, RELAY_NOTLS, SLOTS, SLOTS_AUTO, SLOTS_MAX, ROTATE_AFTER,
# LOG_MAX_KB, DEBUG.
#
# Замерено владельцем 11.09.2026: TRANSPORT="direct" в конфиге, а клиент пошёл
# авто → VK → капча. Отличить «файла нет» от «в файле ничего не задано» было
# нельзя: ошибки нет, в журнале штатная работа.
#
# Флагами эти ключи НЕ передаём намеренно. Запускатель, читающий конфиг и
# перекладывающий его во флаги, — это второе место, где живут те же значения
# (правило 51), и оно разъедется с первым при добавлении двенадцатой настройки.
# Здесь отдаётся ПУТЬ, а читает файл тот, кому он нужен.
export QWDTT_CONF="$CONF"

# РАБОЧИЙ КАТАЛОГ — ОТДЕЛЬНО ОТ КОНФИГА, и это не мелочь.
#
# Клиент кладёт туда то, что ДОЛЖНО исчезать вместе с процессом: маркер
# текущего пути (qwdtt-path.json, его читает панель) и метку мёртвого хеша.
# Умолчание у клиента парковое — /opt/var/run, которого на OpenWrt нет, и
# запись падает МОЛЧА: маркер не появляется, панель показывает «пути нет», и
# это неотличимо от «клиент ещё не выбрал путь».
#
# Не складываем в один каталог с конфигом намеренно: там же лежит счётчик
# износа ссылок и отметка запрета VK, а они обязаны пережить перезагрузку.
# На OpenWrt /var/run — это tmpfs, и счётчик износа там терялся бы каждый раз.
QWDTT_RUN="${QWDTT_RUN:-/var/run}"
mkdir -p "$QWDTT_RUN" 2>/dev/null
export QWDTT_RUN
BIN="${QWDTT_BIN:-/usr/sbin/qwdtt}"

[ -f "$CONF" ] || { echo "нет $CONF" >&2; exit 1; }
[ -x "$BIN" ] || { echo "нет $BIN" >&2; exit 1; }

. "$CONF"

chistoe() {
    printf '%s' "$1" | tr -d '\r\n'
}

PEER=$(chistoe "$PEER")
PASSWORD=$(chistoe "$PASSWORD")
VK_HASHES=$(chistoe "$VK_HASHES")
DEVICE_ID=$(chistoe "$DEVICE_ID")
RAW_TUN=$(chistoe "${RAW_TUN:-meridian}")
ANON_PATH=$(chistoe "${ANON_PATH:-vkcalls}")

RAW_HOST=$(echo "$PEER" | cut -d: -f1)
RAW_PEER=$(chistoe "${RAW_PEER:-${RAW_HOST}:56004}")

[ -n "$PEER" ] || { echo "в $CONF не задан PEER" >&2; exit 1; }
[ -n "$PASSWORD" ] || { echo "в $CONF не задан PASSWORD" >&2; exit 1; }
[ -n "$VK_HASHES" ] || { echo "в $CONF не задан VK_HASHES" >&2; exit 1; }
[ -n "$DEVICE_ID" ] || { echo "в $CONF не задан DEVICE_ID" >&2; exit 1; }

# ПОСЛЕДНЯЯ ПРОВЕРКА ПЕРЕД argv: ни в одном значении нет перевода строки.
# Считаем строки: у чистого значения она одна.
for Z in "$PEER" "$PASSWORD" "$VK_HASHES" "$DEVICE_ID" "$RAW_TUN" "$RAW_PEER"; do
    N=$(printf '%s\n' "$Z" | grep -c .)
    if [ "$N" != "1" ]; then
        echo "ОТКАЗ: значение в $CONF занимает $N строк — argv расщепится" >&2
        exit 1
    fi
done

# -n ЛИТЕРАЛОМ. N в конфиге не задаётся, индирекция ${N:-24} не нужна и опасна:
# именно на -n сел перевод строки. В RAW воркеры не читаются вовсе
# (main.go:315), число здесь ни на что не влияет и меняться не должно.
exec "$BIN" \
    -mode raw \
    -tun "$RAW_TUN" \
    -peer "$RAW_PEER" \
    -password "$PASSWORD" \
    -vk "$VK_HASHES" \
    -vk-anon-path "$ANON_PATH" \
    -n 24 \
    -device-id "$DEVICE_ID" < /dev/null
